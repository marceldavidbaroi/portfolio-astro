---
import type { CollectionEntry } from 'astro:content';

type EduData = CollectionEntry<'education'>['data'];

interface Props {
	isBsc: boolean;
	bscCseProgram: EduData;
	hscScienceProgram: EduData;
}

const { isBsc, bscCseProgram, hscScienceProgram } = Astro.props;
---

<!-- Hero Section -->
<header class="edu-hero card">
	<div class="hero-top-meta">
		<span class="section-tag">{isBsc ? '01 // UNDERGRADUATE DEGREE' : '02 // HIGHER SECONDARY'}</span>
		<div class="hero-badges-wrap">
			<span class={isBsc ? "diu-batch-badge font-mono" : "ndc-batch-badge font-mono"}>
				{isBsc ? "CSE BATCH 55" : "BATCH '19 // GROUP 13"}
			</span>
			<span class="badge-status success">{isBsc ? bscCseProgram.badge : hscScienceProgram.badge}</span>
		</div>
	</div>

	<div class="edu-hero-main-group">
		{isBsc && bscCseProgram.logo && (
			<div class="edu-logo-wrapper">
				<img
					src={bscCseProgram.logo}
					alt={`${bscCseProgram.institution} Crest Logo`}
					class="edu-institution-logo"
					width="88"
					height="88"
					loading="eager"
				/>
			</div>
		)}
		{!isBsc && hscScienceProgram.logo && (
			<div class="edu-logo-wrapper ndc-logo-box">
				<img
					src={hscScienceProgram.logo}
					alt={`${hscScienceProgram.institution} Logo`}
					class="edu-institution-logo ndc-logo-img"
					width="160"
					height="65"
					loading="eager"
				/>
			</div>
		)}
		<div class="edu-hero-title-group">
			<h1 class="edu-hero-title font-dot">
				{isBsc ? bscCseProgram.degree : hscScienceProgram.degree}
			</h1>

			<div class="edu-institution-line">
				<a
					href={isBsc ? bscCseProgram.institutionUrl : hscScienceProgram.institutionUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inst-name-link"
					title={`Visit ${isBsc ? bscCseProgram.institution : hscScienceProgram.institution} Official Website`}
				>
					<span>{isBsc ? bscCseProgram.institution : hscScienceProgram.institution}</span>
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
						<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
						<polyline points="15 3 21 3 21 9"></polyline>
						<line x1="10" y1="14" x2="21" y2="3"></line>
					</svg>
				</a>
				<span class="inst-bullet">•</span>
				<span class="inst-loc">{isBsc ? bscCseProgram.location : hscScienceProgram.location}</span>
			</div>
		</div>
	</div>

	<div class="official-portal-row">
		{!isBsc && (
			<a
				href="/education/hsc-science/gallery"
				class="official-portal-link highlight-gallery font-mono"
			>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
					<circle cx="9" cy="9" r="2"></circle>
					<path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
				</svg>
				<span>Explore NDC Photo Gallery & Memoirs (75+ Photos) →</span>
			</a>
		)}

		<a
			href={isBsc ? bscCseProgram.institutionUrl : hscScienceProgram.institutionUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="official-portal-link font-mono"
		>
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10"></circle>
				<line x1="2" y1="12" x2="22" y2="12"></line>
				<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1 4-10z"></path>
			</svg>
			<span>Official Institutional Portal ↗</span>
		</a>
	</div>

	<!-- Metadata Summary Bar -->
	<div class="edu-meta-strip font-mono">
		<div class="meta-item">
			<span class="meta-lbl">RESULT / STANDING</span>
			<span class="meta-val font-dot highlight">
				{isBsc ? `CGPA ${bscCseProgram.cgpa.toFixed(2)} / 4.00` : `GPA ${hscScienceProgram.gpa.toFixed(2)} / 5.00`}
			</span>
		</div>
		<div class="meta-item">
			<span class="meta-lbl">{isBsc ? 'DEPARTMENT & BATCH' : 'COLLEGE BATCH'}</span>
			<span class="meta-val highlight-batch">
				{isBsc ? 'CSE Batch 55' : "Batch '19 (Group 13)"}
			</span>
		</div>
		<div class="meta-item">
			<span class="meta-lbl">DURATION</span>
			<span class="meta-val">{isBsc ? bscCseProgram.period : hscScienceProgram.period}</span>
		</div>
		<div class="meta-item">
			<span class="meta-lbl">ACCREDITATION</span>
			<span class="meta-val status-verified">Completed & Verified</span>
		</div>
	</div>
</header>
