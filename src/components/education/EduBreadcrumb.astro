---
interface Props {
	isBsc: boolean;
}

const { isBsc } = Astro.props;
const current = isBsc ? 'B.Sc. CSE' : 'HSC Science';
---

<nav class="attic-crumb font-mono" aria-label="Breadcrumb">
	<a href="/about#school" class="attic-crumb-link">About</a>
	<span class="attic-crumb-sep" aria-hidden="true">/</span>
	<span class="attic-crumb-current">{current}</span>
</nav>
