---
import type { CollectionEntry } from 'astro:content';
import AcademicTranscript from '../AcademicTranscript.astro';

type EduData = CollectionEntry<'education'>['data'];

interface Props {
	isBsc: boolean;
	bscCseProgram: EduData;
	hscScienceProgram: EduData;
}

const { isBsc, bscCseProgram, hscScienceProgram } = Astro.props;

const hscClubs = [
	{
		title: 'Notre Dame Math Club (NDMC)',
		role: 'Club Member & Participant',
		desc: 'Engaged in mathematical problem solving, analytical logic workshops, and club activities promoting competitive mathematics and reasoning.',
	},
	{
		title: 'Notre Dame Cultural Club (NDCC)',
		role: 'Club Member & Participant',
		desc: 'Participated in collegiate cultural events, creative festivals, and student collaborative programs organized by Notre Dame Cultural Club.',
	},
];
---

{isBsc ? (
	<div class="edu-detail-body">
		<section class="edu-section">
			<h2 class="edu-section-title font-sans">Specializations</h2>
			<ol class="edu-name-list font-sans">
				{bscCseProgram.keyFocusAreas.map((area) => (
					<li>{area}</li>
				))}
			</ol>
		</section>

		<section class="edu-section" id="varsity-activities">
			<h2 class="edu-section-title font-sans">Varsity Activities &amp; Research</h2>
			{bscCseProgram.formativeMilestones && (
				bscCseProgram.formativeMilestones.map((m) => {
					const Tag = m.url ? 'a' : 'div';
					return (
						<Tag href={m.url} class:list={['about-rail-row edu-milestone-row font-sans', { 'is-link': m.url }]}>
							<p class="about-rail-when font-sans">{m.period}</p>
							<div>
								<p class="about-rail-tag font-sans">{m.tag}</p>
								<h3 class="about-rail-title font-sans">{m.title}</h3>
								<p class="about-rail-sub font-sans">{m.description}</p>
								{m.impact && <p class="edu-milestone-impact font-sans">{m.impact}</p>}
							</div>
						</Tag>
					);
				})
			)}
		</section>

		<section class="edu-section edu-slot">
			<h2 class="edu-section-title font-sans">Transcript</h2>
			<AcademicTranscript />
		</section>
	</div>
) : (
	<div class="edu-detail-body">
		<section class="edu-section">
			<h2 class="edu-section-title font-sans">Overview</h2>
			<p class="edu-body-text font-sans">{hscScienceProgram.summary}</p>
		</section>

		<section class="edu-section">
			<h2 class="edu-section-title font-sans">Subjects</h2>
			<ul class="edu-name-list edu-name-list-inline font-sans">
				{hscScienceProgram.keyCourses.map((subject) => (
					<li>{subject}</li>
				))}
			</ul>
		</section>

		<section class="edu-section">
			<figure class="edu-figure">
				<img
					src="/images/education/ndc-batch-19-group-13.webp"
					alt="Notre Dame College Batch '19 Group 13 formation display"
					class="edu-figure-img"
					loading="lazy"
				/>
				<figcaption class="edu-figure-caption font-sans">
					Batch '19 · Group 13 · Room 304 — aerial lawn formation on the Notre Dame College field.
				</figcaption>
			</figure>
			<a href="/education/hsc-science/gallery" class="section-link font-sans">Gallery →</a>
		</section>

		<section class="edu-section">
			<h2 class="edu-section-title font-sans">Clubs</h2>
			{hscClubs.map((club) => (
				<div class="edu-beyond-row font-sans">
					<p class="edu-beyond-term font-sans">{club.title}</p>
					<p class="edu-beyond-meta font-sans">{club.role}</p>
					<p class="edu-beyond-desc font-sans">{club.desc}</p>
				</div>
			))}
		</section>

		{hscScienceProgram.formativeMilestones && (
			<section class="edu-section">
				<h2 class="edu-section-title font-sans">Milestones</h2>
				{hscScienceProgram.formativeMilestones.map((m) => {
					const Tag = m.url ? 'a' : 'div';
					return (
						<Tag href={m.url} class:list={['about-rail-row edu-milestone-row font-sans', { 'is-link': m.url }]}>
							<p class="about-rail-when font-sans">{m.period}</p>
							<div>
								<p class="about-rail-tag font-sans">{m.tag}</p>
								<h3 class="about-rail-title font-sans">{m.title}</h3>
								<p class="about-rail-sub font-sans">{m.description}</p>
								{m.impact && <p class="edu-milestone-impact font-sans">{m.impact}</p>}
							</div>
						</Tag>
					);
				})}
			</section>
		)}
	</div>
)}
