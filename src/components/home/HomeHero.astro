---
import { site } from '../../data/site';
---

<section class="hero" aria-label="Introduction">
	<div class="hero-content">
		<h1 class="headline font-sans">
			Software engineer designing and building cross-platform applications.
		</h1>

		<p class="bio">
			I design and build full-stack web and mobile systems across Next.js, Vue, NestJS, Flutter, and PostgreSQL — turning complex business workflows into fast, intuitive products that scale.
		</p>

		<div class="hero-actions">
			<a class="action-item font-sans is-primary" href={`mailto:${site.email}`}>
				Get in touch <span class="action-arrow" aria-hidden="true">›</span>
			</a>
			<a class="action-item font-sans" href={site.resumePdf} target="_blank" rel="noopener noreferrer">
				Resume <span class="action-arrow" aria-hidden="true">›</span>
			</a>
			<a class="action-item font-sans" href={site.linkedin} target="_blank" rel="noopener noreferrer">
				LinkedIn <span class="action-arrow" aria-hidden="true">›</span>
			</a>
			<a class="action-item font-sans" href={site.github} target="_blank" rel="noopener noreferrer">
				GitHub <span class="action-arrow" aria-hidden="true">›</span>
			</a>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-top: 1.5rem;
		padding-bottom: 4.5rem;
		border-bottom: 1px solid var(--card-border);
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		max-width: 44rem;
	}

	.headline {
		margin: 0;
		font-size: clamp(1.85rem, 3.2vw, 2.65rem);
		font-weight: 600;
		letter-spacing: -0.035em;
		line-height: 1.22;
		color: var(--text-main);
		text-wrap: balance;
		animation: heroFadeUp 0.6s var(--ease-out) 0ms backwards;
	}

	.bio {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 400;
		line-height: 1.65;
		color: var(--text-muted);
		text-wrap: pretty;
		max-width: 38rem;
		animation: heroFadeUp 0.6s var(--ease-out) 60ms backwards;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.35rem 1.75rem;
		margin-top: 0.25rem;
		animation: heroFadeUp 0.6s var(--ease-out) 120ms backwards;
	}

	@keyframes heroFadeUp {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.action-item {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.95rem;
		font-weight: 400;
		letter-spacing: -0.01em;
		color: var(--text-muted);
		text-decoration: none;
		transition: color var(--dur-fast) ease, opacity var(--dur-fast) ease;
	}

	.action-item.is-primary {
		color: var(--text-main);
		font-weight: 500;
	}

	.action-item:hover {
		color: var(--accent);
	}

	.action-arrow {
		font-size: 1.15rem;
		line-height: 1;
		transition: transform var(--dur-fast) ease;
	}

	.action-item:hover .action-arrow {
		transform: translateX(2px);
	}

	@media (max-width: 900px) {
		.hero {
			padding-top: 0.75rem;
			padding-bottom: 3.5rem;
		}

		.headline {
			font-size: 1.85rem;
		}
	}

	@media (max-width: 640px) {
		.hero {
			padding-top: 0.5rem;
			padding-bottom: 2.75rem;
		}

		.bio {
			font-size: 0.96rem;
			line-height: 1.6;
		}

		.hero-actions {
			gap: 0.9rem 1.35rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.headline,
		.bio,
		.hero-actions {
			animation: none !important;
		}
		.action-arrow,
		.action-item {
			transition: none !important;
			transform: none !important;
		}
	}
</style>
