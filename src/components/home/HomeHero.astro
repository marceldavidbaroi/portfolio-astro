---
import { site } from '../../data/site';

interface Props {
	portraitSrc: string | null;
}

const { portraitSrc } = Astro.props;
---

<section class="hero" aria-label="Introduction">
	<div class="hero-grid">
		<p class="status font-mono">Available · Remote / relocation · Dhaka · US/EU overlap</p>
		<h1 class="name font-sans">{site.name}</h1>
		<p class="role">Full-Stack &amp; Mobile Engineer — SaaS &amp; enterprise systems</p>
		<p class="bio">
			I design and ship full-stack web and cross-platform applications across Next.js, Vue / Quasar, NestJS, Flutter, and PostgreSQL — from wholesale ERP and support desks to mobile field apps.
		</p>
		<div class="hero-actions">
			<a class="btn-solid font-mono" href={`mailto:${site.email}`}>Email me</a>
			<a class="btn-ghost font-mono" href={site.resumePdf} target="_blank" rel="noopener noreferrer">Resume</a>
			<a class="text-link font-mono" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
			<a class="text-link font-mono" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
		</div>

		<figure class:list={['hero-portrait', { 'is-photo': portraitSrc }]}>
			{portraitSrc ? (
				<img
					src={portraitSrc}
					alt="Portrait of Marcel David Baroi"
					width="720"
					height="960"
				/>
			) : (
				<div class="portrait-slot" role="img" aria-label="Portrait placeholder. Add public/images/portrait.webp">
					<span class="portrait-initials font-sans">{site.nameMark}</span>
					<span class="portrait-hint font-mono">Add public/images/portrait.webp</span>
				</div>
			)}
		</figure>
	</div>
</section>

<style>
	.hero {
		padding-bottom: 4.5rem;
		border-bottom: 1px solid rgba(95, 80, 56, 0.12);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(220px, 300px);
		grid-template-areas:
			'status portrait'
			'name portrait'
			'role portrait'
			'bio portrait'
			'actions portrait';
		column-gap: 2.75rem;
		row-gap: 0.7rem;
		align-items: start;
	}

	.status { grid-area: status; }
	.name { grid-area: name; }
	.role { grid-area: role; }
	.bio { grid-area: bio; }
	.hero-actions { grid-area: actions; }
	.hero-portrait { grid-area: portrait; }

	.status {
		display: inline-flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.45rem;
		font-size: var(--type-meta);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin: 0;
		line-height: 1.45;
	}

	.name {
		margin: 0;
		font-size: clamp(1.85rem, 6vw, 3.35rem);
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1.05;
		color: var(--text-main);
		text-transform: none;
		overflow-wrap: break-word;
	}

	.role {
		margin: 0;
		font-size: 1.02rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--text-muted);
		line-height: 1.35;
		max-width: none;
	}

	.bio {
		margin: 0.15rem 0 0;
		font-size: var(--type-body);
		line-height: 1.55;
		color: var(--text-main);
		max-width: 34rem;
	}

	.hero-actions {
		margin-top: 0.35rem;
	}

	.hero-portrait {
		justify-self: end;
		width: 100%;
		max-width: 280px;
		margin: 0;
		background: transparent;
		padding: 0;
		border: 0;
		box-shadow: none;
	}

	.hero-portrait.is-photo img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 4;
		object-fit: contain;
		object-position: top center;
		background: transparent;
		border-radius: 2px;
	}

	.portrait-slot {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		object-position: center 18%;
		background: var(--card-bg);
	}

	.portrait-slot {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.7rem;
		border: 1px dashed rgba(95, 80, 56, 0.28);
		background: linear-gradient(180deg, #f4f0e7 0%, #ebe6d8 100%);
	}

	.portrait-initials {
		font-size: 2.1rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		color: var(--text-main);
	}

	.portrait-hint {
		font-size: var(--type-caption);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		text-align: center;
		max-width: 12rem;
		line-height: 1.4;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-portrait {
			animation: rise var(--dur-enter) var(--ease-out) both;
		}
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 900px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1fr) 128px;
			grid-template-areas:
				'status status'
				'name portrait'
				'role role'
				'bio bio'
				'actions actions';
			column-gap: 0.9rem;
			row-gap: 0.55rem;
		}

		.hero-portrait {
			justify-self: end;
			align-self: start;
			max-width: 128px;
		}

		.portrait-hint {
			display: none;
		}

		.portrait-initials {
			font-size: 1.25rem;
		}
	}

	@media (max-width: 640px) {
		.hero {
			padding-bottom: 2.25rem;
		}

		.status {
			font-size: var(--type-meta);
			letter-spacing: 0.04em;
			max-width: 100%;
		}

		.role,
		.bio {
			font-size: 0.95rem;
			max-width: none;
		}

		.hero-actions {
			width: 100%;
			gap: 0.55rem 0.7rem;
		}
	}

	@media (max-width: 420px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1fr) 104px;
		}

		.hero-portrait {
			max-width: 104px;
		}
	}
</style>
