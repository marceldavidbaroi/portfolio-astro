---
interface Props {
	skills: string[];
}

const { skills } = Astro.props;
---

<section class="skills" aria-label="Skills">
	<div class="skills-row">
		<p class="label font-mono">Stack</p>
		<p class="skills-line">
			{skills.map((name) => (
				<span>{name}</span>
			))}
		</p>
		<a class="section-link font-mono" href="/skills">Full matrix →</a>
	</div>
</section>

<style>
	.skills {
		padding: 1.65rem 0;
		border-bottom: 1px solid rgba(95, 80, 56, 0.12);
	}

	.skills-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem 1rem;
	}

	.skills-line {
		margin: 0;
		flex: 1 1 18rem;
		min-width: 0;
		width: 100%;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		row-gap: 0.2rem;
		font-size: 0.98rem;
		line-height: 1.55;
		letter-spacing: -0.01em;
		color: var(--text-main);
	}

	.skills-line span {
		white-space: nowrap;
	}

	.skills-line span:not(:first-child)::before {
		content: '·';
		margin-right: 0.4rem;
		color: var(--text-muted);
	}

	@media (max-width: 640px) {
		.skills {
			padding: 1.2rem 0;
		}

		.skills-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.45rem;
		}

		.skills-line {
			flex: none;
			width: 100%;
			font-size: 0.9rem;
		}
	}
</style>
