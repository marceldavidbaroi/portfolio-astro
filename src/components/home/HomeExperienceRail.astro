---
interface ExperienceItem {
	slug: string;
	order: number;
	period: string;
	role: string;
	company: string;
	badge?: string;
	summary?: string;
	highlights?: string[];
	relatedProjects?: Array<{ slug: string; label: string }>;
	cardImages?: string[];
	galleryHref?: string;
}

interface Props {
	experience: ExperienceItem[];
	heading?: 'visible' | 'none';
}

const { experience, heading = 'visible' } = Astro.props;
---

<section class="experience" aria-labelledby={heading === 'visible' ? 'exp-heading' : undefined}>
	{heading === 'visible' && (
		<div class="section-kicker">
			<p class="label font-mono">Experience</p>
		</div>
	)}
	{heading === 'visible' && <h2 id="exp-heading" class="sr-only">Work experience</h2>}
	<ol class="rail">
		{experience.map((item) => {
			const line = item.highlights?.[item.order === 1 ? 1 : 0] || item.summary;
			return (
				<li class="rail-row">
					<p class="rail-when font-mono">{item.period}</p>
					<div class="rail-body">
						<div class="rail-head">
							<h3 class="rail-role">
								<a href={`/experience/${item.slug}`} class="rail-title-link">
									{item.role}
								</a>
							</h3>
							{item.badge && <span class="rail-badge font-mono">{item.badge}</span>}
						</div>
						<p class="rail-company">{item.company}</p>
						<p class="rail-line">{line}</p>
						{item.relatedProjects && item.relatedProjects.length > 0 && (
							<p class="rail-links font-mono">
								{item.relatedProjects.slice(0, 2).map((rp) => (
									<a href={`/work/${rp.slug}`}>{rp.label}</a>
								))}
							</p>
						)}
					</div>
				</li>
			);
		})}
	</ol>
</section>

<style>
	.experience {
		padding: 3.25rem 0 2.75rem;
		border-bottom: 1px solid rgba(95, 80, 56, 0.12);
	}

	.rail {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.rail-row {
		position: relative;
		display: grid;
		grid-template-columns: 11.5rem minmax(0, 1fr);
		gap: 1.5rem;
		padding: 1.15rem 0;
		border-top: 1px solid rgba(95, 80, 56, 0.1);
		transition: background 0.18s ease;
	}

	.rail-row:last-child {
		border-bottom: 1px solid rgba(95, 80, 56, 0.1);
	}

	.rail-row:hover .rail-role a {
		color: var(--accent);
	}

	.rail-when {
		margin: 0.2rem 0 0;
		font-size: var(--type-meta);
		letter-spacing: 0.04em;
		color: var(--text-muted);
	}

	.rail-body {
		min-width: 0;
	}

	.rail-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.45rem 0.7rem;
	}

	.rail-role {
		margin: 0;
		font-size: 1.12rem;
		font-weight: 800;
		letter-spacing: -0.025em;
		color: var(--text-main);
		overflow-wrap: break-word;
	}

	.rail-title-link {
		color: inherit;
		text-decoration: none;
		transition: color var(--dur-fast) ease;
	}

	/* Stretched link overlay so clicking the career row opens the role details page */
	.rail-title-link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		cursor: pointer;
	}

	.rail-badge {
		font-size: var(--type-caption);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
		border: 1px solid rgba(132, 53, 63, 0.28);
		padding: 0.12rem 0.4rem;
		border-radius: 9999px;
	}

	.rail-company {
		margin: 0.2rem 0 0;
		font-size: 0.92rem;
		color: var(--accent);
		font-weight: 600;
	}

	.rail-line {
		margin: 0.45rem 0 0;
		font-size: var(--type-xyz);
		line-height: 1.55;
		color: var(--text-main);
		max-width: 42rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.rail-links {
		position: relative;
		z-index: 2;
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin: 0.65rem 0 0;
	}

	.rail-links a {
		font-size: var(--type-meta);
		font-weight: 700;
		letter-spacing: 0.03em;
		color: var(--text-main);
		text-decoration: none;
		border-bottom: 1px solid rgba(95, 80, 56, 0.28);
		transition: color var(--dur-fast) ease, border-color var(--dur-fast) ease;
	}

	.rail-links a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	@media (max-width: 900px) {
		.rail-row {
			grid-template-columns: 1fr;
			gap: 0.35rem;
			padding: 1rem 0;
		}
	}

	@media (max-width: 640px) {
		.experience {
			padding: 2rem 0 1.75rem;
		}

		.rail-role {
			font-size: 1rem;
		}
	}
</style>


