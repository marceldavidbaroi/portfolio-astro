---
import { site } from '../../data/site';
---

<div class="home-quick-actions font-mono" aria-label="Quick contact and profile links">
	<div class="quick-actions-wrap">
		<a class="btn-solid quick-action-btn" href={`mailto:${site.email}`}>
			<svg class="quick-action-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect width="20" height="16" x="2" y="4" rx="2"></rect>
				<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
			</svg>
			<span>Email me</span>
		</a>

		<a class="btn-ghost quick-action-btn" href={site.resumePdf} target="_blank" rel="noopener noreferrer">
			<svg class="quick-action-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
				<polyline points="14 2 14 8 20 8"></polyline>
				<line x1="16" y1="13" x2="8" y2="13"></line>
				<line x1="16" y1="17" x2="8" y2="17"></line>
				<line x1="10" y1="9" x2="8" y2="9"></line>
			</svg>
			<span>Resume</span>
		</a>

		<a class="quick-action-link" href={site.linkedin} target="_blank" rel="noopener noreferrer">
			<svg class="quick-action-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
				<rect width="4" height="12" x="2" y="9"></rect>
				<circle cx="4" cy="4" r="2"></circle>
			</svg>
			<span>LinkedIn</span>
		</a>

		<a class="quick-action-link" href={site.github} target="_blank" rel="noopener noreferrer">
			<svg class="quick-action-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
				<path d="M9 18c-4.51 2-5-2-7-2"></path>
			</svg>
			<span>GitHub</span>
		</a>
	</div>
</div>

<style>
	.home-quick-actions {
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 2.25rem 1rem 2.5rem;
		border-bottom: 1px solid var(--card-border);
		background-color: var(--bg-color);
	}

	.quick-actions-wrap {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.85rem 1.35rem;
	}

	.quick-action-btn,
	.quick-action-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		text-decoration: none;
		line-height: 1;
	}

	.quick-action-link {
		font-size: var(--type-cta);
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--text-muted);
		padding: 0.5rem 0.65rem;
		border-radius: var(--radius-sm);
		transition: color var(--dur-fast) ease, opacity var(--dur-fast) ease;
	}

	.quick-action-link:hover {
		color: var(--text-main);
	}

	.quick-action-icon {
		flex-shrink: 0;
		transition: transform var(--dur-fast) ease;
	}

	.quick-action-btn:hover .quick-action-icon,
	.quick-action-link:hover .quick-action-icon {
		transform: translateY(-1px);
	}

	@media (max-width: 540px) {
		.home-quick-actions {
			padding: 1.75rem 0.75rem 2rem;
		}

		.quick-actions-wrap {
			gap: 0.65rem 1rem;
		}
	}
</style>
