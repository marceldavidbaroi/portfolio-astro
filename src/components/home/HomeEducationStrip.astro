---
interface EducationProgram {
	logo?: string;
	degree?: string;
	shortDegree?: string;
	institution: string;
	institutionShort?: string;
	period?: string;
	badge?: string;
	cgpa?: number;
	gpa?: number;
	maxGpa: number;
	summary?: string;
}

interface Props {
	bscCseProgram: EducationProgram;
	hscScienceProgram: EducationProgram;
}

const { bscCseProgram, hscScienceProgram } = Astro.props;

const items = [
	{
		slug: 'bsc-cse',
		href: '/education/bsc-cse',
		logo: bscCseProgram.logo || '/images/education/daffodil-logo.webp',
		logoAlt: `${bscCseProgram.institutionShort || 'DIU'} logo`,
		degree: bscCseProgram.degree || 'Bachelor of Science in Computer Science & Engineering',
		institution: bscCseProgram.institution,
		period: bscCseProgram.period || '2020 — 2024',
		scoreLabel: 'CGPA',
		scoreValue: `${(bscCseProgram.cgpa ?? 0).toFixed(2)} / ${bscCseProgram.maxGpa.toFixed(2)}`,
		links: [
			{ label: 'Transcript', href: '/education/bsc-cse' },
			{ label: 'Undergrad Thesis', href: '/research/01-bangla-hwcr-ekush' },
		],
	},
	{
		slug: 'hsc-science',
		href: '/education/hsc-science',
		logo: hscScienceProgram.logo || '/images/education/ndc-logo.webp',
		logoAlt: `${hscScienceProgram.institutionShort || 'Notre Dame College'} crest`,
		degree: hscScienceProgram.degree || 'Higher Secondary Certificate (HSC) — Science',
		institution: hscScienceProgram.institution,
		period: hscScienceProgram.period || '2017 — 2019',
		scoreLabel: 'GPA',
		scoreValue: `${(hscScienceProgram.gpa ?? 0).toFixed(2)} / ${hscScienceProgram.maxGpa.toFixed(2)}`,
		links: [
			{ label: 'Credentials', href: '/education/hsc-science' },
		],
	},
];
---

<section class="education" aria-labelledby="edu-heading">
	<div class="section-kicker">
		<p class="label font-mono">Education</p>
		<a class="section-link font-mono" href="/education/bsc-cse">Academic matrix →</a>
	</div>
	<h2 id="edu-heading" class="sr-only">Education and Academic Background</h2>

	<ul class="edu-strip">
		{items.map((item) => (
			<li class="edu-row">
				<div class="edu-left">
					<a href={item.href} class="edu-logo-wrap" aria-label={item.institution}>
						<img src={item.logo} alt={item.logoAlt} class="edu-logo" loading="lazy" />
					</a>
					<div class="edu-period font-mono">{item.period}</div>
				</div>
				<div class="edu-main">
					<div class="edu-title-line">
						<h3 class="edu-degree">
							<a href={item.href} class="edu-link">{item.degree}</a>
						</h3>
						<span class="edu-score font-mono">
							{item.scoreLabel} <strong>{item.scoreValue}</strong>
						</span>
					</div>
					<div class="edu-sub-line">
						<span class="edu-institution">{item.institution}</span>
						<span class="edu-links font-mono">
							{item.links.map((lnk) => (
								<a href={lnk.href} class="edu-sublink">{lnk.label} →</a>
							))}
						</span>
					</div>
				</div>
			</li>
		))}
	</ul>
</section>

<style>
	.education {
		padding: 3rem 0 2.5rem;
		border-bottom: 1px solid var(--card-border);
	}

	.section-kicker {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1.25rem;
	}

	.section-kicker .label {
		margin: 0;
	}

	.section-kicker .section-link {
		font-size: var(--type-cta, 0.8125rem);
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--text-muted);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: color var(--dur-fast, 150ms) ease, border-color var(--dur-fast, 150ms) ease;
	}

	.section-kicker .section-link:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.edu-strip {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.edu-row {
		display: grid;
		grid-template-columns: 11.5rem minmax(0, 1fr);
		gap: 0.5rem 1.5rem;
		padding: 1.15rem 0;
		border-top: 1px solid var(--card-border);
	}

	.edu-row:last-child {
		border-bottom: 1px solid var(--card-border);
	}

	.edu-left {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.edu-logo-wrap {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.35rem;
		height: 2.35rem;
		flex-shrink: 0;
	}

	.edu-logo {
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}

	.edu-period {
		font-size: var(--type-meta, 0.8rem);
		color: var(--text-muted);
	}

	.edu-main {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.edu-title-line {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.35rem 1rem;
	}

	.edu-degree {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--text-main);
	}

	.edu-link {
		color: inherit;
		text-decoration: none;
		transition: color var(--dur-fast, 150ms) ease;
	}

	.edu-link:hover {
		color: var(--accent);
	}

	.edu-score {
		font-size: var(--type-meta, 0.82rem);
		color: var(--text-muted);
	}

	.edu-score strong {
		color: var(--text-main);
		font-weight: 700;
	}

	.edu-sub-line {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.35rem 1rem;
	}

	.edu-institution {
		font-size: 0.92rem;
		color: var(--text-muted);
	}

	.edu-links {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		font-size: var(--type-meta, 0.78rem);
	}

	.edu-sublink {
		color: var(--text-muted);
		text-decoration: none;
		transition: color var(--dur-fast, 150ms) ease;
	}

	.edu-sublink:hover {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.edu-row {
			grid-template-columns: 1fr;
			gap: 0.35rem;
		}
	}
</style>
