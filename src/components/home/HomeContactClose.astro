---
import { site } from '../../data/site';
---

<section class="close" aria-label="Contact">
	<p class="close-kicker font-mono">Available for full-time · remote or relocation</p>
	<p class="close-title">Let’s talk.</p>
	<div class="hero-actions">
		<a class="btn-solid font-mono" href={`mailto:${site.email}`}>Email me</a>
		<a class="btn-ghost font-mono" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
	</div>
</section>
