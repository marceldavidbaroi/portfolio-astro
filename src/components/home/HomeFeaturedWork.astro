---
import ShotFan from '../work/ShotFan.astro';

interface Project {
	slug: string;
	chip?: string;
	title: string;
	description?: string;
	impactMetrics?: Array<{ value: string; label: string }>;
	images?: string[];
	platformType?: string;
	stack?: string[];
}

interface Props {
	focused: Project[];
	supporting: Project[];
	workCount: number;
}

const { focused, supporting, workCount } = Astro.props;
---

<section class="featured" aria-labelledby="work-heading">
	<div class="section-kicker">
		<p class="label font-mono">Work</p>
		<a class="section-link font-mono" href="/work">All {workCount} →</a>
	</div>
	<h2 id="work-heading" class="sr-only">Featured work</h2>

	<div class="focus-list">
		{focused.map((project) => (
			<a class="feature-band" href={`/work/${project.slug}`}>
				<div class="feature-copy">
					<p class="kicker font-mono">{project.chip}</p>
					<h3 class="feature-title">{project.title}</h3>
					<p class="feature-desc">{project.description}</p>
					{(project.stack || []).length > 0 && (
						<div class="card-stack font-mono">
							{project.stack!.map((tech) => (
								<span class="stack-badge">{tech}</span>
							))}
						</div>
					)}
					<span class="inline-cta font-mono">Read case study →</span>
				</div>
				<ShotFan images={project.images} phone={project.platformType === 'mobile'} size="feature" />
			</a>
		))}
	</div>

	<div class="work-list">
		{supporting.map((project) => (
			<a class="work-item" href={`/work/${project.slug}`}>
				<div class="work-copy">
					<p class="kicker font-mono">{project.chip}</p>
					<h3 class="support-title">{project.title}</h3>
					{(project.stack || []).length > 0 && (
						<div class="support-stack font-mono">
							{project.stack!.slice(0, 3).map((tech) => (
								<span class="stack-badge">{tech}</span>
							))}
						</div>
					)}
				</div>
				<ShotFan images={project.images} phone={project.platformType === 'mobile'} />
			</a>
		))}
	</div>

	<div class="work-exit">
		<a class="work-index" href="/work">
			<span class="work-index-copy">
				<span class="work-index-title">See all work</span>
				<span class="work-index-meta font-mono">{workCount} case studies</span>
			</span>
			<span class="inline-cta font-mono">All {workCount} →</span>
		</a>
		<a class="work-archive-exit font-mono" href="/archive">View archive →</a>
	</div>
</section>

<style>
	.featured {
		padding: 3.75rem 0 3.5rem;
		border-bottom: 1px solid rgba(95, 80, 56, 0.12);
	}

	.focus-list {
		margin-bottom: 0.35rem;
	}

	.feature-band {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, 42%);
		gap: 1.5rem 2rem;
		align-items: center;
		text-decoration: none;
		color: inherit;
		padding: 1.5rem 0;
		border-bottom: 1px solid rgba(95, 80, 56, 0.1);
	}

	.focus-list .feature-band:first-child {
		padding-top: 0;
	}

	.feature-band:hover .feature-title {
		color: var(--accent);
	}

	.feature-copy {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		min-width: 0;
	}

	.card-stack,
	.support-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.45rem;
		margin-top: 0.15rem;
	}

	.stack-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.15rem 0.5rem;
		font-size: 0.72rem;
		letter-spacing: 0.02em;
		color: var(--text-muted);
		background: rgba(95, 80, 56, 0.08);
		border: 1px solid rgba(95, 80, 56, 0.12);
		border-radius: 3px;
		white-space: nowrap;
		line-height: 1.25;
	}

	.work-item .kicker {
		color: var(--text-muted);
	}

	.work-list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 2.25rem;
	}

	.work-exit {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem 1.5rem;
		margin-top: 0.35rem;
		padding-top: 1.15rem;
		border-top: 1px solid rgba(95, 80, 56, 0.1);
	}

	.work-index {
		flex: 1;
		min-width: 0;
		margin-top: 0;
		padding: 0;
		border-top: 0;
	}

	.work-archive-exit {
		flex-shrink: 0;
		font-size: var(--type-meta);
		letter-spacing: 0.04em;
		color: var(--text-muted);
		text-decoration: none;
		padding-bottom: 0.15rem;
		transition: color var(--dur-fast) ease;
	}

	.work-archive-exit:hover {
		color: var(--text-main);
		text-decoration: underline;
	}

	.work-item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 8.5rem;
		align-items: center;
		gap: 0.7rem 0.85rem;
		padding: 0.85rem 0;
		border-top: 1px solid rgba(95, 80, 56, 0.1);
		text-decoration: none;
		color: inherit;
		min-width: 0;
	}

	.work-item:hover .support-title {
		color: var(--accent);
	}

	.work-copy {
		display: flex;
		flex-direction: column;
		gap: 0.28rem;
		min-width: 0;
	}

	.work-item:hover :global(.shot-layer) {
		transform: rotate(calc(-4deg + var(--i) * 2deg)) translateY(-2px);
	}

	.support-title {
		margin: 0;
		font-size: 1.08rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.3;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color var(--dur-fast) ease;
	}

	@media (max-width: 900px) {
		.feature-band {
			grid-template-columns: 1fr;
			gap: 0.85rem;
			padding: 1.2rem 0;
		}

		.feature-band :global(.shot-still) {
			justify-self: start;
			max-width: 100%;
		}

		.work-list {
			grid-template-columns: 1fr;
		}

		.work-exit {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	@media (max-width: 640px) {
		.featured {
			padding: 2rem 0 2.15rem;
		}

		.feature-desc {
			-webkit-line-clamp: 3;
			font-size: var(--type-xyz);
		}

		.work-index {
			flex-wrap: wrap;
			gap: 0.35rem 1rem;
			min-height: 2.85rem;
		}

		.work-index-title {
			font-size: 0.98rem;
		}
	}

	@media (max-width: 420px) {
		.work-item {
			grid-template-columns: minmax(0, 1fr) 7.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.support-title {
			transition: none;
		}
	}
</style>
