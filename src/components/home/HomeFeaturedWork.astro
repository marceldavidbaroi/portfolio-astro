---
import ShotFan from '../work/ShotFan.astro';

interface Project {
	slug: string;
	chip?: string;
	title: string;
	description?: string;
	impactMetrics?: Array<{ value: string; label: string }>;
	images?: string[];
	platformType?: string;
	stack?: string[];
}

interface Props {
	focused: Project[];
	supporting?: Project[];
	workCount: number;
}

const { focused, supporting = [], workCount } = Astro.props;
---

<section class="featured" aria-labelledby="work-heading">
	<div class="section-kicker">
		<p class="label font-mono">Work</p>
		<a class="section-link font-mono" href="/work">All {workCount} →</a>
	</div>
	<h2 id="work-heading" class="sr-only">Featured work</h2>

	<div class="focus-list">
		{focused.map((project) => (
			<a class="feature-band" href={`/work/${project.slug}`}>
				<div class="feature-copy">
					<h3 class="feature-title">{project.title}</h3>
					<p class="feature-desc">{project.description}</p>
					{(project.stack || []).length > 0 && (
						<div class="card-stack font-mono">
							{project.stack!.map((tech) => (
								<span class="stack-badge">{tech}</span>
							))}
						</div>
					)}
					<span class="inline-cta font-mono">Read case study →</span>
				</div>
				<ShotFan images={project.images} phone={project.platformType === 'mobile'} size="feature" />
			</a>
		))}
	</div>

	{supporting.length > 0 && (
		<div class="work-list">
			{supporting.map((project) => (
				<a class="work-item" href={`/work/${project.slug}`}>
					<div class="work-copy">
						<h3 class="support-title">{project.title}</h3>
						{(project.stack || []).length > 0 && (
							<div class="support-stack font-mono">
								{project.stack!.slice(0, 3).map((tech) => (
									<span class="stack-badge">{tech}</span>
								))}
							</div>
						)}
					</div>
					<ShotFan images={project.images} phone={project.platformType === 'mobile'} />
				</a>
			))}
		</div>
	)}

	<div class="work-exit">
		<a class="work-index" href="/work">
			<span class="work-index-copy">
				<span class="work-index-title">See all work</span>
				<span class="work-index-meta font-mono">{workCount} case studies</span>
			</span>
			<span class="inline-cta font-mono">All {workCount} →</span>
		</a>
		<a class="work-archive-exit font-mono" href="/archive">View archive →</a>
	</div>
</section>

<style>
	.featured {
		padding: 3.5rem 0 3rem;
		border-bottom: 1px solid var(--card-border);
	}

	.focus-list {
		display: flex;
		flex-direction: column;
	}

	.feature-band {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(320px, 1fr);
		gap: 2.5rem 3.5rem;
		align-items: center;
		text-decoration: none;
		color: inherit;
		padding: 2.75rem 0;
		border-top: 1px solid var(--card-border);
		will-change: transform;
		transition: transform var(--dur-fast) var(--ease-out);
	}

	.feature-band::after {
		content: '';
		position: absolute;
		inset: -0.5rem -1rem;
		border-radius: var(--radius-lg);
		background: var(--card-bg-elevated);
		box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.16), 0 0 20px var(--accent-subtle);
		opacity: 0;
		pointer-events: none;
		z-index: -1;
		transition: opacity var(--dur-fast) ease;
	}

	.focus-list .feature-band:first-child {
		border-top: 0;
		padding-top: 0.5rem;
	}

	.feature-band:hover {
		transform: translateY(-4px);
	}

	.feature-band:hover::after {
		opacity: 1;
	}

	.feature-band:hover .feature-title {
		color: var(--accent);
	}

	.feature-band:hover .inline-cta {
		color: var(--accent);
		transform: translateX(4px);
	}

	.feature-band:hover :global(.shot-still-frame) {
		border-color: var(--card-border-hover);
		transform: scale(1.015);
		box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.25);
	}

	.feature-copy {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		min-width: 0;
	}

	.feature-title {
		margin: 0;
		font-size: clamp(1.35rem, 2.3vw, 1.75rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.22;
		color: var(--text-main);
		transition: color var(--dur-fast) ease;
	}

	.feature-desc {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.6;
		color: var(--text-muted);
		max-width: 44rem;
		text-wrap: pretty;
	}

	.card-stack,
	.support-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.5rem;
		margin-top: 0.25rem;
	}

	.stack-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.22rem 0.65rem;
		font-size: 0.72rem;
		letter-spacing: 0.02em;
		color: var(--text-muted);
		background: var(--accent-subtle);
		border: 1px solid var(--card-border);
		border-radius: var(--radius-full);
		white-space: nowrap;
		line-height: 1.25;
		transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, color var(--dur-fast) ease;
	}

	.feature-band:hover .stack-badge {
		color: var(--text-main);
		border-color: var(--card-border-hover);
	}

	.inline-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: var(--type-cta);
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--accent);
		margin-top: 0.5rem;
		transition: color var(--dur-fast) ease, transform var(--dur-fast) ease;
	}

	.work-list {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		column-gap: 3rem;
		margin-top: 0.5rem;
	}

	.work-item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 1.25rem;
		padding: 1.25rem 0;
		border-top: 1px solid var(--card-border);
		text-decoration: none;
		color: inherit;
		min-width: 0;
	}

	.work-item:hover .support-title {
		color: var(--accent);
	}

	.work-copy {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
	}

	.work-item:hover :global(.shot-layer) {
		transform: rotate(calc(-4deg + var(--i) * 2deg)) translateY(-3px);
	}

	.support-title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.3;
		color: var(--text-main);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color var(--dur-fast) ease;
	}

	.work-exit {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 1.5rem;
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--card-border);
	}

	.work-index {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		text-decoration: none;
		color: inherit;
	}

	.work-index-copy {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.work-index-title {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--text-main);
		letter-spacing: -0.02em;
	}

	.work-index-meta {
		font-size: var(--type-meta);
		letter-spacing: 0.04em;
		color: var(--text-muted);
	}

	.work-archive-exit {
		font-size: var(--type-meta);
		letter-spacing: 0.04em;
		color: var(--text-muted);
		text-decoration: none;
		transition: color var(--dur-fast) ease;
	}

	.work-archive-exit:hover {
		color: var(--accent);
	}

	@media (max-width: 860px) {
		.feature-band {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding: 2rem 0;
		}

		.work-list {
			grid-template-columns: 1fr;
			column-gap: 0;
		}
	}

	@media (max-width: 640px) {
		.featured {
			padding: 2.25rem 0 2rem;
		}

		.feature-band {
			padding: 1.5rem 0;
			gap: 1.25rem;
		}

		.feature-title {
			font-size: 1.2rem;
		}

		.feature-desc {
			font-size: 0.9rem;
			line-height: 1.55;
		}

		.stack-badge {
			font-size: 0.68rem;
			padding: 0.18rem 0.55rem;
		}

		.work-exit {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.feature-band,
		.feature-band::after,
		.feature-title,
		.inline-cta,
		.support-title,
		.work-item {
			transition: none !important;
			transform: none !important;
		}
	}
</style>
