---
import ShotFan from '../work/ShotFan.astro';

interface Project {
	slug: string;
	chip?: string;
	title: string;
	description?: string;
	impactMetrics?: Array<{ value: string; label: string }>;
	images?: string[];
	platformType?: string;
}

interface Props {
	focused: Project[];
	supporting: Project[];
	workCount: number;
}

const { focused, supporting, workCount } = Astro.props;
---

<section class="featured" aria-labelledby="work-heading">
	<div class="section-kicker">
		<p class="label font-mono">Work</p>
		<a class="section-link font-mono" href="/work">All {workCount} →</a>
	</div>
	<h2 id="work-heading" class="sr-only">Featured work</h2>

	<div class="focus-list">
		{focused.map((project) => (
			<a class="feature-band" href={`/work/${project.slug}`}>
				<div class="feature-meta">
					<p class="kicker font-mono">{project.chip}</p>
					<h3 class="feature-title">{project.title}</h3>
					<p class="feature-desc">{project.description}</p>
				</div>
				<ul class="metric-row font-mono">
					{(project.impactMetrics || []).slice(0, 3).map((m) => (
						<li>
							<b>{m.value}</b>
							<span>{m.label}</span>
						</li>
					))}
				</ul>
				<span class="inline-cta font-mono">Read case study →</span>
			</a>
		))}
	</div>

	<div class="work-list">
		{supporting.map((project) => (
			<a class="work-item" href={`/work/${project.slug}`}>
				<div class="work-copy">
					<p class="kicker font-mono">{project.chip}</p>
					<h3 class="support-title">{project.title}</h3>
				</div>
				<ShotFan images={project.images} phone={project.platformType === 'mobile'} />
			</a>
		))}
	</div>

	<a class="work-index" href="/work">
		<span class="work-index-copy">
			<span class="work-index-title">See all work</span>
			<span class="work-index-meta font-mono">{workCount} case studies</span>
		</span>
		<span class="section-link font-mono">View archive →</span>
	</a>
</section>

<style>
	.featured {
		padding: 3.75rem 0 3.5rem;
		border-bottom: 1px solid rgba(95, 80, 56, 0.12);
	}

	.focus-list {
		margin-bottom: 0.35rem;
	}

	.feature-band {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) auto auto;
		gap: 1.5rem 2rem;
		align-items: end;
		text-decoration: none;
		color: inherit;
		padding: 1.5rem 0;
		border-bottom: 1px solid rgba(95, 80, 56, 0.1);
	}

	.focus-list .feature-band:first-child {
		padding-top: 0;
	}

	.feature-band:hover .feature-title {
		color: var(--accent);
	}

	.feature-meta {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		min-width: 0;
	}

	.work-list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 2.25rem;
	}

	.work-item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 7.4rem;
		align-items: center;
		gap: 0.7rem 0.85rem;
		padding: 0.85rem 0;
		border-top: 1px solid rgba(95, 80, 56, 0.1);
		text-decoration: none;
		color: inherit;
		min-width: 0;
	}

	.work-item:hover .support-title {
		color: var(--accent);
	}

	.work-copy {
		display: flex;
		flex-direction: column;
		gap: 0.28rem;
		min-width: 0;
	}

	.work-item:hover :global(.shot-layer) {
		transform: rotate(calc(-7deg + var(--i) * 4deg)) translateY(-3px);
	}

	.support-title {
		margin: 0;
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.3;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color var(--dur-fast) ease;
	}

	@media (max-width: 900px) {
		.feature-band {
			grid-template-columns: 1fr;
			gap: 0.85rem;
			padding: 1.2rem 0;
		}

		.metric-row {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.65rem;
			width: 100%;
		}

		.metric-row li {
			min-width: 0;
		}

		.metric-row b,
		.metric-row span {
			overflow-wrap: break-word;
		}

		.metric-row span {
			letter-spacing: 0.03em;
			line-height: 1.3;
		}

		.inline-cta {
			justify-self: start;
		}

		.work-list {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.featured {
			padding: 2rem 0 2.15rem;
		}

		.feature-desc {
			-webkit-line-clamp: 3;
			font-size: var(--type-xyz);
		}

		.work-index {
			flex-wrap: wrap;
			gap: 0.35rem 1rem;
			padding-top: 1rem;
			min-height: 2.85rem;
		}

		.work-index-title {
			font-size: 0.98rem;
		}
	}

	@media (max-width: 420px) {
		.metric-row {
			gap: 0.4rem;
		}

		.metric-row b {
			font-size: 0.82rem;
		}

		.work-item {
			grid-template-columns: minmax(0, 1fr) 6.2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.support-title {
			transition: none;
		}
	}
</style>
