---
import type { SkillCategoryGroup, SkillItem } from '../../data/aboutData';

interface Props {
	skillCategories: SkillCategoryGroup[];
}

const { skillCategories } = Astro.props;

// Flatten skills across all categories and deduplicate by name
const seen = new Set<string>();
const allSkills: SkillItem[] = [];

for (const group of skillCategories) {
	for (const item of group.items) {
		if (!seen.has(item.name)) {
			seen.add(item.name);
			allSkills.push(item);
		}
	}
}
---

<section class="about-section" id="stack" aria-labelledby="stack-heading">
	<div class="section-kicker">
		<h2 id="stack-heading" class="label font-mono">Stack</h2>
		<a href="/skills" class="section-link font-mono">Full matrix →</a>
	</div>

	<div class="about-stack-marquee-wrapper" tabindex="0" aria-label="Technical skills marquee">
		<div class="about-stack-marquee-track">
			<div class="about-stack-marquee-group">
				{allSkills.map((skill) => (
					<div class:list={['skill-pill', 'skill-pill-mono', { 'is-prior': skill.tier === 'secondary' }]}>
						<div class="skill-pill-media">
							{skill.logo ? (
								<img src={skill.logo} alt="" class="skill-pill-logo" loading="lazy" aria-hidden="true" />
							) : (
								<span class="skill-pill-icon" aria-hidden="true">{skill.icon || '•'}</span>
							)}
						</div>
						<span class="skill-pill-name">{skill.name}</span>
					</div>
				))}
			</div>
			{/* Duplicated group for seamless endless auto-scroll loop */}
			<div class="about-stack-marquee-group" aria-hidden="true">
				{allSkills.map((skill) => (
					<div class:list={['skill-pill', 'skill-pill-mono', { 'is-prior': skill.tier === 'secondary' }]}>
						<div class="skill-pill-media">
							{skill.logo ? (
								<img src={skill.logo} alt="" class="skill-pill-logo" loading="lazy" aria-hidden="true" />
							) : (
								<span class="skill-pill-icon" aria-hidden="true">{skill.icon || '•'}</span>
							)}
						</div>
						<span class="skill-pill-name">{skill.name}</span>
					</div>
				))}
			</div>
		</div>
	</div>
</section>



