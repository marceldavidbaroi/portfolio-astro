---
import type { SkillCategoryGroup } from '../../data/aboutData';
import { stackLegend } from '../../data/aboutLayoutDummy';

interface Props {
	skillCategories: SkillCategoryGroup[];
}

const { skillCategories } = Astro.props;

const legend = stackLegend;
---

<section class="about-section" id="stack" aria-labelledby="stack-heading">
	<div class="section-kicker">
		<h2 id="stack-heading" class="label font-mono">Stack</h2>
		<a href="/skills" class="section-link font-mono">Full matrix →</a>
	</div>

	<p class="about-stack-legend font-mono">{legend}</p>

	{skillCategories.map((group) => (
		<div class="about-stack-block">
			<h3 class="about-stack-category font-mono">{group.category}</h3>
			<ul class="about-stack-names">
				{group.items.map((skill) => (
					<li class:list={[{ 'is-prior': skill.tier === 'secondary' }]}>{skill.name}</li>
				))}
			</ul>
		</div>
	))}
</section>
