---
import type { PrincipleItem } from '../../data/aboutData';
import { principleProofLinks } from '../../data/aboutLayoutDummy';

interface Props {
	principles: PrincipleItem[];
}

type PrincipleWithProof = PrincipleItem & {
	proofHref?: string;
	proofLabel?: string;
};

const { principles } = Astro.props;

function proofFor(principle: PrincipleItem) {
	const withProof = principle as PrincipleWithProof;
	const dummy = principleProofLinks.find((link) => link.principleNum === principle.num);
	return {
		href: withProof.proofHref ?? dummy?.href,
		label: withProof.proofLabel ?? dummy?.label,
	};
}
---

<section class="about-section" id="how-i-work" aria-labelledby="how-i-work-heading">
	<div class="section-kicker">
		<h2 id="how-i-work-heading" class="label font-mono">How I work</h2>
		<a href="/philosophy" class="section-link font-mono">Full philosophy →</a>
	</div>

	{principles.map((p) => {
		const proof = proofFor(p);
		return (
			<article class="about-principle-row">
				<p class="about-principle-num font-mono">{p.num}</p>
				<div>
					<h3 class="about-principle-title">{p.title}</h3>
					<p class="about-principle-body">{p.desc}</p>
					{proof.href && proof.label && (
						<a href={proof.href} class="about-principle-proof font-mono">{proof.label}</a>
					)}
				</div>
			</article>
		);
	})}
</section>
