---
import type { CompactPursuitItem } from '../../data/aboutData';
import { beyondExtras } from '../../data/aboutLayoutDummy';

interface Props {
	compactPursuits: CompactPursuitItem[];
}

const { compactPursuits } = Astro.props;

const pursuits = compactPursuits.length > 0 ? compactPursuits : beyondExtras;
---

<section class="about-section" id="beyond" aria-labelledby="beyond-heading">
	<div class="section-kicker">
		<h2 id="beyond-heading" class="label font-mono">Beyond</h2>
	</div>

	{pursuits.map((p) => (
		<div class="about-beyond-row">
			<p class="about-beyond-term">{p.title}</p>
			<p class="about-beyond-meta font-mono">{p.tag}</p>
			<p class="about-beyond-desc">
				{p.desc}
				{p.url && (
					<>
						{' '}
						<a href={p.url} target="_blank" rel="noopener noreferrer" class="text-link font-mono">IMDb</a>
					</>
				)}
			</p>
		</div>
	))}
</section>
