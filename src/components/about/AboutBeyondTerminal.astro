---
import type { CompactPursuitItem } from '../../data/aboutData';
import { beyondExtras } from '../../data/aboutLayoutDummy';

interface Props {
	compactPursuits: CompactPursuitItem[];
}

const { compactPursuits } = Astro.props;

const pursuits = compactPursuits.length > 0 ? compactPursuits : beyondExtras;
---

<section class="about-section" id="beyond" aria-labelledby="beyond-heading">
	<div class="section-kicker">
		<h2 id="beyond-heading" class="label font-mono">Beyond</h2>
	</div>

	<div class="about-beyond-list">
		{pursuits.map((p) => (
			<div class="about-beyond-row">
				<div class="beyond-icon-wrap" aria-hidden="true">
					{p.iconType === 'music' && (
						/* Classical Tabla / Percussion rhythm drum icon */
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
							<ellipse cx="8.5" cy="8" rx="4.5" ry="3" />
							<path d="M4 8v6c0 1.66 2.01 3 4.5 3s4.5-1.34 4.5-3V8" />
							<ellipse cx="17" cy="11" rx="3.5" ry="2.2" />
							<path d="M13.5 11v4.5c0 1.2 1.57 2.2 3.5 2.2s3.5-1 3.5-2.2V11" />
							<path d="M8.5 7v2" />
							<path d="M17 10v2" />
						</svg>
					)}
					{p.iconType === 'pen' && p.title.toLowerCase().includes('mentor') && (
						/* Academic Mentorship / Compass & Ruler / Graduation */
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
							<path d="M22 10v6M2 10l10-5 10 5-10 5z" />
							<path d="M6 12v5c3 3 9 3 12 0v-5" />
						</svg>
					)}
					{p.iconType === 'pen' && !p.title.toLowerCase().includes('mentor') && (
						/* Drawing & Fine Arts / Palette / Brush */
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="13.5" cy="6.5" r=".5" fill="currentColor" />
							<circle cx="17.5" cy="10.5" r=".5" fill="currentColor" />
							<circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />
							<circle cx="6.5" cy="12.5" r=".5" fill="currentColor" />
							<path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.93 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.24-.26-.38-.61-.38-1 0-.83.67-1.5 1.5-1.5H16c3.31 0 6-2.69 6-6 0-5.5-4.5-9.99-10-9.99z" />
						</svg>
					)}
					{p.iconType === 'theater' && (
						/* Drama & Acting / Masks */
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
							<path d="M2 10s2-6 10-6 10 6 10 6-2 9-10 9-10-9-10-9z" />
							<circle cx="8" cy="10" r="1.5" />
							<circle cx="16" cy="10" r="1.5" />
							<path d="M9 14.5c1.2 1 2.8 1 4 0" />
						</svg>
					)}
					{p.iconType === 'film' && (
						/* Cinema & Screenplay / Clapperboard */
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
							<rect x="2" y="4" width="20" height="16" rx="2" />
							<path d="M2 9.5h20" />
							<path d="M6 4l3 5.5" />
							<path d="M12 4l3 5.5" />
							<path d="M18 4l3 5.5" />
						</svg>
					)}
				</div>

				<div class="beyond-body">
					<div class="beyond-header">
						<p class="about-beyond-term">{p.title}</p>
						<p class="about-beyond-meta font-mono">{p.tag}</p>
					</div>
					<p class="about-beyond-desc">
						{p.desc}
						{p.url && (
							<>
								{' '}
								<a href={p.url} target="_blank" rel="noopener noreferrer" class="text-link font-mono">IMDb ↗</a>
							</>
						)}
					</p>
				</div>
			</div>
		))}
	</div>
</section>

<style>
	.about-beyond-list {
		display: flex;
		flex-direction: column;
	}

	.about-beyond-row {
		display: grid;
		grid-template-columns: 2.75rem minmax(0, 1fr);
		gap: 1.15rem;
		align-items: start;
		padding: 1.25rem 0;
		border-top: 1px solid var(--card-border, rgba(95, 80, 56, 0.1));
		transition: background-color var(--dur-fast, 150ms) ease;
	}

	.about-beyond-row:first-child {
		border-top: 0;
		padding-top: 0.5rem;
	}

	.beyond-icon-wrap {
		width: 2.5rem;
		height: 2.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-md, 10px);
		background: var(--card-bg, #f2ede4);
		border: 1px solid var(--card-border, rgba(33, 31, 29, 0.08));
		color: var(--accent, #b86e1e);
		flex-shrink: 0;
		margin-top: 0.1rem;
		transition: transform var(--dur-fast, 150ms) ease, background-color var(--dur-fast, 150ms) ease, border-color var(--dur-fast, 150ms) ease;
	}

	.about-beyond-row:hover .beyond-icon-wrap {
		transform: scale(1.06);
		background: var(--accent-subtle, #f8ede0);
		border-color: var(--card-border-hover, rgba(184, 110, 30, 0.25));
	}

	.beyond-body {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}

	.beyond-header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.35rem 1rem;
	}

	.about-beyond-term {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--text-main);
		transition: color var(--dur-fast, 150ms) ease;
	}

	.about-beyond-row:hover .about-beyond-term {
		color: var(--accent, #b86e1e);
	}

	.about-beyond-meta {
		margin: 0;
		font-size: var(--type-meta, 0.75rem);
		color: var(--text-muted);
		letter-spacing: 0.02em;
	}

	.about-beyond-desc {
		margin: 0.35rem 0 0;
		font-size: var(--type-xyz, 1rem);
		line-height: 1.55;
		color: var(--text-main);
		max-width: 44rem;
	}

	@media (max-width: 600px) {
		.about-beyond-row {
			grid-template-columns: 2.25rem minmax(0, 1fr);
			gap: 0.85rem;
		}

		.beyond-icon-wrap {
			width: 2.25rem;
			height: 2.25rem;
		}

		.beyond-header {
			flex-direction: column;
			gap: 0.15rem;
		}
	}
</style>
