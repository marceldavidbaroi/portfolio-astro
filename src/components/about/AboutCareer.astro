---
import HomeExperienceRail from '../home/HomeExperienceRail.astro';

interface ExperienceItem {
	slug: string;
	order: number;
	period: string;
	role: string;
	company: string;
	badge?: string;
	summary?: string;
	highlights?: string[];
	relatedProjects?: Array<{ slug: string; label: string }>;
}

interface Props {
	experience: ExperienceItem[];
}

const { experience } = Astro.props;

const experienceWithLines = experience.map((item) => {
	const line = item.highlights?.[item.order === 1 ? 1 : 0] || item.summary;
	return {
		...item,
		summary: line ?? '',
		highlights: item.highlights?.length ? item.highlights : line ? [line] : [],
	};
});
---

<section class="about-section about-career" id="career" aria-labelledby="career-heading">
	<div class="section-kicker">
		<h2 id="career-heading" class="label font-mono">Career</h2>
		<a href="/work" class="section-link font-mono">All work →</a>
	</div>
	<HomeExperienceRail experience={experienceWithLines} heading="none" />
</section>

<style>
	.about-career :global(.experience) {
		padding: 0;
		border-bottom: 0;
	}

	.about-career :global(.experience .section-kicker) {
		display: none;
	}
</style>
