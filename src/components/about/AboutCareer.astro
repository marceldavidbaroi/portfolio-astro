---
import type { CareerHighlightItem } from '../../data/aboutData';

interface Props {
	careerHighlights: CareerHighlightItem[];
}

const { careerHighlights } = Astro.props;
---

<section class="about-section" id="career-highlights">
	<div class="section-header">
		<span class="section-tag font-dot">03 // CAREER TRAJECTORY</span>
		<h2 class="section-title font-dot">Executive Career Highlights</h2>
		<p class="section-desc">
			Landmark production accomplishments framed with Google's XYZ formula — system capability, measurable outcome, and engineering method.
		</p>
	</div>

	<div class="career-grid">
		{careerHighlights.map((item) => (
			<article class="career-card card">
				<span class="career-tag font-mono">{item.tag}</span>
				<h3 class="career-title">{item.title}</h3>
				<p class="career-desc">{item.description}</p>
				<div class="career-metrics font-mono">
					{item.metrics.map((m) => (
						<span class="career-metric-pill">{m}</span>
					))}
				</div>
				{item.caseStudyHref && (
					<a href={item.caseStudyHref} class="career-case-link">
						{item.caseStudyLabel || 'View Case Study →'}
					</a>
				)}
			</article>
		))}
	</div>

	<div class="section-footer-link">
		<a href="/work" class="full-dir-btn">
			<span>View All 12+ Production Case Studies →</span>
		</a>
	</div>
</section>

<style>
	.about-section {
		width: 100%;
		margin-top: 4.5rem;
		text-align: left;
		scroll-margin-top: 5rem;
	}

	.section-header {
		margin-bottom: 2rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.section-tag {
		font-size: 0.9375rem;
		letter-spacing: 0.12em;
		color: var(--accent);
		text-transform: uppercase;
		font-weight: 700;
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--text-main);
	}

	.section-desc {
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--text-muted);
		max-width: 700px;
	}

	.career-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 768px) {
		.career-grid {
			grid-template-columns: 1fr;
		}
	}

	.career-card {
		padding: 1.6rem;
		border-radius: 14px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		text-align: left;
		transition: all 0.2s ease;
	}

	.career-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(180, 33, 53, 0.08);
	}

	.career-tag {
		font-size: 0.68rem;
		color: var(--accent);
		font-weight: 700;
		letter-spacing: 0.06em;
	}

	.career-title {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.3;
	}

	.career-desc {
		font-size: 0.88rem;
		line-height: 1.55;
		color: var(--text-muted);
		flex: 1;
	}

	.career-metrics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.career-metric-pill {
		font-size: 0.7rem;
		background: rgba(180, 33, 53, 0.08);
		color: var(--accent);
		padding: 0.2rem 0.55rem;
		border-radius: 4px;
		font-weight: 700;
	}

	.career-case-link {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		padding-top: 0.5rem;
		border-top: 1px dashed rgba(95, 80, 56, 0.12);
		transition: all 0.15s ease;
	}

	.career-case-link:hover {
		color: var(--accent-hover);
		transform: translateX(3px);
	}

	.section-footer-link {
		margin-top: 1.5rem;
		display: flex;
		justify-content: flex-start;
	}

	.full-dir-btn {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		padding: 0.65rem 1.1rem;
		border-radius: 8px;
		border: 1px solid rgba(180, 33, 53, 0.25);
		background: rgba(180, 33, 53, 0.04);
		transition: all 0.15s ease;
	}

	.full-dir-btn:hover {
		background: var(--accent);
		color: #fffdfa;
		border-color: var(--accent);
	}
</style>
