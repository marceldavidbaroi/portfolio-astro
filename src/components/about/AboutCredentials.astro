---
import type { CompactCertItem } from '../../data/aboutData';

interface Props {
	compactCerts: CompactCertItem[];
}

const { compactCerts } = Astro.props;
---

<section class="about-section" id="credentials-section">
	<div class="section-header">
		<span class="section-tag font-dot">06 // VERIFIED CREDENTIALS</span>
		<h2 class="section-title font-dot">Professional Certifications</h2>
		<p class="section-desc">
			Verified certifications across Google Cloud AI, Generative AI, Cisco Networking, and Frontend Engineering.
		</p>
	</div>

	<div class="compact-certs-grid">
		{compactCerts.map((cert) => (
			<a href={cert.url} target="_blank" rel="noopener noreferrer" class="compact-cert-pill card" title={`Verify ${cert.title} on ${cert.issuer}`}>
				<div class="cert-svg-box">
					{cert.iconType === 'bot' && (
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="3" y="11" width="18" height="10" rx="2"></rect>
							<circle cx="12" cy="5" r="2"></circle>
							<path d="M12 7v4"></path>
							<line x1="8" y1="16" x2="8" y2="16"></line>
							<line x1="16" y1="16" x2="16" y2="16"></line>
						</svg>
					)}
					{cert.iconType === 'sparkles' && (
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
						</svg>
					)}
					{cert.iconType === 'terminal' && (
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="4 17 10 11 4 5"></polyline>
							<line x1="12" y1="19" x2="20" y2="19"></line>
						</svg>
					)}
					{cert.iconType === 'code' && (
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="16 18 22 12 16 6"></polyline>
							<polyline points="8 6 2 12 8 18"></polyline>
						</svg>
					)}
					{cert.iconType === 'globe' && (
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<line x1="2" y1="12" x2="22" y2="12"></line>
							<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1 4-10z"></path>
						</svg>
					)}
					{cert.iconType === 'award' && (
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="8" r="7"></circle>
							<polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
						</svg>
					)}
				</div>
				<div class="cert-meta">
					<div class="cert-top-row">
						<span class="cert-issuer font-mono">{cert.issuer}</span>
						<span class="cert-date font-mono">{cert.date}</span>
					</div>
					<h3 class="cert-title">{cert.title}</h3>
					{cert.id && <span class="cert-id font-mono">ID: {cert.id}</span>}
				</div>
			</a>
		))}
	</div>

	<div class="section-footer-link">
		<a href="/credentials" class="full-dir-btn">
			<span>View All 33 Verified Credentials & Verification Details →</span>
		</a>
	</div>
</section>

<style>
	.about-section {
		width: 100%;
		margin-top: 4.5rem;
		text-align: left;
		scroll-margin-top: 5rem;
	}

	.section-header {
		margin-bottom: 2rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.section-tag {
		font-size: 0.9375rem;
		letter-spacing: 0.12em;
		color: var(--accent);
		text-transform: uppercase;
		font-weight: 700;
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--text-main);
	}

	.section-desc {
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--text-muted);
		max-width: 700px;
	}

	.compact-certs-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	@media (max-width: 900px) {
		.compact-certs-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.compact-certs-grid {
			grid-template-columns: 1fr;
		}
	}

	.compact-cert-pill {
		padding: 1.15rem;
		border-radius: 12px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		transition: all 0.15s ease;
		text-decoration: none;
		height: 100%;
	}

	.compact-cert-pill:hover {
		border-color: rgba(180, 33, 53, 0.35);
		transform: translateY(-2px);
	}

	.cert-svg-box {
		width: 36px;
		height: 36px;
		border-radius: 8px;
		background: rgba(180, 33, 53, 0.08);
		color: var(--accent);
		border: 1px solid rgba(180, 33, 53, 0.18);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.cert-meta {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}

	.cert-top-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.cert-issuer {
		font-size: 0.68rem;
		color: var(--accent);
		font-weight: 700;
	}

	.cert-date {
		font-size: 0.68rem;
		color: var(--text-muted);
	}

	.cert-title {
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.3;
	}

	.cert-id {
		font-size: 0.68rem;
		color: var(--text-muted);
		opacity: 0.85;
	}

	.section-footer-link {
		margin-top: 1.5rem;
		text-align: left;
	}

	.full-dir-btn {
		font-size: 0.86rem;
		color: var(--accent);
		font-weight: 700;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		transition: all 0.15s ease;
	}

	.full-dir-btn:hover {
		color: var(--accent-hover);
		transform: translateX(3px);
	}
</style>
