---
import type { CompactCertItem } from '../../data/aboutData';
import { certRowPadding } from '../../data/aboutLayoutDummy';
import { certifications } from '../../data/certifications';

interface Props {
	compactCerts: CompactCertItem[];
}

const { compactCerts } = Astro.props;

const targetCount = 6;
const paddedCerts = [...compactCerts];
while (paddedCerts.length < targetCount) {
	const pad = certRowPadding[paddedCerts.length - compactCerts.length];
	if (pad) paddedCerts.push(pad);
	else break;
}

const totalCount = certifications.length;
const exitLabel = `All ${totalCount} →`;
---

<section class="about-section" id="certs" aria-labelledby="certs-heading">
	<div class="section-kicker">
		<h2 id="certs-heading" class="label font-mono">Certs</h2>
		<a href="/credentials" class="section-link font-mono">{exitLabel}</a>
	</div>

	{paddedCerts.map((cert) => (
		<a
			href={cert.url}
			target="_blank"
			rel="noopener noreferrer"
			class="about-list-row"
			title={`Verify ${cert.title} on ${cert.issuer}`}
		>
			<p class="about-list-issuer font-mono">{cert.issuer}</p>
			<p class="about-list-title">{cert.title}</p>
			<p class="about-list-meta font-mono">{cert.date} ↗</p>
		</a>
	))}
</section>
