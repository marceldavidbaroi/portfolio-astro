---
import { getAllAlbums, type Album } from '../../lib/gallery';
import AlbumStampCard from '../gallery/AlbumStampCard.astro';

const allAlbums = await getAllAlbums();

// Featured curated albums
const FEATURED_ALBUM_IDS = [
	'proficient-engineering-team',
	'diu-undergraduate-years',
	'civic-movement-2018',
	'group-13-brotherhood'
];

const featuredAlbums: Album[] = FEATURED_ALBUM_IDS
	.map((id) => allAlbums.find((a) => a.id === id))
	.filter(Boolean) as Album[];
---

<section class="about-section about-gallery-section" id="gallery" aria-labelledby="gallery-heading">
	<div class="section-kicker">
		<h2 id="gallery-heading" class="label font-sans">Albums &amp; Stories</h2>
		<a class="section-link font-sans" href="/gallery">All {allAlbums.length} albums →</a>
	</div>

	<div class="about-gallery-grid">
		{allAlbums.map((album) => (
			<AlbumStampCard album={album} />
		))}
	</div>
</section>

<style>
	.about-gallery-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.5rem 1.15rem;
		margin-top: 1.25rem;
	}

	@media (max-width: 900px) {
		.about-gallery-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.25rem 1rem;
		}
	}

	@media (max-width: 600px) {
		.about-gallery-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.15rem 0.85rem;
		}
	}

	@media (max-width: 360px) {
		.about-gallery-grid {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}
</style>

