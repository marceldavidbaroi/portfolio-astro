---
import { getAllAlbums, type Album } from '../../lib/gallery';

const allAlbums = await getAllAlbums();

// Featured curated albums
const FEATURED_ALBUM_IDS = [
	'proficient-engineering-team',
	'diu-undergraduate-years',
	'civic-movement-2018',
	'group-13-brotherhood'
];

const featuredAlbums: Album[] = FEATURED_ALBUM_IDS
	.map((id) => allAlbums.find((a) => a.id === id))
	.filter(Boolean) as Album[];
---

<section class="about-section about-gallery-section" id="gallery" aria-labelledby="gallery-heading">
	<div class="section-kicker">
		<h2 id="gallery-heading" class="label font-sans">Albums &amp; Stories</h2>
		<a class="section-link font-sans" href="/gallery">All {allAlbums.length} albums →</a>
	</div>

	<div class="about-gallery-grid">
		{featuredAlbums.map((album) => {
			const thumbs = album.photos.slice(0, 3).map((p) => p.src);
			const count = album.photos.length;

			return (
				<a class="album-grid-card" href={`/gallery/${album.id}`}>
					{/* Image Collage Viewport */}
					<div class="album-collage" aria-hidden="true">
						{thumbs.length === 1 && (
							<div class="collage-single">
								<img src={thumbs[0]} alt="" loading="lazy" />
							</div>
						)}
						{thumbs.length === 2 && (
							<div class="collage-two">
								<div class="collage-cell main">
									<img src={thumbs[0]} alt="" loading="lazy" />
								</div>
								<div class="collage-cell sub">
									<img src={thumbs[1]} alt="" loading="lazy" />
								</div>
							</div>
						)}
						{thumbs.length >= 3 && (
							<div class="collage-three">
								<div class="collage-cell main">
									<img src={thumbs[0]} alt="" loading="lazy" />
								</div>
								<div class="collage-column">
									<div class="collage-cell sub">
										<img src={thumbs[1]} alt="" loading="lazy" />
									</div>
									<div class="collage-cell sub">
										<img src={thumbs[2]} alt="" loading="lazy" />
									</div>
								</div>
							</div>
						)}
						<span class="collage-count-badge">
							{count} photos
						</span>
					</div>

					{/* Title & Metadata */}
					<div class="album-grid-info">
						<div class="album-grid-meta">
							<span class="album-grid-tag">{album.tag}</span>
							<span class="meta-sep">·</span>
							<span class="album-grid-period">{album.period || 'Preserved'}</span>
						</div>
						<h3 class="album-grid-title">{album.title}</h3>
						{album.story ? (
							<p class="album-grid-desc">{album.story}</p>
						) : album.description ? (
							<p class="album-grid-desc">{album.description}</p>
						) : null}
					</div>
				</a>
			);
		})}
	</div>
</section>

<style>
	.about-gallery-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem 1.25rem;
		margin-top: 0.5rem;
	}

	@media (max-width: 640px) {
		.about-gallery-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}

	.album-grid-card {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		text-decoration: none;
		color: inherit;
		background: var(--card-bg, #f4f0e7);
		border: 1px solid var(--card-border, rgba(95, 80, 56, 0.12));
		border-radius: 12px;
		padding: 0.75rem;
		transition: border-color var(--dur-fast) ease, transform var(--dur-ui) var(--ease-out), box-shadow var(--dur-ui) ease, background-color var(--dur-fast) ease;
	}

	.album-grid-card:hover {
		transform: translateY(-3px);
		border-color: rgba(95, 80, 56, 0.28);
		box-shadow: 0 8px 20px rgba(95, 80, 56, 0.08);
		background: color-mix(in srgb, var(--card-bg, #f4f0e7) 85%, #fff);
	}

	.album-grid-card:hover .album-grid-title {
		color: var(--accent);
	}

	/* Image Collage Layouts */
	.album-collage {
		position: relative;
		width: 100%;
		height: 180px;
		border-radius: 8px;
		overflow: hidden;
		background: var(--slot, rgba(95, 80, 56, 0.08));
	}

	.album-collage img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--dur-enter) ease;
	}

	.album-grid-card:hover .album-collage img {
		transform: scale(1.04);
	}

	.collage-single {
		width: 100%;
		height: 100%;
	}

	.collage-two {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2px;
		width: 100%;
		height: 100%;
	}

	.collage-three {
		display: grid;
		grid-template-columns: 1.35fr 1fr;
		gap: 2px;
		width: 100%;
		height: 100%;
	}

	.collage-column {
		display: grid;
		grid-template-rows: 1fr 1fr;
		gap: 2px;
		height: 100%;
	}

	.collage-cell {
		position: relative;
		overflow: hidden;
		height: 100%;
		width: 100%;
	}

	.collage-count-badge {
		position: absolute;
		right: 0.5rem;
		bottom: 0.5rem;
		z-index: 2;
		font-size: 0.68rem;
		font-weight: 600;
		color: #fff;
		background: rgba(0, 0, 0, 0.65);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		padding: 0.2rem 0.45rem;
		border-radius: 4px;
		letter-spacing: 0.02em;
	}

	/* Card Details */
	.album-grid-info {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 0.15rem 0.25rem 0.25rem;
	}

	.album-grid-meta {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--type-caption);
		color: var(--text-muted);
	}

	.album-grid-tag {
		color: var(--accent);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.album-grid-period {
		color: var(--text-muted);
	}

	.meta-sep {
		opacity: 0.4;
	}

	.album-grid-title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		color: var(--text-main);
		line-height: 1.3;
		transition: color var(--dur-fast) ease;
	}

	.album-grid-desc {
		margin: 0;
		font-size: 0.85rem;
		line-height: 1.45;
		color: var(--text-muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>

