---
import { getEntry } from 'astro:content';
import { site } from '../../data/site';
import CopyEmailButton from '../CopyEmailButton.astro';

const bscEntry = await getEntry('education', 'bsc-cse');
const researchEntry = await getEntry('research', '01-bangla-hwcr-ekush');
const bscCseProgram = bscEntry?.data;
const finalYearThesisResearch = researchEntry?.data;
if (!bscCseProgram || !finalYearThesisResearch) {
	throw new Error('Missing education or research content for AboutHero');
}
---

<section class="about-hero" id="profile">
	<div class="hero-status">
		<span class="status-dot"></span>
		<span class="status-text font-mono">AVAILABLE FOR OPPORTUNITIES</span>
		<span class="status-divider font-mono">•</span>
		<span class="status-text font-mono timezone-tag">DHAKA (UTC+6) • US/EU OVERLAP</span>
	</div>

	<div class="hero-titles">
		<span class="section-tag font-dot">00 // EXECUTIVE PROFILE</span>
		<h1 class="title font-dot">Marcel David Baroi</h1>
		<p class="subtitle font-dot">Full-Stack & Enterprise Systems Engineer</p>
	</div>

	<p class="hero-bio">
		Disciplined Full-Stack & Enterprise Systems Engineer specializing in planning, architecting, and delivering enterprise web applications, multi-tenant SaaS structures, and cross-platform native software ecosystems.
	</p>

	<!-- 15-Second Recruiter Triage Pill Bar -->
	<div class="triage-pill-bar font-mono">
		<span class="triage-pill">
			<span class="triage-label">Location</span>
			<span class="triage-val">Dhaka, BD (UTC+6) • US/EU Overlap</span>
		</span>
		<span class="triage-pill">
			<span class="triage-label">Specialization</span>
			<span class="triage-val">Enterprise SaaS & Distributed Schemas</span>
		</span>
		<span class="triage-pill">
			<span class="triage-label">Work Status</span>
			<span class="triage-val">Full-Time / Contract • Open to Relocation</span>
		</span>
	</div>

	<!-- Action Links & Contact Pills -->
	<div class="hero-actions">
		<a href={site.resumePdf} target="_blank" rel="noopener noreferrer" class="btn btn-accent font-mono" title="Download Resume (PDF)">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
				<polyline points="7 10 12 15 17 10"></polyline>
				<line x1="12" y1="15" x2="12" y2="3"></line>
			</svg>
			Download Resume (PDF)
		</a>
		<a href={site.resumeTxt} target="_blank" rel="noopener noreferrer" class="btn btn-secondary font-mono" title="ATS plain-text CV">
			ATS Text CV
		</a>
		<a href={`mailto:${site.email}`} class="btn btn-primary font-mono">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<rect width="20" height="16" x="2" y="4" rx="2"></rect>
				<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
			</svg>
			Email Me
		</a>
		<CopyEmailButton variant="button" label="Copy Email" />
		<a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary font-mono">
			LinkedIn
		</a>
		<a href={site.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary font-mono">
			GitHub
		</a>
	</div>

	<!-- Academic Pedigree & CS Foundation Top Highlight Strip -->
	<div class="hero-pedigree-strip font-mono">
		<span class="pedigree-label">CS PEDIGREE & APPLIED RESEARCH //</span>
		<div class="pedigree-cards-grid">
			<a href="/education/bsc-cse" class="pedigree-card card" title="View B.Sc. in CSE Details & Transcript">
				<div class="pedigree-logo-box diu-box">
					<img
						src={bscCseProgram.logo || "/images/education/daffodil-logo.webp"}
						alt="Daffodil International University Crest"
						class="pedigree-logo-img"
						width="44"
						height="44"
						loading="eager"
					/>
				</div>
				<div class="pedigree-info">
					<div class="pedigree-top">
						<span class="pedigree-inst">Daffodil International University</span>
						<span class="pedigree-badge font-mono diu-badge">CSE Batch 55</span>
					</div>
					<span class="pedigree-deg font-mono">B.Sc. in CSE (CGPA 3.91) • <strong>142 Credits · 6 A+ Practicums</strong></span>
				</div>
				<span class="pedigree-arrow">→</span>
			</a>

			<a href={`/research/${finalYearThesisResearch.slug}`} class="pedigree-card card" title="View Bangla HWCR Final Year Thesis & Benchmarks">
				<div class="pedigree-logo-box thesis-box">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="thesis-icon-svg">
						<path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
					</svg>
				</div>
				<div class="pedigree-info">
					<div class="pedigree-top">
						<span class="pedigree-inst">Applied Deep Learning Thesis</span>
						<span class="pedigree-badge font-mono thesis-badge">DenseNet: 97.93%</span>
					</div>
					<span class="pedigree-deg font-mono">Bangla HWCR • <strong>16 Benchmarked Models · Ekush Dataset</strong></span>
				</div>
				<span class="pedigree-arrow">→</span>
			</a>
		</div>
	</div>

	<!-- ON THIS PAGE: Quick Section Index Navigator -->
	<nav class="on-this-page-bar card" aria-label="On this page navigation">
		<div class="otp-header">
			<svg class="otp-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="12" cy="12" r="10"></circle>
				<polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
			</svg>
			<span class="otp-label font-mono">ON THIS PAGE // QUICK JUMP:</span>
		</div>
		<div class="otp-links">
			<a href="#at-a-glance" class="otp-link">01. Impact Metrics</a>
			<a href="#capabilities" class="otp-link">02. Capabilities & Stack</a>
			<a href="#career-highlights" class="otp-link">03. Career Trajectory</a>
			<a href="#philosophy" class="otp-link">04. Architecture & Methodology</a>
			<a href="#academic-pedigree" class="otp-link">05. Education & Thesis</a>
			<a href="#credentials-section" class="otp-link">06. Credentials</a>
			<a href="#beyond-terminal" class="otp-link">07. Beyond Code</a>
			<a href="#collaboration" class="otp-link">08. Contact</a>
		</div>
	</nav>
</section>

<style>
	.about-hero {
		width: 100%;
		padding: 3rem 0 1.5rem;
		text-align: left;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.hero-status {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		padding: 0.35rem 0.9rem;
		border-radius: 9999px;
		width: fit-content;
		flex-wrap: wrap;
	}

	.status-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: #22c55e;
		box-shadow: 0 0 10px rgba(34, 197, 94, 0.6);
		animation: pulse 2s infinite ease-in-out;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.5; transform: scale(0.85); }
	}

	.status-text {
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		color: var(--text-muted);
		font-weight: 500;
	}

	.status-divider {
		font-size: 0.75rem;
		color: var(--card-border);
		opacity: 0.8;
	}

	.timezone-tag {
		color: var(--text-main);
		font-weight: 600;
	}

	.hero-titles {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.section-tag {
		font-size: 0.9375rem;
		letter-spacing: 0.12em;
		color: var(--accent);
		text-transform: uppercase;
		font-weight: 700;
	}

	.title {
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.1;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	.subtitle {
		font-size: clamp(1.2rem, 3vw, 1.6rem);
		color: var(--accent);
		font-weight: 600;
	}

	.hero-bio {
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--text-muted);
		max-width: 800px;
	}

	.triage-pill-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		width: 100%;
	}

	.triage-pill {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.55rem 0.9rem;
		border-radius: 10px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		min-width: 180px;
		flex: 1;
	}

	.triage-label {
		font-size: 0.65rem;
		letter-spacing: 0.08em;
		color: var(--accent);
		font-weight: 700;
		text-transform: uppercase;
	}

	.triage-val {
		font-size: 0.78rem;
		color: var(--text-main);
		font-weight: 600;
		line-height: 1.35;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.25rem;
	}

	.btn-secondary {
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		color: var(--text-main);
	}

	.btn-secondary:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	/* Hero Pedigree Strip */
	.hero-pedigree-strip {
		margin-top: 0.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		width: 100%;
	}

	.pedigree-label {
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		color: var(--accent);
		font-weight: 700;
	}

	.pedigree-cards-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
		width: 100%;
	}

	@media (max-width: 768px) {
		.pedigree-cards-grid {
			grid-template-columns: 1fr;
		}
	}

	.pedigree-card {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.25rem;
		border-radius: 12px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.pedigree-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(180, 33, 53, 0.08);
	}

	.pedigree-logo-box {
		width: 48px;
		height: 48px;
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.95);
		border: 1px solid rgba(95, 80, 56, 0.15);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		padding: 4px;
	}

	.pedigree-logo-img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.pedigree-info {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		flex: 1;
		min-width: 0;
	}

	.pedigree-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.pedigree-inst {
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.3;
	}

	.pedigree-badge {
		font-size: 0.72rem;
		background: rgba(180, 33, 53, 0.08);
		color: var(--accent);
		padding: 0.15rem 0.45rem;
		border-radius: 4px;
		font-weight: 700;
		white-space: nowrap;
	}

	.pedigree-badge.diu-badge {
		background: rgba(27, 77, 62, 0.1);
		color: #1b4d3e;
	}

	.pedigree-badge.thesis-badge {
		background: rgba(180, 33, 53, 0.1);
		color: var(--accent);
	}

	.thesis-box {
		background: rgba(180, 33, 53, 0.08);
		border-color: rgba(180, 33, 53, 0.2);
	}

	.thesis-icon-svg {
		color: var(--accent);
	}

	.pedigree-deg {
		font-size: 0.78rem;
		color: var(--text-muted);
		line-height: 1.35;
	}

	.pedigree-arrow {
		font-size: 1.1rem;
		color: var(--accent);
		font-weight: 700;
		transition: transform 0.15s ease;
		flex-shrink: 0;
	}

	.pedigree-card:hover .pedigree-arrow {
		transform: translateX(3px);
	}

	/* On This Page Quick Nav Bar */
	.on-this-page-bar {
		margin-top: 1rem;
		padding: 1.15rem 1.4rem;
		border-radius: 12px;
		background: linear-gradient(135deg, var(--card-bg) 0%, rgba(180, 33, 53, 0.03) 100%);
		border: 1px solid rgba(180, 33, 53, 0.18);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.otp-header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.otp-svg {
		color: var(--accent);
		flex-shrink: 0;
	}

	.otp-label {
		font-size: 0.74rem;
		font-weight: 700;
		color: var(--accent);
		letter-spacing: 0.06em;
	}

	.otp-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.otp-link {
		font-size: 0.75rem;
		padding: 0.3rem 0.65rem;
		border-radius: 6px;
		background: rgba(95, 80, 56, 0.06);
		color: var(--text-main);
		text-decoration: none;
		border: 1px solid rgba(95, 80, 56, 0.12);
		transition: all 0.15s ease;
		font-weight: 600;
	}

	.otp-link:hover {
		background: var(--accent);
		color: #fffdfa;
		border-color: var(--accent);
		transform: translateY(-1px);
	}

	@media (max-width: 480px) {
		.triage-pill {
			min-width: 0;
			flex: 1 1 100%;
		}

		.pedigree-badge {
			white-space: normal;
		}

		.pedigree-card {
			flex-wrap: wrap;
		}
	}
</style>
