---
import { site } from '../../data/site';
import type { MetricItem } from '../../data/aboutData';

interface Props {
	metrics: MetricItem[];
}

const { metrics } = Astro.props;

const proofLine = [
	metrics.find((m) => m.value === '10+'),
	metrics.find((m) => m.value === '100%'),
	metrics.find((m) => m.value === '3.91'),
	metrics.find((m) => m.value === '+60%'),
]
	.filter(Boolean)
	.map((m) => `${m!.value} ${m!.label}`)
	.join(' · ');

const bioParagraphs = [
	'I design and ship full-stack web and cross-platform applications across Next.js, Vue / Quasar, NestJS, Flutter, and PostgreSQL.',
	'Architecture-first: relational data models, strict API contracts, and multi-tenant row-level security before AI-assisted synthesis.',
	'Private SemVer package registries and atomic PostgreSQL migrations — reducing duplication while keeping production velocity measurable.',
];
---

<section class="about-hero" id="profile" aria-label="About">
	<p class="label font-mono about-hero-kicker">About</p>
	<p class="about-hero-status font-mono">Available · Remote / relocation · Dhaka · US/EU overlap</p>
	<h1 class="about-hero-name font-sans">{site.name}</h1>
	<p class="about-hero-role">Software Engineer</p>
	<div class="about-hero-bio">
		{bioParagraphs.map((line) => (
			<p>{line}</p>
		))}
	</div>
	<p class="about-hero-proof-line">{proofLine}</p>
	<div class="hero-actions">
		<a class="btn-solid font-mono" href={`mailto:${site.email}`}>Email me</a>
		<a class="btn-ghost font-mono" href={site.resumePdf} target="_blank" rel="noopener noreferrer">Resume</a>
		<a class="text-link font-mono" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
		<a class="text-link font-mono" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
	</div>
</section>
