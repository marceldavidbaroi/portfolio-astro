---
import CopyEmailButton from '../CopyEmailButton.astro';
---

<section class="about-section" id="collaboration">
	<div class="cta-card card">
		<span class="section-tag font-dot">08 // COLLABORATION</span>
		<h2 class="cta-title font-dot">Let's Build Something Resilient</h2>
		<p class="cta-text">
			Available for full-stack engineering roles, system architecture design, and high-impact SaaS development.
		</p>
		<div class="cta-buttons">
			<a href="mailto:marceldavidbaroi@gmail.com" class="btn btn-accent font-mono">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect width="20" height="16" x="2" y="4" rx="2"></rect>
					<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
				</svg>
				Email Me Directly
			</a>
			<CopyEmailButton variant="button" label="Copy Email" />
			<a href="https://linkedin.com/in/marceldavidbaroi" target="_blank" rel="noopener noreferrer" class="btn btn-primary font-mono">
				Connect on LinkedIn
			</a>
			<a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-secondary font-mono">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
					<polyline points="7 10 12 15 17 10"></polyline>
					<line x1="12" y1="15" x2="12" y2="3"></line>
				</svg>
				Download Resume (PDF)
			</a>
		</div>
	</div>
</section>

<style>
	.about-section {
		width: 100%;
		margin-top: 4.5rem;
		text-align: left;
		scroll-margin-top: 5rem;
	}

	.cta-card {
		padding: 3rem 2.25rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		background: linear-gradient(145deg, #f4f0e7 0%, #ede7da 100%);
	}

	.section-tag {
		font-size: 0.9375rem;
		letter-spacing: 0.12em;
		color: var(--accent);
		text-transform: uppercase;
		font-weight: 700;
	}

	.cta-title {
		font-size: clamp(1.85rem, 4vw, 2.5rem);
		color: var(--text-main);
		text-transform: uppercase;
	}

	.cta-text {
		font-size: 1rem;
		line-height: 1.6;
		color: var(--text-muted);
		max-width: 600px;
	}

	.cta-buttons {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		justify-content: center;
		margin-top: 0.5rem;
	}

	.btn-secondary {
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		color: var(--text-main);
	}

	.btn-secondary:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
</style>
