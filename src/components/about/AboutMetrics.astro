---
import type { MetricItem } from '../../data/aboutData';

interface Props {
	metrics: MetricItem[];
}

const { metrics } = Astro.props;
---

<section class="about-section" id="at-a-glance">
	<div class="metrics-grid">
		{metrics.map((m) => (
			<div class="metric-card card">
				<span class="metric-num font-dot">{m.value}</span>
				<span class="metric-label">{m.label}</span>
				<span class="metric-sub font-mono">{m.sub}</span>
			</div>
		))}
	</div>
</section>

<style>
	.about-section {
		width: 100%;
		margin-top: 3.5rem;
		text-align: left;
		scroll-margin-top: 5rem;
	}

	.metrics-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 900px) {
		.metrics-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 480px) {
		.metrics-grid {
			grid-template-columns: 1fr;
		}
	}

	.metric-card {
		padding: 1.75rem 1.5rem;
		border-radius: 12px;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
	}

	.metric-num {
		font-size: 2.25rem;
		font-weight: 700;
		color: var(--accent);
		line-height: 1;
	}

	.metric-label {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-main);
	}

	.metric-sub {
		font-size: 0.75rem;
		color: var(--text-muted);
	}
</style>
