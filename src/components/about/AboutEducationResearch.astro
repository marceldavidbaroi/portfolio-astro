---

<section class="about-section" id="academic-pedigree">
	<div class="section-header">
		<span class="section-tag font-dot">04 // EDUCATION & RESEARCH</span>
		<h2 class="section-title font-dot">Academic Pedigree & Research</h2>
		<p class="section-desc">
			Formal degree programs, higher secondary foundation, and solo undergraduate thesis.
		</p>
	</div>

	<div class="compact-edu-grid">
		<!-- DIU Card -->
		<div class="compact-card card">
			<div class="c-top">
				<div class="c-left-icon">
					<div class="c-svg-box">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
							<path d="M6 12v5c3 3 9 3 12 0v-5"></path>
						</svg>
					</div>
					<div>
						<span class="c-inst-tag font-mono">DIU CSE BATCH 55</span>
						<h3 class="c-title">B.Sc. in Computer Science & Engineering</h3>
					</div>
				</div>
				<span class="c-stat-pill font-mono">CGPA 3.91 / 4.00</span>
			</div>
			<p class="c-summary">
				142-credit UGC uniform curriculum encompassing algorithms, distributed systems, AI, and 6 consecutive Grade A+ software practicums.
			</p>
			<a href="/education/bsc-cse" class="c-action-btn">
				<span>View B.Sc. Details & 11-Semester Transcript →</span>
			</a>
		</div>

		<!-- NDC Card -->
		<div class="compact-card card">
			<div class="c-top">
				<div class="c-left-icon">
					<div class="c-svg-box">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<line x1="3" y1="21" x2="21" y2="21"></line>
							<line x1="6" y1="18" x2="6" y2="10"></line>
							<line x1="10" y1="18" x2="10" y2="10"></line>
							<line x1="14" y1="18" x2="14" y2="10"></line>
							<line x1="18" y1="18" x2="18" y2="10"></line>
							<polygon points="12 2 2 8 22 8"></polygon>
						</svg>
					</div>
					<div>
						<span class="c-inst-tag font-mono">BATCH '19 // GROUP 13</span>
						<h3 class="c-title">Higher Secondary Certificate (HSC Science)</h3>
					</div>
				</div>
				<span class="c-stat-pill font-mono">GPA 4.67 / 5.00</span>
			</div>
			<p class="c-summary">
				Notre Dame College (Room 304). Rigorous scientific foundation, math club participation, and campus leadership.
			</p>
			<a href="/education/hsc-science" class="c-action-btn">
				<span>View Notre Dame College Details & Heritage →</span>
			</a>
		</div>

		<!-- Thesis Card -->
		<div class="compact-card card">
			<div class="c-top">
				<div class="c-left-icon">
					<div class="c-svg-box">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
							<polyline points="14 2 14 8 20 8"></polyline>
							<line x1="16" y1="13" x2="8" y2="13"></line>
							<line x1="16" y1="17" x2="8" y2="17"></line>
							<polyline points="10 9 9 9 8 9"></polyline>
						</svg>
					</div>
					<div>
						<span class="c-inst-tag font-mono">FINAL YEAR THESIS</span>
						<h3 class="c-title">Bangla Handwritten Character Recognition</h3>
					</div>
				</div>
				<span class="c-stat-pill font-mono">DenseNet: 97.93%</span>
			</div>
			<p class="c-summary">
				Solo undergraduate research evaluating 16 deep learning models on 80,000 Ekush dataset images with DenseNet-201 benchmark excellence.
			</p>
			<a href="/research/01-bangla-hwcr-ekush" class="c-action-btn">
				<span>Read Research Paper & 16-Model Benchmarks →</span>
			</a>
		</div>
	</div>
</section>

<style>
	.about-section {
		width: 100%;
		margin-top: 4.5rem;
		text-align: left;
		scroll-margin-top: 5rem;
	}

	.section-header {
		margin-bottom: 2rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.section-tag {
		font-size: 0.9375rem;
		letter-spacing: 0.12em;
		color: var(--accent);
		text-transform: uppercase;
		font-weight: 700;
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--text-main);
	}

	.section-desc {
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--text-muted);
		max-width: 700px;
	}

	.compact-edu-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 900px) {
		.compact-edu-grid {
			grid-template-columns: 1fr;
		}
	}

	.compact-card {
		padding: 1.6rem;
		border-radius: 14px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		transition: all 0.2s ease;
	}

	.compact-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(180, 33, 53, 0.08);
	}

	.c-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.c-left-icon {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
	}

	.c-svg-box {
		width: 38px;
		height: 38px;
		border-radius: 8px;
		background: rgba(180, 33, 53, 0.08);
		color: var(--accent);
		border: 1px solid rgba(180, 33, 53, 0.2);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.c-inst-tag {
		font-size: 0.68rem;
		color: var(--accent);
		font-weight: 700;
		letter-spacing: 0.06em;
	}

	.c-title {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.3;
	}

	.c-stat-pill {
		font-size: 0.72rem;
		background: rgba(180, 33, 53, 0.08);
		color: var(--accent);
		padding: 0.2rem 0.55rem;
		border-radius: 4px;
		font-weight: 700;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.c-summary {
		font-size: 0.82rem;
		line-height: 1.55;
		color: var(--text-muted);
		flex: 1;
	}

	.c-action-btn {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		padding-top: 0.5rem;
		border-top: 1px dashed rgba(95, 80, 56, 0.12);
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		transition: all 0.15s ease;
	}

	.c-action-btn:hover {
		color: var(--accent-hover);
		transform: translateX(3px);
	}
</style>
