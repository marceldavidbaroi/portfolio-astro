---
import { getEntry } from 'astro:content';
import { schoolExtras } from '../../data/aboutLayoutDummy';

const bscEntry = await getEntry('education', 'bsc-cse');
const hscEntry = await getEntry('education', 'hsc-science');
const researchEntry = await getEntry('research', '01-bangla-hwcr-ekush');

if (!bscEntry || !hscEntry || !researchEntry) {
	throw new Error('Missing education or research content for About school section');
}

const bsc = bscEntry.data;
const hsc = hscEntry.data;
const thesis = researchEntry.data;

const bscPrimary = `${bsc.shortDegree ?? 'B.Sc. CSE'} · ${bsc.institutionShort} · ${(bsc.cgpa ?? 0).toFixed(2)}`;
const bscThird = schoolExtras.bsc.thirdLine.startsWith('[draft]')
	? `${bsc.totalCredits ?? 142} cr`
	: schoolExtras.bsc.thirdLine;
const thesisPrimary = `Thesis · ${thesis.shortTitle ?? 'Bangla HWCR'} · ${thesis.accuracy ?? '97.93%'}`;
const hscPrimary = `HSC Science · ${hsc.institutionShort} · ${(hsc.gpa ?? 0).toFixed(2)}`;
---

<section class="about-section" id="school" aria-labelledby="school-heading">
	<div class="section-kicker">
		<h2 id="school-heading" class="label font-mono">School</h2>
	</div>

	<a class="about-school-row" href="/education/bsc-cse">
		{bsc.logo ? (
			<img src={bsc.logo} alt="" class="about-school-logo" width="40" height="40" loading="lazy" />
		) : (
			<span class="about-school-logo" aria-hidden="true"></span>
		)}
		<div class="about-school-lines">
			<p class="about-school-primary">{bscPrimary}</p>
			<p class="about-school-secondary">{bscThird}</p>
		</div>
		<span class="section-link font-mono">Transcript →</span>
	</a>

	<a class="about-school-row" href={`/research/${thesis.slug}`}>
		<span class="about-school-logo about-school-logo-slot" aria-hidden="true"></span>
		<div class="about-school-lines">
			<p class="about-school-primary">{thesisPrimary}</p>
			<p class="about-school-secondary">{schoolExtras.thesis.thirdLine.replace('[draft] ', '')}</p>
		</div>
		<span class="section-link font-mono">Paper →</span>
	</a>

	<a class="about-school-row" href="/education/hsc-science">
		{hsc.logo ? (
			<img src={hsc.logo} alt="" class="about-school-logo" width="40" height="40" loading="lazy" />
		) : (
			<span class="about-school-logo" aria-hidden="true"></span>
		)}
		<div class="about-school-lines">
			<p class="about-school-primary">{hscPrimary}</p>
			<p class="about-school-secondary">{schoolExtras.hsc.thirdLine.replace('[draft] ', '')}</p>
		</div>
		<span class="section-link font-mono">Details →</span>
	</a>

	<p class="about-school-archive font-mono">
		<a href={schoolExtras.archiveHref}>{schoolExtras.archiveLine.replace('[draft] ', '')}</a>
	</p>
</section>

<style>
	.about-school-logo-slot {
		display: block;
		background: var(--card-bg);
		border: 1px solid rgba(95, 80, 56, 0.12);
		border-radius: 6px;
	}

	.about-school-row {
		text-decoration: none;
		color: inherit;
	}

	.about-school-row:hover .about-school-primary {
		color: var(--accent);
	}

	.about-school-archive {
		margin: 1rem 0 0;
		font-size: var(--type-meta);
		color: var(--text-muted);
	}

	.about-school-archive a {
		color: var(--accent);
		font-weight: 700;
		text-decoration: none;
	}

	.about-school-archive a:hover {
		text-decoration: underline;
	}
</style>
