---
interface Props {
	images?: string[];
	href?: string;
	label?: string;
	align?: 'left' | 'right';
	class?: string;
}

const {
	images = [],
	href,
	label = 'Open gallery',
	align = 'right',
	class: className = ''
} = Astro.props;

const stack = images.filter(Boolean).slice(0, 3);
const showPlaceholders = stack.length === 0;
const layers = showPlaceholders ? [null, null, null] : stack;
const Tag = href ? 'a' : 'div';
---

<Tag
	href={href}
	class:list={['image-stack', `image-stack--${align}`, className]}
	aria-label={href ? label : undefined}
	title={href ? label : undefined}
>
	{layers.map((src, i) => {
		return (
			<span
				class:list={['image-stack-layer', !src && 'is-empty']}
				style={`--stack-i: ${i}`}
			>
				{src ? (
					<img
						src={src}
						alt=""
						loading="lazy"
						class="image-stack-img"
						onerror="this.parentElement.classList.add('is-empty'); this.remove();"
					/>
				) : null}
			</span>
		);
	})}
	{showPlaceholders && <span class="image-stack-hint font-mono">Add photos</span>}
	{href && !showPlaceholders && (
		<span class="image-stack-cta font-mono" aria-hidden="true">Gallery</span>
	)}
</Tag>

<style>
	.image-stack {
		--stack-w: 110px;
		--stack-h: 76px;
		position: relative;
		display: block;
		width: calc(var(--stack-w) + 24px);
		height: calc(var(--stack-h) + 18px);
		text-decoration: none;
		color: inherit;
		isolation: isolate;
	}

	.image-stack--right {
		justify-self: end;
	}

	.image-stack-layer {
		position: absolute;
		width: var(--stack-w);
		height: var(--stack-h);
		border-radius: 11px;
		border: 1px solid rgba(95, 80, 56, 0.2);
		background: var(--paper);
		box-shadow: 0 10px 22px rgba(95, 80, 56, 0.12);
		overflow: hidden;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.image-stack--right .image-stack-layer {
		right: calc(var(--stack-i) * 7px);
		bottom: calc(var(--stack-i) * 5px);
		/* Match project mosaic: counterclockwise tilt */
		transform: rotate(calc(-12deg + var(--stack-i) * 4deg)) skew(calc(-1deg + var(--stack-i) * 0.5deg));
		z-index: calc(3 - var(--stack-i));
	}

	.image-stack--left .image-stack-layer {
		left: calc(var(--stack-i) * 7px);
		bottom: calc(var(--stack-i) * 5px);
		transform: rotate(calc(12deg - var(--stack-i) * 4deg)) skew(calc(1deg - var(--stack-i) * 0.5deg));
		z-index: calc(3 - var(--stack-i));
	}

	.image-stack-layer.is-empty {
		border-style: dashed;
		border-color: rgba(95, 80, 56, 0.3);
		background: rgba(255, 252, 248, 0.9);
	}

	.image-stack-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.image-stack:hover .image-stack-layer {
		box-shadow: 0 14px 28px rgba(95, 80, 56, 0.16);
	}

	.image-stack--right:hover .image-stack-layer {
		transform: rotate(calc(-8deg + var(--stack-i) * 3deg)) skew(0deg) translateY(-3px);
	}

	.image-stack--left:hover .image-stack-layer {
		transform: rotate(calc(8deg - var(--stack-i) * 3deg)) skew(0deg) translateY(-3px);
	}

	.image-stack-hint,
	.image-stack-cta {
		position: absolute;
		z-index: 5;
		font-size: var(--type-caption);
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		pointer-events: none;
	}

	.image-stack-hint {
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-muted);
	}

	.image-stack-cta {
		right: 10px;
		bottom: 10px;
		padding: 0.18rem 0.4rem;
		border-radius: 9999px;
		background: rgba(255, 252, 248, 0.92);
		border: 1px solid rgba(95, 80, 56, 0.2);
		color: var(--text-main);
		opacity: 0;
		transform: translateY(4px);
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.image-stack--left .image-stack-cta {
		right: auto;
		left: 10px;
	}

	.image-stack:hover .image-stack-cta {
		opacity: 1;
		transform: translateY(0);
	}

	@media (max-width: 640px) {
		.image-stack {
			--stack-w: 92px;
			--stack-h: 64px;
		}
	}
</style>
