---
interface Props {
	thumbs: string[];
	photoCount?: number;
	altTitle?: string;
}

const { thumbs = [], photoCount = 0, altTitle = '' } = Astro.props;
// Render up to 3 stacked cards (reverse so bottom-most card renders first in DOM for natural z-stacking)
const cards = thumbs.slice(0, 3);
---

<div class="album-photo-stack" aria-hidden="true">
	<div class="album-stack-deck">
		{cards.map((thumb, idx) => {
			// idx 0 = top, idx 1 = middle, idx 2 = bottom
			return (
				<span
					class={`album-stack-layer layer-${idx}`}
					style={`--card-idx: ${idx};`}
				>
					<img src={thumb} alt={idx === 0 ? altTitle : ''} loading="lazy" />
				</span>
			);
		})}
	</div>
	{photoCount > 1 && (
		<span class="album-stack-badge font-mono">
			{photoCount}
		</span>
	)}
</div>

<style>
	.album-photo-stack {
		position: relative;
		width: 8.4rem;
		height: 5.6rem;
		justify-self: end;
		flex-shrink: 0;
		user-select: none;
	}

	.album-stack-deck {
		position: relative;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.album-stack-layer {
		position: absolute;
		width: 6.8rem;
		aspect-ratio: 16 / 10;
		border-radius: 2px;
		border: 1px solid rgba(95, 80, 56, 0.2);
		background: var(--card-bg, #f4f0e7);
		overflow: hidden;
		transform-origin: center center;
		box-shadow: 0 1px 3px rgba(44, 36, 26, 0.08);
		transition: transform 0.26s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.2s ease;
	}

	.album-stack-layer img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	/* Layer 0 (Top card) */
	.album-stack-layer.layer-0 {
		z-index: 3;
		transform: rotate(0deg) translate(0, 0);
		opacity: 1;
	}

	/* Layer 1 (Middle card) */
	.album-stack-layer.layer-1 {
		z-index: 2;
		transform: rotate(-3.5deg) translate(-3px, 1px);
		opacity: 0.92;
	}

	/* Layer 2 (Bottom card) */
	.album-stack-layer.layer-2 {
		z-index: 1;
		transform: rotate(4deg) translate(3px, 3px);
		opacity: 0.85;
	}

	/* Tactile Hover Fan Expansion */
	:global(.about-gallery-row:hover) .album-stack-layer.layer-0,
	:global(.gallery-catalog-row:hover) .album-stack-layer.layer-0 {
		transform: rotate(0deg) translate(0, -3px);
	}

	:global(.about-gallery-row:hover) .album-stack-layer.layer-1,
	:global(.gallery-catalog-row:hover) .album-stack-layer.layer-1 {
		transform: rotate(-7deg) translate(-7px, 1px);
		opacity: 0.98;
	}

	:global(.about-gallery-row:hover) .album-stack-layer.layer-2,
	:global(.gallery-catalog-row:hover) .album-stack-layer.layer-2 {
		transform: rotate(7deg) translate(7px, 5px);
		opacity: 0.95;
	}

	/* Subtle stationery count stamp on the bottom right */
	.album-stack-badge {
		position: absolute;
		right: -0.25rem;
		bottom: -0.25rem;
		z-index: 5;
		font-size: 0.65rem;
		line-height: 1;
		color: var(--text-muted, #72624e);
		background: var(--paper, #fffcf8);
		border: 1px solid rgba(95, 80, 56, 0.22);
		padding: 2px 4px;
		border-radius: 2px;
		box-shadow: 0 1px 2px rgba(44, 36, 26, 0.06);
		pointer-events: none;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	:global(.about-gallery-row:hover) .album-stack-badge,
	:global(.gallery-catalog-row:hover) .album-stack-badge {
		color: var(--accent, #84353f);
		border-color: rgba(132, 53, 63, 0.35);
	}

	@media (max-width: 768px) {
		.album-photo-stack {
			justify-self: start;
			margin-top: 0.35rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.album-stack-layer {
			transition: none;
		}
	}
</style>
