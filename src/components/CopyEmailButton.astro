---
interface Props {
	email?: string;
	variant?: 'icon' | 'button';
	class?: string;
	label?: string;
}

const {
	email = 'marceldavidbaroi@gmail.com',
	variant = 'icon',
	class: className = '',
	label = 'Copy Email',
} = Astro.props;

const isButton = variant === 'button';
---

<button
	type="button"
	class:list={['copy-email-btn', isButton ? 'copy-email-btn--button font-mono' : 'copy-email-btn--icon', className]}
	data-email={email}
	aria-label={`Copy ${email} to clipboard`}
	title={`Copy ${email}`}
>
	<span class="copy-email-default">
		{isButton ? (
			<>
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
					<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
				</svg>
				<span>{label}</span>
			</>
		) : (
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
				<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
			</svg>
		)}
	</span>
	<span class="copy-email-copied" hidden>
		{isButton ? 'Copied!' : (
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<polyline points="20 6 9 17 4 12"></polyline>
			</svg>
		)}
	</span>
	<span class="copy-email-tooltip" role="status" aria-live="polite">Copied!</span>
</button>

<script>
	function initCopyEmailButtons() {
		document.querySelectorAll<HTMLButtonElement>('.copy-email-btn').forEach((btn) => {
			if (btn.dataset.copyBound === 'true') return;
			btn.dataset.copyBound = 'true';

			btn.addEventListener('click', async () => {
				const email = btn.dataset.email || 'marceldavidbaroi@gmail.com';
				try {
					await navigator.clipboard.writeText(email);
				} catch {
					const ta = document.createElement('textarea');
					ta.value = email;
					ta.setAttribute('readonly', '');
					ta.style.position = 'absolute';
					ta.style.left = '-9999px';
					document.body.appendChild(ta);
					ta.select();
					document.execCommand('copy');
					document.body.removeChild(ta);
				}

				btn.classList.add('is-copied');
				const defaultEl = btn.querySelector('.copy-email-default');
				const copiedEl = btn.querySelector('.copy-email-copied');
				if (defaultEl instanceof HTMLElement) defaultEl.hidden = true;
				if (copiedEl instanceof HTMLElement) copiedEl.hidden = false;

				window.setTimeout(() => {
					btn.classList.remove('is-copied');
					if (defaultEl instanceof HTMLElement) defaultEl.hidden = false;
					if (copiedEl instanceof HTMLElement) copiedEl.hidden = true;
				}, 1800);
			});
		});
	}

	initCopyEmailButtons();
	document.addEventListener('astro:page-load', initCopyEmailButtons);
</script>

<style>
	.copy-email-btn {
		position: relative;
		cursor: pointer;
		border: none;
		font: inherit;
		line-height: 1;
	}

	.copy-email-btn--icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		color: var(--text-muted);
		background: transparent;
		border: 1px solid transparent;
		transition: all 0.2s ease;
	}

	.copy-email-btn--icon:hover {
		color: var(--accent);
		background: rgba(95, 80, 56, 0.06);
		border-color: rgba(95, 80, 56, 0.12);
		transform: translateY(-1px);
	}

	.copy-email-btn--button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		border-radius: 9999px;
		font-size: 0.9375rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		color: var(--text-main);
		transition: all 0.2s ease;
	}

	.copy-email-btn--button:hover {
		border-color: var(--accent);
		color: var(--accent);
		transform: translateY(-1px);
	}

	.copy-email-btn.is-copied {
		color: #15803d;
	}

	.copy-email-btn--button.is-copied {
		border-color: #15803d;
		background: rgba(21, 128, 61, 0.08);
	}

	.copy-email-default,
	.copy-email-copied {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
	}

	.copy-email-tooltip {
		position: absolute;
		bottom: calc(100% + 6px);
		left: 50%;
		transform: translateX(-50%) translateY(4px);
		background: var(--text-main);
		color: #fffdfa;
		font-size: 0.7rem;
		font-family: var(--font-mono);
		padding: 0.25rem 0.5rem;
		border-radius: 4px;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s ease, transform 0.15s ease;
		z-index: 20;
	}

	.copy-email-btn.is-copied .copy-email-tooltip {
		opacity: 1;
		transform: translateX(-50%) translateY(0);
	}
</style>
