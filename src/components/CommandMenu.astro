---
import { site } from '../data/site';

const commands = [
	{ id: 'home', label: 'Home', keywords: 'home index', href: '/', type: 'nav', meta: 'Page' },
	{ id: 'work', label: 'Work / Case Studies', keywords: 'work projects case studies portfolio', href: '/work', type: 'nav', meta: 'Page' },
	{ id: 'about', label: 'About Profile', keywords: 'about profile bio', href: '/about', type: 'nav', meta: 'Page' },
	{ id: 'skills', label: 'Skills Matrix', keywords: 'skills stack tech', href: '/skills', type: 'nav', meta: 'Page' },
	{ id: 'credentials', label: 'Credentials', keywords: 'credentials certifications certs', href: '/credentials', type: 'nav', meta: 'Page' },
	{ id: 'philosophy', label: 'Engineering Philosophy', keywords: 'philosophy architecture principles', href: '/philosophy', type: 'nav', meta: 'Page' },
	{ id: 'archive', label: 'Civic Leadership Archive', keywords: 'archive leadership memoirs', href: '/archive', type: 'nav', meta: 'Page' },
	{ id: 'resume', label: 'Download Resume (PDF)', keywords: 'resume cv pdf download', href: site.resumePdf, type: 'action', meta: 'File', external: true },
	{ id: 'resume-txt', label: 'ATS Text CV', keywords: 'ats resume text plain cv', href: site.resumeTxt, type: 'action', meta: 'File', external: true },
	{ id: 'email', label: 'Copy Email', keywords: 'email copy contact mail', href: '#copy-email', type: 'copy-email', meta: 'Copy' },
	{ id: 'linkedin', label: 'LinkedIn', keywords: 'linkedin social', href: site.linkedin, type: 'action', meta: 'Link', external: true },
	{ id: 'github', label: 'GitHub', keywords: 'github code repos', href: site.github, type: 'action', meta: 'Link', external: true },
];
---

<div id="command-menu" class="cmdk" hidden aria-hidden="true">
	<div class="cmdk-backdrop" data-cmdk-close></div>
	<div
		class="cmdk-dialog"
		role="dialog"
		aria-modal="true"
		aria-labelledby="cmdk-title"
	>
		<div class="cmdk-header">
			<input
				id="cmdk-input"
				class="cmdk-input font-mono"
				type="text"
				placeholder="Jump to…"
				autocomplete="off"
				spellcheck="false"
				aria-label="Command menu search"
			/>
		</div>
		<p id="cmdk-title" class="cmdk-sr-only">Quick navigation command menu</p>
		<ul class="cmdk-list" id="cmdk-list" role="listbox">
			{commands.map((cmd, i) => (
				<li
					class="cmdk-item"
					role="option"
					data-id={cmd.id}
					data-label={cmd.label}
					data-keywords={`${cmd.label} ${cmd.keywords}`.toLowerCase()}
					data-href={cmd.href}
					data-type={cmd.type}
					data-external={cmd.external ? 'true' : 'false'}
					data-index={i}
				>
					<span class="cmdk-item-label">{cmd.label}</span>
					<span class="cmdk-item-meta font-mono" data-meta={cmd.meta}>{cmd.meta}</span>
				</li>
			))}
		</ul>
		<div class="cmdk-empty font-mono" id="cmdk-empty" hidden>No matches</div>
		<div class="cmdk-footer font-mono">
			<span>↑↓ Navigate</span>
			<span>↵ Select</span>
			<span>Esc Close</span>
		</div>
	</div>
</div>

<script define:vars={{ EMAIL: site.email }}>
	function initCommandMenu() {
		const root = document.getElementById('command-menu');
		const input = document.getElementById('cmdk-input') as HTMLInputElement | null;
		const list = document.getElementById('cmdk-list');
		const empty = document.getElementById('cmdk-empty');
		if (!root || !input || !list || root.dataset.bound === 'true') return;
		root.dataset.bound = 'true';

		let activeIndex = 0;

		const getVisibleItems = () =>
			Array.from(list.querySelectorAll<HTMLElement>('.cmdk-item')).filter(
				(el) => el.style.display !== 'none'
			);

		function setActive(index: number) {
			const items = getVisibleItems();
			if (items.length === 0) {
				activeIndex = 0;
				return;
			}
			activeIndex = ((index % items.length) + items.length) % items.length;
			items.forEach((el, i) => el.classList.toggle('is-active', i === activeIndex));
			items[activeIndex]?.scrollIntoView({ block: 'nearest' });
		}

		function filterList(query: string) {
			const q = query.trim().toLowerCase();
			let visible = 0;
			list.querySelectorAll<HTMLElement>('.cmdk-item').forEach((el) => {
				const keywords = el.dataset.keywords || '';
				const match = !q || keywords.includes(q);
				el.style.display = match ? '' : 'none';
				if (match) visible++;
			});
			if (empty) empty.hidden = visible > 0;
			setActive(0);
		}

		async function runItem(el: HTMLElement) {
			const type = el.dataset.type;
			const href = el.dataset.href || '/';
			const external = el.dataset.external === 'true';

			if (type === 'copy-email') {
				try {
					await navigator.clipboard.writeText(EMAIL);
				} catch {
					const ta = document.createElement('textarea');
					ta.value = EMAIL;
					document.body.appendChild(ta);
					ta.select();
					document.execCommand('copy');
					document.body.removeChild(ta);
				}
				const metaEl = el.querySelector('.cmdk-item-meta');
				if (metaEl) metaEl.textContent = 'Copied';
				window.setTimeout(() => closeMenu(), 500);
				return;
			}

			closeMenu();
			if (external) {
				window.open(href, '_blank', 'noopener,noreferrer');
			} else {
				window.location.href = href;
			}
		}

		function emitMenu(open: boolean) {
			document.dispatchEvent(new CustomEvent('command-menu:change', { detail: { open } }));
		}

		function openMenu() {
			root.hidden = false;
			root.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
			input.value = '';
			filterList('');
			emitMenu(true);
			window.setTimeout(() => input.focus(), 10);
		}

		function closeMenu() {
			root.hidden = true;
			root.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = '';
			emitMenu(false);
		}

		document.addEventListener('keydown', (e) => {
			const isCmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';
			if (isCmdK) {
				e.preventDefault();
				if (root.hidden) openMenu();
				else closeMenu();
				return;
			}

			if (root.hidden) return;

			if (e.key === 'Escape') {
				e.preventDefault();
				closeMenu();
			} else if (e.key === 'ArrowDown') {
				e.preventDefault();
				setActive(activeIndex + 1);
			} else if (e.key === 'ArrowUp') {
				e.preventDefault();
				setActive(activeIndex - 1);
			} else if (e.key === 'Enter') {
				e.preventDefault();
				const items = getVisibleItems();
				if (items[activeIndex]) runItem(items[activeIndex]);
			}
		});

		input.addEventListener('input', () => filterList(input.value));

		list.addEventListener('click', (e) => {
			const item = (e.target as HTMLElement).closest<HTMLElement>('.cmdk-item');
			if (item) runItem(item);
		});

		root.querySelectorAll('[data-cmdk-close]').forEach((el) => {
			el.addEventListener('click', closeMenu);
		});

		// Expose open for optional header hint button
		(window as any).__openCommandMenu = openMenu;
	}

	initCommandMenu();
	document.addEventListener('astro:page-load', initCommandMenu);
</script>

<style>
	.cmdk {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding: 12vh 1rem 2rem;
	}

	.cmdk[hidden] {
		display: none !important;
	}

	.cmdk-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(43, 37, 30, 0.28);
	}

	.cmdk-dialog {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 420px;
		padding: 0;
		overflow: hidden;
		border: 1px solid rgba(95, 80, 56, 0.2);
		border-radius: 5px;
		box-shadow: 0 16px 40px rgba(43, 37, 30, 0.14);
		background: var(--paper);
	}

	.cmdk-header {
		padding: 0.85rem 1rem;
		border-bottom: 1px solid rgba(95, 80, 56, 0.12);
	}

	.cmdk-input {
		display: block;
		width: 100%;
		border: none;
		outline: none;
		background: transparent;
		font-size: 0.85rem;
		color: var(--text-main);
	}

	.cmdk-list {
		list-style: none;
		margin: 0;
		padding: 0.4rem;
		max-height: 320px;
		overflow-y: auto;
	}

	.cmdk-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.65rem 0.85rem;
		border-radius: 4px;
		cursor: pointer;
		transition: background 0.1s ease;
	}

	.cmdk-item:hover,
	.cmdk-item.is-active {
		background: rgba(95, 80, 56, 0.06);
	}

	.cmdk-item-label {
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--text-main);
	}

	.cmdk-item-meta {
		font-size: 0.62rem;
		color: var(--text-muted);
		letter-spacing: 0.02em;
	}

	.cmdk-empty {
		padding: 1.5rem;
		text-align: center;
		color: var(--text-muted);
		font-size: 0.8rem;
	}

	.cmdk-footer {
		display: flex;
		gap: 1rem;
		padding: 0.55rem 1rem;
		border-top: 1px solid rgba(95, 80, 56, 0.1);
		font-size: 0.65rem;
		color: var(--text-muted);
	}

	.cmdk-sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		border: 0;
	}
</style>
