---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtticBreadcrumb from './about/AtticBreadcrumb.astro';
import '../styles/about.css';

interface Photo {
	src: string;
	caption: string;
}

interface Props {
	title: string;
	backHref: string;
	backLabel: string;
	tag: string;
	description: string;
	photos: Photo[];
	emptyHint: string;
	/** @deprecated Prefer `crumb` */
	useAtticChrome?: boolean;
	crumb?: 'school' | 'experience';
}

const { title, backHref, backLabel, tag, description, photos, emptyHint, useAtticChrome = false, crumb } = Astro.props;
const atticCrumb = crumb ?? (useAtticChrome ? 'school' : undefined);
---

<BaseLayout title={`Marcel David Baroi | ${title}`} isWide alignStart={Boolean(atticCrumb)}>
	<section class:list={['gallery-page', { 'gallery-attic': Boolean(atticCrumb) }]}>
		{atticCrumb === 'school' ? (
			<>
				<nav class="attic-crumb font-mono gallery-crumb" aria-label="Breadcrumb">
					<a href="/about" class="attic-crumb-link">About</a>
					<span class="attic-crumb-sep" aria-hidden="true">/</span>
					<a href="/about#school" class="attic-crumb-link">School</a>
					<span class="attic-crumb-sep" aria-hidden="true">/</span>
					<span class="attic-crumb-current">Gallery</span>
				</nav>
				<header class="about-attic-head">
					<p class="label font-mono about-attic-kicker">{tag}</p>
					<h1 class="about-attic-title">{title}</h1>
					<p class="about-attic-lead">{description}</p>
				</header>
			</>
		) : atticCrumb === 'experience' ? (
			<>
				<nav class="attic-crumb font-mono gallery-crumb" aria-label="Breadcrumb">
					<a href="/" class="attic-crumb-link">Home</a>
					<span class="attic-crumb-sep" aria-hidden="true">/</span>
					<a href="/#experience" class="attic-crumb-link">Experience</a>
					<span class="attic-crumb-sep" aria-hidden="true">/</span>
					<span class="attic-crumb-current">Gallery</span>
				</nav>
				<header class="about-attic-head">
					<p class="label font-mono about-attic-kicker">{tag}</p>
					<h1 class="about-attic-title">{title}</h1>
					<p class="about-attic-lead">{description}</p>
				</header>
			</>
		) : (
			<>
				<a href={backHref} class="back-link font-mono">← {backLabel}</a>
				<header class="gallery-header">
					<span class="gallery-tag font-mono">{tag}</span>
					<h1 class="gallery-title font-sans">{title}</h1>
					<p class="gallery-desc">{description}</p>
				</header>
			</>
		)}

		{photos.length > 0 ? (
			<div class="gallery-grid" id="gallery-grid">
				{photos.map((photo) => (
					<figure class="gallery-item" data-caption={photo.caption}>
						<button type="button" class="gallery-shot" data-src={photo.src} data-alt={photo.caption}>
							<img src={photo.src} alt={photo.caption} loading="lazy" />
						</button>
						{photo.caption && <figcaption class="font-mono">{photo.caption}</figcaption>}
					</figure>
				))}
			</div>
		) : (
			<p class="gallery-empty font-mono" set:html={emptyHint} />
		)}

		{atticCrumb && <a href={backHref} class="about-return font-mono">← {backLabel}</a>}
	</section>
</BaseLayout>

<script>
	function initGalleryPage() {
		// 1. Cascade observer
		const items = document.querySelectorAll<HTMLElement>('.gallery-item');
		if (items.length) {
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
				items.forEach((it) => it.classList.add('is-revealed'));
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-revealed');
								observer.unobserve(entry.target);
							}
						});
					},
					{
						rootMargin: '0px 0px -40px 0px',
						threshold: 0.05
					}
				);
				items.forEach((it) => {
					if (!it.classList.contains('is-revealed')) {
						observer.observe(it);
					}
				});
			}
		}

		// 2. Lightbox click handler
		const grid = document.getElementById('gallery-grid');
		if (grid && !(grid as any)._boundSpotlight) {
			(grid as any)._boundSpotlight = true;
			grid.addEventListener('click', (e) => {
				const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.gallery-shot');
				if (!btn) return;
				const src = btn.dataset.src;
				const alt = btn.dataset.alt || '';
				if (!src) return;
				const overlay = document.createElement('div');
				overlay.className = 'gallery-spotlight';
				overlay.innerHTML = `<button type="button" class="gallery-spotlight-close" aria-label="Close">×</button><img src="${src}" alt="${alt}" />`;
				document.body.appendChild(overlay);
				const close = () => overlay.remove();
				overlay.addEventListener('click', (ev) => {
					if (ev.target === overlay || (ev.target as HTMLElement).classList.contains('gallery-spotlight-close')) close();
				});
				document.addEventListener('keydown', (ev) => {
					if (ev.key === 'Escape') close();
				}, { once: true });
			});
		}
	}

	initGalleryPage();
	document.addEventListener('astro:page-load', initGalleryPage);
</script>

<style>
	.gallery-page {
		max-width: 1180px;
		margin: 0 auto;
		padding: 2rem 0 4rem;
	}

	.gallery-attic {
		max-width: none;
		margin: 0;
	}

	.gallery-crumb {
		margin-bottom: 1rem;
	}

	.back-link {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--text-main);
		text-decoration: none;
		margin-bottom: 1.25rem;
	}

	.back-link:hover {
		text-decoration: underline;
	}

	.gallery-tag {
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--accent);
		letter-spacing: 0.06em;
	}

	.gallery-title {
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 700;
		margin: 0.35rem 0 0.5rem;
	}

	.gallery-desc {
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.gallery-empty {
		margin-top: 2rem;
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.gallery-item {
		opacity: 0;
		transform: translateY(14px);
		transition:
			opacity var(--dur-enter, 600ms) var(--ease-out),
			transform var(--dur-enter, 600ms) var(--ease-out);
		will-change: opacity, transform;
	}

	.gallery-item.is-revealed {
		opacity: 1;
		transform: translateY(0);
	}

	.gallery-shot {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: var(--card-bg);
		cursor: pointer;
		overflow: hidden;
		transition:
			transform var(--dur-ui, 220ms) var(--ease-out),
			box-shadow var(--dur-ui, 220ms) var(--ease-out);
		will-change: transform;
	}

	.gallery-shot:hover {
		transform: translateY(-4px) rotate(-0.4deg);
		box-shadow: 0 8px 24px rgba(43, 37, 30, 0.12);
	}

	.gallery-shot img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		transition: transform var(--dur-enter, 600ms) var(--ease-out);
	}

	.gallery-shot:hover img {
		transform: scale(1.02);
	}

	.gallery-item figcaption {
		margin-top: 0.35rem;
		font-size: var(--type-caption);
		color: var(--text-muted);
	}

	:global(.gallery-spotlight) {
		position: fixed;
		inset: 0;
		z-index: 100;
		background: rgba(43, 37, 30, 0.88);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem;
		animation: galleryFadeIn 0.22s var(--ease-out);
	}

	:global(.gallery-spotlight img) {
		max-width: min(92vw, 960px);
		max-height: 88vh;
		object-fit: contain;
		animation: galleryScaleIn 0.24s var(--ease-out);
	}

	@keyframes galleryFadeIn {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	@keyframes galleryScaleIn {
		from { transform: scale(0.97); }
		to { transform: scale(1); }
	}

	:global(.gallery-spotlight-close) {
		position: absolute;
		top: 1rem;
		right: 1rem;
		border: 0;
		background: transparent;
		color: var(--paper);
		font-size: 2rem;
		cursor: pointer;
	}

	@media (prefers-reduced-motion: reduce) {
		.gallery-item,
		.gallery-shot,
		.gallery-shot img,
		:global(.gallery-spotlight),
		:global(.gallery-spotlight img) {
			opacity: 1 !important;
			transform: none !important;
			transition: none !important;
			animation: none !important;
		}
	}
</style>
