---
import '../styles/transcript.css';
import { getEntry } from 'astro:content';
import {
	ugcGradingSystem,
	courseCategoryLabels,
	getAcademicStatistics,
	type CourseCategory,
	type Semester
} from '../lib/education';

const program = await getEntry('education', 'bsc-cse');
if (!program) throw new Error('Missing education/bsc-cse');
const semesters = (program.data.semesters || []) as Semester[];
const stats = getAcademicStatistics(semesters);
const topGradeCount = stats.gradeCounts['A+'] + stats.gradeCounts.A;
const categories = Object.keys(courseCategoryLabels) as CourseCategory[];
---

<div class="transcript-wrapper">
	<ul class="transcript-stats">
		<li>
			<strong>{stats.cgpa.toFixed(2)}</strong>
			<span>CGPA / 4.00</span>
		</li>
		<li>
			<strong>{stats.totalCredits.toFixed(1)}</strong>
			<span>Total credits</span>
		</li>
		<li>
			<strong>{topGradeCount} / {stats.totalCourses}</strong>
			<span>A+ / A courses</span>
		</li>
		<li>
			<strong>{stats.softwareProjectsCount} / {stats.softwareProjectsCount}</strong>
			<span>Software projects A+</span>
		</li>
	</ul>

	<div class="transcript-toolbar">
		<div class="about-tabs" role="tablist" aria-label="Transcript views">
			<button class="about-tab is-active view-tab font-mono" type="button" data-view="semesters" id="btn-view-semesters">Semesters</button>
			<button class="about-tab view-tab font-mono" type="button" data-view="categories" id="btn-view-categories">Clusters</button>
			<button class="about-tab view-tab font-mono" type="button" data-view="ugc-scale" id="btn-view-ugc">UGC scale</button>
		</div>

		<div class="transcript-toolbar-actions">
			<label class="transcript-search-wrap">
				<span class="sr-only">Search courses</span>
				<input
					type="search"
					id="course-search-input"
					placeholder="Course code or title…"
					class="transcript-search font-sans"
					autocomplete="off"
				/>
			</label>
			<button id="toggle-expand-all" class="text-link font-mono" type="button">
				<span id="expand-btn-text">Expand all</span>
			</button>
			<button id="clear-search-btn" class="text-link font-mono hidden" type="button" aria-label="Clear search">Clear</button>
		</div>
	</div>

	<!-- VIEW 1: Semester Accordion View (Default) -->
	<div id="semesters-view" class="view-panel active">
		<div class="semesters-list">
			{semesters.map((sem, semIdx) => (
				<details class="semester-accordion" open={semIdx < 2} data-semester={sem.semesterNumber}>
					<summary class="semester-summary">
						<div class="sem-summary-left">
							<span class="sem-chevron">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
									<polyline points="6 9 12 15 18 9"></polyline>
								</svg>
							</span>
							<span class="sem-title font-mono">{sem.semesterTitle}</span>
							<span class="sem-course-count font-mono">({sem.courses.length} courses)</span>
						</div>
						<div class="sem-summary-right">
							<span class="sem-credits-badge font-mono">{sem.totalCredit.toFixed(1)} Credits</span>
							<span class:list={['sem-sgpa-badge font-mono', { perfect: sem.sgpa === 4.0 }]}>
								SGPA {sem.sgpa.toFixed(2)}
							</span>
						</div>
					</summary>

					<div class="semester-content">
						<div class="courses-table-container">
							<table class="courses-table font-mono">
								<thead>
									<tr>
										<th class="th-code">Code</th>
										<th class="th-title">Course Title</th>
										<th class="th-category">Domain</th>
										<th class="th-type">Type</th>
										<th class="th-credit">Credit</th>
										<th class="th-grade">Grade</th>
										<th class="th-points">Point</th>
									</tr>
								</thead>
								<tbody>
									{sem.courses.map((course) => (
										<tr class="course-row" data-code={course.code.toLowerCase()} data-title={course.title.toLowerCase()} data-cat={course.category}>
											<td class="td-code">
												<span class="code-pill font-mono">{course.code}</span>
											</td>
											<td class="td-title">
												<span class="course-name">{course.title}</span>
												{course.type === 'project' && (
													<span class="project-tag">Capstone / Project</span>
												)}
											</td>
											<td class="td-category">
												<span class:list={['cat-tag', course.category]}>
													{course.categoryLabel}
												</span>
											</td>
											<td class="td-type">
												<span class:list={['type-tag', course.type]}>
													{course.type.toUpperCase()}
												</span>
											</td>
											<td class="td-credit font-mono">{course.credit.toFixed(2)}</td>
											<td class="td-grade">
												<span class:list={['grade-pill font-mono', { 'a-plus': course.grade === 'A+', 'a-regular': course.grade === 'A', 'other-grade': course.grade !== 'A+' && course.grade !== 'A' }]}>
													{course.grade}
												</span>
											</td>
											<td class="td-points font-mono">{course.gradePoint.toFixed(2)}</td>
										</tr>
									))}
								</tbody>
								<tfoot>
									<tr class="tfoot-row">
										<td colspan="4" class="tfoot-label font-mono">Semester Total & SGPA</td>
										<td class="tfoot-credit font-mono">{sem.totalCredit.toFixed(2)}</td>
										<td colspan="2" class="tfoot-sgpa font-mono">SGPA: {sem.sgpa.toFixed(2)} / 4.00</td>
									</tr>
								</tfoot>
							</table>
						</div>
					</div>
				</details>
			))}
		</div>
	</div>

	<!-- VIEW 2: Subject Clusters & Category Breakdown -->
	<div id="categories-view" class="view-panel hidden">
		<div class="categories-grid">
			{stats.categoryBreakdown.map((cat) => {
				const catCourses = semesters.flatMap((s) =>
					s.courses.filter((c) => c.category === cat.category).map((c) => ({ ...c, semNum: s.semesterNumber }))
				);
				return (
					<div class="category-block edu-slot">
						<div class="category-header">
							<div class="cat-title-group">
								<span class="cat-indicator"></span>
								<h3 class="cat-name">{cat.label}</h3>
							</div>
							<div class="cat-metrics font-mono">
								<span class="cat-credit-badge">{cat.totalCredits.toFixed(1)} Credits</span>
								<span class="cat-gpa-badge font-mono">Avg {cat.averageGradePoint.toFixed(2)}</span>
							</div>
						</div>
						<p class="cat-description">{cat.description}</p>
						<div class="cat-course-list">
							{catCourses.map((c) => (
								<div class="cat-course-item">
									<div class="cat-course-left">
										<span class="cat-code font-mono">{c.code}</span>
										<span class="cat-title">{c.title}</span>
									</div>
									<div class="cat-course-right">
										<span class="cat-sem-tag font-mono">Sem {c.semNum}</span>
										<span class:list={['grade-pill small font-mono', { 'a-plus': c.grade === 'A+', 'a-regular': c.grade === 'A' }]}>
											{c.grade}
										</span>
									</div>
								</div>
							))}
						</div>
					</div>
				);
			})}
		</div>
	</div>

	<!-- VIEW 3: UGC Grading Scale Reference -->
	<div id="ugc-scale-view" class="view-panel hidden">
		<div class="ugc-block edu-slot">
			<div class="ugc-header">
				<h3 class="ugc-title">University Grants Commission (UGC) Uniform Grading System</h3>
				<p class="ugc-sub">
					Standardized 4.00 Grade Point Average (GPA) grading system implemented across higher academic institutions in Bangladesh.
				</p>
			</div>

			<div class="ugc-table-container">
				<table class="ugc-table font-mono">
					<thead>
						<tr>
							<th>Numerical Marks (%)</th>
							<th>Letter Grade</th>
							<th>Grade Point (GP)</th>
							<th>Qualitative Remarks</th>
						</tr>
					</thead>
					<tbody>
						{ugcGradingSystem.map((scale) => (
							<tr class:list={[{ 'highlight-scale': scale.grade === 'A+' || scale.grade === 'A' }]}>
								<td class="ugc-marks font-mono">{scale.marksRange}</td>
								<td class="ugc-grade">
									<span class:list={['grade-pill font-mono', { 'a-plus': scale.grade === 'A+', 'a-regular': scale.grade === 'A' }]}>
										{scale.grade}
									</span>
								</td>
								<td class="ugc-gp font-mono">{scale.gradePoint.toFixed(2)}</td>
								<td class="ugc-remarks">{scale.remarks}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<!-- Search Results Feedback (Hidden by default) -->
	<div id="search-no-results" class="no-results-box font-mono hidden">
		<p>No matching courses found for query. Try searching by course code (e.g. <code>CSE311</code>) or title.</p>
	</div>
</div>

<script>
	function initTranscript() {
		// View Switching
		const tabs = document.querySelectorAll<HTMLButtonElement>('.view-tab');
		const panels = {
			semesters: document.getElementById('semesters-view'),
			categories: document.getElementById('categories-view'),
			'ugc-scale': document.getElementById('ugc-scale-view')
		};

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const targetView = tab.getAttribute('data-view');
				if (!targetView) return;

				tabs.forEach((t) => {
					t.classList.remove('active', 'is-active');
				});
				tab.classList.add('active', 'is-active');

				Object.entries(panels).forEach(([key, panel]) => {
					if (panel) {
						if (key === targetView) {
							panel.classList.remove('hidden');
							panel.classList.add('active');
						} else {
							panel.classList.add('hidden');
							panel.classList.remove('active');
						}
					}
				});
			});
		});

		// Expand / Collapse All
		const toggleBtn = document.getElementById('toggle-expand-all');
		const btnText = document.getElementById('expand-btn-text');
		const accordions = document.querySelectorAll<HTMLDetailsElement>('.semester-accordion');
		let allExpanded = false;

		toggleBtn?.addEventListener('click', () => {
			allExpanded = !allExpanded;
			accordions.forEach((acc) => {
				acc.open = allExpanded;
			});
			if (btnText) {
				btnText.textContent = allExpanded ? 'Collapse all' : 'Expand all';
			}
		});

		// Live Course Search Filtering
		const searchInput = document.getElementById('course-search-input') as HTMLInputElement | null;
		const clearBtn = document.getElementById('clear-search-btn');
		const noResults = document.getElementById('search-no-results');

		const filterCourses = (term: string) => {
			const cleanTerm = term.trim().toLowerCase();
			let visibleCount = 0;

			if (clearBtn) {
				if (cleanTerm.length > 0) {
					clearBtn.classList.remove('hidden');
				} else {
					clearBtn.classList.add('hidden');
				}
			}

			// If user searches, switch to semester view automatically
			if (cleanTerm.length > 0 && panels.semesters?.classList.contains('hidden')) {
				document.getElementById('btn-view-semesters')?.click();
			}

			accordions.forEach((acc) => {
				const rows = acc.querySelectorAll<HTMLTableRowElement>('.course-row');
				let semHasMatch = false;

				rows.forEach((row) => {
					const code = row.getAttribute('data-code') || '';
					const title = row.getAttribute('data-title') || '';
					const matches = cleanTerm === '' || code.includes(cleanTerm) || title.includes(cleanTerm);

					if (matches) {
						row.style.display = '';
						semHasMatch = true;
						visibleCount++;
					} else {
						row.style.display = 'none';
					}
				});

				if (cleanTerm !== '') {
					if (semHasMatch) {
						acc.style.display = '';
						acc.open = true;
					} else {
						acc.style.display = 'none';
					}
				} else {
					acc.style.display = '';
				}
			});

			if (noResults) {
				if (cleanTerm !== '' && visibleCount === 0) {
					noResults.classList.remove('hidden');
				} else {
					noResults.classList.add('hidden');
				}
			}
		};

		searchInput?.addEventListener('input', (e) => {
			filterCourses((e.target as HTMLInputElement).value);
		});

		clearBtn?.addEventListener('click', () => {
			if (searchInput) {
				searchInput.value = '';
				filterCourses('');
				searchInput.focus();
			}
		});
	}

	// Initialize on page load and on Astro navigation
	initTranscript();
	document.addEventListener('astro:page-load', initTranscript);
</script>
