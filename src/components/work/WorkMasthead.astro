---
interface Props {
	workCount: number;
}

const { workCount } = Astro.props;
---

<section class="masthead">
	<div class="masthead-kicker">
		<p class="label font-mono">Work Archive</p>
		<span class="masthead-count font-mono">{workCount} Case Studies</span>
	</div>
	<h1 class="page-title font-sans">Selected Work & Case Studies</h1>
	<p class="lead">Production SaaS, enterprise architectures, mobile apps, and distributed systems engineering.</p>
</section>

<style>
	.masthead {
		padding: 0.5rem 0 2rem;
		border-bottom: 1px solid var(--card-border);
		margin-bottom: 1.5rem;
	}

	.masthead-kicker {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	.masthead-count {
		font-size: var(--type-meta);
		color: var(--text-muted);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.page-title {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.1;
		color: var(--text-main);
	}

	.lead {
		margin: 0.75rem 0 0;
		font-size: clamp(1rem, 2vw, 1.125rem);
		line-height: 1.55;
		color: var(--text-muted);
		max-width: 44rem;
		text-wrap: pretty;
	}

	@media (max-width: 640px) {
		.masthead {
			padding: 0.25rem 0 1.5rem;
			margin-bottom: 1.25rem;
		}

		.page-title {
			font-size: 1.75rem;
		}

		.lead {
			font-size: 0.95rem;
		}
	}
</style>
