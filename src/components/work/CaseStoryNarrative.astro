---
import StrategyzerValueCanvas from './StrategyzerValueCanvas.astro';
import MermaidDiagram from '../ui/MermaidDiagram.astro';
import { tradeflowVpcData } from '../../data/tradeflowVpcData';

interface ValueItem {
	painTitle: string;
	painDescription: string;
	gainTitle: string;
	gainDescription: string;
}

interface ValueProposition {
	targetCustomer?: string;
	items: ValueItem[];
}

interface Diagram {
	id: string;
	label: string;
	mermaid: string;
}

interface Platform {
	scope: string;
	who: string;
	does: string;
}

interface Module {
	name: string;
	summary: string;
	kernels?: string;
}

interface StackReason {
	tech: string;
	reason: string;
}

interface CaseStory {
	thesis?: string;
	productHeadline: string;
	productBullets: string[];
	diagrams: Diagram[];
	platforms: Platform[];
	modules: Module[];
	stackRationale: StackReason[];
	showVpcContrastCards?: boolean;
}

interface Props {
	caseStory: CaseStory;
	valueProposition?: ValueProposition;
	isTradeflowVpc?: boolean;
}

const { caseStory, valueProposition, isTradeflowVpc = false } = Astro.props;
const showContrast = caseStory.showVpcContrastCards && valueProposition?.items?.length;
---

{valueProposition && valueProposition.items.length > 0 && (
	<section id="value-canvas" class="story-section w-full max-w-full">
		<div class="story-head">
			<h2 class="label font-mono">Value proposition</h2>
			{valueProposition.targetCustomer && (
				<span class="story-badge font-mono">Customer: {valueProposition.targetCustomer}</span>
			)}
		</div>
		{caseStory.thesis && <p class="story-thesis">{caseStory.thesis}</p>}

		{isTradeflowVpc && (
			<StrategyzerValueCanvas
				labels={tradeflowVpcData.labels}
				productsAndServices={tradeflowVpcData.productsAndServices}
				gainCreators={tradeflowVpcData.gainCreators}
				painRelievers={tradeflowVpcData.painRelievers}
				customerJobs={tradeflowVpcData.customerJobs}
				gains={tradeflowVpcData.gains}
				pains={tradeflowVpcData.pains}
			/>
		)}

		{showContrast && (
			<div class="contrast-mini">
				{valueProposition.items.slice(0, 3).map((item) => (
					<div class="contrast-mini-card">
						<p class="contrast-mini-pain"><strong>Before:</strong> {item.painTitle}</p>
						<p class="contrast-mini-gain"><strong>After:</strong> {item.gainTitle}</p>
					</div>
				))}
			</div>
		)}
	</section>
)}

<section id="product-story" class="story-section w-full max-w-full">
	<div class="story-head">
		<h2 class="label font-mono">What the product does</h2>
	</div>
	<p class="story-lead">{caseStory.productHeadline}</p>
	{caseStory.productBullets.length > 0 && (
		<ul class="story-bullets">
			{caseStory.productBullets.map((line) => (
				<li>{line}</li>
			))}
		</ul>
	)}
	{caseStory.diagrams
		.filter((d) => d.id === 'architecture')
		.map((d) => (
			<MermaidDiagram code={d.mermaid} caption="Platform architecture" />
		))}
</section>

{caseStory.platforms.length > 0 && (
	<section id="login-platforms" class="story-section w-full max-w-full">
		<div class="story-head">
			<h2 class="label font-mono">Login platforms (four surfaces)</h2>
			<span class="story-badge font-mono">Not job titles — different doors, one parent books</span>
		</div>
		<div class="story-table-wrap">
			<table class="story-table">
				<thead>
					<tr>
						<th scope="col">Scope</th>
						<th scope="col">Who</th>
						<th scope="col">Does</th>
					</tr>
				</thead>
				<tbody>
					{caseStory.platforms.map((row) => (
						<tr>
							<td><code>{row.scope}</code></td>
							<td>{row.who}</td>
							<td>{row.does}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
		{caseStory.diagrams
			.filter((d) => d.id === 'scopes')
			.map((d) => (
				<MermaidDiagram code={d.mermaid} caption="How surfaces connect" />
			))}
	</section>
)}

{caseStory.modules.length > 0 && (
	<section id="sell-modules" class="story-section w-full max-w-full">
		<div class="story-head">
			<h2 class="label font-mono">Sell modules</h2>
			<span class="story-badge font-mono">{caseStory.modules.length} tenant packs on four kernels</span>
		</div>
		<div class="story-table-wrap">
			<table class="story-table">
				<thead>
					<tr>
						<th scope="col">Module</th>
						<th scope="col">Job</th>
						<th scope="col">Kernels</th>
					</tr>
				</thead>
				<tbody>
					{caseStory.modules.map((row) => (
						<tr>
							<td><strong>{row.name}</strong></td>
							<td>{row.summary}</td>
							<td>{row.kernels ?? '—'}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
		{caseStory.diagrams
			.filter((d) => d.id === 'modules')
			.map((d) => (
				<MermaidDiagram code={d.mermaid} caption="Modules plug into kernels" />
			))}
	</section>
)}

{caseStory.stackRationale.length > 0 && (
	<section id="stack-rationale" class="story-section w-full max-w-full">
		<div class="story-head">
			<h2 class="label font-mono">Why this stack</h2>
			<span class="story-badge font-mono">Choices tied to product constraints</span>
		</div>
		<ul class="stack-why-list">
			{caseStory.stackRationale.map((row) => (
				<li>
					<span class="stack-why-tech font-mono">{row.tech}</span>
					<span class="stack-why-reason">{row.reason}</span>
				</li>
			))}
		</ul>
	</section>
)}

<style>
	.story-section {
		margin-top: 2rem;
		scroll-margin-top: 5rem;
		width: 100%;
		box-sizing: border-box;
	}

	.story-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 0.75rem;
		margin-bottom: 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--card-border);
	}

	.story-head .label {
		margin: 0;
		font-size: clamp(1.05rem, 2.5vw, 1.2rem);
		font-weight: 800;
		color: var(--text-main);
	}

	.story-badge {
		font-size: 0.72rem;
		color: var(--text-muted);
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		padding: 0.2rem 0.55rem;
		border-radius: var(--radius-sm);
	}

	.story-thesis {
		margin: 0 0 1rem;
		font-size: 1.05rem;
		line-height: 1.55;
		color: var(--text-main);
		font-weight: 600;
	}

	.story-lead {
		margin: 0 0 0.85rem;
		font-size: 1.02rem;
		line-height: 1.65;
		color: var(--text-main);
	}

	.story-bullets {
		margin: 0 0 1rem;
		padding-left: 1.2rem;
		line-height: 1.6;
	}

	.story-bullets li {
		margin: 0.35rem 0;
	}

	.story-table-wrap {
		width: 100%;
		overflow-x: auto;
		margin-bottom: 0.5rem;
	}

	.story-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9rem;
		border: 1px solid var(--card-border);
		border-radius: var(--radius-sm);
		overflow: hidden;
	}

	.story-table th,
	.story-table td {
		padding: 0.6rem 0.75rem;
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid var(--card-border);
	}

	.story-table th {
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--accent);
		background: var(--card-bg-elevated);
	}

	.story-table td {
		background: var(--card-bg);
	}

	.story-table code {
		font-size: 0.85em;
	}

	.stack-why-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.stack-why-list li {
		display: grid;
		grid-template-columns: minmax(7rem, 11rem) 1fr;
		gap: 0.75rem 1rem;
		padding: 0.75rem 1rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: var(--radius-md);
		align-items: start;
	}

	.stack-why-tech {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--accent);
	}

	.stack-why-reason {
		font-size: 0.92rem;
		line-height: 1.55;
		color: var(--text-main);
	}

	.contrast-mini {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 0.65rem;
		margin-top: 1.25rem;
	}

	.contrast-mini-card {
		padding: 0.75rem 0.9rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: var(--radius-md);
		font-size: 0.88rem;
		line-height: 1.5;
	}

	.contrast-mini-pain {
		margin: 0 0 0.5rem;
		color: var(--text-muted);
	}

	.contrast-mini-gain {
		margin: 0;
		color: var(--text-main);
	}

	@media (max-width: 640px) {
		.stack-why-list li {
			grid-template-columns: 1fr;
		}
	}
</style>
