---
interface Metric {
	label: string;
	value: string;
	detail?: string;
}

interface Props {
	metrics?: Metric[];
}

const { metrics = [] } = Astro.props;
---

{metrics.length > 0 && (
	<section id="impact-metrics" class="metrics-bar w-full max-w-full" aria-label="Executive Impact Metrics">
		<div class="metrics-grid">
			{metrics.map((item) => (
				<div class="metric-card">
					<span class="metric-value font-mono">{item.value}</span>
					<span class="metric-label font-mono">{item.label}</span>
					{item.detail && <p class="metric-detail">{item.detail}</p>}
				</div>
			))}
		</div>
	</section>
)}

<style>
	.metrics-bar {
		margin-top: 1.5rem;
		margin-bottom: 0.5rem;
		padding: 1.25rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: var(--radius-lg);
		position: relative;
		overflow: hidden;
		box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
		box-sizing: border-box;
	}

	.metrics-bar::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: linear-gradient(90deg, transparent, var(--accent), transparent);
		opacity: 0.8;
	}

	.metrics-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 1.25rem 1.5rem;
		width: 100%;
		box-sizing: border-box;
	}

	.metric-card {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
		overflow-wrap: break-word;
	}

	.metric-value {
		font-size: clamp(1.35rem, 4vw, 1.85rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: var(--accent);
		overflow-wrap: break-word;
		word-break: break-word;
	}

	.metric-label {
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.35;
	}

	.metric-detail {
		margin: 0.15rem 0 0;
		font-size: 0.82rem;
		line-height: 1.45;
		color: var(--text-muted);
		overflow-wrap: break-word;
	}

	@media (max-width: 768px) {
		.metrics-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.85rem;
		}

		.metrics-bar {
			padding: 1rem 0.85rem;
			border-radius: var(--radius-md);
		}

		.metric-value {
			font-size: 1.45rem;
		}

		.metric-label {
			font-size: 0.68rem;
		}

		.metric-detail {
			font-size: 0.78rem;
		}
	}

	@media (max-width: 440px) {
		.metrics-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.75rem 0.65rem;
		}

		.metrics-bar {
			padding: 0.85rem 0.75rem;
			margin-top: 1rem;
		}

		.metric-card {
			padding: 0.5rem 0.35rem;
			background: var(--card-bg-elevated);
			border-radius: var(--radius-sm);
			border: 1px solid var(--card-border);
		}

		.metric-value {
			font-size: 1.28rem;
		}

		.metric-label {
			font-size: 0.65rem;
			line-height: 1.25;
		}

		.metric-detail {
			font-size: 0.74rem;
			line-height: 1.35;
		}
	}
</style>
