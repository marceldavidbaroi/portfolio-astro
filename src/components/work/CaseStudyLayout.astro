---
export interface CaseChapter {
	id: string;
	label: string;
}

interface Props {
	chapters: CaseChapter[];
}

const { chapters } = Astro.props;
---

<div class="case-study">
	{chapters.length > 1 && (
		<nav class="case-study__nav-mobile case-chapter-nav" aria-label="Case study chapters">
			<div class="case-chapter-nav__track">
				{chapters.map((ch) => (
					<a href={`#${ch.id}`} class="case-chapter-nav__pill" data-chapter-id={ch.id}>
						{ch.label}
					</a>
				))}
			</div>
		</nav>
	)}

	<div class="case-study__grid">
		{chapters.length > 1 && (
			<nav class="case-study__nav case-study__nav-desktop case-chapter-nav" aria-label="Case study chapters">
				<ul class="case-chapter-nav__list">
					{chapters.map((ch) => (
						<li>
							<a href={`#${ch.id}`} class="case-chapter-nav__link" data-chapter-id={ch.id}>
								{ch.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		)}

		<div class="case-study__main">
			<slot />
		</div>
	</div>
</div>

<script>
	function setupChapterNavSpy() {
		const links = document.querySelectorAll<HTMLAnchorElement>('[data-chapter-id]');
		if (!links.length) return;

		const targets = Array.from(links)
			.map((link) => {
				const id = link.getAttribute('data-chapter-id');
				const el = id ? document.getElementById(id) : null;
				return el ? { link, el } : null;
			})
			.filter((x): x is { link: HTMLAnchorElement; el: HTMLElement } => Boolean(x));

		if (!targets.length) return;

		const setActive = (id: string) => {
			links.forEach((link) => {
				const match = link.getAttribute('data-chapter-id') === id;
				link.classList.toggle('is-active', match);
			});
		};

		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries
					.filter((e) => e.isIntersecting)
					.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
				if (visible?.target?.id) setActive(visible.target.id);
			},
			{ rootMargin: '-20% 0px -55% 0px', threshold: [0, 0.1, 0.25] }
		);

		targets.forEach(({ el }) => observer.observe(el));

		links.forEach((link) => {
			link.addEventListener('click', (e) => {
				const id = link.getAttribute('data-chapter-id');
				const el = id ? document.getElementById(id) : null;
				if (!el) return;
				e.preventDefault();
				const top = el.getBoundingClientRect().top + window.scrollY - 88;
				window.scrollTo({ top, behavior: 'smooth' });
			});
		});
	}

	setupChapterNavSpy();
	document.addEventListener('astro:page-load', setupChapterNavSpy);
</script>
