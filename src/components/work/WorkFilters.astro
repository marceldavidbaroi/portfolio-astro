---
interface Tab {
	id: string;
	label: string;
	count: number;
}

interface StackLink {
	label: string;
	query: string;
}

interface Props {
	tabs: Tab[];
	stackLinks: StackLink[];
	workCount: number;
}

const { tabs, stackLinks, workCount } = Astro.props;
---

<div class="filters" id="work-filters">
	<div class="filters-main">
		<div class="tabs-scroll-container">
			<div class="tabs" role="tablist" aria-label="Project categories">
				{tabs.map((tab, i) => (
					<button
						class:list={['tab', { active: i === 0 }]}
						data-category={tab.id}
						role="tab"
						aria-selected={i === 0 ? 'true' : 'false'}
						type="button"
					>
						<span class="tab-label">{tab.label}</span>
						<span class="tab-count font-mono">{tab.count}</span>
					</button>
				))}
			</div>
		</div>
		<div class="search-wrap">
			<label for="work-search" class="sr-only">Search work by stack or title</label>
			<svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="11" cy="11" r="8"></circle>
				<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
			</svg>
			<input
				type="search"
				id="work-search"
				class="search font-sans"
				placeholder="Filter by stack or keyword…"
				autocomplete="off"
				spellcheck="false"
			/>
		</div>
	</div>

	<div class="stack-bar-wrap">
		<div class="stack-scroll-track" id="stack-links">
			<span class="stack-guide font-mono">Quick stack:</span>
			{stackLinks.map((link) => (
				<button type="button" class="stack-chip font-mono" data-tech-query={link.query}>
					{link.label}
				</button>
			))}
			<button type="button" class="stack-chip is-reset font-mono" id="filter-reset">Reset</button>
		</div>
	</div>

	<div class="status-line font-mono" id="filter-status" hidden>
		<span id="results-count">Showing {workCount} of {workCount}</span>
		<button type="button" class="status-clear-btn" id="status-clear">Clear all filters ✕</button>
	</div>
</div>

<script>
	const searchInput = document.getElementById('work-search') as HTMLInputElement | null;
	const status = document.getElementById('filter-status');
	const resultsCount = document.getElementById('results-count');
	const empty = document.getElementById('work-empty');
	const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
	const stackBtns = document.querySelectorAll<HTMLButtonElement>('[data-tech-query]');
	const items = document.querySelectorAll<HTMLAnchorElement>('.catalog-item');
	const focusList = document.getElementById('focus-list');
	const focusSection = document.querySelector<HTMLElement>('.focus-section');
	const total = items.length;

	let category = 'all';
	let query = '';

	function apply() {
		const q = query.trim().toLowerCase();
		let visible = 0;
		items.forEach((el) => {
			const cats = (el.dataset.categories || '').split(' ');
			const hay = (el.dataset.searchContent || '').toLowerCase();
			const matchCat = category === 'all' || cats.includes(category);
			const matchQ = !q || hay.includes(q);
			const show = matchCat && matchQ;
			el.hidden = !show;
			if (show) visible++;
		});

		const filtered = category !== 'all' || q.length > 0;
		if (status) status.hidden = !filtered;
		if (resultsCount) resultsCount.textContent = `Showing ${visible} of ${total}`;
		if (empty) empty.hidden = visible !== 0;

		const focusItems = focusList?.querySelectorAll<HTMLAnchorElement>('.catalog-item') ?? [];
		const anyFocusVisible = Array.from(focusItems).some((el) => !el.hidden);
		if (focusSection) focusSection.hidden = focusItems.length > 0 && !anyFocusVisible;

		stackBtns.forEach((btn) => {
			btn.classList.toggle('is-on', Boolean(btn.dataset.techQuery) && q === (btn.dataset.techQuery || ''));
		});
	}

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			tabs.forEach((t) => {
				t.classList.toggle('active', t === tab);
				t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
			});
			category = tab.dataset.category || 'all';
			apply();
		});
	});

	searchInput?.addEventListener('input', () => {
		query = searchInput.value;
		apply();
	});

	stackBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			const tech = btn.dataset.techQuery || '';
			if (!searchInput) return;
			if (query.toLowerCase() === tech) {
				searchInput.value = '';
				query = '';
			} else {
				searchInput.value = tech;
				query = tech;
			}
			apply();
		});
	});

	function resetAll() {
		category = 'all';
		query = '';
		if (searchInput) searchInput.value = '';
		tabs.forEach((t) => {
			const on = t.dataset.category === 'all';
			t.classList.toggle('active', on);
			t.setAttribute('aria-selected', on ? 'true' : 'false');
		});
		apply();
	}

	document.getElementById('filter-reset')?.addEventListener('click', resetAll);
	document.getElementById('status-clear')?.addEventListener('click', resetAll);
	document.getElementById('empty-clear')?.addEventListener('click', resetAll);
</script>

<style>
	.filters {
		position: static;
		padding: 0.6rem 0 1rem;
		margin: 0 0 1.5rem;
		background: transparent;
		border-bottom: 1px solid rgba(243, 186, 107, 0.12);
	}

	.filters-main {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
	}

	.tabs-scroll-container {
		display: flex;
		align-items: center;
		overflow-x: auto;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
		padding-bottom: 2px;
		flex: 1 1 auto;
		min-width: 0;
	}

	.tabs-scroll-container::-webkit-scrollbar {
		display: none;
	}

	.tabs {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-shrink: 0;
	}

	.tab {
		appearance: none;
		border: 1px solid transparent;
		background: transparent;
		padding: 0.35rem 0.75rem;
		margin: 0;
		font: inherit;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--text-muted);
		cursor: pointer;
		border-radius: var(--radius-full);
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		white-space: nowrap;
		transition: all var(--dur-fast) ease;
	}

	.tab:hover {
		color: var(--text-main);
		background: rgba(243, 186, 107, 0.06);
	}

	.tab.active {
		color: var(--accent);
		background: rgba(243, 186, 107, 0.12);
		border-color: rgba(243, 186, 107, 0.28);
		font-weight: 600;
	}

	.tab-count {
		font-size: 0.7rem;
		padding: 0.05rem 0.35rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.05);
		color: inherit;
		opacity: 0.85;
	}

	.tab.active .tab-count {
		background: rgba(243, 186, 107, 0.2);
		opacity: 1;
	}

	.search-wrap {
		position: relative;
		display: flex;
		align-items: center;
		min-width: 13rem;
		max-width: 17rem;
		flex-shrink: 0;
	}

	.search-icon {
		position: absolute;
		left: 0.65rem;
		color: var(--text-muted);
		pointer-events: none;
		opacity: 0.65;
		transition: color var(--dur-fast) ease, opacity var(--dur-fast) ease;
	}

	.search {
		width: 100%;
		border: 1px solid rgba(243, 186, 107, 0.14);
		border-radius: var(--radius-full);
		background: rgba(255, 255, 255, 0.03);
		padding: 0.38rem 0.85rem 0.38rem 2rem;
		font-size: 0.84rem;
		color: var(--text-main);
		outline: none;
		transition: all var(--dur-fast) ease;
	}

	.search::placeholder {
		color: var(--text-muted);
		opacity: 0.7;
	}

	.search:focus {
		border-color: var(--accent);
		background: rgba(255, 255, 255, 0.06);
		box-shadow: 0 0 0 3px rgba(243, 186, 107, 0.12);
	}

	.search-wrap:focus-within .search-icon {
		color: var(--accent);
		opacity: 1;
	}

	/* Stack filter chips */
	.stack-bar-wrap {
		margin-top: 0.65rem;
		display: flex;
		align-items: center;
		overflow-x: auto;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
	}

	.stack-bar-wrap::-webkit-scrollbar {
		display: none;
	}

	.stack-scroll-track {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex-wrap: nowrap;
		white-space: nowrap;
		padding-bottom: 2px;
	}

	.stack-guide {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-muted);
		opacity: 0.6;
		margin-right: 0.2rem;
		user-select: none;
	}

	.stack-chip {
		appearance: none;
		border: 1px solid rgba(243, 186, 107, 0.1);
		background: rgba(255, 255, 255, 0.02);
		padding: 0.2rem 0.55rem;
		margin: 0;
		font: inherit;
		font-size: 0.73rem;
		color: var(--text-muted);
		cursor: pointer;
		border-radius: var(--radius-sm);
		transition: all var(--dur-fast) ease;
		letter-spacing: 0.02em;
	}

	.stack-chip:hover {
		color: var(--text-main);
		background: rgba(255, 255, 255, 0.06);
		border-color: rgba(243, 186, 107, 0.25);
	}

	.stack-chip.is-on {
		color: #0b0c10;
		background: var(--accent);
		border-color: var(--accent);
		font-weight: 700;
	}

	.stack-chip.is-reset {
		border-style: dashed;
		border-color: rgba(243, 186, 107, 0.2);
		opacity: 0.75;
	}

	.stack-chip.is-reset:hover {
		opacity: 1;
		border-style: solid;
		color: var(--accent);
	}

	/* Status line */
	.status-line {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin: 0.65rem 0 0;
		padding: 0.35rem 0.65rem;
		background: rgba(243, 186, 107, 0.06);
		border: 1px dashed rgba(243, 186, 107, 0.2);
		border-radius: var(--radius-sm);
		font-size: 0.75rem;
		letter-spacing: 0.02em;
		color: var(--text-main);
	}

	.status-clear-btn {
		appearance: none;
		border: 0;
		background: none;
		padding: 0;
		font: inherit;
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--accent);
		cursor: pointer;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.status-clear-btn:hover {
		text-decoration: underline;
	}

	.status-line[hidden] {
		display: none !important;
	}

	@media (max-width: 768px) {
		.filters {
			padding: 0.5rem 0 0.75rem;
			margin-bottom: 1.25rem;
		}

		.filters-main {
			flex-direction: column;
			align-items: stretch;
			gap: 0.65rem;
		}

		.search-wrap {
			min-width: 100%;
			max-width: 100%;
		}

		.search {
			padding: 0.45rem 0.85rem 0.45rem 2.1rem;
			font-size: 0.88rem;
		}

		.tabs {
			gap: 0.4rem;
		}

		.tab {
			padding: 0.3rem 0.65rem;
			font-size: 0.82rem;
		}

		.stack-bar-wrap {
			margin-top: 0.5rem;
		}

		.stack-chip {
			padding: 0.22rem 0.5rem;
			font-size: 0.72rem;
		}
	}
</style>
