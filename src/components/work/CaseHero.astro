---
interface Links {
	liveDemo?: string;
	parentPlatform?: string;
	github?: string;
	githubFrontend?: string;
	githubBackend?: string;
	docs?: string;
}

interface Props {
	title: string;
	chip?: string;
	status?: string;
	classLabel: string;
	role?: string;
	timeline?: string;
	description?: string;
	links?: Links;
	hasActions: boolean;
	live: boolean;
	parent: boolean;
	github: boolean;
	ghFront: boolean;
	ghBack: boolean;
	docs: boolean;
	heroImage?: string | null;
	isPhone: boolean;
}

const {
	title,
	chip,
	status,
	classLabel,
	role,
	timeline,
	description,
	links,
	hasActions,
	live,
	parent,
	github,
	ghFront,
	ghBack,
	docs,
	heroImage,
	isPhone
} = Astro.props;

const showActions = hasActions;
---

<p class="kicker font-mono">
	{chip}
	{status && <> · {status}</>}
	<span> · {classLabel}</span>
</p>
<h1 class="case-title font-sans">{title}</h1>
<p class="case-meta">
	{role && <span>{role}</span>}
	{timeline && <span>{timeline}</span>}
</p>
{description && <p class="xyz">{description}</p>}

{showActions && (
	<div class="hero-actions">
		{live && (
			<a class="btn-solid font-mono" href={links!.liveDemo} target="_blank" rel="noopener noreferrer">Live</a>
		)}
		{parent && (
			<a class="btn-ghost font-mono" href={links!.parentPlatform} target="_blank" rel="noopener noreferrer">Parent</a>
		)}
		{github && (
			<a class="text-link font-mono" href={links!.github} target="_blank" rel="noopener noreferrer">Repository</a>
		)}
		{ghFront && (
			<a class="text-link font-mono" href={links!.githubFrontend} target="_blank" rel="noopener noreferrer">Frontend</a>
		)}
		{ghBack && (
			<a class="text-link font-mono" href={links!.githubBackend} target="_blank" rel="noopener noreferrer">Backend</a>
		)}
		{docs && (
			<a class="text-link font-mono" href={links!.docs} target="_blank" rel="noopener noreferrer">Docs</a>
		)}
	</div>
)}

{heroImage && (
	<div class:list={['hero-well', { 'is-phone': isPhone }]}>
		<img src={heroImage} alt={`${title} interface`} width={isPhone ? 400 : 1280} height={isPhone ? 720 : 800} loading="eager" />
	</div>
)}
