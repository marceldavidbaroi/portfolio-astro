---
import ShotFan from './ShotFan.astro';

interface Metric {
	value: string;
	label: string;
	detail?: string;
}

interface Links {
	liveDemo?: string;
	parentPlatform?: string;
	github?: string;
	githubFrontend?: string;
	githubBackend?: string;
	docs?: string;
}

interface Props {
	title: string;
	chip?: string;
	status?: string;
	classLabel: string;
	role?: string;
	timeline?: string;
	description?: string;
	impactMetrics?: Metric[];
	links?: Links;
	hasActions: boolean;
	live: boolean;
	parent: boolean;
	github: boolean;
	ghFront: boolean;
	ghBack: boolean;
	docs: boolean;
	heroStill?: string | null;
	realImages: string[];
	isPhone: boolean;
}

const {
	title,
	chip,
	status,
	classLabel,
	role,
	timeline,
	description,
	impactMetrics,
	links,
	hasActions,
	live,
	parent,
	github,
	ghFront,
	ghBack,
	docs,
	heroStill,
	realImages,
	isPhone
} = Astro.props;
---

<p class="kicker font-mono">
	{chip}
	{status && <> · {status}</>}
	<span> · {classLabel}</span>
</p>
<h1 class="case-title">{title}</h1>
<p class="case-meta">
	{role && <span>{role}</span>}
	{timeline && <span>{timeline}</span>}
</p>
{description && <p class="xyz">{description}</p>}

{impactMetrics && impactMetrics.length > 0 && (
	<ul class="metric-row font-mono">
		{impactMetrics.map((m) => (
			<li>
				<b>{m.value}</b>
				<span>{m.label}</span>
			</li>
		))}
	</ul>
)}

{hasActions && (
	<div class="hero-actions">
		{live && (
			<a class="btn-solid font-mono" href={links!.liveDemo} target="_blank" rel="noopener noreferrer">Live</a>
		)}
		{parent && (
			<a class="btn-ghost font-mono" href={links!.parentPlatform} target="_blank" rel="noopener noreferrer">Parent</a>
		)}
		{github && (
			<a class="text-link font-mono" href={links!.github} target="_blank" rel="noopener noreferrer">Repository</a>
		)}
		{ghFront && (
			<a class="text-link font-mono" href={links!.githubFrontend} target="_blank" rel="noopener noreferrer">Frontend</a>
		)}
		{ghBack && (
			<a class="text-link font-mono" href={links!.githubBackend} target="_blank" rel="noopener noreferrer">Backend</a>
		)}
		{docs && (
			<a class="text-link font-mono" href={links!.docs} target="_blank" rel="noopener noreferrer">Docs</a>
		)}
	</div>
)}

{(heroStill || realImages.length > 0) && (
	<div class="hero-well">
		{isPhone ? (
			<ShotFan images={realImages} phone size="hero" />
		) : heroStill ? (
			<img src={heroStill} alt={`${title} interface`} width="1280" height="800" />
		) : (
			<ShotFan images={realImages} size="hero" />
		)}
	</div>
)}

<style>
	.case-title {
		margin: 0.45rem 0 0;
		font-size: clamp(1.85rem, 5vw, 3.1rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.08;
		color: var(--text-main);
	}

	.case-meta {
		margin: 0.55rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1rem;
		font-size: 1.02rem;
		font-weight: 500;
		color: var(--text-muted);
	}

	.xyz {
		margin: 0.85rem 0 0;
		font-size: var(--type-body);
		line-height: 1.55;
		color: var(--text-main);
		max-width: 42rem;
	}

	.metric-row {
		gap: 0.85rem 1.35rem;
		margin: 1.1rem 0 0;
		padding: 0.9rem 0 0;
		border-top: 1px solid rgba(95, 80, 56, 0.12);
	}

	.hero-actions {
		margin-top: 1rem;
	}

	.hero-well {
		margin: 1.75rem 0 0;
		background: var(--card-bg);
		border: 1px solid rgba(95, 80, 56, 0.12);
		overflow: hidden;
		display: flex;
		justify-content: center;
		padding: 1rem;
	}

	.hero-well img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		object-position: top center;
		background: var(--card-bg);
	}
</style>
