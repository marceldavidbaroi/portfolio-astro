---
import '../../styles/mermaid-diagram.css';
---

<section class="markdown-article w-full max-w-full">
	<slot />
</section>

<script>
	import { createMermaidFigure, paintMermaidDiagrams } from '../../lib/paintMermaidDiagrams';

	function mermaidCaptionFromCode(text: string): string | undefined {
		if (text.startsWith('erDiagram')) return 'Database';
		if (text.startsWith('sequenceDiagram')) return 'Sequence';
		if (text.startsWith('flowchart') || text.startsWith('graph')) return 'Diagram';
		if (text.startsWith('timeline')) return 'Timeline';
		if (text.startsWith('pie')) return 'Chart';
		return undefined;
	}

	function isMermaidBlock(text: string, el: Element): boolean {
		return (
			el.classList.contains('language-mermaid') ||
			el.parentElement?.classList.contains('language-mermaid') ||
			/^(flowchart|sequenceDiagram|erDiagram|classDiagram|stateDiagram|mindmap|timeline|pie|graph)\b/.test(text)
		);
	}

	async function enhanceMarkdownMermaidBlocks() {
		const codeBlocks = Array.from(document.querySelectorAll('.markdown-article pre, .markdown-article pre code'));

		for (const el of codeBlocks) {
			const text = el.textContent?.trim() || '';
			if (!isMermaidBlock(text, el)) continue;

			const pre = (el.tagName.toLowerCase() === 'pre' ? el : el.closest('pre')) as HTMLElement | null;
			if (!pre || pre.dataset.processed === 'true') continue;
			pre.dataset.processed = 'true';

			const caption = mermaidCaptionFromCode(text);
			const figure = createMermaidFigure(text, caption);
			pre.replaceWith(figure);
		}

		await paintMermaidDiagrams();
	}

	function runMarkdownEnhancements() {
		enhanceMarkdownMermaidBlocks().finally(() => {
			document.dispatchEvent(new CustomEvent('case-markdown-enhanced'));
		});
	}

	runMarkdownEnhancements();
	document.addEventListener('astro:page-load', runMarkdownEnhancements);
	document.addEventListener('case-markdown-enhanced', () => {
		document.querySelector('.deep-dive-section')?.classList.add('is-revealed');
	});
</script>
