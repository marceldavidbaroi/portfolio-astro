---
import type { ImageMetadata } from 'astro';

interface VisualAssets {
	heroMockup?: string;
	architectureDiagram?: string;
	databaseErd?: string;
	screenshots?: string[];
	benchmarkGraphic?: string;
}

interface Props {
	title: string;
	heroImage?: string | null;
	isPhone?: boolean;
	visualAssets?: VisualAssets;
	images?: string[];
}

const { title, heroImage, isPhone = false, visualAssets, images = [] } = Astro.props;

// Filter out dummy/placeholder images
const sanitize = (src?: string) => {
	if (!src) return null;
	if (src.includes('dummy') || src.includes('thumb-')) return null;
	return src;
};

const validHero = sanitize(heroImage) || sanitize(visualAssets?.heroMockup);
const validArch = sanitize(visualAssets?.architectureDiagram);
const validErd = sanitize(visualAssets?.databaseErd);
const validBenchmark = sanitize(visualAssets?.benchmarkGraphic);

const screenshotPool = [
	...(visualAssets?.screenshots || []),
	...(images || [])
].map(sanitize).filter((img): img is string => Boolean(img));

// Deduplicate screenshots and remove hero if already shown as hero
const galleryImages = Array.from(new Set(screenshotPool)).filter(
	(src) => src !== validHero
);

const hasVisuals = validHero || validArch || validErd || validBenchmark || galleryImages.length > 0;
---

{hasVisuals && (
	<section id="media-showcase" class="media-showcase w-full max-w-full">
		<div class="media-header">
			<span class="label font-mono">Visual Systems & Proof of Work</span>
			<span class="media-count font-mono">{galleryImages.length + (validHero ? 1 : 0)} Visual Assets</span>
		</div>

		{validHero && (
			<figure class:list={['hero-media-figure', { 'is-phone': isPhone }]}>
				<div class="hero-media-frame">
					<div class="browser-chrome" aria-hidden="true">
						<span class="dot"></span>
						<span class="dot"></span>
						<span class="dot"></span>
						<span class="address-bar font-mono">{title.toLowerCase().replace(/\s+/g, '-')} · system workbench</span>
					</div>
					<div class="img-wrapper">
						<img
							src={validHero}
							alt={`${title} primary interface preview`}
							width={isPhone ? 420 : 1280}
							height={isPhone ? 740 : 800}
							loading="eager"
							class="hero-media-img"
						/>
					</div>
				</div>
				<figcaption class="font-mono">
					<span class="caption-badge">Primary Interface</span>
					<span>Production environment UI and core interactive workflow</span>
				</figcaption>
			</figure>
		)}

		{(validArch || validErd || validBenchmark) && (
			<div class="arch-diagrams-grid">
				{validArch && (
					<figure class="diagram-figure">
						<div class="diagram-frame">
							<img src={validArch} alt={`${title} System Architecture Diagram`} loading="lazy" />
						</div>
						<figcaption class="font-mono">Architecture Blueprint</figcaption>
					</figure>
				)}
				{validErd && (
					<figure class="diagram-figure">
						<div class="diagram-frame">
							<img src={validErd} alt={`${title} Database Schema & ERD`} loading="lazy" />
						</div>
						<figcaption class="font-mono">Database Schema & Relational Model</figcaption>
					</figure>
				)}
				{validBenchmark && (
					<figure class="diagram-figure">
						<div class="diagram-frame">
							<img src={validBenchmark} alt={`${title} Performance Benchmarks`} loading="lazy" />
						</div>
						<figcaption class="font-mono">Performance & Query Optimization Metrics</figcaption>
					</figure>
				)}
			</div>
		)}

		{galleryImages.length > 0 && (
			<div class="gallery-section">
				<p class="gallery-subhead font-mono">Interface Gallery & Module Workbenches</p>
				<div class="gallery-grid">
					{galleryImages.map((src, idx) => (
						<figure class="gallery-item">
							<div class="gallery-frame">
								<img src={src} alt={`${title} interface preview ${idx + 1}`} loading="lazy" />
							</div>
							<figcaption class="font-mono">Workbench View {idx + 1}</figcaption>
						</figure>
					))}
				</div>
			</div>
		)}
	</section>
)}

<style>
	.media-showcase {
		margin-top: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		width: 100%;
		box-sizing: border-box;
	}

	.media-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid rgba(243, 186, 107, 0.12);
		width: 100%;
		box-sizing: border-box;
	}

	.media-count {
		font-size: var(--type-caption);
		color: var(--text-muted);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.hero-media-figure {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
	}

	.hero-media-frame {
		background: #11100f;
		border: 1px solid rgba(243, 186, 107, 0.18);
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.85);
		transition: border-color var(--dur-ui) ease, box-shadow var(--dur-ui) ease;
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
	}

	.hero-media-frame:hover {
		border-color: rgba(243, 186, 107, 0.35);
		box-shadow: 0 20px 48px -10px rgba(0, 0, 0, 0.95);
	}

	.browser-chrome {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.65rem 1rem;
		background: #191715;
		border-bottom: 1px solid rgba(243, 186, 107, 0.1);
		min-width: 0;
		overflow: hidden;
	}

	.browser-chrome .dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		flex-shrink: 0;
		background: rgba(243, 186, 107, 0.25);
	}

	.browser-chrome .dot:nth-child(1) {
		background: rgba(239, 68, 68, 0.55);
	}
	.browser-chrome .dot:nth-child(2) {
		background: rgba(234, 179, 8, 0.55);
	}
	.browser-chrome .dot:nth-child(3) {
		background: rgba(34, 197, 94, 0.55);
	}

	.address-bar {
		margin-left: 0.5rem;
		font-size: 0.72rem;
		color: var(--text-muted);
		letter-spacing: 0.02em;
		background: rgba(0, 0, 0, 0.25);
		padding: 0.15rem 0.65rem;
		border-radius: 4px;
		max-width: calc(100% - 60px);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.img-wrapper {
		width: 100%;
		max-width: 100%;
		overflow: hidden;
		background: var(--card-bg);
	}

	.hero-media-img {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
		max-height: 540px;
		object-fit: cover;
		object-position: top center;
	}

	.hero-media-figure.is-phone .hero-media-frame {
		max-width: 320px;
		margin: 0 auto;
	}

	.hero-media-figure.is-phone .hero-media-img {
		max-height: none;
		object-fit: contain;
	}

	figcaption {
		font-size: var(--type-caption);
		color: var(--text-muted);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}

	.caption-badge {
		background: rgba(243, 186, 107, 0.12);
		color: var(--accent);
		padding: 0.15rem 0.45rem;
		border-radius: 3px;
		border: 1px solid rgba(243, 186, 107, 0.2);
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-weight: 700;
		flex-shrink: 0;
	}

	.arch-diagrams-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.25rem;
		width: 100%;
		box-sizing: border-box;
	}

	.diagram-figure,
	.gallery-item {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
	}

	.diagram-frame,
	.gallery-frame {
		background: var(--card-bg);
		border: 1px solid rgba(243, 186, 107, 0.14);
		border-radius: var(--radius-md);
		overflow: hidden;
		aspect-ratio: 16 / 10;
		box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.6);
		transition: border-color var(--dur-fast) ease, transform var(--dur-fast) ease;
		width: 100%;
		box-sizing: border-box;
	}

	.diagram-frame:hover,
	.gallery-frame:hover {
		border-color: rgba(243, 186, 107, 0.3);
		transform: translateY(-2px);
	}

	.diagram-frame img,
	.gallery-frame img {
		display: block;
		width: 100%;
		height: 100%;
		max-width: 100%;
		object-fit: cover;
		object-position: top center;
	}

	.gallery-section {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		margin-top: 0.5rem;
		width: 100%;
		box-sizing: border-box;
	}

	.gallery-subhead {
		font-size: var(--type-meta);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
		font-weight: 600;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
		width: 100%;
		box-sizing: border-box;
	}

	@media (max-width: 640px) {
		.hero-media-frame {
			border-radius: var(--radius-md);
		}

		.arch-diagrams-grid,
		.gallery-grid {
			grid-template-columns: 1fr;
			gap: 0.85rem;
		}

		.browser-chrome {
			padding: 0.5rem 0.75rem;
		}
	}
</style>
