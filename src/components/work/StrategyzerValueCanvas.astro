---
export interface CanvasNote {
	title: string;
	note: string;
}

export interface Props {
	labels?: {
		valueProposition?: string;
		customerSegment?: string;
		title?: string;
	};
	productsAndServices?: CanvasNote[];
	gainCreators?: CanvasNote[];
	painRelievers?: CanvasNote[];
	customerJobs?: CanvasNote[];
	gains?: CanvasNote[];
	pains?: CanvasNote[];
}

const {
	labels = {},
	productsAndServices = [],
	gainCreators = [],
	painRelievers = [],
	customerJobs = [],
	gains = [],
	pains = []
} = Astro.props;
---

<div class="strategyzer-vpc w-full" id="strategyzerVpc">
	<div class="vpc-header">
		<div class="vpc-header-titles">
			<span class="vpc-canvas-badge font-mono">Strategyzer Canvas</span>
			<h3 class="vpc-canvas-title font-sans">{labels.title || 'The Value Proposition Canvas'}</h3>
		</div>
		<div class="vpc-name-row">
			<div class="vpc-name-field">
				<span class="vpc-name-label font-mono">Value Proposition</span>
				<span class="vpc-name-value font-sans">{labels.valueProposition || '—'}</span>
			</div>
			<div class="vpc-name-field">
				<span class="vpc-name-label font-mono">Customer Segment</span>
				<span class="vpc-name-value font-sans">{labels.customerSegment || '—'}</span>
			</div>
		</div>
	</div>

	<details class="vpc-disclosure">
		<summary class="vpc-disclosure-summary font-mono">Expand value canvas</summary>
		<div class="vpc-stage">
		<!-- Left: Value Map (Square) -->
		<div class="vpc-square" aria-label="Value Map: Products and Services, Gain Creators, Pain Relievers">
			<svg class="vpc-square-rules" viewBox="0 0 100 100" aria-hidden="true">
				<rect x="1.6" y="1.6" width="96.8" height="96.8" />
				<line x1="50" y1="50" x2="1.6" y2="1.6" />
				<line x1="50" y1="50" x2="1.6" y2="98.4" />
				<line x1="50" y1="50" x2="98.4" y2="50" />
			</svg>

			<!-- Products & Services (Left Wedge) -->
			<div class="vpc-wedge vpc-wedge--products">
				<div class="vpc-wedge-header font-mono">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
					<span>Products & Services</span>
				</div>
				<ul class="vpc-chips vpc-chips--start">
					{productsAndServices.map((item, i) => (
						<li class="vpc-chip-item" style={`--scatter: translate(${((i * 53) % 15) - 7}px, ${((i * 37) % 11) - 5}px) rotate(${((i * 29) % 11) - 5}deg);`}>
							<button type="button" class="vpc-pin" data-note-title={item.title} data-note-body={item.note} data-note-sector="Products & Services">
								<span class="vpc-pin-head" aria-hidden="true"></span>
								<span class="vpc-pin-title">{item.title}</span>
							</button>
						</li>
					))}
				</ul>
			</div>

			<!-- Gain Creators (Top Wedge) -->
			<div class="vpc-wedge vpc-wedge--gain-creators">
				<div class="vpc-wedge-header font-mono">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
					<span>Gain Creators</span>
				</div>
				<ul class="vpc-chips vpc-chips--center">
					{gainCreators.map((item, i) => (
						<li class="vpc-chip-item" style={`--scatter: translate(${((i * 47) % 17) - 8}px, ${((i * 31) % 11) - 5}px) rotate(${((i * 23) % 9) - 4}deg);`}>
							<button type="button" class="vpc-pin" data-note-title={item.title} data-note-body={item.note} data-note-sector="Gain Creators">
								<span class="vpc-pin-head" aria-hidden="true"></span>
								<span class="vpc-pin-title">{item.title}</span>
							</button>
						</li>
					))}
				</ul>
			</div>

			<!-- Pain Relievers (Bottom Wedge) -->
			<div class="vpc-wedge vpc-wedge--pain-relievers">
				<ul class="vpc-chips vpc-chips--center">
					{painRelievers.map((item, i) => (
						<li class="vpc-chip-item" style={`--scatter: translate(${((i * 43) % 15) - 7}px, ${((i * 29) % 11) - 5}px) rotate(${((i * 19) % 9) - 4}deg);`}>
							<button type="button" class="vpc-pin" data-note-title={item.title} data-note-body={item.note} data-note-sector="Pain Relievers">
								<span class="vpc-pin-head" aria-hidden="true"></span>
								<span class="vpc-pin-title">{item.title}</span>
							</button>
						</li>
					))}
				</ul>
				<div class="vpc-wedge-header font-mono">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.5 20.5l10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path><path d="m8.5 8.5 7 7"></path></svg>
					<span>Pain Relievers</span>
				</div>
			</div>

			<!-- Center Icon Hub -->
			<div class="vpc-square-hub" aria-hidden="true">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
			</div>
		</div>

		<!-- Connector / Fit Symbol -->
		<div class="vpc-connector" aria-hidden="true">
			<svg viewBox="0 0 40 24" width="40" height="24">
				<line x1="0" y1="12" x2="12" y2="12" />
				<polyline points="16,5 10,12 16,19" fill="none" />
				<polyline points="24,5 30,12 24,19" fill="none" />
				<line x1="28" y1="12" x2="40" y2="12" />
			</svg>
		</div>

		<!-- Right: Customer Profile (Circle) -->
		<div class="vpc-circle" aria-label="Customer Profile: Customer Jobs, Customer Gains, Customer Pains">
			<svg class="vpc-circle-rules" viewBox="0 0 100 100" aria-hidden="true">
				<circle cx="50" cy="50" r="47.8" />
				<line x1="2.2" y1="50" x2="50" y2="50" />
				<line x1="50" y1="50" x2="83.8" y2="16.2" />
				<line x1="50" y1="50" x2="83.8" y2="83.8" />
			</svg>

			<!-- Gains (Top-Left Wedge) -->
			<div class="vpc-wedge vpc-wedge--gains">
				<div class="vpc-wedge-header font-mono">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>
					<span>Gains</span>
				</div>
				<ul class="vpc-chips vpc-chips--center">
					{gains.map((item, i) => (
						<li class="vpc-chip-item" style={`--scatter: translate(${((i * 41) % 15) - 7}px, ${((i * 23) % 11) - 5}px) rotate(${((i * 17) % 9) - 4}deg);`}>
							<button type="button" class="vpc-pin" data-note-title={item.title} data-note-body={item.note} data-note-sector="Customer Gains">
								<span class="vpc-pin-head" aria-hidden="true"></span>
								<span class="vpc-pin-title">{item.title}</span>
							</button>
						</li>
					))}
				</ul>
			</div>

			<!-- Pains (Bottom-Left Wedge) -->
			<div class="vpc-wedge vpc-wedge--pains">
				<ul class="vpc-chips vpc-chips--center">
					{pains.map((item, i) => (
						<li class="vpc-chip-item" style={`--scatter: translate(${((i * 37) % 15) - 7}px, ${((i * 29) % 11) - 5}px) rotate(${((i * 13) % 9) - 4}deg);`}>
							<button type="button" class="vpc-pin" data-note-title={item.title} data-note-body={item.note} data-note-sector="Customer Pains">
								<span class="vpc-pin-head" aria-hidden="true"></span>
								<span class="vpc-pin-title">{item.title}</span>
							</button>
						</li>
					))}
				</ul>
				<div class="vpc-wedge-header font-mono">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line><path d="M16 16s-1.5-2-4-2-4 2-4 2"></path></svg>
					<span>Pains</span>
				</div>
			</div>

			<!-- Customer Jobs (Right Wedge) -->
			<div class="vpc-wedge vpc-wedge--jobs">
				<div class="vpc-wedge-header font-mono">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
					<span>Customer Jobs</span>
				</div>
				<ul class="vpc-chips vpc-chips--center">
					{customerJobs.map((item, i) => (
						<li class="vpc-chip-item" style={`--scatter: translate(${((i * 31) % 15) - 7}px, ${((i * 19) % 11) - 5}px) rotate(${((i * 11) % 9) - 4}deg);`}>
							<button type="button" class="vpc-pin" data-note-title={item.title} data-note-body={item.note} data-note-sector="Customer Jobs">
								<span class="vpc-pin-head" aria-hidden="true"></span>
								<span class="vpc-pin-title">{item.title}</span>
							</button>
						</li>
					))}
				</ul>
			</div>

			<!-- Center Icon Hub -->
			<div class="vpc-circle-hub" aria-hidden="true">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
			</div>
		</div>
		</div>
	</details>

	<!-- Interactive Pop-Out Sticky Note Anchor Popover -->
	<dialog class="vpc-modal" id="vpcNoteDialog" aria-labelledby="vpcNoteTitle">
		<div class="vpc-stickynote">
			<span class="vpc-stickynote-pin" aria-hidden="true"></span>
			<button type="button" class="vpc-stickynote-close" id="vpcCloseBtn" aria-label="Close note">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
			</button>
			<p class="vpc-stickynote-sector font-mono" id="vpcNoteSector">Sector</p>
			<h4 class="vpc-stickynote-title font-sans" id="vpcNoteTitle">Title</h4>
			<p class="vpc-stickynote-body font-sans" id="vpcNoteBody">Body</p>
		</div>
	</dialog>
</div>

<script>
	const dialog = document.getElementById('vpcNoteDialog') as HTMLDialogElement | null;
	const closeBtn = document.getElementById('vpcCloseBtn');
	const noteSector = document.getElementById('vpcNoteSector');
	const noteTitle = document.getElementById('vpcNoteTitle');
	const noteBody = document.getElementById('vpcNoteBody');

	function positionDialogToPin(btn: HTMLElement) {
		if (!dialog) return;

		// Reset positioning to calculate dimensions
		dialog.style.top = '0px';
		dialog.style.left = '0px';
		dialog.style.visibility = 'hidden';
		if (!dialog.open) {
			dialog.showModal();
		}

		const rect = btn.getBoundingClientRect();
		const dialogRect = dialog.getBoundingClientRect();
		const pad = 12;

		// Calculate preferred placement: directly below the pin
		let top = rect.bottom + 8;
		let left = rect.left + (rect.width / 2) - (dialogRect.width / 2);

		// If overflows bottom of viewport, place above the pin
		if (top + dialogRect.height > window.innerHeight - pad) {
			top = rect.top - dialogRect.height - 8;
		}

		// Keep within viewport bounds
		if (top < pad) {
			top = Math.max(pad, rect.bottom + 6);
		}
		if (left < pad) {
			left = pad;
		} else if (left + dialogRect.width > window.innerWidth - pad) {
			left = window.innerWidth - dialogRect.width - pad;
		}

		dialog.style.top = `${Math.round(top)}px`;
		dialog.style.left = `${Math.round(left)}px`;
		dialog.style.visibility = 'visible';
	}

	document.querySelectorAll<HTMLButtonElement>('.vpc-pin').forEach((btn) => {
		btn.addEventListener('click', (e) => {
			e.stopPropagation();
			if (!dialog) return;
			const title = btn.getAttribute('data-note-title') || '';
			const body = btn.getAttribute('data-note-body') || 'No additional note description provided.';
			const sector = btn.getAttribute('data-note-sector') || '';

			if (noteTitle) noteTitle.textContent = title;
			if (noteBody) noteBody.textContent = body;
			if (noteSector) noteSector.textContent = sector;

			positionDialogToPin(btn);
		});
	});

	closeBtn?.addEventListener('click', () => {
		dialog?.close();
	});

	dialog?.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		// Close when clicking backdrop
		if (target === dialog) {
			dialog.close();
		}
	});

	// Close on Escape or click outside
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && dialog?.open) {
			dialog.close();
		}
	});

	function syncVpcDisclosure() {
		document.querySelectorAll<HTMLDetailsElement>('.vpc-disclosure').forEach((el) => {
			if (window.matchMedia('(min-width: 1024px)').matches) {
				el.setAttribute('open', '');
			} else if (!el.dataset.userToggled) {
				el.removeAttribute('open');
			}
		});
	}

	document.querySelectorAll('.vpc-disclosure').forEach((el) => {
		el.addEventListener('toggle', () => {
			(el as HTMLDetailsElement).dataset.userToggled = '1';
		});
	});

	syncVpcDisclosure();
	window.addEventListener('resize', syncVpcDisclosure);
	document.addEventListener('astro:page-load', syncVpcDisclosure);
</script>

<style>
.strategyzer-vpc {
	margin: 1.25rem 0;
	padding: 1.1rem 1.25rem;
	border: 1px solid var(--card-border);
	border-radius: var(--radius-md);
	background: var(--card-bg-elevated);
	color: var(--text-main);
	box-shadow: none;
	transition: background var(--dur-chrome) ease, border-color var(--dur-chrome) ease;
}

.vpc-disclosure-summary {
	cursor: pointer;
	font-size: 0.78rem;
	font-weight: 600;
	color: var(--accent);
	margin-bottom: 0.75rem;
	list-style: none;
}

.vpc-disclosure-summary::-webkit-details-marker {
	display: none;
}

@media (min-width: 1024px) {
	.vpc-disclosure-summary {
		display: none;
	}
}

.vpc-header {
	margin-bottom: 1rem;
}

.vpc-header-titles {
	display: flex;
	align-items: center;
	gap: 0.75rem;
	margin-bottom: 0.65rem;
}

.vpc-canvas-badge {
	display: inline-flex;
	align-items: center;
	padding: 0.2rem 0.55rem;
	font-size: 0.72rem;
	font-weight: 700;
	letter-spacing: 0.08em;
	text-transform: uppercase;
	color: var(--accent);
	background: var(--accent-subtle);
	border: 1px solid var(--card-border-hover);
	border-radius: var(--radius-sm);
}

.vpc-canvas-title {
	margin: 0;
	font-size: 1.35rem;
	font-weight: 700;
	letter-spacing: -0.025em;
	color: var(--text-main);
}

.vpc-name-row {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 1.5rem;
}

@media (max-width: 640px) {
	.vpc-name-row {
		grid-template-columns: 1fr;
		gap: 0.75rem;
	}
}

.vpc-name-field {
	display: flex;
	flex-direction: column;
	gap: 0.25rem;
	padding-bottom: 0.5rem;
	border-bottom: 1px solid var(--card-border);
}

.vpc-name-label {
	font-size: 0.7rem;
	font-weight: 700;
	letter-spacing: 0.08em;
	text-transform: uppercase;
	color: var(--text-muted);
}

.vpc-name-value {
	font-size: 0.95rem;
	font-weight: 600;
	color: var(--text-main);
}

/* Stage Layout */
.vpc-stage {
	display: grid;
	grid-template-columns: minmax(0, 1fr) 48px minmax(0, 1fr);
	gap: 12px;
	align-items: center;
	width: 100%;
}

@media (max-width: 820px) {
	.vpc-stage {
		grid-template-columns: 1fr;
		gap: 2rem;
	}
	.vpc-connector {
		justify-self: center;
		transform: rotate(90deg);
	}
}

.vpc-square,
.vpc-circle {
	position: relative;
	width: 100%;
	aspect-ratio: 1;
	background: var(--card-bg-elevated);
	border: 1px solid var(--card-border);
	overflow: hidden;
	box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.02);
}

.vpc-circle {
	border-radius: 50%;
}

.vpc-square-rules,
.vpc-circle-rules {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	pointer-events: none;
	z-index: 1;
}

.vpc-square-rules rect,
.vpc-circle-rules circle {
	fill: transparent;
	stroke: var(--card-border);
	stroke-width: 2;
	vector-effect: non-scaling-stroke;
}

.vpc-square-rules line,
.vpc-circle-rules line,
.vpc-connector line,
.vpc-connector polyline {
	stroke: var(--text-muted);
	opacity: 0.5;
	stroke-width: 1.8;
	stroke-linecap: round;
	stroke-linejoin: round;
	vector-effect: non-scaling-stroke;
}

.vpc-connector {
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--text-muted);
}

/* Wedges */
.vpc-wedge {
	position: absolute;
	z-index: 2;
	display: flex;
	flex-direction: column;
	gap: 6px;
	min-width: 0;
	overflow: visible;
}

.vpc-wedge-header {
	display: inline-flex;
	align-items: center;
	gap: 6px;
	padding: 0.2rem 0.45rem;
	font-size: 0.65rem;
	font-weight: 700;
	letter-spacing: 0.09em;
	text-transform: uppercase;
	color: var(--text-muted);
	background: var(--card-bg);
	border: 1px solid var(--card-border);
	border-radius: var(--radius-sm);
	line-height: 1;
	white-space: nowrap;
}

.vpc-wedge--products {
	left: 4%;
	top: 22%;
	width: 32%;
	height: 56%;
	justify-content: center;
	align-items: flex-start;
}

.vpc-wedge--gain-creators {
	left: 36%;
	top: 5%;
	width: 52%;
	height: 34%;
	align-items: center;
}

.vpc-wedge--pain-relievers {
	left: 36%;
	bottom: 5%;
	width: 52%;
	height: 34%;
	align-items: center;
	justify-content: flex-end;
}

.vpc-wedge--gains {
	left: 8%;
	top: 8%;
	width: 40%;
	height: 32%;
	align-items: center;
}

.vpc-wedge--pains {
	left: 8%;
	bottom: 8%;
	width: 40%;
	height: 32%;
	align-items: center;
	justify-content: flex-end;
}

.vpc-wedge--jobs {
	left: 58%;
	top: 20%;
	width: 34%;
	height: 60%;
	align-items: center;
	justify-content: center;
}

/* Hubs */
.vpc-square-hub,
.vpc-circle-hub {
	position: absolute;
	z-index: 3;
	left: 50%;
	top: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 42px;
	height: 42px;
	transform: translate(-50%, -50%);
	background: var(--card-bg);
	color: var(--accent);
	border: 1.5px solid var(--card-border);
	box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.12);
}

.vpc-circle-hub {
	border-radius: 50%;
}

/* Chips / Pins — Themed Warm Paper / Obsidian Cards */
.vpc-chips {
	list-style: none;
	margin: 0;
	padding: 4px;
	display: flex;
	flex-wrap: wrap;
	gap: 4px 6px;
	width: 100%;
	min-width: 0;
}

.vpc-chips--center {
	justify-content: center;
}

.vpc-chips--start {
	justify-content: flex-start;
}

.vpc-chip-item {
	transform: var(--scatter, none);
	transition: transform var(--dur-fast) var(--ease-ui), z-index var(--dur-fast) ease;
}

.vpc-chip-item:hover {
	z-index: 10;
	transform: var(--scatter, none) translateY(-3px) scale(1.05);
}

.vpc-pin {
	position: relative;
	display: inline-flex;
	align-items: center;
	width: max-content;
	max-width: 135px;
	margin: 0;
	padding: 6px 10px 5px;
	border: 1px solid var(--card-border);
	border-radius: var(--radius-sm);
	background: var(--card-bg-elevated);
	color: var(--text-main);
	box-shadow: 0 2px 8px -2px rgba(0, 0, 0, 0.15);
	font-family: var(--font-sans);
	font-size: 0.72rem;
