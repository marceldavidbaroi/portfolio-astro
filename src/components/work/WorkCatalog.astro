---
import ShotFan from './ShotFan.astro';

interface Project {
	slug: string;
	categories: string[];
	searchString: string;
	thumbs: string[];
	chip?: string;
	title: string;
	subtitle?: string;
	platformType?: string;
}

interface Props {
	projects: Project[];
}

const { projects } = Astro.props;
---

<section class="directory" aria-label="Case study catalog">
	<div class="catalog" id="catalog-list">
		{projects.map((project) => (
			<a
				class="work-item catalog-item"
				href={`/work/${project.slug}`}
				data-categories={project.categories.join(' ')}
				data-search-content={project.searchString}
			>
				<div class="work-copy">
					<p class="kicker font-mono">{project.chip}</p>
					<h2 class="catalog-title">{project.title}</h2>
					{project.subtitle && <p class="catalog-line">{project.subtitle}</p>}
				</div>
				<ShotFan images={project.thumbs} phone={project.platformType === 'mobile'} size="row-still" />
			</a>
		))}
	</div>

	<p class="empty font-mono" id="work-empty" hidden>
		No matching case studies. <button type="button" class="stack-link" id="empty-clear">Clear</button>
	</p>
</section>

<style>
	.empty[hidden],
	.work-item[hidden] {
		display: none !important;
	}

	.catalog {
		display: flex;
		flex-direction: column;
	}

	.work-item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 8.5rem;
		align-items: center;
		gap: 0.7rem 0.85rem;
		padding: 0.85rem 0;
		border-top: 1px solid rgba(95, 80, 56, 0.1);
		text-decoration: none;
		color: inherit;
		min-width: 0;
	}

	.catalog .work-item:first-child {
		border-top: 0;
		padding-top: 0.35rem;
	}

	.work-item:hover .catalog-title {
		color: var(--accent);
	}

	.work-copy {
		display: flex;
		flex-direction: column;
		gap: 0.28rem;
		min-width: 0;
	}

	.catalog-title {
		margin: 0;
		font-size: 1.08rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.3;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color var(--dur-fast) ease;
	}

	.catalog-line {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.45;
		color: var(--text-muted);
		display: -webkit-box;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.empty {
		margin: 1.5rem 0 0;
		font-size: var(--type-meta);
		color: var(--text-muted);
	}

	.stack-link {
		appearance: none;
		border: 0;
		background: none;
		padding: 0;
		margin: 0;
		font: inherit;
		color: var(--text-muted);
		cursor: pointer;
		text-transform: none;
		letter-spacing: inherit;
	}

	.stack-link:hover {
		color: var(--text-main);
		text-decoration: underline;
	}

	@media (max-width: 640px) {
		.work-item {
			grid-template-columns: minmax(0, 1fr) 7.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.catalog-title {
			transition: none;
		}
	}
</style>
