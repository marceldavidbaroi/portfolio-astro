---
interface Props {
	role?: string;
	timeline?: string;
	classLabel: string;
}

const { role, timeline, classLabel } = Astro.props;
---

<dl class="meta-rail">
	{role && (
		<div>
			<dt class="font-mono">Role</dt>
			<dd>{role}</dd>
		</div>
	)}
	{timeline && (
		<div>
			<dt class="font-mono">Timeline</dt>
			<dd>{timeline}</dd>
		</div>
	)}
	<div>
		<dt class="font-mono">Class</dt>
		<dd>{classLabel}</dd>
	</div>
</dl>
