---
interface Props {
	title: string;
	chip?: string;
	images?: string[];
	heroMockup?: string;
	isPhone?: boolean;
}

const { title, chip, images = [], heroMockup, isPhone = false } = Astro.props;

// Filter out dummy/placeholder images
const sanitize = (src?: string) => {
	if (!src) return null;
	if (src.includes('dummy') || src.includes('thumb-')) return null;
	return src;
};

const imagePool = [
	heroMockup,
	...(images || [])
].map(sanitize).filter((img): img is string => Boolean(img));

// Deduplicate screenshots
const cleanImages = Array.from(new Set(imagePool));
const hasImages = cleanImages.length > 0;

// Derive descriptive overlay labels based on file names or index
const getCardMetadata = (src: string, index: number) => {
	const lower = src.toLowerCase();
	if (lower.includes('dashboard') || index === 0) {
		return {
			badge: 'System Workbench',
			title: 'Executive Overview & Live Telemetry',
			description: 'Real-time operational metrics, multi-tenant state and executive telemetry.'
		};
	}
	if (lower.includes('shipment') || lower.includes('inbox') || lower.includes('register')) {
		return {
			badge: 'Transaction Flow',
			title: 'Core Processing & Ingestion Engine',
			description: 'Structured intake workflows, audit trails, and transactional state machines.'
		};
	}
	if (lower.includes('costing') || lower.includes('form') || lower.includes('scanner')) {
		return {
			badge: 'Engine Specification',
			title: 'Algorithmic Rules & Pricing Model',
			description: 'Deterministic calculations, formula apportionment, and automated rules.'
		};
	}
	return {
		badge: `Module View ${index + 1}`,
		title: 'Interactive Application Interface',
		description: 'High-throughput desktop and mobile interface components.'
	};
};
---

{hasImages && (
	<section id="media-showcase" class="carousel-section w-full max-w-full" aria-label="Project Visual Interfaces">
		<div class="carousel-header">
			<div class="header-left">
				<span class="label font-mono">System Interfaces & Visual Carousel</span>
				<span class="gallery-count font-mono">{cleanImages.length} Visual Workbenches</span>
			</div>
			
			<div class="header-nav font-mono">
				<button type="button" class="nav-arrow-btn prev-btn" aria-label="Scroll left" title="Previous Image">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
				</button>
				<button type="button" class="nav-arrow-btn next-btn" aria-label="Scroll right" title="Next Image">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
				</button>
			</div>
		</div>

		<!-- Horizontal Smooth Carousel Track -->
		<div class="carousel-track-wrapper">
			<div class="carousel-track" id="projectCarouselTrack">
				{cleanImages.map((src, index) => {
					const meta = getCardMetadata(src, index);
					return (
						<article class:list={['carousel-card', { 'is-phone-card': isPhone }]}>
							<div class="card-browser-chrome" aria-hidden="true">
								<div class="chrome-dots">
									<span class="dot red"></span>
									<span class="dot yellow"></span>
									<span class="dot green"></span>
								</div>
								<span class="chrome-route font-mono">{title.toLowerCase().replace(/[^a-z0-9]+/g, '-')} · view-0{index + 1}</span>
								<span class="chrome-index font-mono">{index + 1} / {cleanImages.length}</span>
							</div>

							<div class="card-media">
								<img
									src={src}
									alt={`${title} screenshot ${index + 1}`}
									loading={index < 2 ? 'eager' : 'lazy'}
									class="card-img"
								/>
								
								{/* Important Information Overlay */}
								<div class="card-overlay">
									<div class="overlay-header">
										<span class="overlay-badge font-mono">
											<span class="pulse-dot"></span>
											{meta.badge}
										</span>
										<span class="overlay-step font-mono">STEP 0{index + 1}</span>
									</div>
									<h3 class="overlay-title font-sans">{meta.title}</h3>
									<p class="overlay-desc font-sans">{meta.description}</p>
								</div>
							</div>
						</article>
					);
				})}
			</div>
		</div>

		<div class="carousel-footer font-mono">
			<span class="hint-text">← Scroll or drag horizontally to explore all interface workbenches →</span>
		</div>
	</section>
)}

<style>
	.carousel-section {
		margin-top: 2rem;
		margin-bottom: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
		box-sizing: border-box;
	}

	.carousel-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1rem;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid rgba(243, 186, 107, 0.12);
		width: 100%;
		box-sizing: border-box;
	}

	.header-left {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.75rem;
	}

	.gallery-count {
		font-size: var(--type-caption);
		color: var(--text-muted);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.header-nav {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav-arrow-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: var(--radius-sm);
		background: #1e1c19;
		border: 1px solid rgba(243, 186, 107, 0.2);
		color: var(--accent);
		cursor: pointer;
		transition: all var(--dur-fast) ease;
	}

	.nav-arrow-btn:hover {
		background: rgba(243, 186, 107, 0.15);
		border-color: var(--accent);
		color: var(--accent-hover);
		transform: scale(1.05);
	}

	.nav-arrow-btn:active {
		transform: scale(0.95);
	}

	/* Horizontal Scroll Track */
	.carousel-track-wrapper {
		position: relative;
		width: 100%;
		max-width: 100%;
		overflow: hidden;
		border-radius: var(--radius-lg);
	}

	.carousel-track {
		display: flex;
		gap: 1.5rem;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		-webkit-overflow-scrolling: touch;
		touch-action: pan-x;
		padding: 0.5rem 0 1rem;
		scrollbar-width: thin;
		box-sizing: border-box;
	}

	.carousel-card {
		flex: 0 0 min(820px, 85vw);
		scroll-snap-align: center;
		background: #11100f;
		border: 1px solid rgba(243, 186, 107, 0.18);
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: 0 16px 44px -10px rgba(0, 0, 0, 0.85);
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		position: relative;
		transition: border-color var(--dur-ui) ease, transform var(--dur-ui) ease, box-shadow var(--dur-ui) ease;
	}

	.carousel-card:hover {
		border-color: rgba(243, 186, 107, 0.38);
		box-shadow: 0 20px 50px -8px rgba(0, 0, 0, 0.95);
	}

	.carousel-card.is-phone-card {
		flex: 0 0 min(340px, 75vw);
	}

	.card-browser-chrome {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.65rem 1rem;
		background: #1a1816;
		border-bottom: 1px solid rgba(243, 186, 107, 0.1);
		min-width: 0;
	}

	.chrome-dots {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.chrome-dots .dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
	}
	.chrome-dots .dot.red { background: rgba(239, 68, 68, 0.7); }
	.chrome-dots .dot.yellow { background: rgba(234, 179, 8, 0.7); }
	.chrome-dots .dot.green { background: rgba(34, 197, 94, 0.7); }

	.chrome-route {
		font-size: 0.72rem;
		color: var(--text-muted);
		letter-spacing: 0.02em;
		background: rgba(0, 0, 0, 0.3);
		padding: 0.15rem 0.65rem;
		border-radius: 4px;
		max-width: 50%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.chrome-index {
		font-size: 0.7rem;
		color: var(--accent);
		font-weight: 700;
	}

	.card-media {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		background: #151413;
		overflow: hidden;
	}

	.carousel-card.is-phone-card .card-media {
		aspect-ratio: 9 / 16;
	}

	.card-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		transition: transform var(--dur-ui) var(--ease-out);
	}

	.carousel-card:hover .card-img {
		transform: scale(1.02);
	}

	/* High-Contrast Message Overlay */
	.card-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		padding: 1.25rem 1.4rem;
		background: linear-gradient(180deg, transparent 0%, rgba(12, 11, 10, 0.88) 35%, rgba(12, 11, 10, 0.98) 100%);
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		border-top: 1px solid rgba(243, 186, 107, 0.14);
		backdrop-filter: blur(8px);
		z-index: 10;
	}

	.overlay-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.overlay-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 700;
		color: var(--accent);
		background: rgba(243, 186, 107, 0.12);
		border: 1px solid rgba(243, 186, 107, 0.25);
		padding: 0.2rem 0.55rem;
		border-radius: 4px;
	}

	.pulse-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #4ade80;
		box-shadow: 0 0 6px #4ade80;
	}

	.overlay-step {
		font-size: 0.68rem;
		color: var(--text-muted);
		letter-spacing: 0.08em;
		font-weight: 700;
	}

	.overlay-title {
		margin: 0.15rem 0 0;
		font-size: clamp(1rem, 2.5vw, 1.2rem);
		font-weight: 700;
		color: #ffffff;
		line-height: 1.3;
	}

	.overlay-desc {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.45;
		color: #d1cbc1;
	}

	.carousel-footer {
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 0.25rem 0;
	}

	.hint-text {
		font-size: 0.72rem;
		color: var(--text-muted);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	@media (max-width: 640px) {
		.carousel-card {
			flex: 0 0 92vw;
			border-radius: var(--radius-md);
		}

		.carousel-card.is-phone-card {
			flex: 0 0 82vw;
		}

		.card-browser-chrome {
			padding: 0.5rem 0.75rem;
		}

		.card-overlay {
			padding: 0.95rem 1rem;
		}

		.overlay-title {
			font-size: 1rem;
		}

		.overlay-desc {
			font-size: 0.82rem;
		}
	}
</style>

<script>
	function setupCarouselNav() {
		const track = document.getElementById('projectCarouselTrack');
		const prevBtn = document.querySelector('.prev-btn');
		const nextBtn = document.querySelector('.next-btn');

		if (!track || !prevBtn || !nextBtn) return;

		const scrollStep = () => {
			const firstCard = track.querySelector<HTMLElement>('.carousel-card');
			return firstCard ? firstCard.offsetWidth + 24 : 600;
		};

		prevBtn.addEventListener('click', () => {
			track.scrollBy({ left: -scrollStep(), behavior: 'smooth' });
		});

		nextBtn.addEventListener('click', () => {
			track.scrollBy({ left: scrollStep(), behavior: 'smooth' });
		});
	}

	setupCarouselNav();
	document.addEventListener('astro:page-load', setupCarouselNav);
</script>
