---
import ShotFan from './ShotFan.astro';

import type { ProjectListItem } from '../../lib/projectView';

interface Props {
	projects: ProjectListItem[];
}

const { projects } = Astro.props;
---

<section class="focus-section" aria-label="Featured case studies">
	<div class="focus-list" id="focus-list">
		{projects.map((project) => (
			<a
				class="feature-band catalog-item"
				href={`/work/${project.slug}`}
				data-categories={project.categories.join(' ')}
				data-search-content={project.searchString}
			>
				<div class="feature-copy">
					<div class="feature-kicker-row">
						{project.chip && <p class="label font-mono card-chip">{project.chip}</p>}
						{project.contributionBadge && (
							<span class="contribution-badge font-mono">{project.contributionBadge}</span>
						)}
						{project.status && (
							<span class="badge-status font-mono">{project.status}</span>
						)}
					</div>
					<h2 class="feature-title font-sans">{project.title}</h2>
					{project.timeline && (
						<p class="feature-meta font-mono">
							{project.timeline}
						</p>
					)}
					{project.listMetrics.length > 0 && (
						<ul class="metric-row font-mono feature-metrics">
							{project.listMetrics.map((m) => (
								<li>
									<b>{m.value}</b>
									<span>{m.label}</span>
								</li>
							))}
						</ul>
					)}
					<p class="feature-desc">{project.description}</p>
					{(project.stack || []).length > 0 && (
						<div class="feature-stack font-mono">
							{project.stack!.map((tech) => (
								<span class="stack-badge">{tech}</span>
							))}
						</div>
					)}
					<span class="inline-cta font-mono">Read case study →</span>
				</div>
				<ShotFan images={project.thumbs} phone={project.platformType === 'mobile'} size="feature" />
			</a>
		))}
	</div>
</section>

<script>
	function setupScrollReveal() {
		const items = document.querySelectorAll<HTMLElement>('.feature-band');
		if (!items.length) return;

		// Respect prefers-reduced-motion
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			items.forEach((item) => item.classList.add('is-revealed'));
			return;
		}

		if (!('IntersectionObserver' in window)) {
			items.forEach((item) => item.classList.add('is-revealed'));
			return;
		}

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-revealed');
						observer.unobserve(entry.target);
					}
				});
			},
			{
				root: null,
				rootMargin: '0px 0px -60px 0px',
				threshold: 0.12
			}
		);

		items.forEach((item) => {
			if (!item.classList.contains('is-revealed')) {
				observer.observe(item);
			}
		});
	}

	// Run on initial load and view transitions
	setupScrollReveal();
	document.addEventListener('astro:page-load', setupScrollReveal);
	document.addEventListener('work:filter-applied', setupScrollReveal);
</script>

<style>
	.focus-section {
		padding: 0.5rem 0 1.5rem;
		border-bottom: 1px solid var(--card-border);
	}

	.focus-list {
		display: flex;
		flex-direction: column;
	}

	.focus-section[hidden],
	.feature-band[hidden] {
		display: none !important;
	}

	.feature-band {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(320px, 1fr);
		gap: 2.5rem 3.5rem;
		align-items: center;
		text-decoration: none;
		color: inherit;
		padding: 2.75rem 0;
		border-top: 1px solid var(--card-border);
		opacity: 0;
		transform: translateY(24px);
		transition:
			opacity 0.65s var(--ease-out),
			transform 0.65s var(--ease-out),
			border-color var(--dur-fast) ease;
		will-change: opacity, transform;
	}

	.feature-band.is-revealed {
		opacity: 1;
		transform: translateY(0);
	}

	.focus-list .feature-band:first-child {
		border-top: 0;
		padding-top: 0.5rem;
	}

	.feature-band:hover .feature-title {
		color: var(--accent);
	}

	.feature-band:hover .inline-cta {
		color: var(--accent);
	}

	.feature-band:hover :global(.shot-still-frame) {
		border-color: var(--card-border-hover);
		transform: scale(1.015);
		box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.25);
	}

	.feature-copy {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		min-width: 0;
	}

	.feature-kicker-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.65rem;
	}

	.card-chip {
		margin: 0;
		font-size: var(--type-kicker);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.contribution-badge {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--accent);
		background: var(--accent-subtle);
		border: 1px solid var(--card-border-hover);
		padding: 0.15rem 0.55rem;
		border-radius: var(--radius-sm);
	}

	.badge-status {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #16a34a;
		background: rgba(34, 197, 94, 0.12);
		border: 1px solid rgba(34, 197, 94, 0.25);
		padding: 0.15rem 0.55rem;
		border-radius: var(--radius-sm);
	}

	:root[data-theme="dark"] .badge-status {
		color: #4ade80;
	}

	.feature-meta {
		margin: 0;
		font-size: 0.72rem;
		color: var(--text-muted);
		letter-spacing: 0.03em;
	}

	.feature-title {
		margin: 0;
		font-size: clamp(1.4rem, 2.5vw, 1.85rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.22;
		color: var(--text-main);
		transition: color var(--dur-fast) ease;
	}

	.feature-desc {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.6;
		color: var(--text-muted);
		max-width: 44rem;
		text-wrap: pretty;
	}

	.feature-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.5rem;
		margin-top: 0.25rem;
	}

	.stack-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.22rem 0.65rem;
		font-size: 0.72rem;
		letter-spacing: 0.02em;
		color: var(--text-muted);
		background: var(--card-bg-elevated);
		border: 1px solid var(--card-border);
		border-radius: var(--radius-full);
		white-space: nowrap;
		line-height: 1.25;
		transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, color var(--dur-fast) ease;
	}

	.feature-band:hover .stack-badge {
		color: var(--accent);
		background: var(--accent-subtle);
		border-color: var(--card-border-hover);
	}

	.feature-metrics {
		margin: 0.2rem 0 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem 1.5rem;
	}

	.feature-metrics li {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.feature-metrics b {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--accent);
		letter-spacing: -0.02em;
	}

	.feature-metrics span {
		font-size: 0.72rem;
		color: var(--text-muted);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.inline-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: var(--type-cta);
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--accent);
		margin-top: 0.5rem;
		transition: color var(--dur-fast) ease, transform var(--dur-fast) ease;
	}

	.feature-band:hover .inline-cta {
		transform: translateX(4px);
	}

	@media (max-width: 860px) {
		.feature-band {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding: 2rem 0;
		}

		.feature-metrics {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.75rem;
			width: 100%;
		}

		.feature-metrics li {
			min-width: 0;
		}

		.feature-metrics b,
		.feature-metrics span {
			overflow-wrap: break-word;
		}
	}

	@media (max-width: 640px) {
		.focus-section {
			padding: 0.25rem 0 1rem;
		}

		.feature-band {
			padding: 1.5rem 0;
			gap: 1.25rem;
		}

		.feature-title {
			font-size: 1.2rem;
		}

		.feature-desc {
			font-size: 0.9rem;
			line-height: 1.55;
		}

		.stack-badge {
			font-size: 0.68rem;
			padding: 0.18rem 0.55rem;
		}

		.feature-metrics {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.feature-band {
			opacity: 1 !important;
			transform: none !important;
			transition: none !important;
		}

		.feature-band::after,
		.feature-title,
		.inline-cta {
			transition: none !important;
			transform: none !important;
		}
	}
</style>
