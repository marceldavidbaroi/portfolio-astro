---
import ShotFan from './ShotFan.astro';

interface Metric {
	value: string;
	label: string;
}

interface Project {
	slug: string;
	categories: string[];
	searchString: string;
	chip?: string;
	title: string;
	description?: string;
	impactMetrics?: Metric[];
	thumbs: string[];
	platformType?: string;
	stack?: string[];
}

interface Props {
	projects: Project[];
}

const { projects } = Astro.props;
---

<section class="focus-section" aria-label="Featured case studies">
	<div class="focus-list" id="focus-list">
		{projects.map((project) => (
			<a
				class="feature-band catalog-item"
				href={`/work/${project.slug}`}
				data-categories={project.categories.join(' ')}
				data-search-content={project.searchString}
			>
				<div class="feature-copy">
					<p class="kicker font-mono">{project.chip}</p>
					<h2 class="feature-title">{project.title}</h2>
					{(project.impactMetrics || []).length > 0 && (
						<ul class="metric-row font-mono feature-metrics">
							{(project.impactMetrics || []).slice(0, 3).map((m) => (
								<li>
									<b>{m.value}</b>
									<span>{m.label}</span>
								</li>
							))}
						</ul>
					)}
					<p class="feature-desc">{project.description}</p>
					{(project.stack || []).length > 0 && (
						<div class="feature-stack font-mono">
							{project.stack!.map((tech) => (
								<span class="stack-badge">{tech}</span>
							))}
						</div>
					)}
					<span class="inline-cta font-mono">Read case study →</span>
				</div>
				<ShotFan images={project.thumbs} phone={project.platformType === 'mobile'} size="feature" />
			</a>
		))}
	</div>
</section>

<style>
	.focus-section {
		padding: 0.5rem 0 1.5rem;
		border-bottom: 1px solid var(--card-border);
	}

	.focus-list {
		display: flex;
		flex-direction: column;
	}

	.focus-section[hidden],
	.feature-band[hidden] {
		display: none !important;
	}

	.feature-band {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(320px, 1fr);
		gap: 2.5rem 3.5rem;
		align-items: center;
		text-decoration: none;
		color: inherit;
		padding: 2.75rem 0;
		border-top: 1px solid rgba(255, 255, 255, 0.09);
	}

	.focus-list .feature-band:first-child {
		border-top: 0;
		padding-top: 0.5rem;
	}

	.feature-band:hover .feature-title {
		color: #ffffff;
	}

	.feature-band:hover .inline-cta {
		color: #ffffff;
	}

	.feature-band:hover :global(.shot-still-frame) {
		border-color: rgba(255, 255, 255, 0.28);
		transform: scale(1.015);
		box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.85);
	}

	.feature-copy {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		min-width: 0;
	}

	.kicker {
		font-size: var(--type-kicker);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin: 0;
	}

	.feature-title {
		margin: 0;
		font-size: clamp(1.35rem, 2.3vw, 1.75rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.22;
		color: #ffffff;
		transition: color var(--dur-fast) ease;
	}

	.feature-desc {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.6;
		color: var(--text-muted);
		max-width: 44rem;
		text-wrap: pretty;
	}

	.feature-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.5rem;
		margin-top: 0.25rem;
	}

	.stack-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.22rem 0.65rem;
		font-size: 0.72rem;
		letter-spacing: 0.02em;
		color: #a1a1aa;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.09);
		border-radius: var(--radius-full);
		white-space: nowrap;
		line-height: 1.25;
		transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, color var(--dur-fast) ease;
	}

	.feature-band:hover .stack-badge {
		color: #e4e4e7;
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.15);
	}

	.feature-metrics {
		margin-top: 0.1rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem 1.25rem;
	}

	.inline-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: var(--type-cta);
		font-weight: 600;
		letter-spacing: 0.02em;
		color: #d4d4d8;
		margin-top: 0.5rem;
		transition: color var(--dur-fast) ease, transform var(--dur-fast) ease;
	}

	@media (max-width: 860px) {
		.feature-band {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding: 2rem 0;
		}

		.feature-metrics {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.75rem;
			width: 100%;
		}

		.feature-metrics li {
			min-width: 0;
		}

		.feature-metrics b,
		.feature-metrics span {
			overflow-wrap: break-word;
		}
	}

	@media (max-width: 640px) {
		.focus-section {
			padding: 0.25rem 0 1rem;
		}

		.feature-band {
			padding: 1.5rem 0;
			gap: 1.25rem;
		}

		.feature-title {
			font-size: 1.2rem;
		}

		.feature-desc {
			font-size: 0.9rem;
			line-height: 1.55;
		}

		.stack-badge {
			font-size: 0.68rem;
			padding: 0.18rem 0.55rem;
		}

		.feature-metrics {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.feature-band,
		.feature-band::after,
		.feature-title,
		.inline-cta {
			transition: none !important;
			transform: none !important;
		}
	}
</style>
