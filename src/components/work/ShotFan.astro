---
interface Props {
	images?: string[];
	phone?: boolean;
	size?: 'row' | 'row-still' | 'hero' | 'feature';
}

const { images = [], phone = false, size = 'row' } = Astro.props;
const thumbs = images.filter((img) => img && !img.includes('thumb-') && !img.includes('dummy')).slice(0, 3);
const layers = thumbs.length > 0 ? thumbs : [null];
const eager = size === 'hero' || size === 'feature';
const isFeatureCollage = size === 'feature';
const isRowStill = size === 'row-still';
---

{isFeatureCollage ? (
	<div class="shot-collage" aria-hidden="true">
		<div class="collage-main">
			{thumbs[0] ? (
				<img src={thumbs[0]} alt="" loading={eager ? 'eager' : 'lazy'} />
			) : (
				<div class="collage-empty"></div>
			)}
		</div>
		{thumbs[1] && (
			<div class="collage-sub collage-sub-1">
				<img src={thumbs[1]} alt="" loading={eager ? 'eager' : 'lazy'} />
			</div>
		)}
		{thumbs[2] && (
			<div class="collage-sub collage-sub-2">
				<img src={thumbs[2]} alt="" loading={eager ? 'eager' : 'lazy'} />
			</div>
		)}
	</div>
) : isRowStill ? (
	<div class="shot-still is-row" aria-hidden="true">
		<div class:list={['shot-still-frame', { 'is-empty': !thumbs[0] }]}>
			{thumbs[0] && <img src={thumbs[0]} alt="" loading="lazy Rund" />}
		</div>
	</div>
) : (
	<div class:list={['shot-stack', { 'is-phone': phone, 'is-hero': size === 'hero' }]} aria-hidden="true">
		{layers.map((src, i) => (
			<span class:list={['shot-layer', { 'is-empty': !src }]} style={`--i: ${i}`}>
				{src && <img src={src} alt="" loading={eager ? 'eager' : 'lazy'} />}
			</span>
		))}
	</div>
)}

<style>
	/* Multi-image collage / mosaic for featured projects */
	.shot-collage {
		position: relative;
		width: 100%;
		max-width: 520px;
		aspect-ratio: 16 / 11;
		justify-self: center;
		isolation: isolate;
		perspective: 1200px;
	}

	.collage-main {
		position: absolute;
		top: 0;
		left: 0;
		width: 82%;
		height: 78%;
		border-radius: var(--radius-lg);
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: #0d0e12;
		overflow: hidden;
		box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.75);
		z-index: 1;
		transform: rotateX(2deg) rotateY(-2deg) translateZ(0);
		transform-style: preserve-3d;
		will-change: transform, box-shadow;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
			border-color 0.4s ease,
			box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.collage-main img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
	}

	.collage-sub {
		position: absolute;
		border-radius: var(--radius-md);
		border: 1px solid rgba(255, 255, 255, 0.16);
		background: #111318;
		overflow: hidden;
		box-shadow: 0 14px 28px -6px rgba(0, 0, 0, 0.85);
		transform-style: preserve-3d;
		will-change: transform, box-shadow;
		transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1),
			border-color 0.4s ease,
			box-shadow 0.65s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.collage-sub img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
	}

	.collage-sub-1 {
		right: 0;
		bottom: 4%;
		width: 56%;
		height: 58%;
		z-index: 2;
		transform: rotateX(4deg) rotateY(-6deg) rotateZ(1deg) translateZ(10px);
	}

	.collage-sub-2 {
		right: 6%;
		top: 4%;
		width: 44%;
		height: 46%;
		z-index: 3;
		opacity: 0.96;
		transform: rotateX(6deg) rotateY(-8deg) rotateZ(-2deg) translateZ(24px);
	}

	/* 3D Floating & Parallax Fanning on Hover */
	:global(.feature-band:hover) .collage-main {
		transform: rotateX(5deg) rotateY(-4deg) rotateZ(-1.5deg) translateY(-8px) translateX(-6px) translateZ(15px);
		border-color: rgba(243, 186, 107, 0.35);
		box-shadow: -12px 28px 48px -10px rgba(0, 0, 0, 0.9), 0 0 24px rgba(243, 186, 107, 0.12);
	}

	:global(.feature-band:hover) .collage-sub-1 {
		transform: rotateX(2deg) rotateY(-1deg) rotateZ(3.5deg) translate(16px, 6px) translateZ(40px) scale(1.04);
		border-color: rgba(243, 186, 107, 0.4);
		box-shadow: 16px 24px 44px -8px rgba(0, 0, 0, 0.95), 0 0 20px rgba(243, 186, 107, 0.15);
		transition-delay: 0.03s;
	}

	:global(.feature-band:hover) .collage-sub-2 {
		transform: rotateX(-3deg) rotateY(4deg) rotateZ(-4deg) translate(22px, -18px) translateZ(65px) scale(1.06);
		opacity: 1;
		border-color: rgba(243, 186, 107, 0.45);
		box-shadow: 20px 20px 42px -6px rgba(0, 0, 0, 0.95), 0 0 22px rgba(243, 186, 107, 0.18);
		transition-delay: 0.06s;
	}

	.shot-still {
		width: 100%;
		max-width: none;
		display: flex;
		justify-content: center;
	}

	.shot-still.is-row {
		max-width: 11rem;
		justify-self: end;
	}

	.shot-still-frame {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		border-radius: var(--radius-md);
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: #090a0d;
		overflow: hidden;
		box-shadow: 0 6px 16px -4px rgba(0, 0, 0, 0.5);
		transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast) ease;
	}

	.shot-still-frame.is-empty,
	.collage-empty {
		border-style: dashed;
		background: var(--card-bg);
		width: 100%;
		height: 100%;
	}

	.shot-still-frame img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		will-change: transform;
		transition: transform var(--dur-fast) var(--ease-out);
	}

	:global(.work-item:hover) .shot-still-frame img,
	:global(.catalog-item:hover) .shot-still-frame img,
	:global(.feature-band:hover) .shot-still-frame img {
		transform: scale(1.03);
	}

	:global(.feature-band:hover) .collage-main img,
	:global(.feature-band:hover) .collage-sub img {
		transform: scale(1.03);
	}

	.collage-main img,
	.collage-sub img {
		will-change: transform;
		transition: transform var(--dur-fast) var(--ease-out);
	}

	.shot-stack {
		--w: 104px;
		--h: 65px;
		position: relative;
		width: calc(var(--w) + 20px);
		height: calc(var(--h) + 14px);
		justify-self: end;
		isolation: isolate;
		flex-shrink: 0;
	}

	.shot-stack.is-phone {
		--w: 40px;
		--h: 70px;
		width: calc(var(--w) + 28px);
		height: calc(var(--h) + 10px);
	}

	.shot-stack.is-hero {
		--w: 220px;
		--h: 138px;
		width: calc(var(--w) + 48px);
		height: calc(var(--h) + 28px);
		justify-self: start;
	}

	.shot-stack.is-hero.is-phone {
		--w: 92px;
		--h: 168px;
		width: calc(var(--w) + 64px);
		height: calc(var(--h) + 20px);
	}

	.shot-layer {
		position: absolute;
		right: calc(var(--i) * 7px);
		bottom: calc(var(--i) * 5px);
		width: var(--w);
		height: var(--h);
		border-radius: 7px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: var(--card-bg);
		box-shadow: 0 8px 16px rgba(0, 0, 0, 0.45);
		overflow: hidden;
		transform: rotate(calc(-6deg + var(--i) * 3deg));
		z-index: calc(4 - var(--i));
		transition: transform var(--dur-ui) var(--ease-out);
	}

	.shot-stack.is-hero .shot-layer {
		right: calc(var(--i) * 14px);
		bottom: calc(var(--i) * 8px);
		border-radius: 10px;
	}

	.shot-stack.is-phone .shot-layer {
		border-radius: 9px;
	}

	.shot-layer.is-empty {
		border-style: dashed;
		background: var(--card-bg);
	}

	.shot-layer img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
	}

	@media (max-width: 640px) {
		.shot-collage {
			max-width: 100%;
			aspect-ratio: 16 / 10;
		}

		.collage-main {
			width: 86%;
			height: 82%;
		}

		.collage-sub-1 {
			width: 54%;
			height: 54%;
		}

		.collage-sub-2 {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.shot-layer,
		.shot-still-frame,
		.shot-still-frame img,
		.collage-main,
		.collage-main img,
		.collage-sub,
		.collage-sub img {
			transition: none !important;
			transform: none !important;
		}
	}
</style>
