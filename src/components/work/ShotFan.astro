---
interface Props {
	images?: string[];
	phone?: boolean;
	size?: 'row' | 'row-still' | 'hero' | 'feature';
}

const { images = [], phone = false, size = 'row' } = Astro.props;
const thumbs = images.filter((img) => img && !img.includes('thumb-') && !img.includes('dummy')).slice(0, 3);
const layers = thumbs.length > 0 ? thumbs : [null];
const featureStill = thumbs[0] ?? null;
const eager = size === 'hero' || size === 'feature';
const isStill = size === 'feature' || size === 'row-still';
---

{isStill ? (
	<div class:list={['shot-still', { 'is-row': size === 'row-still' }]} aria-hidden="true">
		<span class:list={['shot-still-frame', { 'is-empty': !featureStill }]}>
			{featureStill && <img src={featureStill} alt="" loading={eager ? 'eager' : 'lazy'} />}
		</span>
	</div>
) : (
	<div class:list={['shot-stack', { 'is-phone': phone, 'is-hero': size === 'hero' }]} aria-hidden="true">
		{layers.map((src, i) => (
			<span class:list={['shot-layer', { 'is-empty': !src }]} style={`--i: ${i}`}>
				{src && <img src={src} alt="" loading={eager ? 'eager' : 'lazy'} />}
			</span>
		))}
	</div>
)}

<style>
	.shot-still {
		width: 100%;
		max-width: none;
		justify-self: end;
	}

	.shot-still.is-row {
		max-width: 11rem;
	}

	.shot-still-frame {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		border-radius: 2px;
		border: 1px solid rgba(95, 80, 56, 0.18);
		background: var(--card-bg);
		overflow: hidden;
	}

	.shot-still-frame.is-empty {
		border-style: dashed;
	}

	.shot-still-frame img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
	}

	.shot-stack {
		--w: 104px;
		--h: 65px;
		position: relative;
		width: calc(var(--w) + 20px);
		height: calc(var(--h) + 14px);
		justify-self: end;
		isolation: isolate;
		flex-shrink: 0;
	}

	.shot-stack.is-phone {
		--w: 40px;
		--h: 70px;
		width: calc(var(--w) + 28px);
		height: calc(var(--h) + 10px);
	}

	.shot-stack.is-hero {
		--w: 220px;
		--h: 138px;
		width: calc(var(--w) + 48px);
		height: calc(var(--h) + 28px);
		justify-self: start;
	}

	.shot-stack.is-hero.is-phone {
		--w: 92px;
		--h: 168px;
		width: calc(var(--w) + 64px);
		height: calc(var(--h) + 20px);
	}

	.shot-layer {
		position: absolute;
		right: calc(var(--i) * 7px);
		bottom: calc(var(--i) * 5px);
		width: var(--w);
		height: var(--h);
		border-radius: 7px;
		border: 1px solid rgba(95, 80, 56, 0.2);
		background: var(--paper);
		box-shadow: 0 8px 16px rgba(95, 80, 56, 0.12);
		overflow: hidden;
		transform: rotate(calc(-6deg + var(--i) * 3deg));
		z-index: calc(4 - var(--i));
		transition: transform var(--dur-ui) var(--ease-out);
	}

	.shot-stack.is-hero .shot-layer {
		right: calc(var(--i) * 14px);
		bottom: calc(var(--i) * 8px);
		border-radius: 10px;
	}

	.shot-stack.is-phone .shot-layer {
		border-radius: 9px;
	}

	.shot-layer.is-empty {
		border-style: dashed;
		background: var(--card-bg);
	}

	.shot-layer img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
	}

	@media (prefers-reduced-motion: reduce) {
		.shot-layer {
			transition: none;
		}
	}
</style>
