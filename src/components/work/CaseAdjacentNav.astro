---
import { site } from '../../data/site';

interface Neighbor {
	id: string;
	data: { title: string };
}

interface Props {
	prevProject: Neighbor | null;
	nextProject: Neighbor | null;
}

const { prevProject, nextProject } = Astro.props;
---

<nav class="adjacent">
	{prevProject ? (
		<a href={`/work/${prevProject.id}`}>
			<span class="mini font-mono">Previous</span>
			<span>{prevProject.data.title}</span>
		</a>
	) : <span></span>}
	{nextProject ? (
		<a href={`/work/${nextProject.id}`} class="next">
			<span class="mini font-mono">Next</span>
			<span>{nextProject.data.title}</span>
		</a>
	) : <span></span>}
</nav>

<section class="close" aria-label="Contact">
	<p class="close-kicker font-mono">Case closed</p>
	<p class="close-title">More work.</p>
	<div class="hero-actions">
		<a class="text-link font-mono" href="/work">All work →</a>
		<a class="btn-solid font-mono" href={`mailto:${site.email}`}>Email me</a>
	</div>
</section>
