---
interface Props {
	title?: string;
	description?: string;
	isWide?: boolean;
}

const {
	title = 'Marcel David Baroi | Full-Stack & Enterprise Systems Engineer',
	description = 'Portfolio & Case Studies of Marcel David Baroi, Full-Stack & Enterprise Systems Engineer specializing in multi-tenant SaaS, Vue.js/Quasar, Supabase, and architecture-first systems.',
	isWide = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="layout-wrapper">
			<header id="site-header" class="header">
				<div class="header-container">
					<!-- Left spacer to ensure center navigation remains precisely centered -->
					<div class="header-left"></div>

					<!-- Centered Navigation -->
					<nav class="nav">
						<a
							href="/"
							class:list={['nav-link', { active: currentPath === '/' }]}
						>
							Home
						</a>
						<a
							href="/work"
							class:list={['nav-link', { active: currentPath.startsWith('/work') }]}
						>
							Work
						</a>
						<a
							href="/about"
							class:list={['nav-link', { active: currentPath.startsWith('/about') }]}
						>
							About
						</a>
					</nav>

					<!-- Right Social Links -->
					<div class="social-links">
						<a
							href="https://github.com/marceldavidbaroi"
							target="_blank"
							rel="noopener noreferrer"
							class="social-btn"
							aria-label="GitHub"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
								<path d="M9 18c-4.51 2-5-2-7-2"></path>
							</svg>
						</a>
						<a
							href="https://linkedin.com/in/marceldavidbaroi"
							target="_blank"
							rel="noopener noreferrer"
							class="social-btn"
							aria-label="LinkedIn"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
								<rect width="4" height="12" x="2" y="9"></rect>
								<circle cx="4" cy="4" r="2"></circle>
							</svg>
						</a>
						<a
							href="mailto:marceldavidbaroi@gmail.com"
							class="social-btn"
							aria-label="Email"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<rect width="20" height="16" x="2" y="4" rx="2"></rect>
								<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
							</svg>
						</a>
					</div>
				</div>
			</header>

			<main class:list={['main-content', { 'wide-container': isWide }]}>
				<slot />
			</main>
		</div>

		<script>
			const header = document.getElementById('site-header');
			const handleScroll = () => {
				if (window.scrollY > 20) {
					header?.classList.add('scrolled');
				} else {
					header?.classList.remove('scrolled');
				}
			};
			window.addEventListener('scroll', handleScroll, { passive: true });
			handleScroll();
		</script>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'NType 82 Mono';
		src: url('/fonts/NType82Mono-Regular.otf') format('opentype');
		font-weight: 400 700;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: 'NDot 55';
		src: url('/fonts/Ndot55-Regular.otf') format('opentype');
		font-weight: 400 700;
		font-style: normal;
		font-display: swap;
	}

	:root {
		--bg-color: #fffdfa;
		--card-bg: #f4f0e7;
		--card-border: rgba(95, 80, 56, 0.12);
		--btn-primary: #5f5038;
		--btn-primary-hover: #4d402c;
		--accent: #b42135;
		--accent-hover: #96192a;
		--text-main: #2b251e;
		--text-muted: #746855;
		--font-sans: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		--font-mono: 'NType 82 Mono', monospace;
		--font-dot: 'NDot 55', monospace;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		font-family: var(--font-sans);
		background-color: var(--bg-color);
		color: var(--text-main);
		min-height: 100vh;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		text-rendering: optimizeLegibility;
	}

	a {
		text-decoration: none;
		color: inherit;
	}

	/* Dedicated utility class for crisp proportional sans body font (Geist) */
	.font-sans {
		font-family: var(--font-sans);
	}

	/* Dedicated utility class for dotted NDot 55 font - Enhanced Bold Clarity */
	.font-dot {
		font-family: var(--font-dot);
		font-weight: 700;
		letter-spacing: 0.04em;
		-webkit-text-stroke: 0.35px currentColor;
		text-rendering: optimizeLegibility;
	}

	/* Dedicated utility class for regular NType 82 Mono font */
	.font-mono {
		font-family: var(--font-mono);
	}

	/* Global Code Block Theme: Warm Palette instead of harsh black */
	pre,
	pre.astro-code,
	pre.shiki {
		background-color: #f4f0e7 !important;
		border: 1px solid rgba(95, 80, 56, 0.16) !important;
		border-radius: 16px !important;
		padding: 1.25rem 1.5rem !important;
		color: #2b251e !important;
		font-family: var(--font-mono) !important;
		font-size: 0.875rem !important;
		line-height: 1.65 !important;
		overflow-x: auto;
		box-shadow: 0 4px 20px rgba(95, 80, 56, 0.04);
	}

	pre code,
	pre.astro-code code,
	pre span {
		color: #2b251e !important;
		font-family: inherit !important;
		background: transparent !important;
	}

	:not(pre) > code {
		background: rgba(95, 80, 56, 0.08) !important;
		color: var(--accent) !important;
		padding: 0.2rem 0.45rem !important;
		border-radius: 6px !important;
		font-size: 0.875em !important;
		font-family: var(--font-mono) !important;
		border: 1px solid rgba(95, 80, 56, 0.12) !important;
	}

	.layout-wrapper {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 100%;
		display: flex;
		justify-content: center;
		padding: 1.25rem 2rem;
		background: transparent;
		border-bottom: 1px solid transparent;
		transition: background-color 0.3s ease, backdrop-filter 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, padding 0.3s ease;
	}

	.header.scrolled {
		background: rgba(255, 253, 250, 0.75);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(95, 80, 56, 0.08);
		box-shadow: 0 4px 20px rgba(95, 80, 56, 0.04);
		padding: 0.85rem 2rem;
	}

	.header-container {
		width: 100%;
		max-width: 1140px;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}

	.header-left {
		/* Keeps center nav truly centered */
	}

	.nav {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 2rem;
		background: transparent;
		border: none;
		padding: 0;
	}

	.nav-link {
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.9375rem;
		font-weight: 500;
		padding: 0.25rem 0;
		background: transparent;
		border: none;
		box-shadow: none;
		border-radius: 0;
		transition: color 0.2s ease;
	}

	.nav-link:hover {
		color: var(--accent);
	}

	/* Selected nav item: just text color, nothing else */
	.nav-link.active {
		color: var(--accent);
		background: transparent;
		box-shadow: none;
		border: none;
	}

	.social-links {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
	}

	.social-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		color: var(--text-muted);
		background: transparent;
		border: 1px solid transparent;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.social-btn:hover {
		color: var(--accent);
		background: rgba(95, 80, 56, 0.06);
		border-color: rgba(95, 80, 56, 0.12);
		transform: translateY(-1px);
	}

	.main-content {
		width: 100%;
		max-width: 960px;
		padding: 2.5rem 1.5rem 5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		transition: max-width 0.3s ease;
	}

	.main-content.wide-container {
		max-width: 1280px;
		padding-left: 2rem;
		padding-right: 2rem;
	}

	/* Reusable card & button utilities */
	.card {
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: 16px;
		padding: 1.5rem;
		transition: all 0.2s ease;
	}

	.card:hover {
		border-color: rgba(180, 33, 53, 0.3);
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(95, 80, 56, 0.08);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		border-radius: 9999px;
		font-size: 0.9375rem;
		text-decoration: none;
		cursor: pointer;
		border: none;
		transition: all 0.2s ease;
	}

	.btn-primary {
		background-color: var(--btn-primary);
		color: #fffdfa;
	}

	.btn-primary:hover {
		background-color: var(--btn-primary-hover);
		transform: translateY(-1px);
	}

	.btn-accent {
		background-color: var(--accent);
		color: #ffffff;
	}

	.btn-accent:hover {
		background-color: var(--accent-hover);
		transform: translateY(-1px);
	}
</style>
