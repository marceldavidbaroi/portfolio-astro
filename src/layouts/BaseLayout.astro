---
import CommandMenu from '../components/CommandMenu.astro';
import { site } from '../data/site';
import '../styles/tokens.css';
import '../styles/chrome.css';
import '../styles/ui.css';

interface Props {
	title?: string;
	description?: string;
	isWide?: boolean;
	alignStart?: boolean;
}

const {
	title = `${site.name} | Software Engineer`,
	description = `Portfolio & Case Studies of ${site.name}, Software Engineer specializing in Next.js, Vue/Quasar, NestJS, Flutter, PostgreSQL, and architecture-first systems.`,
	isWide = false,
	alignStart = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isWork = currentPath === '/work' || currentPath.startsWith('/work/');
const isAbout =
	currentPath === '/about' ||
	currentPath.startsWith('/about/') ||
	['/skills', '/credentials', '/philosophy', '/archive', '/education', '/research', '/memories', '/gallery'].some(
		(root) => currentPath === root || currentPath.startsWith(`${root}/`)
	);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImageUrl = new URL('/og-preview.png', Astro.site ?? Astro.url.origin).href;

const personJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: site.name,
	jobTitle: 'Software Engineer',
	email: `mailto:${site.email}`,
	url: canonicalUrl,
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Dhaka',
		addressCountry: 'BD',
	},
	alumniOf: {
		'@type': 'CollegeOrUniversity',
		name: 'Daffodil International University',
	},
	sameAs: [site.github, site.linkedin],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
	</head>
	<body>
		<div class="layout-wrapper">
			<header id="site-header" class="header">
				<div class="header-container">
					<nav class="nav" aria-label="Primary">
						<a href="/" class="header-logo-link" aria-label="Home">
							<img src="/images/logo.svg" alt="Marcel David Baroi" class="header-logo-img" />
						</a>
						<a href="/" class:list={['nav-link', { active: isHome }]}>Home</a>
						<a href="/work" class:list={['nav-link', { active: isWork }]}>Work</a>
						<a href="/about" class:list={['nav-link', { active: isAbout }]}>About</a>
					</nav>

					<button
						type="button"
						class="header-menu font-mono"
						id="cmdk-hint-btn"
						aria-haspopup="dialog"
						aria-expanded="false"
						aria-controls="command-menu"
						title="Open menu (⌘K / Ctrl+K)"
					>
						<span class="header-menu-label">Menu</span>
						<kbd class="header-menu-keys" data-shortcut>⌘K</kbd>
					</button>
				</div>
			</header>

			<main class:list={['main-content', { 'wide-container': isWide, 'align-start': alignStart }]}>
				<slot />
			</main>

			<footer class="site-footer">
				<div class="footer-inner font-mono">
					<a href="/" class="footer-brand" aria-label="Marcel David Baroi" title="Marcel David Baroi">
						<img src="/images/signature.png" alt="Marcel David Baroi signature" class="footer-signature-img" />
					</a>
					<span class="footer-pill">Based in Dhaka (UTC+6) · 4–5 hrs overlap with US East &amp; EU CET</span>
					<span class="footer-sep" aria-hidden="true">·</span>
					<span class="footer-pill footer-pill-accent">Available for Full-Time · Remote / Relocation</span>
				</div>
			</footer>
		</div>

		<CommandMenu />

		<script>
			const header = document.getElementById('site-header');
			const menuBtn = document.getElementById('cmdk-hint-btn');
			const shortcut = menuBtn?.querySelector<HTMLElement>('[data-shortcut]');

			const isApple = /Mac|iPhone|iPad|iPod/i.test(navigator.platform) || /Mac|iPhone|iPad|iPod/i.test(navigator.userAgent);
			if (shortcut) shortcut.textContent = isApple ? '⌘K' : 'Ctrl K';
			if (menuBtn) {
				menuBtn.title = isApple ? 'Open menu (⌘K)' : 'Open menu (Ctrl+K)';
			}

			menuBtn?.addEventListener('click', () => {
				(window as any).__openCommandMenu?.();
			});

			let lastY = window.scrollY;
			let hidden = false;
			let ticking = false;

			const menuIsOpen = () => {
				const root = document.getElementById('command-menu');
				return Boolean(root && !root.hidden);
			};

			const setHidden = (next: boolean) => {
				hidden = next;
				header?.classList.toggle('is-hidden', hidden);
				if (hidden) header?.setAttribute('inert', '');
				else header?.removeAttribute('inert');
			};

			const syncHeader = () => {
				if (!header) return;
				const y = window.scrollY;
				const delta = y - lastY;
				header.classList.toggle('is-scrolled', y > 8);

				const hold =
					menuIsOpen() ||
					header.contains(document.activeElement) ||
					y < 40;

				if (hold) {
					setHidden(false);
				} else if (delta > 6 && y > 72) {
					setHidden(true);
				} else if (delta < -6) {
					setHidden(false);
				}

				lastY = y;
			};

			const onScroll = () => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					syncHeader();
					ticking = false;
				});
			};

			window.addEventListener('scroll', onScroll, { passive: true });
			syncHeader();

			document.addEventListener('command-menu:change', ((e: CustomEvent<{ open: boolean }>) => {
				menuBtn?.setAttribute('aria-expanded', e.detail.open ? 'true' : 'false');
				if (e.detail.open) setHidden(false);
			}) as EventListener);
		</script>
	</body>
</html>
