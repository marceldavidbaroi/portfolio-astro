---
import CommandMenu from '../components/CommandMenu.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import '../styles/tokens.css';
import '../styles/chrome.css';
import '../styles/ui.css';

interface Props {
	title?: string;
	description?: string;
	isWide?: boolean;
	alignStart?: boolean;
}

const {
	title = `${site.name} | Software Engineer`,
	description = `Portfolio & Case Studies of ${site.name}, Software Engineer specializing in Next.js, Vue/Quasar, NestJS, Flutter, PostgreSQL, and architecture-first systems.`,
	isWide = false,
	alignStart = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isWork = currentPath === '/work' || currentPath.startsWith('/work/');
const isNotes = currentPath === '/notes' || currentPath.startsWith('/notes/');
const isAbout =
	currentPath === '/about' ||
	currentPath.startsWith('/about/') ||
	['/skills', '/credentials', '/philosophy', '/archive', '/education', '/research', '/memories', '/gallery'].some(
		(root) => currentPath === root || currentPath.startsWith(`${root}/`)
	);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImageUrl = new URL('/og-preview.png', Astro.site ?? Astro.url.origin).href;

const personJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: site.name,
	jobTitle: 'Software Engineer',
	email: `mailto:${site.email}`,
	url: canonicalUrl,
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Dhaka',
		addressCountry: 'BD',
	},
	alumniOf: {
		'@type': 'CollegeOrUniversity',
		name: 'Daffodil International University',
	},
	sameAs: [site.github, site.linkedin],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Zero-Flash Theme Initializer -->
		<script is:inline>
			(function () {
				const storedTheme = localStorage.getItem('theme');
				if (storedTheme === 'dark' || storedTheme === 'light') {
					document.documentElement.dataset.theme = storedTheme;
				} else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					document.documentElement.dataset.theme = 'dark';
				} else {
					document.documentElement.dataset.theme = 'light';
				}
			})();
		</script>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
		<ClientRouter />
	</head>
	<body>
		<div class="layout-wrapper">
			<header id="site-header" class="header">
				<div class="header-container">
					<a href="/" class="header-brand" aria-label="Marcel David - Home">
						<span class="header-brand-name">Marcel David</span>
					</a>

					<nav class="nav" aria-label="Primary">
						<div class="nav-links">
							{isHome ? (
								<a href="/work" class="nav-link">Work</a>
							) : (
								<a href="/" class="nav-link">Home</a>
							)}

							<button
								id="header-more-btn"
								type="button"
								class="nav-more-btn"
								aria-label="More navigation links"
								aria-expanded="false"
								aria-haspopup="true"
							>
								<span>More</span>
							</button>

							<ThemeToggle />
						</div>
					</nav>
				</div>
			</header>

			<main class:list={['main-content', { 'wide-container': isWide, 'align-start': alignStart }]}>
				<slot />
			</main>

			<footer class="site-footer">
				<div class="footer-inner font-mono">
					<a href="/" class="footer-brand" aria-label="Marcel David Baroi" title="Marcel David Baroi">
						<img src="/images/signature.png" alt="Marcel David Baroi signature" class="footer-signature-img" />
					</a>
					<span class="footer-pill">Based in Dhaka (UTC+6) · 4–5 hrs overlap with US East &amp; EU CET</span>
					<span class="footer-sep" aria-hidden="true">·</span>
					<span class="footer-pill footer-pill-accent">Available for Full-Time · Remote / Relocation</span>
				</div>
			</footer>
		</div>

		<!-- Independent Floating Menu for Scrolled State -->
		<div id="floating-menu-container" class="floating-menu-container">
			<button
				id="floating-menu-btn"
				type="button"
				class="floating-menu-btn"
				aria-label="Toggle navigation menu"
				aria-expanded="false"
				aria-haspopup="true"
			>
				<span class="floating-menu-icon" aria-hidden="true">
					<span class="icon-line top-line"></span>
					<span class="icon-line bottom-line"></span>
				</span>
			</button>

			<div id="floating-dropdown" class="floating-dropdown" role="menu" hidden aria-hidden="true">
				<a href="/" role="menuitem" class:list={['floating-dropdown-item', { active: isHome }]}>
					<span>Home</span>
				</a>
				<a href="/work" role="menuitem" class:list={['floating-dropdown-item', { active: isWork }]}>
					<span>Work</span>
				</a>
				<a href="/about" role="menuitem" class:list={['floating-dropdown-item', { active: isAbout }]}>
					<span>About</span>
				</a>
				<a href="/skills" role="menuitem" class:list={['floating-dropdown-item', { active: currentPath.startsWith('/skills') }]}>
					<span>Skills</span>
				</a>
				<a href="/credentials" role="menuitem" class:list={['floating-dropdown-item', { active: currentPath.startsWith('/credentials') }]}>
					<span>Credentials</span>
				</a>
				<a href="/philosophy" role="menuitem" class:list={['floating-dropdown-item', { active: currentPath.startsWith('/philosophy') }]}>
					<span>Philosophy</span>
				</a>
				<a href="/archive" role="menuitem" class:list={['floating-dropdown-item', { active: currentPath.startsWith('/archive') }]}>
					<span>Archive</span>
				</a>
			</div>
		</div>

		<CommandMenu />

		<script>
			function initHeader() {
				const header = document.getElementById('site-header');
				const floatingContainer = document.getElementById('floating-menu-container');
				const menuBtn = document.getElementById('floating-menu-btn');
				const dropdown = document.getElementById('floating-dropdown');
				const moreBtn = document.getElementById('header-more-btn');

				let lastY = window.scrollY;
				let hidden = false;
				let ticking = false;

				const isMenuOpen = () => Boolean(dropdown && !dropdown.hidden);

				const closeMenu = () => {
					if (!dropdown || !menuBtn) return;
					dropdown.hidden = true;
					dropdown.setAttribute('aria-hidden', 'true');
					menuBtn.setAttribute('aria-expanded', 'false');
					menuBtn.classList.remove('is-open');
					header?.classList.remove('is-menu-open');
					floatingContainer?.classList.remove('is-menu-open');
					moreBtn?.setAttribute('aria-expanded', 'false');
				};

				const openMenu = () => {
					if (!dropdown || !menuBtn) return;
					dropdown.hidden = false;
					dropdown.setAttribute('aria-hidden', 'false');
					menuBtn.setAttribute('aria-expanded', 'true');
					menuBtn.classList.add('is-open');
					header?.classList.add('is-menu-open');
					floatingContainer?.classList.add('is-menu-open');
					moreBtn?.setAttribute('aria-expanded', 'true');
				};

				const toggleMenu = (e: MouseEvent) => {
					e.stopPropagation();
					if (isMenuOpen()) closeMenu();
					else openMenu();
				};

				menuBtn?.addEventListener('click', toggleMenu);
				moreBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					openMenu();
				});

				document.addEventListener('click', (e) => {
					const target = e.target as HTMLElement | null;
					if (isMenuOpen() && target && !dropdown?.contains(target) && !menuBtn?.contains(target) && !moreBtn?.contains(target)) {
						closeMenu();
					}
				});

				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && isMenuOpen()) {
						closeMenu();
						if (window.scrollY > 20) menuBtn?.focus();
						else moreBtn?.focus();
					}
				});

				const cmdkIsOpen = () => {
					const root = document.getElementById('command-menu');
					return Boolean(root && !root.hidden);
				};

				const setHidden = (next: boolean) => {
					hidden = next;
					header?.classList.toggle('is-hidden', hidden);
					if (hidden) {
						header?.setAttribute('inert', '');
						closeMenu();
					} else {
						header?.removeAttribute('inert');
					}
				};

				const syncHeader = () => {
					if (!header) return;
					const y = window.scrollY;
					const delta = y - lastY;
					const isScrolled = y > 20;
					header.classList.toggle('is-scrolled', isScrolled);
					floatingContainer?.classList.toggle('is-scrolled', isScrolled);

					const hold =
						cmdkIsOpen() ||
						isMenuOpen() ||
						header.contains(document.activeElement) ||
						y < 40;

					if (hold) {
						setHidden(false);
					} else if (delta > 6 && y > 72) {
						setHidden(true);
					} else if (delta < -6) {
						setHidden(false);
					}

					lastY = y;
				};

				const onScroll = () => {
					if (ticking) return;
					ticking = true;
					requestAnimationFrame(() => {
						syncHeader();
						ticking = false;
					});
				};

				window.addEventListener('scroll', onScroll, { passive: true });
				syncHeader();

				document.addEventListener('command-menu:change', ((e: CustomEvent<{ open: boolean }>) => {
					if (e.detail.open) {
						setHidden(false);
						closeMenu();
					}
				}) as EventListener);
			}

			initHeader();
			document.addEventListener('astro:page-load', initHeader);
		</script>
	</body>
</html>
