---
import CommandMenu from '../components/CommandMenu.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import '../styles/tokens.css';
import '../styles/chrome.css';
import '../styles/ui.css';

interface Props {
	title?: string;
	description?: string;
	isWide?: boolean;
	alignStart?: boolean;
}

const {
	title = `${site.name} | Software Engineer`,
	description = `Portfolio & Case Studies of ${site.name}, Software Engineer specializing in Next.js, Vue/Quasar, NestJS, Flutter, PostgreSQL, and architecture-first systems.`,
	isWide = false,
	alignStart = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isWork = currentPath === '/work' || currentPath.startsWith('/work/');
const isNotes = currentPath === '/notes' || currentPath.startsWith('/notes/');
const isAbout =
	currentPath === '/about' ||
	currentPath.startsWith('/about/') ||
	['/skills', '/credentials', '/philosophy', '/archive', '/education', '/research', '/memories', '/gallery'].some(
		(root) => currentPath === root || currentPath.startsWith(`${root}/`)
	);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImageUrl = new URL('/og-preview.png', Astro.site ?? Astro.url.origin).href;

const personJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: site.name,
	jobTitle: 'Software Engineer',
	email: `mailto:${site.email}`,
	url: canonicalUrl,
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Dhaka',
		addressCountry: 'BD',
	},
	alumniOf: {
		'@type': 'CollegeOrUniversity',
		name: 'Daffodil International University',
	},
	sameAs: [site.github, site.linkedin],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Zero-Flash Theme Initializer -->
		<script is:inline>
			function applyTheme() {
				const storedTheme = localStorage.getItem('theme');
				if (storedTheme === 'dark' || storedTheme === 'light') {
					document.documentElement.dataset.theme = storedTheme;
				} else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					document.documentElement.dataset.theme = 'dark';
				} else {
					document.documentElement.dataset.theme = 'light';
				}
			}
			applyTheme();
			document.addEventListener('astro:after-swap', applyTheme);
		</script>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
		<ClientRouter />
	</head>
	<body>
		<div class="layout-wrapper">
			<header id="site-header" class="header">
				<div class="header-container">
					<a href="/" class="header-brand" aria-label="Marcel David Baroi - Home">
						<span class="header-brand-name">Marcel David Baroi</span>
					</a>

					<nav class="nav" aria-label="Primary">
						<div class="nav-links">
							{isHome ? (
								<a href="/work" class="nav-link">Work</a>
							) : (
								<a href="/" class="nav-link">Home</a>
							)}

							<div class="nav-more-container">
								<button
									id="header-more-btn"
									type="button"
									class="nav-more-btn"
									aria-label="More navigation links"
									aria-expanded="false"
									aria-haspopup="true"
								>
									<span>More</span>
								</button>

								<div id="header-more-dropdown" class="nav-dropdown-menu" role="menu" hidden aria-hidden="true">
									<a href="/about" role="menuitem" class:list={['nav-dropdown-item', { active: isAbout }]}>
										<span>About</span>
									</a>
									<a href="/skills" role="menuitem" class:list={['nav-dropdown-item', { active: currentPath.startsWith('/skills') }]}>
										<span>Skills</span>
									</a>
									<a href="/credentials" role="menuitem" class:list={['nav-dropdown-item', { active: currentPath.startsWith('/credentials') }]}>
										<span>Credentials</span>
									</a>
									<a href="/philosophy" role="menuitem" class:list={['nav-dropdown-item', { active: currentPath.startsWith('/philosophy') }]}>
										<span>Philosophy</span>
									</a>
									<a href="/archive" role="menuitem" class:list={['nav-dropdown-item', { active: currentPath.startsWith('/archive') }]}>
										<span>Archive</span>
									</a>
								</div>
							</div>

							<ThemeToggle />
						</div>
					</nav>
				</div>
			</header>

			<main class:list={['main-content', { 'wide-container': isWide, 'align-start': alignStart }]}>
				<slot />
			</main>

			<footer class="site-footer">
				<div class="footer-inner font-mono">
					<a href="/" class="footer-brand" aria-label="Marcel David Baroi" title="Marcel David Baroi">
						<img src="/images/signature.png" alt="Marcel David Baroi signature" class="footer-signature-img" />
					</a>
					<span class="footer-pill">Based in Dhaka (UTC+6) · 4–5 hrs overlap with US East &amp; EU CET</span>
					<span class="footer-sep" aria-hidden="true">·</span>
					<span class="footer-pill footer-pill-accent">Available for Full-Time · Remote / Relocation</span>
				</div>
			</footer>
		</div>

		<!-- Floating Navigation Menu (Appears when scrolled) -->
		<div id="floating-menu-container" class="floating-menu-container">
			<button
				id="floating-menu-btn"
				type="button"
				class="floating-menu-btn"
				aria-label="Toggle navigation menu"
				aria-expanded="false"
				aria-haspopup="true"
			>
				<span class="floating-menu-icon" aria-hidden="true">
					<span class="icon-line top-line"></span>
					<span class="icon-line bottom-line"></span>
				</span>
			</button>

			<div id="floating-dropdown" class="floating-dropdown" role="menu" hidden aria-hidden="true">
				<a href="/" role="menuitem" class:list={['floating-dropdown-item', { active: isHome }]}>
					<span>Home</span>
				</a>
				<a href="/work" role="menuitem" class:list={['floating-dropdown-item', { active: isWork }]}>
					<span>Work</span>
				</a>
				<a href="/about" role="menuitem" class:list={['floating-dropdown-item', { active: isAbout }]}>
					<span>About</span>
				</a>
				<a href="/skills" role="menuitem" class:list={['floating-dropdown-item', { active: currentPath.startsWith('/skills') }]}>
					<span>Skills</span>
				</a>
				<a href="/credentials" role="menuitem" class:list={['floating-dropdown-item', { active: currentPath.startsWith('/credentials') }]}>
					<span>Credentials</span>
				</a>
				<a href="/philosophy" role="menuitem" class:list={['floating-dropdown-item', { active: currentPath.startsWith('/philosophy') }]}>
					<span>Philosophy</span>
				</a>
				<a href="/archive" role="menuitem" class:list={['floating-dropdown-item', { active: currentPath.startsWith('/archive') }]}>
					<span>Archive</span>
				</a>
			</div>
		</div>

		<CommandMenu />

		<script>
			function initHeader() {
				const moreBtn = document.getElementById('header-more-btn');
				const headerDropdown = document.getElementById('header-more-dropdown');
				const floatingContainer = document.getElementById('floating-menu-container');
				const floatingBtn = document.getElementById('floating-menu-btn');
				const floatingDropdown = document.getElementById('floating-dropdown');

				let ticking = false;

				const isHeaderMenuOpen = () => Boolean(headerDropdown && !headerDropdown.hidden);
				const isFloatingMenuOpen = () => Boolean(floatingDropdown && !floatingDropdown.hidden);

				const closeHeaderMenu = () => {
					if (!headerDropdown || !moreBtn) return;
					headerDropdown.hidden = true;
					headerDropdown.setAttribute('aria-hidden', 'true');
					moreBtn.setAttribute('aria-expanded', 'false');
					moreBtn.classList.remove('is-open');
				};

				const openHeaderMenu = () => {
					if (!headerDropdown || !moreBtn) return;
					closeFloatingMenu();
					headerDropdown.hidden = false;
					headerDropdown.setAttribute('aria-hidden', 'false');
					moreBtn.setAttribute('aria-expanded', 'true');
					moreBtn.classList.add('is-open');
				};

				const closeFloatingMenu = () => {
					if (!floatingDropdown || !floatingBtn) return;
					floatingDropdown.hidden = true;
					floatingDropdown.setAttribute('aria-hidden', 'true');
					floatingBtn.setAttribute('aria-expanded', 'false');
					floatingBtn.classList.remove('is-open');
					floatingContainer?.classList.remove('is-menu-open');
				};

				const openFloatingMenu = () => {
					if (!floatingDropdown || !floatingBtn) return;
					closeHeaderMenu();
					floatingDropdown.hidden = false;
					floatingDropdown.setAttribute('aria-hidden', 'false');
					floatingBtn.setAttribute('aria-expanded', 'true');
					floatingBtn.classList.add('is-open');
					floatingContainer?.classList.add('is-menu-open');
				};

				moreBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					if (isHeaderMenuOpen()) closeHeaderMenu();
					else openHeaderMenu();
				});

				floatingBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					if (isFloatingMenuOpen()) closeFloatingMenu();
					else openFloatingMenu();
				});

				document.addEventListener('click', (e) => {
					const target = e.target as HTMLElement | null;
					if (isHeaderMenuOpen() && target && !headerDropdown?.contains(target) && !moreBtn?.contains(target)) {
						closeHeaderMenu();
					}
					if (isFloatingMenuOpen() && target && !floatingDropdown?.contains(target) && !floatingBtn?.contains(target)) {
						closeFloatingMenu();
					}
				});

				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') {
						if (isHeaderMenuOpen()) {
							closeHeaderMenu();
							moreBtn?.focus();
						}
						if (isFloatingMenuOpen()) {
							closeFloatingMenu();
							floatingBtn?.focus();
						}
					}
				});

				const syncScroll = () => {
					const isScrolled = window.scrollY > 60;
					floatingContainer?.classList.toggle('is-scrolled', isScrolled);
				};

				const onScroll = () => {
					if (ticking) return;
					ticking = true;
					requestAnimationFrame(() => {
						syncScroll();
						ticking = false;
					});
				};

				window.addEventListener('scroll', onScroll, { passive: true });
				syncScroll();

				document.addEventListener('command-menu:change', ((e: CustomEvent<{ open: boolean }>) => {
					if (e.detail.open) {
						closeHeaderMenu();
						closeFloatingMenu();
					}
				}) as EventListener);
			}

			initHeader();
			document.addEventListener('astro:page-load', initHeader);
		</script>
	</body>
</html>
