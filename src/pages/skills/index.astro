---
import BaseLayout from '../../layouts/BaseLayout.astro';

const skillCategories = [
	{
		id: 'engineering-workflow',
		category: 'Engineering Workflow & Architecture',
		tag: 'SYSTEM SYNTHESIS',
		icon: '⚡',
		description: 'Core architectural methodologies and engineering processes applied across production ecosystems.',
		items: [
			{ name: 'Architecture-First AI Synthesis', desc: 'Pre-planning schemas, dependency trees, and specs before code generation (Cursor Agentic, Copilot).' },
			{ name: 'Relational Data Modeling', desc: 'Third Normal Form (3NF) relational design, explicit constraints, foreign key cascades, and complex indexing.' },
			{ name: 'Systematic Code Validation', desc: 'Rigorous regression testing, type checking, edge-case validation, and clean code hygiene.' },
			{ name: 'Modular Infrastructure', desc: 'Extracting reusable enterprise logic into private npm packages governed by SemVer.' },
			{ name: 'Rapid MVP Scaffolding', desc: 'Accelerated development of production-ready SaaS foundations and end-to-end prototypes.' }
		]
	},
	{
		id: 'backend-cloud',
		category: 'Backend & Cloud Services',
		tag: 'DATA & APIS',
		icon: '⚙️',
		description: 'Server architectures, secure data access layers, relational database engines, and cloud persistence.',
		items: [
			{ name: 'PHP (Core & MVC Architecture)', desc: 'Enterprise business logic, custom MVC engines, ERP costing routines, and legacy migration.' },
			{ name: 'PostgreSQL & Database Optimization', desc: 'Relational schema design, complex JOINs, query indexing, execution plans, and views.' },
			{ name: 'Supabase (Realtime & RLS)', desc: 'Multi-tenant tenant isolation, Row-Level Security (RLS) policies, and Realtime event subscriptions.' },
			{ name: 'NestJS & Node.js', desc: 'Enterprise modular backend structures, dependency injection, and scalable microservice APIs.' },
			{ name: 'Express & RESTful APIs', desc: 'Lightweight API endpoints, JWT token authentication, middleware pipelines, and CORS governance.' },
			{ name: 'TypeORM & Prisma ORM', desc: 'Type-safe database migrations, entity relationships, query builders, and database seeds.' },
			{ name: 'MongoDB', desc: 'Document data modeling, schema indexing, aggregation pipelines, and flexible datastores.' }
		]
	},
	{
		id: 'frontend-mobile',
		category: 'Frontend & Mobile Ecosystem',
		tag: 'USER INTERFACES',
		icon: '💻',
		description: 'Modern reactive component frameworks, type-safe interfaces, state stores, and cross-platform apps.',
		items: [
			{ name: 'Vue.js (v2 / v3 Composition API)', desc: 'Reactive component architectures, custom hooks, reusable directives, and high-performance render trees.' },
			{ name: 'Quasar Framework', desc: 'Enterprise SPA/PWA application suites, table data virtualization, and responsive layouts.' },
			{ name: 'TypeScript & JavaScript (ES6+)', desc: 'Strict compile-time type safety, generic interfaces, utility types, and asynchronous concurrency.' },
			{ name: 'React & Next.js (App Router)', desc: 'Server-side rendering, React Server Components (RSC), dynamic routing, and performant state.' },
			{ name: 'React Native & Mobile Development', desc: 'Cross-platform mobile applications, native bridges, offline persistence, and touch ergonomics.' },
			{ name: 'Pinia & Vuex State Management', desc: 'Centralized reactive store design, persistent state plugins, action dispatchers, and modular state.' }
		]
	},
	{
		id: 'devops-infra',
		category: 'Architecture, Versioning & DevOps',
		tag: 'INFRASTRUCTURE',
		icon: '🛡️',
		description: 'Enterprise repository governance, packaging, containerization, and multi-tenant security.',
		items: [
			{ name: 'Multi-Tenant SaaS Security', desc: 'Strict organizational data segregation, tenant context injection, and role-based access control (RBAC).' },
			{ name: 'Private Git Registries & SemVer', desc: 'Deploying versioned enterprise packages across private GitLab/GitHub registries with strict SemVer.' },
			{ name: 'Git Submodules & Monorepos', desc: 'Coordinated multi-repository synchronization and shared library infrastructure.' },
			{ name: 'Tailwind CSS & ShadCN UI', desc: 'Utility-first modern design systems, accessible UI primitives, and glassmorphism styling.' },
			{ name: 'Figma to Code Implementation', desc: 'Translating high-fidelity Figma visual designs into pixel-perfect, accessible HTML/CSS components.' },
			{ name: 'Docker & Containerization', desc: 'Consistent local development environments, containerized services, and CI/CD pipelines.' }
		]
	}
];
---

<BaseLayout
	title="Technical Capabilities & Skill Matrix | Marcel David Baroi"
	description="Comprehensive breakdown of technologies, frameworks, relational database architectures, and engineering workflow tools mastered by Marcel David Baroi."
	isWide={true}
>
	<div class="skills-page-container">
		<!-- Breadcrumbs -->
		<nav class="page-breadcrumb font-mono" aria-label="Breadcrumb">
			<a href="/" class="b-link">Home</a>
			<span class="b-sep">/</span>
			<a href="/about" class="b-link">About</a>
			<span class="b-sep">/</span>
			<span class="b-curr">Technical Capabilities</span>
		</nav>

		<!-- Hero Header -->
		<header class="skills-hero card">
			<div class="hero-top-meta">
				<span class="section-tag font-dot">02 // CAPABILITIES MATRIX</span>
				<span class="badge-status success font-mono">Production Verified</span>
			</div>

			<h1 class="skills-title font-dot">Technical Capabilities & Skill Matrix</h1>
			<p class="skills-subtitle font-dot">Full-Stack System Architecture • Reactive Frontends • Secure Data Stores</p>

			<p class="skills-intro">
				A comprehensive directory of technologies, architectures, and engineering methodologies refined across enterprise platforms, multi-tenant SaaS systems, and high-performance applications.
			</p>

			<div class="skills-quick-jump font-mono">
				<span class="jump-lbl font-mono">JUMP TO:</span>
				<a href="#engineering-workflow" class="j-btn">Workflow & Synthesis</a>
				<a href="#backend-cloud" class="j-btn">Backend & Cloud</a>
				<a href="#frontend-mobile" class="j-btn">Frontend & Mobile</a>
				<a href="#devops-infra" class="j-btn">DevOps & Architecture</a>
			</div>
		</header>

		<!-- Skill Categories Deep Dive -->
		<div class="categories-container">
			{skillCategories.map((cat, idx) => (
				<section class="cat-section card" id={cat.id}>
					<div class="cat-header">
						<div class="cat-title-wrap">
							<span class="cat-num font-mono">{`0${idx + 1}`} // {cat.tag}</span>
							<h2 class="cat-h2 font-dot">{cat.category}</h2>
						</div>
						<span class="cat-icon">{cat.icon}</span>
					</div>

					<p class="cat-desc">{cat.description}</p>

					<div class="cat-items-grid">
						{cat.items.map((item) => (
							<div class="cat-item-card card">
								<div class="item-top">
									<span class="item-dot"></span>
									<h3 class="item-name">{item.name}</h3>
								</div>
								<p class="item-desc">{item.desc}</p>
							</div>
						))}
					</div>
				</section>
			))}
		</div>

		<!-- Cross Navigation -->
		<div class="skills-cross-nav card">
			<div class="nav-col">
				<span class="nav-lbl font-mono">EXECUTIVE PROFILE</span>
				<a href="/about" class="nav-link">← Return to About Profile</a>
			</div>
			<div class="nav-col">
				<span class="nav-lbl font-mono">CREDENTIALS</span>
				<a href="/credentials" class="nav-link">Verified Certifications →</a>
			</div>
			<div class="nav-col">
				<span class="nav-lbl font-mono">PROVEN WORK</span>
				<a href="/work" class="nav-link">Explore Case Studies →</a>
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	.skills-page-container {
		width: 100%;
		max-width: 1080px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		padding: 1rem 1rem 4rem;
		text-align: left;
	}

	/* Breadcrumb */
	.page-breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.b-link {
		color: var(--text-muted);
		transition: color 0.15s ease;
	}

	.b-link:hover {
		color: var(--accent);
	}

	.b-sep {
		opacity: 0.4;
	}

	.b-curr {
		color: var(--accent);
		font-weight: 600;
	}

	/* Hero */
	.skills-hero {
		padding: 2.25rem;
		border-radius: 16px;
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
		background: linear-gradient(135deg, var(--card-bg) 0%, rgba(180, 33, 53, 0.03) 100%);
		border: 1px solid rgba(180, 33, 53, 0.2);
	}

	.hero-top-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.badge-status.success {
		font-size: 0.72rem;
		padding: 0.2rem 0.65rem;
		border-radius: 9999px;
		background: rgba(46, 125, 50, 0.12);
		color: #2e7d32;
		border: 1px solid rgba(46, 125, 50, 0.25);
		font-weight: 700;
	}

	.skills-title {
		font-size: clamp(1.85rem, 3.5vw, 2.5rem);
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.2;
	}

	.skills-subtitle {
		font-size: 1rem;
		color: var(--accent);
	}

	.skills-intro {
		font-size: 0.92rem;
		line-height: 1.65;
		color: var(--text-muted);
		max-width: 860px;
	}

	.skills-quick-jump {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
		padding-top: 0.85rem;
		border-top: 1px dashed rgba(95, 80, 56, 0.15);
	}

	.jump-lbl {
		font-size: 0.72rem;
		color: var(--text-muted);
		font-weight: 700;
	}

	.j-btn {
		font-size: 0.76rem;
		padding: 0.3rem 0.65rem;
		background: rgba(95, 80, 56, 0.06);
		color: var(--text-main);
		border-radius: 6px;
		border: 1px solid rgba(95, 80, 56, 0.12);
		transition: all 0.15s ease;
	}

	.j-btn:hover {
		background: var(--accent);
		color: #fffdfa;
		border-color: var(--accent);
	}

	/* Categories */
	.categories-container {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.cat-section {
		padding: 2rem;
		border-radius: 16px;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
	}

	.cat-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.cat-title-wrap {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.cat-num {
		font-size: 0.72rem;
		color: var(--accent);
		letter-spacing: 0.08em;
		font-weight: 700;
	}

	.cat-h2 {
		font-size: clamp(1.35rem, 2.5vw, 1.75rem);
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.3;
	}

	.cat-icon {
		font-size: 1.75rem;
		line-height: 1;
	}

	.cat-desc {
		font-size: 0.88rem;
		line-height: 1.6;
		color: var(--text-muted);
		max-width: 820px;
	}

	.cat-items-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
		margin-top: 0.5rem;
	}

	@media (max-width: 768px) {
		.cat-items-grid {
			grid-template-columns: 1fr;
		}
	}

	.cat-item-card {
		padding: 1.25rem 1.4rem;
		border-radius: 12px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		transition: all 0.15s ease;
	}

	.cat-item-card:hover {
		border-color: rgba(180, 33, 53, 0.4);
		transform: translateY(-2px);
	}

	.item-top {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.item-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
		flex-shrink: 0;
	}

	.item-name {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--text-main);
	}

	.item-desc {
		font-size: 0.82rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	/* Cross Navigation */
	.skills-cross-nav {
		padding: 1.75rem 2rem;
		border-radius: 16px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.nav-col {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.nav-lbl {
		font-size: 0.72rem;
		color: var(--text-muted);
		letter-spacing: 0.05em;
	}

	.nav-link {
		font-size: 0.92rem;
		color: var(--accent);
		font-weight: 700;
		transition: all 0.15s ease;
	}

	.nav-link:hover {
		color: var(--accent-hover);
		transform: translateX(2px);
	}
</style>
