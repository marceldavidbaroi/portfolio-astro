---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtticBreadcrumb from '../../components/about/AtticBreadcrumb.astro';
import { skillCategories } from '../../data/aboutData';
import '../../styles/about.css';

const totalCount = skillCategories.reduce((acc, cat) => acc + cat.items.length, 0);
const primaryCount = skillCategories.reduce((acc, cat) => acc + cat.items.filter((i) => i.tier === 'primary').length, 0);
const priorCount = skillCategories.reduce((acc, cat) => acc + cat.items.filter((i) => i.tier === 'secondary').length, 0);

---

<BaseLayout
	title="Technical Capabilities & Skill Matrix | Marcel David Baroi"
	description="Comprehensive breakdown of primary production technologies, relational database architectures, and secondary exposure tools mastered by Marcel David Baroi."
	isWide
	alignStart
>
	<AtticBreadcrumb current="Skills" />

	<header class="about-attic-head">
		<p class="label font-mono about-attic-kicker">Skills</p>
		<h1 class="about-attic-title">Technical capabilities</h1>
		<p class="about-attic-lead">
			Primary production stack versus prior tools and migration exposure — names, descriptions, and hire-me-for-this tiering.
		</p>
	</header>

	<div class="skills-tabs-container">
		<div class="about-tabs" role="tablist" aria-label="Filter skills by tier" id="skills-tabs">
			<button class="about-tab is-active font-mono" type="button" data-tier="all" role="tab" aria-selected="true">
				All <span class="about-tab-count">{totalCount}</span>
			</button>
			<button class="about-tab font-mono" type="button" data-tier="primary" role="tab" aria-selected="false">
				Primary <span class="about-tab-count">{primaryCount}</span>
			</button>
			<button class="about-tab font-mono" type="button" data-tier="prior" role="tab" aria-selected="false">
				Prior <span class="about-tab-count">{priorCount}</span>
			</button>
			<span class="skills-tab-indicator" id="skills-tab-indicator" aria-hidden="true"></span>
		</div>
	</div>

	<div id="skills-categories" class="skills-categories-wrapper">
		{skillCategories.map((cat) => (
			<section class="about-section about-stack-block skills-category-section" id={cat.id} data-category={cat.id}>
				<div class="skills-category-header">
					<div class="skills-category-title-group">
						<div>
							<h2 class="skills-category-title">{cat.category}</h2>
							<p class="skills-category-desc">{cat.description}</p>
						</div>
					</div>
					<span class="skills-category-tag font-mono">{cat.tag}</span>
				</div>

				<div class="skills-grid">
					{cat.items.map((skill) => (
						<div
							class:list={['skill-item', { 'is-prior-item': skill.tier === 'secondary' }]}
							data-tier={skill.tier === 'secondary' ? 'prior' : 'primary'}
							data-category={cat.id}
						>
							<div class="skill-item-media">
								{skill.logo ? (
									<img src={skill.logo} alt="" class="skill-item-logo" loading="lazy" aria-hidden="true" />
								) : (
									<span class="skill-item-icon" aria-hidden="true">{skill.icon || '•'}</span>
								)}
							</div>
							<p class="skill-item-name">{skill.name}</p>
						</div>
					))}
				</div>
			</section>
		))}
	</div>

	<a href="/about" class="about-return font-mono">← About</a>
</BaseLayout>

<script>
	function initSkillsFilter() {
		const tabsWrap = document.getElementById('skills-tabs');
		const indicator = document.getElementById('skills-tab-indicator');
		const tabs = document.querySelectorAll<HTMLButtonElement>('#skills-tabs .about-tab');
		const items = document.querySelectorAll<HTMLElement>('.skill-item');
		const sections = document.querySelectorAll<HTMLElement>('[data-category]');
		if (!tabsWrap || !tabs.length) return;

		const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let currentTier = 'all';

		// 1. Sliding Tab Indicator Positioning
		function updateIndicator(activeTab: HTMLElement) {
			if (!indicator || prefersReduced) return;
			const wrapRect = tabsWrap!.getBoundingClientRect();
			const tabRect = activeTab.getBoundingClientRect();
			const left = tabRect.left - wrapRect.left;
			const width = tabRect.width;

			indicator.style.transform = `translateX(${left}px)`;
			indicator.style.width = `${width}px`;
			indicator.style.opacity = '1';
		}

		const initialActive = document.querySelector<HTMLButtonElement>('#skills-tabs .about-tab.is-active') || tabs[0];
		if (initialActive) {
			updateIndicator(initialActive);
		}

		// 2. Animated Cross-Fade Filter
		function applyFilter(targetTier: string) {
			if (prefersReduced) {
				items.forEach((item) => {
					const itemTier = item.dataset.tier || 'primary';
					item.hidden = !(targetTier === 'all' || itemTier === targetTier);
					item.classList.remove('is-fading-out');
				});
				sections.forEach((section) => {
					const visible = section.querySelectorAll('.skill-item:not([hidden])').length > 0;
					section.hidden = !visible;
				});
				return;
			}

			// Fade out departing items
			const departing: HTMLElement[] = [];
			const arriving: HTMLElement[] = [];

			items.forEach((item) => {
				const itemTier = item.dataset.tier || 'primary';
				const willBeVisible = targetTier === 'all' || itemTier === targetTier;
				const isCurrentlyVisible = !item.hidden;

				if (isCurrentlyVisible && !willBeVisible) {
					departing.push(item);
				} else if (!isCurrentlyVisible && willBeVisible) {
					arriving.push(item);
				}
			});

			if (departing.length > 0) {
				departing.forEach((item) => item.classList.add('is-fading-out'));

				setTimeout(() => {
					departing.forEach((item) => {
						item.hidden = true;
						item.classList.remove('is-fading-out');
					});

					arriving.forEach((item) => {
						item.hidden = false;
						item.classList.add('is-settling-in');
						requestAnimationFrame(() => {
							item.classList.remove('is-settling-in');
						});
					});

					sections.forEach((section) => {
						const visible = section.querySelectorAll('.skill-item:not([hidden])').length > 0;
						section.hidden = !visible;
					});
				}, 150);
			} else {
				arriving.forEach((item) => {
					item.hidden = false;
					item.classList.add('is-settling-in');
					requestAnimationFrame(() => {
						item.classList.remove('is-settling-in');
					});
				});

				sections.forEach((section) => {
					const visible = section.querySelectorAll('.skill-item:not([hidden])').length > 0;
					section.hidden = !visible;
				});
			}
		}

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				currentTier = tab.dataset.tier || 'all';
				tabs.forEach((t) => {
					const active = t === tab;
					t.classList.toggle('is-active', active);
					t.setAttribute('aria-selected', active ? 'true' : 'false');
				});
				updateIndicator(tab);
				applyFilter(currentTier);
			});
		});

		window.addEventListener('resize', () => {
			const active = document.querySelector<HTMLButtonElement>('#skills-tabs .about-tab.is-active');
			if (active) updateIndicator(active);
		}, { passive: true });
	}

	initSkillsFilter();
	document.addEventListener('astro:page-load', initSkillsFilter);
</script>

<style>
	.skills-tabs-container {
		position: relative;
		margin-bottom: 0.5rem;
	}

	.about-tabs {
		position: relative;
		border-bottom: 1px solid rgba(95, 80, 56, 0.12);
	}

	/* Disable static border-bottom on active tab in favor of the animated indicator */
	.about-tabs .about-tab {
		border-bottom: 2px solid transparent !important;
	}

	.skills-tab-indicator {
		position: absolute;
		bottom: -1px;
		left: 0;
		height: 2px;
		background: var(--accent);
		opacity: 0;
		transition:
			transform var(--dur-ui, 220ms) var(--ease-ui, cubic-bezier(0.22, 1, 0.36, 1)),
			width var(--dur-ui, 220ms) var(--ease-ui, cubic-bezier(0.22, 1, 0.36, 1)),
			opacity var(--dur-fast, 150ms) ease;
		pointer-events: none;
		will-change: transform, width;
	}

	/* Category and Skill Card entrance & cross-fade states */
	.skill-item {
		transition:
			opacity 150ms var(--ease-out),
			transform 150ms var(--ease-out),
			border-color var(--dur-fast) ease,
			background-color var(--dur-fast) ease,
			box-shadow var(--dur-ui) ease;
		will-change: opacity, transform;
	}

	.skill-item.is-fading-out {
		opacity: 0;
		transform: scale(0.97);
	}

	.skill-item.is-settling-in {
		opacity: 0;
		transform: scale(0.97);
	}

	@media (prefers-reduced-motion: reduce) {
		.skills-tab-indicator {
			display: none;
		}

		.about-tabs .about-tab.is-active {
			border-bottom-color: var(--accent) !important;
		}

		.skill-item {
			opacity: 1 !important;
			transform: none !important;
			transition: none !important;
		}
	}
</style>
