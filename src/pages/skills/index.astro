---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { skillCategories } from '../../data/aboutData';

const totalCount = skillCategories.reduce((acc, cat) => acc + cat.items.length, 0);
const primaryCount = skillCategories.reduce((acc, cat) => acc + cat.items.filter((i) => i.tier === 'primary').length, 0);
const secondaryCount = skillCategories.reduce((acc, cat) => acc + cat.items.filter((i) => i.tier === 'secondary').length, 0);
---

<BaseLayout
	title="Technical Capabilities & Skill Matrix | Marcel David Baroi"
	description="Comprehensive breakdown of primary production technologies, relational database architectures, and secondary exposure tools mastered by Marcel David Baroi."
	isWide={true}
>
	<div class="skills-page-container">
		<!-- Breadcrumbs -->
		<nav class="page-breadcrumb font-mono" aria-label="Breadcrumb">
			<a href="/" class="b-link">Home</a>
			<span class="b-sep">/</span>
			<a href="/about" class="b-link">About</a>
			<span class="b-sep">/</span>
			<span class="b-curr">Technical Capabilities</span>
		</nav>

		<!-- Hero Header -->
		<header class="skills-hero card">
			<div class="hero-top-meta">
				<span class="section-tag font-dot">02 // CAPABILITIES MATRIX</span>
				<div class="hero-badges font-mono">
					<span class="badge-status success font-mono">Production Verified</span>
					<span class="badge-status triage font-mono">Recruiter Triage Ready</span>
				</div>
			</div>

			<h1 class="skills-title font-dot">Technical Capabilities & Skill Matrix</h1>
			<p class="skills-subtitle font-dot">Primary Production Stack • Secondary Exposure • Enterprise Architectural Depth</p>

			<p class="skills-intro">
				A rigorous directory of engineering methodologies, reactive frameworks, database architectures, and infrastructure tooling categorized by <strong>Primary Production Drivers</strong> (active focus for immediate hire) versus <strong>Secondary Exposure</strong> (prior systems & legacy migration competencies).
			</p>

			<!-- Recruiter Triage Tiering Callout -->
			<div class="triage-callout-grid">
				<div class="triage-card primary-triage">
					<div class="triage-header">
						<span class="triage-indicator primary-indicator"></span>
						<h2 class="triage-title font-dot">Primary Production Stack</h2>
						<span class="triage-badge font-mono">HIRE ME FOR THIS TODAY</span>
					</div>
					<p class="triage-desc">
						Active daily production drivers with deep architectural ownership. Proven in live enterprise SaaS, multi-tenant PostgreSQL RLS architectures, reactive Vue 3 / Next.js suites, and private SemVer package ecosystems.
					</p>
					<div class="triage-stack-pills font-mono">
						<span class="t-pill">TypeScript</span>
						<span class="t-pill">Vue 3 / Composition API</span>
						<span class="t-pill">Quasar Framework</span>
						<span class="t-pill">React / Next.js</span>
						<span class="t-pill">PostgreSQL & RLS</span>
						<span class="t-pill">Supabase Realtime</span>
						<span class="t-pill">NestJS / Node.js</span>
						<span class="t-pill">Docker</span>
					</div>
				</div>

				<div class="triage-card secondary-triage">
					<div class="triage-header">
						<span class="triage-indicator secondary-indicator"></span>
						<h2 class="triage-title font-dot">Secondary Exposure & Prior Systems</h2>
						<span class="triage-badge secondary font-mono">PRIOR TOOLS & MIGRATION</span>
					</div>
					<p class="triage-desc">
						Prior production ecosystems, legacy ERP maintenance, and auxiliary tools. Experienced in refactoring legacy procedural/MVC architectures, migrating data models, and cross-platform mobile development.
					</p>
					<div class="triage-stack-pills font-mono">
						<span class="t-pill sec">PHP Core & MVC</span>
						<span class="t-pill sec">Vue 2 / Vuex</span>
						<span class="t-pill sec">MongoDB</span>
						<span class="t-pill sec">React Native</span>
						<span class="t-pill sec">TypeORM / Prisma</span>
					</div>
				</div>
			</div>

			<!-- Interactive Filter & Navigation Bar -->
			<div class="filter-and-nav-bar">
				<div class="filter-tabs-group" role="tablist" aria-label="Filter skills by tier">
					<button class="filter-tab active font-mono" data-tier-filter="all" role="tab" aria-selected="true">
						All Capabilities <span class="tab-count font-mono">({totalCount})</span>
					</button>
					<button class="filter-tab font-mono" data-tier-filter="primary" role="tab" aria-selected="false">
						<span class="btn-dot primary"></span>
						Primary Production Stack <span class="tab-count font-mono">({primaryCount})</span>
					</button>
					<button class="filter-tab font-mono" data-tier-filter="secondary" role="tab" aria-selected="false">
						<span class="btn-dot secondary"></span>
						Secondary Exposure <span class="tab-count font-mono">({secondaryCount})</span>
					</button>
				</div>

				<div class="skills-quick-jump font-mono">
					<span class="jump-lbl font-mono">JUMP TO:</span>
					<a href="#engineering-workflow" class="j-btn">⚡ Workflow & AI</a>
					<a href="#backend-cloud" class="j-btn">⚙️ Backend & Cloud</a>
					<a href="#frontend-mobile" class="j-btn">💻 Frontend & Mobile</a>
					<a href="#devops-infra" class="j-btn">🛡️ DevOps & Infra</a>
				</div>
			</div>
		</header>

		<!-- Skill Categories Deep Dive -->
		<div class="categories-container" id="categories-container">
			{skillCategories.map((cat, idx) => (
				<section class="cat-section card" id={cat.id} data-cat-id={cat.id}>
					<div class="cat-header">
						<div class="cat-title-wrap">
							<span class="cat-num font-mono">{`0${idx + 1}`} // {cat.tag}</span>
							<h2 class="cat-h2 font-dot">{cat.category}</h2>
						</div>
						<span class="cat-icon">{cat.icon}</span>
					</div>

					<p class="cat-desc">{cat.description}</p>

					<div class="cat-items-grid">
						{cat.items.map((item) => (
							<div
								class:list={['cat-item-card card', { 'item-primary': item.tier === 'primary', 'item-secondary': item.tier === 'secondary' }]}
								data-skill-tier={item.tier}
							>
								<div class="item-top">
									<div class="item-title-row">
										<span class:list={['item-dot', { 'dot-primary': item.tier === 'primary', 'dot-secondary': item.tier === 'secondary' }]}></span>
										<h3 class="item-name">{item.name}</h3>
									</div>
									<span class:list={['tier-badge font-mono', { 'badge-primary': item.tier === 'primary', 'badge-secondary': item.tier === 'secondary' }]}>
										{item.tier === 'primary' ? '🟢 PRIMARY PRODUCTION' : '⚪ SECONDARY / PRIOR'}
									</span>
								</div>
								<div class="item-context font-mono">
									{item.tier === 'primary' ? 'Active Production Driver • Primary Hiring Focus' : 'Prior Production & Legacy Migration Experience'}
								</div>
								<p class="item-desc">{item.desc}</p>
							</div>
						))}
					</div>
				</section>
			))}
		</div>

		<!-- Cross Navigation -->
		<div class="skills-cross-nav card">
			<div class="nav-col">
				<span class="nav-lbl font-mono">EXECUTIVE PROFILE</span>
				<a href="/about" class="nav-link">← Return to About Profile</a>
			</div>
			<div class="nav-col">
				<span class="nav-lbl font-mono">CREDENTIALS</span>
				<a href="/credentials" class="nav-link">Verified Certifications →</a>
			</div>
			<div class="nav-col">
				<span class="nav-lbl font-mono">PROVEN WORK</span>
				<a href="/work" class="nav-link">Explore Case Studies →</a>
			</div>
		</div>
	</div>
</BaseLayout>

<script>
	function setupSkillFilters() {
		const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-tier-filter]');
		const skillCards = document.querySelectorAll<HTMLElement>('[data-skill-tier]');
		const categorySections = document.querySelectorAll<HTMLElement>('[data-cat-id]');

		filterButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const selectedTier = btn.getAttribute('data-tier-filter');

				// Update active tab states
				filterButtons.forEach((b) => {
					b.classList.remove('active');
					b.setAttribute('aria-selected', 'false');
				});
				btn.classList.add('active');
				btn.setAttribute('aria-selected', 'true');

				// Filter skill cards
				skillCards.forEach((card) => {
					const cardTier = card.getAttribute('data-skill-tier');
					if (selectedTier === 'all' || cardTier === selectedTier) {
						card.style.display = 'flex';
					} else {
						card.style.display = 'none';
					}
				});

				// Check category visibility (hide sections that have 0 visible cards)
				categorySections.forEach((sec) => {
					const visibleCards = sec.querySelectorAll<HTMLElement>('[data-skill-tier]:not([style*="display: none"])');
					if (visibleCards.length === 0) {
						sec.style.display = 'none';
					} else {
						sec.style.display = 'flex';
					}
				});
			});
		});
	}

	// Initialize on page load and view transitions
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupSkillFilters);
	} else {
		setupSkillFilters();
	}
	document.addEventListener('astro:page-load', setupSkillFilters);
</script>

<style>
	.skills-page-container {
		width: 100%;
		max-width: 1080px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		padding: 1rem 1rem 4rem;
		text-align: left;
	}

	/* Breadcrumb */
	.page-breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.b-link {
		color: var(--text-muted);
		transition: color 0.15s ease;
	}

	.b-link:hover {
		color: var(--accent);
	}

	.b-sep {
		opacity: 0.4;
	}

	.b-curr {
		color: var(--accent);
		font-weight: 600;
	}

	/* Hero */
	.skills-hero {
		padding: 2.25rem;
		border-radius: 16px;
		display: flex;
		flex-direction: column;
		gap: 1.35rem;
		background: linear-gradient(135deg, var(--card-bg) 0%, rgba(180, 33, 53, 0.03) 100%);
		border: 1px solid rgba(180, 33, 53, 0.2);
	}

	.hero-top-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.hero-badges {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.badge-status.success {
		font-size: 0.72rem;
		padding: 0.2rem 0.65rem;
		border-radius: 9999px;
		background: rgba(46, 125, 50, 0.12);
		color: #2e7d32;
		border: 1px solid rgba(46, 125, 50, 0.25);
		font-weight: 700;
	}

	.badge-status.triage {
		font-size: 0.72rem;
		padding: 0.2rem 0.65rem;
		border-radius: 9999px;
		background: rgba(180, 33, 53, 0.08);
		color: var(--accent);
		border: 1px solid rgba(180, 33, 53, 0.25);
		font-weight: 700;
	}

	.skills-title {
		font-size: clamp(1.85rem, 3.5vw, 2.5rem);
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.2;
	}

	.skills-subtitle {
		font-size: 1rem;
		color: var(--accent);
	}

	.skills-intro {
		font-size: 0.92rem;
		line-height: 1.65;
		color: var(--text-muted);
		max-width: 920px;
	}

	/* Recruiter Triage Callout Cards */
	.triage-callout-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
		margin-top: 0.5rem;
	}

	@media (max-width: 768px) {
		.triage-callout-grid {
			grid-template-columns: 1fr;
		}
	}

	.triage-card {
		padding: 1.35rem 1.5rem;
		border-radius: 12px;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		transition: all 0.2s ease;
	}

	.triage-card.primary-triage {
		background: rgba(46, 125, 50, 0.05);
		border: 1px solid rgba(46, 125, 50, 0.25);
	}

	.triage-card.primary-triage:hover {
		border-color: rgba(46, 125, 50, 0.45);
		box-shadow: 0 4px 12px rgba(46, 125, 50, 0.08);
	}

	.triage-card.secondary-triage {
		background: rgba(95, 80, 56, 0.04);
		border: 1px solid rgba(95, 80, 56, 0.15);
	}

	.triage-card.secondary-triage:hover {
		border-color: rgba(95, 80, 56, 0.3);
	}

	.triage-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.triage-indicator {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		flex-shrink: 0;
	}

	.triage-indicator.primary-indicator {
		background: #2e7d32;
		box-shadow: 0 0 6px rgba(46, 125, 50, 0.5);
	}

	.triage-indicator.secondary-indicator {
		background: #8c8273;
	}

	.triage-title {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--text-main);
		flex: 1;
	}

	.triage-badge {
		font-size: 0.65rem;
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
		font-weight: 700;
		letter-spacing: 0.04em;
		background: rgba(46, 125, 50, 0.12);
		color: #2e7d32;
		border: 1px solid rgba(46, 125, 50, 0.25);
	}

	.triage-badge.secondary {
		background: rgba(95, 80, 56, 0.08);
		color: var(--text-muted);
		border: 1px solid rgba(95, 80, 56, 0.15);
	}

	.triage-desc {
		font-size: 0.84rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	.triage-stack-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.25rem;
	}

	.t-pill {
		font-size: 0.72rem;
		padding: 0.2rem 0.55rem;
		border-radius: 6px;
		background: rgba(46, 125, 50, 0.08);
		color: #2e7d32;
		border: 1px solid rgba(46, 125, 50, 0.2);
		font-weight: 600;
	}

	.t-pill.sec {
		background: rgba(95, 80, 56, 0.06);
		color: var(--text-muted);
		border: 1px solid rgba(95, 80, 56, 0.12);
	}

	/* Filter and Navigation Bar */
	.filter-and-nav-bar {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-top: 1rem;
		border-top: 1px dashed rgba(95, 80, 56, 0.15);
	}

	.filter-tabs-group {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.filter-tab {
		font-family: inherit;
		font-size: 0.8rem;
		padding: 0.45rem 0.9rem;
		border-radius: 8px;
		background: rgba(95, 80, 56, 0.06);
		color: var(--text-muted);
		border: 1px solid rgba(95, 80, 56, 0.12);
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		transition: all 0.15s ease;
		font-weight: 600;
	}

	.filter-tab:hover {
		background: rgba(95, 80, 56, 0.1);
		color: var(--text-main);
	}

	.filter-tab.active {
		background: var(--text-main);
		color: #fffdfa;
		border-color: var(--text-main);
	}

	.tab-count {
		opacity: 0.8;
		font-size: 0.75rem;
	}

	.btn-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
	}

	.btn-dot.primary {
		background: #2e7d32;
	}

	.btn-dot.secondary {
		background: #8c8273;
	}

	.skills-quick-jump {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.jump-lbl {
		font-size: 0.72rem;
		color: var(--text-muted);
		font-weight: 700;
	}

	.j-btn {
		font-size: 0.76rem;
		padding: 0.3rem 0.65rem;
		background: rgba(95, 80, 56, 0.06);
		color: var(--text-main);
		border-radius: 6px;
		border: 1px solid rgba(95, 80, 56, 0.12);
		transition: all 0.15s ease;
	}

	.j-btn:hover {
		background: var(--accent);
		color: #fffdfa;
		border-color: var(--accent);
	}

	/* Categories */
	.categories-container {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.cat-section {
		padding: 2rem;
		border-radius: 16px;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		scroll-margin-top: 5rem;
	}

	.cat-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.cat-title-wrap {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.cat-num {
		font-size: 0.72rem;
		color: var(--accent);
		letter-spacing: 0.08em;
		font-weight: 700;
	}

	.cat-h2 {
		font-size: clamp(1.35rem, 2.5vw, 1.75rem);
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.3;
	}

	.cat-icon {
		font-size: 1.75rem;
		line-height: 1;
	}

	.cat-desc {
		font-size: 0.88rem;
		line-height: 1.6;
		color: var(--text-muted);
		max-width: 820px;
	}

	.cat-items-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
		margin-top: 0.5rem;
	}

	@media (max-width: 768px) {
		.cat-items-grid {
			grid-template-columns: 1fr;
		}
	}

	.cat-item-card {
		padding: 1.35rem 1.45rem;
		border-radius: 12px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		transition: all 0.2s ease;
	}

	.cat-item-card.item-primary {
		background: rgba(46, 125, 50, 0.03);
		border-color: rgba(46, 125, 50, 0.2);
	}

	.cat-item-card.item-primary:hover {
		border-color: rgba(46, 125, 50, 0.5);
		box-shadow: 0 4px 12px rgba(46, 125, 50, 0.08);
		transform: translateY(-2px);
	}

	.cat-item-card.item-secondary {
		background: rgba(95, 80, 56, 0.02);
		border-color: rgba(95, 80, 56, 0.12);
		opacity: 0.92;
	}

	.cat-item-card.item-secondary:hover {
		border-color: rgba(95, 80, 56, 0.3);
		opacity: 1;
		transform: translateY(-2px);
	}

	.item-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.item-title-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.item-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		flex-shrink: 0;
	}

	.item-dot.dot-primary {
		background: #2e7d32;
		box-shadow: 0 0 5px rgba(46, 125, 50, 0.5);
	}

	.item-dot.dot-secondary {
		background: #8c8273;
	}

	.item-name {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--text-main);
	}

	.tier-badge {
		font-size: 0.65rem;
		padding: 0.15rem 0.45rem;
		border-radius: 4px;
		font-weight: 700;
		letter-spacing: 0.03em;
	}

	.tier-badge.badge-primary {
		color: #2e7d32;
		background: rgba(46, 125, 50, 0.1);
		border: 1px solid rgba(46, 125, 50, 0.22);
	}

	.tier-badge.badge-secondary {
		color: #746855;
		background: rgba(95, 80, 56, 0.06);
		border: 1px solid rgba(95, 80, 56, 0.14);
	}

	.item-context {
		font-size: 0.72rem;
		color: var(--text-muted);
		opacity: 0.9;
	}

	.item-desc {
		font-size: 0.83rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	/* Cross Navigation */
	.skills-cross-nav {
		padding: 1.75rem 2rem;
		border-radius: 16px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.nav-col {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.nav-lbl {
		font-size: 0.72rem;
		color: var(--text-muted);
		letter-spacing: 0.05em;
	}

	.nav-link {
		font-size: 0.92rem;
		color: var(--accent);
		font-weight: 700;
		transition: all 0.15s ease;
	}

	.nav-link:hover {
		color: var(--accent-hover);
		transform: translateX(2px);
	}
</style>
