---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');

// Helper to assign high-signal domain categories based on project frontmatter
function getProjectCategory(p: any): string[] {
	const cats: string[] = ['all'];
	const chip = (p.data.chip || '').toLowerCase();
	const title = (p.data.title || '').toLowerCase();
	const id = p.id || '';
	const pType = p.data.platformType;

	// Enterprise SaaS & ERP
	if (
		chip.includes('saas') ||
		chip.includes('erp') ||
		chip.includes('retail') ||
		chip.includes('support') ||
		['01', '02', '09', '10'].includes(id)
	) {
		cats.push('enterprise-saas');
	}

	// FinTech & Accounting
	if (
		chip.includes('fintech') ||
		title.includes('accounting') ||
		title.includes('finance') ||
		title.includes('loan') ||
		['04', '07', '10', '14'].includes(id)
	) {
		cats.push('fintech');
	}

	// Mobile & IoT
	if (
		pType === 'mobile' ||
		chip.includes('mobile') ||
		chip.includes('iot') ||
		['03', '14'].includes(id)
	) {
		cats.push('mobile-iot');
	}

	// Developer Tools & Architecture
	if (
		chip.includes('architecture') ||
		chip.includes('doc engine') ||
		chip.includes('packaging') ||
		chip.includes('learning') ||
		chip.includes('ui &') ||
		['05', '06', '08', '11', '12', '13'].includes(id)
	) {
		cats.push('devtools-arch');
	}

	return cats;
}

const projects = allProjects
	.sort((a, b) => a.data.order - b.data.order)
	.map((p) => {
		const categories = getProjectCategory(p);
		const allStack = [
			...(p.data.techStack?.frontend || []),
			...(p.data.techStack?.mobile_hardware || []),
			...(p.data.techStack?.backend || []),
			...(p.data.techStack?.database || []),
			...(p.data.techStack?.devops || [])
		];
		return {
			slug: p.id,
			categories,
			allStack,
			searchString: `${p.data.title} ${p.data.subtitle || ''} ${p.data.description || ''} ${p.data.chip || ''} ${p.data.role || ''} ${allStack.join(' ')}`.toLowerCase(),
			...p.data
		};
	});

// Compute Category Counts
const counts = {
	all: projects.length,
	'enterprise-saas': projects.filter((p) => p.categories.includes('enterprise-saas')).length,
	fintech: projects.filter((p) => p.categories.includes('fintech')).length,
	'mobile-iot': projects.filter((p) => p.categories.includes('mobile-iot')).length,
	'devtools-arch': projects.filter((p) => p.categories.includes('devtools-arch')).length
};

const quickTechFilters = [
	{ label: 'Vue 3 / Quasar', query: 'vue' },
	{ label: 'PostgreSQL / RLS', query: 'postgresql' },
	{ label: 'Next.js / React', query: 'next.js' },
	{ label: 'NestJS', query: 'nestjs' },
	{ label: 'Capacitor / Android', query: 'capacitor' },
	{ label: 'Docker', query: 'docker' },
	{ label: 'Firebase', query: 'firebase' }
];
---

<BaseLayout title="Work & Case Studies | Marcel David Baroi">
	<section class="work-hero">
		<div class="hero-label-group">
			<span class="section-tag font-dot">01 // DIRECTORY</span>
			<h1 class="work-title font-dot">Selected Work</h1>
			<p class="work-subtitle font-dot">Enterprise SaaS & Architecture Systems</p>
		</div>
		<p class="work-lead">
			A complete catalog of production platforms, multi-tenant frameworks, mobile systems, and full-stack software architectures accumulated through 2026.
		</p>
	</section>

	<!-- Interactive Filtering & Search Toolbar -->
	<section class="filter-toolbar-section">
		<!-- Category Tabs -->
		<div class="category-tabs-container" role="tablist" aria-label="Project Categories">
			<button class="category-tab active" data-category="all" role="tab" aria-selected="true">
				<span class="tab-label">All Work</span>
				<span class="tab-count font-mono">{counts.all}</span>
			</button>
			<button class="category-tab" data-category="enterprise-saas" role="tab" aria-selected="false">
				<span class="tab-label">Enterprise SaaS & ERP</span>
				<span class="tab-count font-mono">{counts['enterprise-saas']}</span>
			</button>
			<button class="category-tab" data-category="fintech" role="tab" aria-selected="false">
				<span class="tab-label">FinTech & Accounting</span>
				<span class="tab-count font-mono">{counts.fintech}</span>
			</button>
			<button class="category-tab" data-category="mobile-iot" role="tab" aria-selected="false">
				<span class="tab-label">Mobile & IoT</span>
				<span class="tab-count font-mono">{counts['mobile-iot']}</span>
			</button>
			<button class="category-tab" data-category="devtools-arch" role="tab" aria-selected="false">
				<span class="tab-label">Tools & Architecture</span>
				<span class="tab-count font-mono">{counts['devtools-arch']}</span>
			</button>
		</div>

		<!-- Keyword Search & Quick Stack Tags -->
		<div class="search-and-tags-row">
			<div class="search-input-wrapper">
				<svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<input
					type="search"
					id="work-search-input"
					class="search-input font-sans"
					placeholder="Search by tech stack, role, or keyword (e.g. Vue 3, PostgreSQL, Capacitor, NestJS, Docker)..."
					autocomplete="off"
					spellcheck="false"
					aria-label="Filter projects by keyword or tech stack"
				/>
				<button id="search-clear-btn" class="search-clear-btn" type="button" aria-label="Clear search">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>

			<!-- Quick Stack Filter Badges -->
			<div class="quick-stack-bar font-mono">
				<span class="quick-stack-label">Quick Stack:</span>
				<div class="quick-stack-pills">
					{quickTechFilters.map((filter) => (
						<button class="quick-tech-btn font-mono" data-tech-query={filter.query}>
							{filter.label}
						</button>
					))}
					<button id="filter-reset-btn" class="reset-filter-btn font-mono" type="button">
						Reset Filter
					</button>
				</div>
			</div>
		</div>

		<!-- Active Filter Feedback -->
		<div id="filter-status-bar" class="filter-status-bar font-mono" style="display: none;">
			<span id="results-count-text">Showing 14 projects</span>
			<button id="status-clear-all" class="status-clear-link font-mono" type="button">Clear all filters</button>
		</div>
	</section>

	<section class="work-grid-section">
		<div class="projects-grid" id="projects-grid-container">
			{projects.map((project) => (
				<a
					href={`/work/${project.slug}`}
					class="project-showcase-card"
					data-categories={project.categories.join(' ')}
					data-search-content={project.searchString}
				>
					<!-- Top Info Header: CV-Style Layout (Title, Role & Timeline, Google XYZ Accomplishment, Skill Chips) -->
					<div class="card-header-info">
						<div class="card-title-row">
							<h3 class="project-title font-sans">{project.title}</h3>
						</div>
						{project.role && (
							<div class="card-cv-meta font-mono">
								<span class="cv-role">{project.role}</span>
								{project.timeline && <span class="cv-timeline">· {project.timeline}</span>}
							</div>
						)}
						<p class="project-description font-sans">{project.description}</p>
						<div class="chip-container">
							<span class="keyword-chip font-mono">{project.chip}</span>
							{(() => {
								const topStack = [
									...(project.techStack?.frontend || []),
									...(project.techStack?.mobile_hardware || []),
									...(project.techStack?.backend || []),
									...(project.techStack?.database || [])
								].slice(0, 3);
								return topStack.map((tech) => (
									<span class="keyword-chip stack-chip font-mono">{tech}</span>
								));
							})()}
						</div>
					</div>

					<!-- Bottom Image Slot: Desktop (16:10) or Mobile (9:19.5 Phone) Screenshots -->
					{(() => {
						const validImages = (project.images || []).filter((img) => img && !img.includes('thumb-'));
						const thumbsToRender = validImages.length > 0 ? validImages.slice(0, 4) : [null, null, null, null];
						const count = thumbsToRender.length;

						return (
							<div class={`card-image-slot slot-${project.platformType || 'desktop'} count-${count}`}>
								<div class={`thumbs-mosaic mosaic-${project.platformType || 'desktop'} mosaic-count-${count}`}>
									{thumbsToRender.map((img, idx) => {
										const isMobile = img 
											? (!img.includes('web-') && !img.includes('dashboard') && !img.includes('chart-of-accounts') && !img.includes('balance-sheet') && !img.includes('reports') && (img.includes('collections.png') || img.includes('scanner') || img.includes('register.png') || img.includes('inventory.png') || img.includes('mobile') || project.platformType === 'mobile'))
											: project.platformType === 'mobile';
										return (
											<div class={`thumb-card thumb-${idx + 1} ${isMobile ? 'thumb-mobile-device' : 'thumb-desktop-window'}`}>
												{isMobile && (
													<div class="mobile-phone-notch">
														<span class="notch-pill"></span>
													</div>
												)}
												{img ? (
													<img src={img} alt={`${project.title} Preview ${idx + 1}`} class="thumb-img" loading="lazy" />
												) : (
													<div class="thumb-placeholder">
														<svg 
															xmlns="http://www.w3.org/2000/svg" 
															width="32" 
															height="32" 
															viewBox="0 0 24 24" 
															fill="none" 
															stroke="currentColor" 
															stroke-width="1.5" 
															stroke-linecap="round" 
															stroke-linejoin="round"
															class="placeholder-icon"
														>
															{isMobile ? (
																<>
																	<rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
																	<line x1="12" x2="12.01" y1="18" y2="18"></line>
																</>
															) : (
																<>
																	<rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
																	<circle cx="8.5" cy="8.5" r="1.5"></circle>
																	<polyline points="21 15 16 10 5 21"></polyline>
																</>
															)}
														</svg>
														<span class="placeholder-idx font-mono">{isMobile ? `SCREEN 0${idx + 1}` : `PREVIEW 0${idx + 1}`}</span>
													</div>
												)}
											</div>
										);
									})}
								</div>
							</div>
						);
					})()}
				</a>
			))}
		</div>

		<!-- Empty State when no results match filter -->
		<div id="no-projects-fallback" class="no-projects-fallback" style="display: none;">
			<div class="fallback-icon-wrap">
				<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					<line x1="8" y1="11" x2="14" y2="11"></line>
				</svg>
			</div>
			<h3 class="fallback-title font-sans">No matching systems found</h3>
			<p class="fallback-desc font-sans">Try adjusting your keyword search query or selecting a different category tab.</p>
			<button id="fallback-reset-btn" class="fallback-btn font-mono" type="button">Reset All Filters</button>
		</div>
	</section>
</BaseLayout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const categoryTabs = document.querySelectorAll<HTMLButtonElement>('.category-tab');
		const searchInput = document.getElementById('work-search-input') as HTMLInputElement | null;
		const clearBtn = document.getElementById('search-clear-btn') as HTMLButtonElement | null;
		const quickTechBtns = document.querySelectorAll<HTMLButtonElement>('.quick-tech-btn');
		const resetBtn = document.getElementById('filter-reset-btn') as HTMLButtonElement | null;
		const fallbackResetBtn = document.getElementById('fallback-reset-btn') as HTMLButtonElement | null;
		const statusClearBtn = document.getElementById('status-clear-all') as HTMLButtonElement | null;
		const statusBar = document.getElementById('filter-status-bar');
		const resultsCountText = document.getElementById('results-count-text');
		const fallbackBlock = document.getElementById('no-projects-fallback');
		const cards = document.querySelectorAll<HTMLAnchorElement>('.project-showcase-card');

		let currentCategory = 'all';
		let currentSearch = '';

		function updateFiltering() {
			let visibleCount = 0;
			const query = currentSearch.trim().toLowerCase();

			cards.forEach((card) => {
				const categories = (card.dataset.categories || '').split(' ');
				const searchContent = (card.dataset.searchContent || '').toLowerCase();

				const matchesCategory = currentCategory === 'all' || categories.includes(currentCategory);
				const matchesSearch = !query || searchContent.includes(query);

				if (matchesCategory && matchesSearch) {
					card.style.display = 'flex';
					visibleCount++;
				} else {
					card.style.display = 'none';
				}
			});

			// Update Clear Button Visibility
			if (clearBtn) {
				clearBtn.style.display = query.length > 0 ? 'flex' : 'none';
			}

			// Update Status Bar
			const isFiltered = currentCategory !== 'all' || query.length > 0;
			if (statusBar && resultsCountText) {
				if (isFiltered) {
					statusBar.style.display = 'flex';
					resultsCountText.textContent = `Showing ${visibleCount} of ${cards.length} systems`;
				} else {
					statusBar.style.display = 'none';
				}
			}

			// Update Empty State
			if (fallbackBlock) {
				fallbackBlock.style.display = visibleCount === 0 ? 'flex' : 'none';
			}
		}

		// Category Tab Handlers
		categoryTabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				categoryTabs.forEach((t) => {
					t.classList.remove('active');
					t.setAttribute('aria-selected', 'false');
				});
				tab.classList.add('active');
				tab.setAttribute('aria-selected', 'true');
				currentCategory = tab.dataset.category || 'all';
				updateFiltering();
			});
		});

		// Search Input Handler
		if (searchInput) {
			searchInput.addEventListener('input', (e) => {
				currentSearch = (e.target as HTMLInputElement).value;
				// Sync active state of quick pills
				quickTechBtns.forEach((btn) => {
					const pillQuery = btn.dataset.techQuery || '';
					if (pillQuery && currentSearch.toLowerCase() === pillQuery) {
						btn.classList.add('active');
					} else {
						btn.classList.remove('active');
					}
				});
				updateFiltering();
			});
		}

		// Clear Search Input Button
		if (clearBtn && searchInput) {
			clearBtn.addEventListener('click', () => {
				searchInput.value = '';
				currentSearch = '';
				quickTechBtns.forEach((btn) => btn.classList.remove('active'));
				updateFiltering();
				searchInput.focus();
			});
		}

		// Quick Tech Filter Pills Handler
		quickTechBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const techQuery = btn.dataset.techQuery || '';
				if (!searchInput) return;

				if (btn.classList.contains('active')) {
					// Toggle off
					btn.classList.remove('active');
					searchInput.value = '';
					currentSearch = '';
				} else {
					// Toggle on
					quickTechBtns.forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');
					searchInput.value = techQuery;
					currentSearch = techQuery;
				}
				updateFiltering();
			});
		});

		// Full Reset Helper
		function resetAll() {
			currentCategory = 'all';
			currentSearch = '';
			if (searchInput) searchInput.value = '';
			categoryTabs.forEach((t) => {
				if (t.dataset.category === 'all') {
					t.classList.add('active');
					t.setAttribute('aria-selected', 'true');
				} else {
					t.classList.remove('active');
					t.setAttribute('aria-selected', 'false');
				}
			});
			quickTechBtns.forEach((b) => b.classList.remove('active'));
			updateFiltering();
		}

		if (resetBtn) resetBtn.addEventListener('click', resetAll);
		if (fallbackResetBtn) fallbackResetBtn.addEventListener('click', resetAll);
		if (statusClearBtn) statusClearBtn.addEventListener('click', resetAll);

		// Initial Run
		updateFiltering();
	});
</script>

<style>
	.work-hero {
		width: 100%;
		padding: 3.5rem 0 1.5rem;
		text-align: left;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.hero-label-group {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.section-tag {
		font-size: 0.9375rem;
		letter-spacing: 0.12em;
		color: var(--accent);
		text-transform: uppercase;
		font-weight: 700;
		-webkit-text-stroke: 0.25px currentColor;
	}

	.work-title {
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-main);
		line-height: 1.05;
		-webkit-text-stroke: 0.45px currentColor;
		text-rendering: optimizeLegibility;
	}

	.work-subtitle {
		font-size: clamp(1.25rem, 2.5vw, 1.85rem);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
		font-weight: 700;
		-webkit-text-stroke: 0.35px currentColor;
	}

	.work-lead {
		font-size: clamp(1rem, 1.6vw, 1.15rem);
		line-height: 1.6;
		color: var(--text-muted);
		max-width: 800px;
	}

	/* Filtering & Search Toolbar */
	.filter-toolbar-section {
		width: 100%;
		margin-top: 1rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding: 1.5rem;
		background: #f7f4ed;
		border: 1px solid var(--card-border);
		border-radius: 24px;
	}

	/* Category Filter Tabs */
	.category-tabs-container {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		align-items: center;
	}

	.category-tab {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.6rem 1.15rem;
		border-radius: 9999px;
		background: rgba(95, 80, 56, 0.05);
		border: 1px solid rgba(95, 80, 56, 0.18);
		color: var(--text-main);
		font-size: 0.875rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
		user-select: none;
	}

	.category-tab:hover {
		background: rgba(95, 80, 56, 0.12);
		border-color: rgba(95, 80, 56, 0.35);
		transform: translateY(-1px);
	}

	.category-tab.active {
		background: var(--btn-primary);
		color: #fffdfa;
		border-color: var(--btn-primary);
		box-shadow: 0 4px 12px rgba(95, 80, 56, 0.18);
	}

	.tab-count {
		font-size: 0.75rem;
		padding: 0.15rem 0.45rem;
		border-radius: 9999px;
		background: rgba(95, 80, 56, 0.12);
		color: var(--text-muted);
	}

	.category-tab.active .tab-count {
		background: rgba(255, 255, 255, 0.22);
		color: #fffdfa;
	}

	/* Search Row & Quick Stack Bar */
	.search-and-tags-row {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.search-input-wrapper {
		position: relative;
		width: 100%;
		display: flex;
		align-items: center;
	}

	.search-icon {
		position: absolute;
		left: 1.1rem;
		color: var(--text-muted);
		pointer-events: none;
	}

	.search-input {
		width: 100%;
		padding: 0.85rem 2.8rem 0.85rem 3rem;
		font-size: 0.9375rem;
		color: var(--text-main);
		background: #ffffff;
		border: 1px solid rgba(95, 80, 56, 0.22);
		border-radius: 14px;
		outline: none;
		transition: all 0.2s ease;
	}

	.search-input:focus {
		border-color: var(--accent);
		box-shadow: 0 0 0 3px rgba(180, 33, 53, 0.12);
	}

	.search-input::placeholder {
		color: rgba(95, 80, 56, 0.5);
	}

	/* Remove default search clear button in webkit */
	.search-input::-webkit-search-cancel-button {
		display: none;
	}

	.search-clear-btn {
		position: absolute;
		right: 0.85rem;
		background: rgba(95, 80, 56, 0.1);
		border: none;
		border-radius: 50%;
		width: 26px;
		height: 26px;
		display: none;
		align-items: center;
		justify-content: center;
		color: var(--text-muted);
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.search-clear-btn:hover {
		background: var(--accent);
		color: #ffffff;
	}

	/* Quick Stack Pills */
	.quick-stack-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.75rem;
	}

	.quick-stack-label {
		color: var(--text-muted);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-right: 0.25rem;
	}

	.quick-stack-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		align-items: center;
	}

	.quick-tech-btn {
		background: #ffffff;
		border: 1px solid rgba(95, 80, 56, 0.2);
		color: var(--text-main);
		border-radius: 9999px;
		padding: 0.3rem 0.75rem;
		font-size: 0.75rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.15s ease;
	}

