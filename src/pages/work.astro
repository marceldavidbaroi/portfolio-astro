---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkMasthead from '../components/work/WorkMasthead.astro';
import WorkFocusBands from '../components/work/WorkFocusBands.astro';
import WorkFilters from '../components/work/WorkFilters.astro';
import WorkArchiveTeaser from '../components/work/WorkArchiveTeaser.astro';
import { getCollection } from 'astro:content';
import { getProjectCategory, shots, stackNames } from '../lib/work';

const allProjects = await getCollection('projects');

const projects = allProjects
	.sort((a, b) => a.data.order - b.data.order)
	.map((p) => {
		const categories = getProjectCategory(p);
		const allStack = stackNames(p.data.techStack, p.data.stack);
		return {
			slug: p.id,
			categories,
			allStack,
			searchString: `${p.data.title} ${p.data.subtitle || ''} ${p.data.description || ''} ${p.data.chip || ''} ${p.data.role || ''} ${(p.data.stack || []).join(' ')} ${allStack.join(' ')}`.toLowerCase(),
			thumbs: shots(p.data.images),
			stack: p.data.stack || [],
			...p.data
		};
	});

const workCount = projects.length;

const counts = {
	all: workCount,
	'enterprise-saas': projects.filter((p) => p.categories.includes('enterprise-saas')).length,
	fintech: projects.filter((p) => p.categories.includes('fintech')).length,
	'mobile-iot': projects.filter((p) => p.categories.includes('mobile-iot')).length,
	'devtools-arch': projects.filter((p) => p.categories.includes('devtools-arch')).length
};

const tabs = [
	{ id: 'all', label: 'All', count: counts.all },
	{ id: 'enterprise-saas', label: 'Enterprise', count: counts['enterprise-saas'] },
	{ id: 'fintech', label: 'FinTech', count: counts.fintech },
	{ id: 'mobile-iot', label: 'Mobile', count: counts['mobile-iot'] },
	{ id: 'devtools-arch', label: 'Tools', count: counts['devtools-arch'] }
];

const stackLinks = [
	{ label: 'Next.js', query: 'next' },
	{ label: 'NestJS', query: 'nest' },
	{ label: 'React', query: 'react' },
	{ label: 'Vue 3', query: 'vue' },
	{ label: 'Quasar', query: 'quasar' },
	{ label: 'Capacitor', query: 'capacitor' },
	{ label: 'Firebase', query: 'firebase' },
	{ label: 'PostgreSQL', query: 'postgresql' }
];
---

<BaseLayout title="Work & Case Studies | Marcel David Baroi" isWide alignStart>
	<WorkMasthead workCount={workCount} />
	<WorkFilters tabs={tabs} stackLinks={stackLinks} workCount={workCount} />
	<WorkFocusBands projects={projects} />
	<WorkArchiveTeaser />
</BaseLayout>
