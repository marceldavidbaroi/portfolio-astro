---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtticBreadcrumb from '../../components/about/AtticBreadcrumb.astro';
import AlbumStampCard from '../../components/gallery/AlbumStampCard.astro';
import { getAllAlbums } from '../../lib/gallery';
import '../../styles/about.css';

const allAlbums = await getAllAlbums();

const counts = {
	all: allAlbums.length,
	work: allAlbums.filter((a) => a.category === 'work').length,
	education: allAlbums.filter((a) => a.category === 'education').length,
	civic: allAlbums.filter((a) => a.category === 'civic').length,
	life: allAlbums.filter((a) => a.category === 'life').length
};

const filterTabs = [
	{ id: 'all', label: 'All', count: counts.all },
	{ id: 'work', label: 'Work & Career', count: counts.work },
	{ id: 'education', label: 'Campus & School', count: counts.education },
	{ id: 'civic', label: 'Civic & Events', count: counts.civic },
	{ id: 'life', label: 'Life & Memories', count: counts.life }
].filter((t) => t.id === 'all' || t.count > 0);
---

<BaseLayout
	title="Photo Albums & Event Stories | Marcel David Baroi"
	description="Preserved photography albums, engineering workbenches, academic milestones, and civic operations of Marcel David Baroi."
	isWide
	alignStart
>
	<AtticBreadcrumb current="Gallery" />

	<header class="about-attic-head">
		<p class="label font-sans about-attic-kicker">Gallery</p>
		<h1 class="about-attic-title font-sans">Photo albums &amp; memoirs</h1>
		<p class="about-attic-lead font-sans">
			Preserved photography collections across engineering workbenches, academic thesis defenses, collegiate discipline, and historic civic operations. Each photo collection carries its narrative story.
		</p>
	</header>

	<!-- Category Filter Bar (Standard Stationery Underline Tabs) -->
	<div class="filters" id="gallery-filters">
		<div class="tabs" role="tablist" aria-label="Filter albums by category" id="gallery-tabs">
			{filterTabs.map((tab, idx) => (
				<button
					type="button"
					class:list={['tab', 'font-sans', { active: idx === 0 }]}
					data-category={tab.id}
					role="tab"
					aria-selected={idx === 0 ? 'true' : 'false'}
				>
					{tab.label} <span class="tab-count font-sans">({tab.count})</span>
				</button>
			))}
			<span class="gallery-tab-indicator" id="gallery-tab-indicator" aria-hidden="true"></span>
		</div>
	</div>

	<!-- Albums Stamp Grid -->
	<div class="gallery-stamp-grid" id="gallery-catalog">
		{allAlbums.map((album) => (
			<div class="gallery-card-wrapper" data-album-category={album.category}>
				<AlbumStampCard album={album} />
			</div>
		))}
	</div>

	<p class="empty font-sans" id="gallery-empty" hidden>
		No albums found in this category.
	</p>

	<a href="/about" class="about-return font-sans">← About</a>
</BaseLayout>

<script>
	function initGalleryFilter() {
		const tabsWrap = document.getElementById('gallery-tabs');
		const indicator = document.getElementById('gallery-tab-indicator');
		const tabs = document.querySelectorAll<HTMLButtonElement>('#gallery-tabs .tab');
		const cards = document.querySelectorAll<HTMLElement>('.gallery-card-wrapper');
		const emptyMsg = document.getElementById('gallery-empty');

		if (!tabsWrap || !tabs.length) return;

		const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let currentCat = 'all';

		function updateIndicator(activeTab: HTMLElement) {
			if (!indicator || prefersReduced) return;
			const wrapRect = tabsWrap!.getBoundingClientRect();
			const tabRect = activeTab.getBoundingClientRect();
			const left = tabRect.left - wrapRect.left;
			const width = tabRect.width;

			indicator.style.transform = `translateX(${left}px)`;
			indicator.style.width = `${width}px`;
			indicator.style.opacity = '1';
		}

		const initialActive = document.querySelector<HTMLButtonElement>('#gallery-tabs .tab.active') || tabs[0];
		if (initialActive) {
			updateIndicator(initialActive);
		}

		function applyFilter(cat: string) {
			currentCat = cat;

			if (prefersReduced) {
				let visibleCount = 0;
				cards.forEach((card) => {
					const cardCat = card.dataset.albumCategory;
					const shouldShow = cat === 'all' || cardCat === cat;
					card.style.display = shouldShow ? 'block' : 'none';
					card.classList.remove('is-fading-out', 'is-settling-in');
					if (shouldShow) visibleCount++;
				});

				if (emptyMsg) emptyMsg.hidden = visibleCount > 0;
				return;
			}

			// Smooth cross-dissolve
			const departing: HTMLElement[] = [];
			const arriving: HTMLElement[] = [];

			cards.forEach((card) => {
				const cardCat = card.dataset.albumCategory;
				const willBeVisible = cat === 'all' || cardCat === cat;
				const isCurrentlyVisible = card.style.display !== 'none';

				if (isCurrentlyVisible && !willBeVisible) {
					departing.push(card);
				} else if (!isCurrentlyVisible && willBeVisible) {
					arriving.push(card);
				}
			});

			if (departing.length > 0) {
				departing.forEach((c) => c.classList.add('is-fading-out'));

				setTimeout(() => {
					departing.forEach((c) => {
						c.style.display = 'none';
						c.classList.remove('is-fading-out');
					});

					let visibleCount = 0;
					cards.forEach((c) => {
						const cardCat = c.dataset.albumCategory;
						const shouldShow = cat === 'all' || cardCat === cat;
						if (shouldShow) visibleCount++;
					});

					arriving.forEach((c) => {
						c.style.display = 'block';
						c.classList.add('is-settling-in');
						requestAnimationFrame(() => {
							c.classList.remove('is-settling-in');
						});
					});

					if (emptyMsg) emptyMsg.hidden = visibleCount > 0;
				}, 150);
			} else {
				let visibleCount = 0;
				cards.forEach((c) => {
					const cardCat = c.dataset.albumCategory;
					const shouldShow = cat === 'all' || cardCat === cat;
					if (shouldShow) visibleCount++;
				});

				arriving.forEach((c) => {
					c.style.display = 'block';
					c.classList.add('is-settling-in');
					requestAnimationFrame(() => {
						c.classList.remove('is-settling-in');
					});
				});

				if (emptyMsg) emptyMsg.hidden = visibleCount > 0;
			}
		}

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const cat = tab.dataset.category || 'all';
				tabs.forEach((t) => {
					const isActive = t === tab;
					t.classList.toggle('active', isActive);
					t.setAttribute('aria-selected', isActive ? 'true' : 'false');
				});
				updateIndicator(tab);
				applyFilter(cat);
			});
		});

		window.addEventListener('resize', () => {
			const activeTab = document.querySelector<HTMLButtonElement>('#gallery-tabs .tab.active');
			if (activeTab) updateIndicator(activeTab);
		}, { passive: true });
	}

	initGalleryFilter();
	document.addEventListener('astro:page-load', initGalleryFilter);
</script>

<style>
	.filters {
		margin: 0 0 2rem;
		border-bottom: 1px solid rgba(95, 80, 56, 0.12);
	}

	.tabs {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.85rem 1.25rem;
	}

	.tab {
		appearance: none;
		border: 0;
		background: none;
		padding: 0.2rem 0 0.45rem;
		margin: 0;
		font: inherit;
		font-size: var(--type-tab);
		font-weight: 500;
		color: var(--text-muted);
		cursor: pointer;
		border-bottom: 2px solid transparent !important;
		transition: color var(--dur-fast) ease;
	}

	.tab.active,
	.tab:hover {
		color: var(--accent);
	}

	.gallery-tab-indicator {
		position: absolute;
		bottom: -1px;
		left: 0;
		height: 2px;
		background: var(--accent);
		opacity: 0;
		transition:
			transform var(--dur-ui, 220ms) var(--ease-ui, cubic-bezier(0.22, 1, 0.36, 1)),
			width var(--dur-ui, 220ms) var(--ease-ui, cubic-bezier(0.22, 1, 0.36, 1)),
			opacity var(--dur-fast, 150ms) ease;
		pointer-events: none;
		will-change: transform, width;
	}

	.tab-count {
		font-size: var(--type-caption);
		margin-left: 0.2rem;
		opacity: 0.8;
	}

	.gallery-stamp-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 2rem 1.5rem;
		margin-bottom: 3.5rem;
	}

	.gallery-card-wrapper {
		display: block;
		min-width: 0;
		transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out);
		will-change: opacity, transform;
	}

	.gallery-card-wrapper.is-fading-out {
		opacity: 0;
		transform: scale(0.97);
	}

	.gallery-card-wrapper.is-settling-in {
		opacity: 0;
		transform: scale(0.97);
	}

	.empty {
		padding: 2.5rem 0;
		color: var(--text-muted);
		font-size: var(--type-meta);
	}

	.empty[hidden] {
		display: none !important;
	}

	@media (max-width: 960px) {
		.gallery-stamp-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.75rem 1.25rem;
		}
	}

	@media (max-width: 680px) {
		.gallery-stamp-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.5rem 1rem;
		}
	}

	@media (max-width: 400px) {
		.gallery-stamp-grid {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.gallery-tab-indicator {
			display: none;
		}

		.tab.active {
			border-bottom-color: var(--accent) !important;
		}

		.gallery-card-wrapper {
			opacity: 1 !important;
			transform: none !important;
			transition: none !important;
		}
	}
</style>

