---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllAlbums, type Album } from '../../lib/gallery';
import '../../styles/about.css';

export async function getStaticPaths() {
	const allAlbums = await getAllAlbums();

	return allAlbums.map((album, index) => {
		const prev = index > 0 ? allAlbums[index - 1] : null;
		const next = index < allAlbums.length - 1 ? allAlbums[index + 1] : null;

		return {
			params: { slug: album.id },
			props: {
				album,
				prev: prev ? { id: prev.id, title: prev.title } : null,
				next: next ? { id: next.id, title: next.title } : null
			}
		};
	});
}

interface Props {
	album: Album;
	prev: { id: string; title: string } | null;
	next: { id: string; title: string } | null;
}

const { album, prev, next } = Astro.props;
---

<BaseLayout
	title={`${album.title} | Story & Preserved Album`}
	description={album.description || album.story || `Photo album and stories for ${album.title}`}
	isWide
	alignStart
>
	<!-- Breadcrumb -->
	<nav class="attic-crumb font-sans" aria-label="Breadcrumb">
		<a href="/about" class="attic-crumb-link">About</a>
		<span class="attic-crumb-sep" aria-hidden="true">/</span>
		<a href="/gallery" class="attic-crumb-link">Gallery</a>
		<span class="attic-crumb-sep" aria-hidden="true">/</span>
		<span class="attic-crumb-current">{album.title}</span>
	</nav>

	<!-- Editorial Story Masthead -->
	<header class="story-masthead">
		<div class="story-header-meta font-sans">
			<span class="label font-sans">{album.tag}</span>
			{album.period && <span class="story-header-period font-sans">· {album.period}</span>}
		</div>

		<h1 class="story-main-title font-sans">{album.title}</h1>

		{album.story && (
			<div class="story-prologue">
				<p class="story-prologue-text font-sans">{album.story}</p>
			</div>
		)}

		<dl class="edu-facts-rail font-sans story-facts-rail">
			{album.period && (
				<div class="edu-fact">
					<dt>Timeline</dt>
					<dd>{album.period}</dd>
				</div>
			)}
			{album.location && (
				<div class="edu-fact">
					<dt>Location</dt>
					<dd>{album.location}</dd>
				</div>
			)}
			<div class="edu-fact">
				<dt>Curated</dt>
				<dd>{album.photoCount} preserved records</dd>
			</div>
			{album.memoirHref && (
				<div class="edu-fact">
					<dt>Documentary</dt>
					<dd><a href={album.memoirHref} class="text-link font-sans">Dedicated memoir essay →</a></dd>
				</div>
			)}
		</dl>
	</header>

	<!-- Pure Visual Grid (Masonry / Bento Style) -->
	<main class="album-grid-container" aria-label="Photo collection grid">
		<div class="album-photo-grid">
			{album.photos.map((photo, idx) => {
				const isPortrait = photo.orientation === 'portrait';
				const isPanoramic = photo.aspectRatio && photo.aspectRatio > 2.2;
				const isExtraTall = photo.aspectRatio && photo.aspectRatio < 0.55;

				const layoutClass =
					photo.span === 'full' || isPanoramic
						? 'is-span-full'
						: photo.span === 'wide'
						? 'is-span-wide'
						: isExtraTall
						? 'is-portrait-tall'
						: isPortrait
						? 'is-portrait'
						: (idx % 8 === 0 && album.photos.length > 4)
						? 'is-featured-landscape'
						: 'is-landscape';

				return (
					<figure
						class:list={['album-photo-item', layoutClass]}
						data-spotlight-src={photo.src}
						data-spotlight-title={photo.title || `${album.title} — Record ${idx + 1}`}
						data-spotlight-caption={photo.caption || photo.story || ''}
					>
						<button
							type="button"
							class="album-photo-btn"
							aria-label={`View photo ${idx + 1}: ${photo.title || album.title}`}
						>
							<img
								src={photo.src}
								alt={photo.alt || photo.title || `${album.title} photo ${idx + 1}`}
								class="album-photo-img"
								loading={idx < 4 ? 'eager' : 'lazy'}
							/>
							<div class="album-photo-overlay" aria-hidden="true">
								<span class="overlay-expand-icon">⤢</span>
							</div>
						</button>
					</figure>
				);
			})}
		</div>
	</main>

	<!-- Spotlight / Lightbox Modal -->
	<div id="gallery-spotlight-modal" class="gallery-spotlight" aria-hidden="true" role="dialog">
		<div class="gallery-spotlight-backdrop" id="spotlight-backdrop"></div>
		<div class="gallery-spotlight-panel font-sans">
			<button class="gallery-spotlight-close font-sans" id="spotlight-close" type="button" aria-label="Close">Close ✕</button>
			<button class="gallery-spotlight-nav prev font-sans" id="spotlight-prev" type="button" aria-label="Previous photo">←</button>
			<div class="gallery-spotlight-stage">
				<img id="spotlight-img" src="" alt="" class="gallery-spotlight-img" />
				<div class="gallery-spotlight-meta">
					<div>
						<h3 id="spotlight-title" class="gallery-spotlight-title font-sans"></h3>
						<p id="spotlight-desc" class="gallery-spotlight-caption font-sans"></p>
					</div>
					<span id="spotlight-counter" class="gallery-spotlight-counter font-sans"></span>
				</div>
			</div>
			<button class="gallery-spotlight-nav next font-sans" id="spotlight-next" type="button" aria-label="Next photo">→</button>
		</div>
	</div>

	<!-- Sequential Storytelling Cross-Nav -->
	<footer class="story-nav font-sans" aria-label="Story sequential navigation">
		<div class="story-nav-prev">
			{prev && (
				<a href={`/gallery/${prev.id}`} class="text-link font-sans">
					← Previous: {prev.title}
				</a>
			)}
		</div>

		<a href="/gallery" class="text-link font-sans story-nav-index">
			↑ All preserved albums
		</a>

		<div class="story-nav-next">
			{next && (
				<a href={`/gallery/${next.id}`} class="text-link font-sans">
					Next: {next.title} →
				</a>
			)}
		</div>
	</footer>

	<script>
		function initSpotlight() {
			const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-spotlight-src]'));
			const modal = document.getElementById('gallery-spotlight-modal');
			const backdrop = document.getElementById('spotlight-backdrop');
			const closeBtn = document.getElementById('spotlight-close');
			const prevBtn = document.getElementById('spotlight-prev');
			const nextBtn = document.getElementById('spotlight-next');
			const spotImg = document.getElementById('spotlight-img') as HTMLImageElement | null;
			const spotTitle = document.getElementById('spotlight-title');
			const spotDesc = document.getElementById('spotlight-desc');
			const spotCounter = document.getElementById('spotlight-counter');

			if (!modal || !spotImg || cards.length === 0) return;

			let currentIndex = 0;

			function openSpotlight(index: number) {
				currentIndex = (index + cards.length) % cards.length;
				const card = cards[currentIndex];
				const src = card.dataset.spotlightSrc || '';
				const title = card.dataset.spotlightTitle || '';
				const caption = card.dataset.spotlightCaption || '';

				spotImg.src = src;
				spotImg.alt = title || caption || 'Gallery photo';
				if (spotTitle) spotTitle.textContent = title;
				if (spotDesc) spotDesc.textContent = caption;
				if (spotCounter) spotCounter.textContent = `${currentIndex + 1} / ${cards.length}`;

				modal.classList.add('is-open');
				modal.setAttribute('aria-hidden', 'false');
				document.body.style.overflow = 'hidden';
			}

			function closeSpotlight() {
				modal.classList.remove('is-open');
				modal.setAttribute('aria-hidden', 'true');
				document.body.style.overflow = '';
			}

			cards.forEach((card, index) => {
				const btn = card.querySelector('button');
				if (btn) {
					btn.addEventListener('click', () => openSpotlight(index));
				}
			});

			closeBtn?.addEventListener('click', closeSpotlight);
			backdrop?.addEventListener('click', closeSpotlight);
			prevBtn?.addEventListener('click', () => openSpotlight(currentIndex - 1));
			nextBtn?.addEventListener('click', () => openSpotlight(currentIndex + 1));

			window.addEventListener('keydown', (e) => {
				if (!modal.classList.contains('is-open')) return;
				if (e.key === 'Escape') closeSpotlight();
				if (e.key === 'ArrowRight') openSpotlight(currentIndex + 1);
				if (e.key === 'ArrowLeft') openSpotlight(currentIndex - 1);
			});
		}

		initSpotlight();
		document.addEventListener('astro:page-load', initSpotlight);
	</script>
</BaseLayout>

<style>
	.story-masthead {
		padding-bottom: 2.5rem;
		border-bottom: 1px solid rgba(95, 80, 56, 0.12);
		margin-bottom: 2.5rem;
	}

	.story-header-meta {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
	}

	.story-header-period {
		font-size: var(--type-meta);
		color: var(--text-muted);
	}

	.story-main-title {
		margin: 0;
		font-size: clamp(2rem, 5.5vw, 3.1rem);
		font-weight: 800;
		line-height: 1.08;
		letter-spacing: -0.035em;
		color: var(--text-main);
		max-width: 48rem;
	}

	.story-prologue {
		margin: 1.5rem 0 0;
		max-width: 46rem;
		border-left: 2px solid var(--accent);
		padding-left: 1.25rem;
	}

	.story-prologue-text {
		margin: 0;
		font-size: 1.12rem;
		line-height: 1.65;
		color: var(--text-main);
	}

	.story-facts-rail {
		margin-top: 2rem;
	}

	/* Photo Grid Container */
	.album-grid-container {
		width: 100%;
		margin-bottom: 4rem;
	}

	/* Dynamic Seamless Masonry/Bento Grid */
	.album-photo-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		grid-auto-flow: dense;
		gap: 0.5rem;
		width: 100%;
	}

	.album-photo-item {
		margin: 0;
		position: relative;
		overflow: hidden;
		background: var(--card-bg);
		border-radius: var(--radius-md, 10px);
		aspect-ratio: 4 / 3;
		transition: transform 0.25s var(--ease-ui), box-shadow 0.25s var(--ease-ui);
	}

	.album-photo-item.is-landscape {
		aspect-ratio: 4 / 3;
	}

	.album-photo-item.is-portrait {
		grid-row: span 2;
		aspect-ratio: 3 / 4;
	}

	.album-photo-item.is-portrait-tall {
		grid-row: span 3;
		aspect-ratio: 9 / 16;
	}

	.album-photo-item.is-featured-landscape {
		grid-column: span 2;
		grid-row: span 2;
		aspect-ratio: 16 / 10;
	}

	.album-photo-item.is-span-wide {
		grid-column: span 2;
		aspect-ratio: 16 / 9;
	}

	.album-photo-item.is-span-full {
		grid-column: 1 / -1;
		aspect-ratio: 21 / 9;
	}

	.album-photo-btn {
		display: block;
		width: 100%;
		height: 100%;
		padding: 0;
		margin: 0;
		border: 0;
		background: transparent;
		cursor: pointer;
		position: relative;
		text-align: left;
	}

	.album-photo-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transition: transform 0.4s var(--ease-out), filter 0.3s ease;
	}

	.album-photo-overlay {
		position: absolute;
		inset: 0;
		background: rgba(15, 13, 11, 0.35);
		opacity: 0;
		transition: opacity 0.25s ease;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.overlay-expand-icon {
		color: #ffffff;
		font-size: 1.5rem;
		filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
		transform: scale(0.85);
		transition: transform 0.25s var(--ease-out);
	}

	.album-photo-item:hover {
		z-index: 2;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
	}

	.album-photo-item:hover .album-photo-img {
		transform: scale(1.03);
	}

	.album-photo-item:hover .album-photo-overlay {
		opacity: 1;
	}

	.album-photo-item:hover .overlay-expand-icon {
		transform: scale(1);
	}

	/* Spotlight Modal */
	.gallery-spotlight {
		position: fixed;
		inset: 0;
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s var(--ease-ui);
	}

	.gallery-spotlight.is-open {
		opacity: 1;
		pointer-events: auto;
	}

	.gallery-spotlight-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(20, 18, 15, 0.92);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	.gallery-spotlight-panel {
		position: relative;
		z-index: 2;
		width: min(94vw, 1200px);
		max-height: 92vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 1.5rem 1rem 1rem;
		box-sizing: border-box;
	}

	.gallery-spotlight-close {
		position: absolute;
		top: -0.5rem;
		right: 0.5rem;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: #ffffff;
		padding: 0.4rem 0.85rem;
		border-radius: 9999px;
		cursor: pointer;
		font-size: var(--type-caption);
		letter-spacing: 0.05em;
		transition: background 0.2s, color 0.2s;
	}

	.gallery-spotlight-close:hover {
		background: var(--accent);
		color: #ffffff;
	}

	.gallery-spotlight-nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: #ffffff;
		font-size: 1.25rem;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: background 0.2s, transform 0.2s;
	}

	.gallery-spotlight-nav:hover {
		background: var(--accent);
		transform: translateY(-50%) scale(1.08);
	}

	.gallery-spotlight-nav.prev {
		left: -0.5rem;
	}

	.gallery-spotlight-nav.next {
		right: -0.5rem;
	}

	.gallery-spotlight-stage {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		width: 100%;
		max-width: 1000px;
	}

	.gallery-spotlight-img {
		max-width: 100%;
		max-height: 72vh;
		object-fit: contain;
		border-radius: 4px;
		box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
	}

	.gallery-spotlight-meta {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
		width: 100%;
		color: #f8f6f0;
	}

	.gallery-spotlight-title {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
	}

	.gallery-spotlight-caption {
		margin: 0.25rem 0 0;
		font-size: var(--type-caption);
		color: rgba(248, 246, 240, 0.7);
		max-width: 45rem;
	}

	.gallery-spotlight-counter {
		flex-shrink: 0;
		font-size: var(--type-caption);
		color: var(--accent);
		font-weight: 700;
	}

	/* Sequential Navigation Footer */
	.story-nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1.5rem;
		padding: 2.5rem 0 3.5rem;
		border-top: 1px solid rgba(95, 80, 56, 0.12);
		font-size: var(--type-meta);
	}

	.story-nav-prev {
		text-align: left;
	}

	.story-nav-index {
		text-align: center;
	}

	.story-nav-next {
		text-align: right;
	}

	@media (max-width: 1024px) {
		.album-photo-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 768px) {
		.album-photo-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.35rem;
		}

		.gallery-spotlight-nav.prev {
			left: 0.25rem;
		}

		.gallery-spotlight-nav.next {
			right: 0.25rem;
		}

		.story-nav {
			grid-template-columns: 1fr;
			text-align: center;
			gap: 1.25rem;
		}

		.story-nav-prev,
		.story-nav-next {
			text-align: center;
		}
	}

	@media (max-width: 480px) {
		.album-photo-grid {
			grid-template-columns: 1fr;
		}

		.album-photo-item.pattern-portrait-tall,
		.album-photo-item.pattern-landscape-wide,
		.album-photo-item.pattern-wide,
		.album-photo-item.pattern-full {
			grid-column: auto;
			grid-row: auto;
			aspect-ratio: 4 / 3;
		}
	}
</style>
