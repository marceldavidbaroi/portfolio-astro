---
import GalleryPage from '../../../components/GalleryPage.astro';
import { getCollection, getEntry } from 'astro:content';
import { mediaMap, resolveAssets } from '../../../lib/media';

const gallery = await getEntry('galleries', 'proficient');
const title = gallery?.data.title || 'Proficient Information Systems — Gallery';
const map = mediaMap(await getCollection('media'));
const photoIds = (gallery?.data.albums || []).flatMap((a) => a.photos.map((p) => p.id));
const photos =
	photoIds.length > 0
		? resolveAssets(photoIds, map).map((a) => ({ src: a.src, caption: a.caption || a.alt }))
		: [];
---

<GalleryPage
	title={title}
	backHref="/#experience"
	backLabel="Work Experience"
	tag="01 // WORKPLACE"
	description="Photo gallery for the Proficient role. Add images anytime."
	photos={photos}
	emptyHint='Photos coming soon — drop files in <code>public/images/experience/</code>.'
/>
