</style>

<script>
	async function initMermaid() {
		try {
			// Find all pre elements that contain mermaid syntax or language-mermaid
			const codeBlocks = Array.from(document.querySelectorAll('pre, pre code'));
			const targets: { pre: HTMLElement; code: string }[] = [];

			for (const el of codeBlocks) {
				const text = el.textContent?.trim() || '';
				const isMermaid = 
					el.classList.contains('language-mermaid') || 
					el.parentElement?.classList.contains('language-mermaid') ||
					el.getAttribute('data-language') === 'mermaid' ||
					text.startsWith('flowchart') || 
					text.startsWith('sequenceDiagram') || 
					text.startsWith('mindmap') || 
					text.startsWith('timeline') || 
					text.startsWith('graph');

				if (isMermaid) {
					const pre = (el.tagName.toLowerCase() === 'pre' ? el : el.closest('pre')) as HTMLElement | null;
					if (pre && !pre.dataset.processed) {
						pre.dataset.processed = 'true';
						targets.push({ pre, code: text });
					}
				}
			}

			if (targets.length === 0) return;

			// Dynamically import Mermaid ESM from CDN
			// @ts-ignore
			const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs');

			mermaid.initialize({
				startOnLoad: false,
				theme: 'base',
				themeVariables: {
					primaryColor: '#f4f0e7',
					primaryTextColor: '#2b251e',
					primaryBorderColor: '#5f5038',
					lineColor: '#5f5038',
					secondaryColor: '#ffffff',
					tertiaryColor: '#ede7da',
					noteBkgColor: '#f4f0e7',
					noteTextColor: '#2b251e',
					noteBorderColor: '#5f5038',
					actorBkg: '#f4f0e7',
					actorBorder: '#5f5038',
					actorTextColor: '#2b251e',
					signalColor: '#5f5038',
					signalTextColor: '#2b251e',
					labelBoxBkgColor: '#f4f0e7',
					labelBoxBorderColor: '#5f5038',
					labelTextColor: '#2b251e',
					loopTextColor: '#2b251e',
					activationBorderColor: '#b42135',
					activationBkgColor: '#f4f0e7',
					fontFamily: 'NType 82 Mono, monospace',
					fontSize: '13px'
				},
				flowchart: {
					curve: 'basis',
					htmlLabels: true,
					padding: 16
				},
				securityLevel: 'loose'
			});

			for (let i = 0; i < targets.length; i++) {
				const { pre, code } = targets[i];
				const wrapper = document.createElement('div');
				wrapper.className = 'mermaid-diagram-card';
				
				const diagramDiv = document.createElement('div');
				diagramDiv.className = 'mermaid';
				diagramDiv.textContent = code;
				
				wrapper.appendChild(diagramDiv);
				pre.replaceWith(wrapper);
			}

			await mermaid.run();
		} catch (err) {
			console.error('Mermaid render error:', err);
		}
	}

	// Initialize TOC ScrollSpy
	function initTocScrollSpy() {
			const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
			if (tocLinks.length === 0) return;

			const targetIds = Array.from(tocLinks)
				.map((link) => link.getAttribute('data-target'))
				.filter((id): id is string => Boolean(id));

			const targetElements = targetIds
				.map((id) => document.getElementById(id))
				.filter((el): el is HTMLElement => el !== null);

			if (targetElements.length === 0) return;

			let activeId = targetIds[0] || '';

			const observerOptions = {
				root: null,
				rootMargin: '-80px 0px -70% 0px',
				threshold: 0,
			};

			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						activeId = entry.target.id;
						updateActiveToc();
					}
				});
			}, observerOptions);

			targetElements.forEach((el) => observer.observe(el));

			function updateActiveToc() {
				tocLinks.forEach((link) => {
					if (link.getAttribute('data-target') === activeId) {
						link.classList.add('active');
					} else {
						link.classList.remove('active');
					}
				});
			}

			// Smooth scroll click handler with sticky header offset
			tocLinks.forEach((link) => {
				link.addEventListener('click', (e) => {
					const targetId = link.getAttribute('data-target');
					if (targetId) {
						const targetEl = document.getElementById(targetId);
						if (targetEl) {
							e.preventDefault();
							const headerOffset = 90;
							const elementPosition = targetEl.getBoundingClientRect().top;
							const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

							window.scrollTo({
								top: Math.max(0, offsetPosition),
								behavior: 'smooth'
							});
							history.pushState(null, '', `#${targetId}`);
							activeId = targetId;
							updateActiveToc();
						}
					}
				});
			});

			// Back to Top button click handler
			const topBtn = document.getElementById('toc-top-button');
			if (topBtn) {
				topBtn.addEventListener('click', (e) => {
					e.preventDefault();
					window.scrollTo({ top: 0, behavior: 'smooth' });
					history.pushState(null, '', window.location.pathname);
				});
			}

			updateActiveToc();
		}

		// Dynamically wrap EVERY markdown screenshot into an authentic device mockup based on size/aspect ratio
		function initScreenshotFrames() {
			const articleImgs = document.querySelectorAll<HTMLImageElement>('.markdown-article img');

			function applyDeviceFrame(img: HTMLImageElement) {
				// Avoid double wrapping
				if (img.closest('.md-mobile-phone-device') || img.closest('.md-tablet-device')) return;

				const src = (img.getAttribute('src') || '').toLowerCase();
				const rawAlt = img.getAttribute('alt') || '';
				const alt = rawAlt.toLowerCase();

				// Size-based aspect ratio detection: height > width = mobile phone, otherwise tablet / desktop frame
				const w = img.naturalWidth || img.width || 0;
				const h = img.naturalHeight || img.height || 0;
				const isVerticalPortrait = (w > 0 && h > 0) ? (h > (w * 1.12)) : false;

				const isExplicitMobile = src.includes('#mobile') || alt.includes('[mobile]') || alt.includes('mobile');
				const isExplicitDesktop = src.includes('#desktop') || alt.includes('[desktop]') || alt.includes('desktop') || alt.includes('web') || alt.includes('dashboard') || alt.includes('costing') || alt.includes('shipment');

				// Decision: explicit tag takes precedence, otherwise automated aspect ratio detection
				const isMobileDevice = isExplicitMobile ? true : (isExplicitDesktop ? false : isVerticalPortrait);

				// Clean visual metadata tag from alt attribute
				const cleanAlt = rawAlt.replace(/\[(mobile|desktop|tablet)\]/gi, '').trim();
				img.setAttribute('alt', cleanAlt);

				// Find container to replace: if img is wrapped solely in a <p>, replace the <p>
				const parentP = img.parentElement;
				const targetInsertNode = (parentP && parentP.tagName.toLowerCase() === 'p' && parentP.children.length === 1) 
					? parentP 
					: img;

				if (isMobileDevice) {
					const wrapper = document.createElement('div');
					wrapper.className = 'md-mockup-mobile-wrapper';

					const device = document.createElement('div');
					device.className = 'md-mobile-phone-device';

					const notch = document.createElement('div');
					notch.className = 'mobile-speaker-notch';
					notch.innerHTML = '<span class="notch-camera-dot"></span><span class="notch-speaker-bar"></span>';

					const screen = document.createElement('div');
					screen.className = 'mobile-mockup-screen';

					const homeIndicator = document.createElement('div');
					homeIndicator.className = 'mobile-home-indicator';

					targetInsertNode.parentNode?.insertBefore(wrapper, targetInsertNode);
					screen.appendChild(img);
					device.appendChild(notch);
					device.appendChild(screen);
					device.appendChild(homeIndicator);
					wrapper.appendChild(device);

					if (targetInsertNode !== img && targetInsertNode.parentNode) {
						targetInsertNode.remove();
					}
				} else {
					// Render compact realistic Tablet frame for web / landscape images
					const wrapper = document.createElement('div');
					wrapper.className = 'md-mockup-tablet-wrapper';

					const tablet = document.createElement('div');
					tablet.className = 'md-tablet-device';

					const topBezel = document.createElement('div');
					topBezel.className = 'tablet-top-bezel';
					topBezel.innerHTML = '<span class="tablet-camera-dot"></span>';

					const screenArea = document.createElement('div');
					screenArea.className = 'tablet-screen-area';

					const bottomBezel = document.createElement('div');
					bottomBezel.className = 'tablet-bottom-bezel';
					bottomBezel.innerHTML = '<span class="tablet-home-indicator"></span>';

					targetInsertNode.parentNode?.insertBefore(wrapper, targetInsertNode);
					screenArea.appendChild(img);
					tablet.appendChild(topBezel);
					tablet.appendChild(screenArea);
					tablet.appendChild(bottomBezel);
					wrapper.appendChild(tablet);

					// Render clean bottom label underneath if descriptive alt text exists
					if (cleanAlt && cleanAlt.length > 0) {
						const caption = document.createElement('span');
						caption.className = 'md-tablet-caption';
						caption.textContent = cleanAlt;
						wrapper.appendChild(caption);
					}

					if (targetInsertNode !== img && targetInsertNode.parentNode) {
						targetInsertNode.remove();
					}
				}
			}

			articleImgs.forEach((img) => {
				applyDeviceFrame(img);
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', () => {
				initMermaid();
				initTocScrollSpy();
				initScreenshotFrames();
			});
		} else {
			initMermaid();
			initTocScrollSpy();
			initScreenshotFrames();
		}
	</script>
