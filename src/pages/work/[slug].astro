---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseBreadcrumb from '../../components/work/CaseBreadcrumb.astro';
import CaseHero from '../../components/work/CaseHero.astro';
import CaseMetaRail from '../../components/work/CaseMetaRail.astro';
import CaseArticle from '../../components/work/CaseArticle.astro';
import CaseMarkdown from '../../components/work/CaseMarkdown.astro';
import CaseAdjacentNav from '../../components/work/CaseAdjacentNav.astro';
import CaseToc from '../../components/work/CaseToc.astro';
import { ipLabel, isRealUrl, shots } from '../../lib/work';
import '../../styles/case.css';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	const sorted = [...projects].sort((a, b) => a.data.order - b.data.order);

	return projects.flatMap((project) => {
		const currentIndex = sorted.findIndex((p) => p.id === project.id);
		const prevProject = currentIndex > 0 ? sorted[currentIndex - 1] : null;
		const nextProject = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;
		const props = { project, prevProject, nextProject };
		const paths = [{ params: { slug: project.id }, props }];
		if (project.data.id && project.data.id !== project.id) {
			paths.push({ params: { slug: project.data.id }, props });
		}
		return paths;
	});
}

const { project, prevProject, nextProject } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);

const rawBody = project.body || '';
const structuredWords = [
	data.title || '',
	data.description || '',
	data.executiveOverview || '',
	data.problemStatement || '',
	...(data.impactMetrics?.map((m) => `${m.label} ${m.value} ${m.detail || ''}`) || []),
	...(data.keyDecisions?.map((k) => `${k.challenge} ${k.decision} ${k.outcome || ''}`) || [])
].join(' ');
const totalWordCount = (rawBody + ' ' + structuredWords).replace(/[#*`_~[\]()]/g, ' ').trim().split(/\s+/).filter(Boolean).length;
const readingTimeText = `${Math.max(1, Math.ceil(totalWordCount / 200))} min`;

const tocItems: { id: string; text: string }[] = [];
if (data.executiveOverview || data.impactMetrics?.length) tocItems.push({ id: 'overview', text: 'Overview' });
if (data.keyDecisions?.length || data.problemStatement) tocItems.push({ id: 'decisions', text: 'Decisions' });
if (data.valueProposition) tocItems.push({ id: 'before-after', text: 'Before → after' });
if (data.techStack) tocItems.push({ id: 'stack', text: 'Stack' });
if (data.securityReliability?.length || data.futureRoadmap?.length) tocItems.push({ id: 'security-roadmap', text: 'Security' });
headings.forEach((h) => {
	if (h.depth === 2 && !tocItems.some((item) => item.id === h.slug || item.text.toLowerCase() === h.text.toLowerCase())) {
		tocItems.push({ id: h.slug, text: h.text });
	}
});
const showToc = tocItems.length >= 4;

const classLabel = ipLabel(data.classification);
const live = isRealUrl(data.links?.liveDemo);
const parent = isRealUrl(data.links?.parentPlatform);
const github = isRealUrl(data.links?.github);
const ghFront = isRealUrl(data.links?.githubFrontend);
const ghBack = isRealUrl(data.links?.githubBackend);
const docs = isRealUrl(data.links?.docs);
const hasActions = live || parent || github || ghFront || ghBack || docs;

const realImages = shots(data.images);
const heroStill =
	data.platformType !== 'mobile' &&
	data.visualAssets?.heroMockup &&
	!data.visualAssets.heroMockup.includes('dummy')
		? data.visualAssets.heroMockup
		: realImages[0];
const isPhone = data.platformType === 'mobile';

const stackRows = [
	{ label: 'Frontend', items: data.techStack?.frontend },
	{ label: 'Mobile', items: data.techStack?.mobile_hardware },
	{ label: 'Backend', items: data.techStack?.backend },
	{ label: 'Database', items: data.techStack?.database },
	{ label: 'DevOps', items: data.techStack?.devops }
].filter((row) => row.items && row.items.length > 0);
---

<BaseLayout title={`${data.title} | Case Study`} description={data.description} isWide alignStart>
	<div class:list={['case-shell', { 'has-toc': showToc }]}>
		<article class="case">
			<CaseBreadcrumb title={data.title} readingTimeText={readingTimeText} />
			<CaseHero
				title={data.title}
				chip={data.chip}
				status={data.status}
				classLabel={classLabel}
				role={data.role}
				timeline={data.timeline}
				description={data.description}
				impactMetrics={data.impactMetrics}
				links={data.links}
				hasActions={hasActions}
				live={live}
				parent={parent}
				github={github}
				ghFront={ghFront}
				ghBack={ghBack}
				docs={docs}
				heroStill={heroStill}
				realImages={realImages}
				isPhone={isPhone}
			/>
			<CaseMetaRail role={data.role} timeline={data.timeline} classLabel={classLabel} />
			<CaseArticle
				executiveOverview={data.executiveOverview}
				problemStatement={data.problemStatement}
				keyDecisions={data.keyDecisions}
				valueProposition={data.valueProposition}
				stackRows={stackRows}
				securityReliability={data.securityReliability}
				futureRoadmap={data.futureRoadmap}
			/>
			<CaseMarkdown>
				<Content />
			</CaseMarkdown>
			<CaseAdjacentNav prevProject={prevProject} nextProject={nextProject} />
		</article>

		{showToc && <CaseToc items={tocItems} />}
	</div>
</BaseLayout>
