---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	const sorted = [...projects].sort((a, b) => a.data.order - b.data.order);

	const paths: any[] = [];
	projects.forEach((project) => {
		const currentIndex = sorted.findIndex((p) => p.id === project.id);
		const prevProject = currentIndex > 0 ? sorted[currentIndex - 1] : null;
		const nextProject = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;

		// Support file-based slug (e.g. "01-tradeflowbd")
		paths.push({
			params: { slug: project.id },
			props: { project, prevProject, nextProject }
		});

		// If entry has custom data.id (e.g. "01"), also support that slug if different
		if (project.data.id && project.data.id !== project.id) {
			paths.push({
				params: { slug: project.data.id },
				props: { project, prevProject, nextProject }
			});
		}
	});

	return paths;
}

const { project, prevProject, nextProject } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);

// Calculate estimated reading time based on total word count of content and structured sections
const rawBody = project.body || '';
const structuredWords = [
	data.title || '',
	data.subtitle || '',
	data.description || '',
	data.executiveOverview || '',
	data.problemStatement || '',
	data.architectureSummary || '',
	...(data.impactMetrics?.map((m: any) => `${m.label} ${m.value} ${m.detail || ''}`) || []),
	...(data.keyDecisions?.map((k: any) => `${k.challenge} ${k.decision} ${k.outcome || ''}`) || []),
	...(data.securityReliability || []),
	...(data.futureRoadmap || [])
].join(' ');

const totalWordCount = (rawBody + ' ' + structuredWords)
	.replace(/[#*`_~[\]()]/g, ' ')
	.trim()
	.split(/\s+/)
	.filter(Boolean).length;

const wordsPerMinute = 200;
const readingMinutes = Math.max(1, Math.ceil(totalWordCount / wordsPerMinute));
const readingTimeText = `${readingMinutes} min read`;

// Construct comprehensive table of contents
const tocItems: { id: string; text: string; depth: number }[] = [];

if (data.executiveOverview || (data.impactMetrics && data.impactMetrics.length > 0)) {
	tocItems.push({ id: 'executive-overview', text: 'Executive Overview', depth: 2 });
}
if (data.techStack && Object.keys(data.techStack).length > 0) {
	tocItems.push({ id: 'tech-stack', text: 'Technology Stack', depth: 2 });
}
if (data.problemStatement || (data.keyDecisions && data.keyDecisions.length > 0)) {
	tocItems.push({ id: 'engineering-decisions', text: 'Engineering Decisions', depth: 2 });
}
if (data.valueProposition) {
	tocItems.push({ id: 'value-proposition', text: 'Value Proposition Canvas', depth: 2 });
}
if (data.securityReliability?.length > 0 || data.futureRoadmap?.length > 0) {
	tocItems.push({ id: 'security-roadmap', text: 'Security & Roadmap', depth: 2 });
}

// Add all markdown headings (depth 2)
headings.forEach((h) => {
	if (h.depth === 2) {
		const isDuplicate = tocItems.some(
			(item) => item.id === h.slug || item.text.toLowerCase() === h.text.toLowerCase()
		);
		if (!isDuplicate) {
			tocItems.push({ id: h.slug, text: h.text, depth: 2 });
		}
	}
});

// Check if the project has genuine production screenshots (not placeholders/dummies)
const realImages = (data.images || []).filter(
	(img: string) => img && !img.includes('dummy') && !img.includes('thumb-')
);
const realMobileImages = realImages.filter(
	(img: string) => !img.includes('web-') && !img.includes('dashboard') && !img.includes('chart-of-accounts')
);
const hasRealHeroMockup = Boolean(data.visualAssets?.heroMockup) && !data.visualAssets?.heroMockup?.includes('dummy');
const hasRealHeroImage = data.platformType === 'mobile' 
	? realMobileImages.length > 0 
	: hasRealHeroMockup;

// Helper to validate whether a link is a real project target (not generic GitHub profile or placeholder)
const isRealUrl = (url?: string) => {
	if (!url) return false;
	const trimmed = url.trim().replace(/\/+$/, '');
	if (!trimmed.startsWith('http://') && !trimmed.startsWith('https://')) return false;
	if (trimmed === 'https://github.com/marceldavidbaroi' || trimmed === 'https://github.com') return false;
	if (trimmed.includes('example.com') || trimmed.includes('localhost')) return false;
	return true;
};

const hasActionButtons = Boolean(
	isRealUrl(data.links?.liveDemo) ||
	isRealUrl(data.links?.parentPlatform) ||
	isRealUrl(data.links?.github) ||
	isRealUrl(data.links?.githubFrontend) ||
	isRealUrl(data.links?.githubBackend) ||
	isRealUrl(data.links?.docs)
);
---

<BaseLayout 
	title={`${data.title} | Case Study`} 
	description={data.subtitle || data.description}
	isWide={true}
>
	<div class="case-layout-grid">
		<!-- Main Article Content Area -->
		<article class="case-study-page case-detail-container" data-platform={data.platformType || 'desktop'}>
			<!-- Top Breadcrumb & Tag -->
			<div class="breadcrumb-bar">
				<a href="/work" class="back-link">
					<span class="arrow">‹</span> Back to Selected Work
				</a>
				<div class="breadcrumb-right">
					<span class="read-time-pill font-mono">
						<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<polyline points="12 6 12 12 16 14"></polyline>
						</svg>
						{readingTimeText}
					</span>
					<span class="case-tag font-dot">CASE STUDY // {data.id}</span>
				</div>
			</div>

		<!-- Main Case Study Header -->
		<header class="case-header">
			<div class="header-badge-row">
				<span class="chip-accent font-dot">{data.chip}</span>
				{data.status && <span class="status-pill">{data.status}</span>}
				<span class="classification-pill font-mono">
					{data.classification || (hasActionButtons && isRealUrl(data.links?.github)
						? '🌐 Open Source Architecture'
						: '🔒 Proprietary Enterprise IP')}
				</span>
				<span class="header-read-time font-mono">
					<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="10"></circle>
						<polyline points="12 6 12 12 16 14"></polyline>
					</svg>
					{readingTimeText}
				</span>
			</div>

			{data.securityReliability && data.securityReliability.length > 0 && (
				<div class="reliability-pills-row font-mono">
					{data.securityReliability.slice(0, 3).map((item) => (
						<span class="reliability-pill">{item}</span>
					))}
				</div>
			)}

			<h1 class="case-title font-dot">{data.title}</h1>
			
			{data.subtitle && (
				<p class="case-subtitle">{data.subtitle}</p>
			)}

			{data.description && (
				<p class="case-description font-sans">{data.description}</p>
			)}

			{data.valueProposition?.items?.[0] && (
				<div class="lead-before-after card">
					<span class="lead-ba-tag font-mono">BUSINESS OUTCOME // BEFORE → AFTER</span>
					<div class="lead-ba-grid">
						<div class="lead-ba-col before">
							<span class="lead-ba-label font-mono">Before</span>
							<strong class="lead-ba-title">{data.valueProposition.items[0].painTitle}</strong>
							<p class="lead-ba-desc">{data.valueProposition.items[0].painDescription}</p>
						</div>
						<div class="lead-ba-arrow font-dot" aria-hidden="true">→</div>
						<div class="lead-ba-col after">
							<span class="lead-ba-label font-mono">After</span>
							<strong class="lead-ba-title">{data.valueProposition.items[0].gainTitle}</strong>
							<p class="lead-ba-desc">{data.valueProposition.items[0].gainDescription}</p>
						</div>
					</div>
				</div>
			)}

			<!-- Action Buttons / Links (Only rendered if genuine links exist) -->
			{hasActionButtons && (
				<div class="project-actions">
					{isRealUrl(data.links?.liveDemo) && (
						<a href={data.links!.liveDemo} target="_blank" rel="noopener noreferrer" class="btn btn-accent">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle>
								<line x1="2" y1="22" y2="12"></line>
								<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
							</svg>
							Live Demo
						</a>
					)}
					{isRealUrl(data.links?.parentPlatform) && (
						<a href={data.links!.parentPlatform} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
								<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
							</svg>
							Parent Platform
						</a>
					)}
					{isRealUrl(data.links?.github) && (
						<a href={data.links!.github} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
								<path d="M9 18c-4.51 2-5-2-7-2"></path>
							</svg>
							Repository
						</a>
					)}
					{isRealUrl(data.links?.githubFrontend) && (
						<a href={data.links!.githubFrontend} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
							Frontend Repo
						</a>
					)}
					{isRealUrl(data.links?.githubBackend) && (
						<a href={data.links!.githubBackend} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
							Backend Repo
						</a>
					)}
					{isRealUrl(data.links?.docs) && (
						<a href={data.links!.docs} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
							Documentation
						</a>
					)}
				</div>
			)}
		</header>

		<!-- 1. Hero Image / Application Mockup Showcase (Rendered ONLY if genuine screenshots exist) -->
		{hasRealHeroImage && (
			<section class="case-section">
				{data.platformType === 'mobile' ? (
					<div class="hero-mobile-gallery-wrapper">
						<div class="hero-mobile-devices-row">
							{realMobileImages.slice(0, 3).map((screenImg: string, sIdx: number) => (
								<div class={`hero-mobile-phone-device device-pos-${sIdx}`}>
									<div class="mobile-speaker-notch">
										<span class="notch-camera-dot"></span>
										<span class="notch-speaker-bar"></span>
									</div>
									<div class="mobile-mockup-screen">
										<img 
											src={screenImg} 
											alt={`${data.title} Mobile Screen ${sIdx + 1}`} 
											class="mobile-hero-img" 
											loading="eager"
										/>
									</div>
									<div class="mobile-home-indicator"></div>
								</div>
							))}
						</div>
					</div>
				) : (
					<div class="hero-mockup-frame">
						<div class="browser-header">
							<div class="window-dots">
								<span></span><span></span><span></span>
							</div>
							<span class="browser-url">app.{data.id.toLowerCase()}.internal/dashboard</span>
						</div>
						<div class="mockup-display-area">
							<img 
								src={data.visualAssets!.heroMockup} 
								alt={`${data.title} Interface Screenshot`} 
								class="hero-mockup-img" 
								loading="eager"
							/>
						</div>
					</div>
				)}
			</section>
		)}

		<!-- 2. Metadata Quick Overview Table / Grid -->
		<section class="case-section">
			<div class="metadata-grid">
				{data.role && (
					<div class="meta-box card">
						<span class="meta-label">Role & Responsibilities</span>
						<p class="meta-value font-sans">{data.role}</p>
					</div>
				)}
				{data.timeline && (
					<div class="meta-box card">
						<span class="meta-label">Timeline & Lifecycle</span>
						<p class="meta-value font-sans">{data.timeline}</p>
					</div>
				)}
				<div class="meta-box card">
					<span class="meta-label">Project Classification</span>
					<p class="meta-value font-sans">
						{data.classification || (hasActionButtons && isRealUrl(data.links?.github) 
							? '🌐 Open Source Architecture' 
							: '🔒 Proprietary Enterprise IP')}
					</p>
				</div>
				<div class="meta-box card meta-box-readtime">
					<span class="meta-label">Recruiter Review Budget</span>
					<p class="meta-value font-sans readtime-meta-val">
						<svg class="meta-clock-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<polyline points="12 6 12 12 16 14"></polyline>
						</svg>
						<span>{readingTimeText}</span>
						<span class="readtime-sub font-mono">({totalWordCount.toLocaleString()} words)</span>
					</p>
				</div>
			</div>
		</section>


		<!-- 3. Executive Overview (Google XYZ Pattern) & KPI Metric Badges -->
		{data.executiveOverview && (
			<section class="case-section" id="executive-overview">
				<div class="xyz-overview-card card">
					<span class="section-tag font-mono">01 // IMPACT FORMULA</span>
					<h2 class="section-heading">Executive Overview</h2>
					<blockquote class="xyz-quote font-sans">
						"{data.executiveOverview}"
					</blockquote>

					{data.impactMetrics && data.impactMetrics.length > 0 && (
						<div class="metrics-row">
							{data.impactMetrics.map((metric) => (
								<div class="metric-card">
									<span class="metric-val font-mono">{metric.value}</span>
									<span class="metric-lbl font-mono">{metric.label}</span>
									{metric.detail && <span class="metric-sub font-sans">{metric.detail}</span>}
								</div>
							))}
						</div>
					)}
				</div>
			</section>
		)}

		<!-- 4. Categorized Tech Stack Matrix (Directly under Overview for Rapid Technical Scanning) -->
		{data.techStack && (
			<section class="case-section" id="tech-stack">
				<span class="section-tag font-mono">02 // ARCHITECTURE</span>
				<h2 class="section-heading">Technology Stack</h2>
				
				<div class="tech-stack-grid">
					{data.techStack.frontend && data.techStack.frontend.length > 0 && (
						<div class="tech-group card">
							<span class="tech-group-title">Frontend Ecosystem</span>
							<div class="tech-tags-wrap font-mono">
								{data.techStack.frontend.map((item) => (
									<span class="tech-badge">{item}</span>
								))}
							</div>
						</div>
					)}
					{data.techStack.mobile_hardware && data.techStack.mobile_hardware.length > 0 && (
						<div class="tech-group card">
							<span class="tech-group-title">Mobile Hardware & ML Kit</span>
							<div class="tech-tags-wrap font-mono">
								{data.techStack.mobile_hardware.map((item) => (
									<span class="tech-badge">{item}</span>
								))}
							</div>
						</div>
					)}
					{data.techStack.backend && data.techStack.backend.length > 0 && (
						<div class="tech-group card">
							<span class="tech-group-title">Backend & APIs</span>
							<div class="tech-tags-wrap font-mono">
								{data.techStack.backend.map((item) => (
									<span class="tech-badge">{item}</span>
								))}
							</div>
						</div>
					)}
					{data.techStack.database && data.techStack.database.length > 0 && (
						<div class="tech-group card">
							<span class="tech-group-title">Database & Storage</span>
							<div class="tech-tags-wrap font-mono">
								{data.techStack.database.map((item) => (
									<span class="tech-badge">{item}</span>
								))}
							</div>
						</div>
					)}
					{data.techStack.devops && data.techStack.devops.length > 0 && (
						<div class="tech-group card">
							<span class="tech-group-title">DevOps & Tooling</span>
							<div class="tech-tags-wrap font-mono">
								{data.techStack.devops.map((item) => (
									<span class="tech-badge">{item}</span>
								))}
							</div>
						</div>
					)}
				</div>
			</section>
		)}

		<!-- 5. Problem Statement & Key Technical Decisions -->
		{(data.problemStatement || (data.keyDecisions && data.keyDecisions.length > 0)) && (
			<section class="case-section" id="engineering-decisions">
				<span class="section-tag font-mono">03 // ENGINEERING DECISIONS</span>
				<h2 class="section-heading">Technical Challenges & Solutions</h2>

				{data.problemStatement && (
					<div class="problem-box card">
						<div class="problem-badge-row">
							<span class="problem-badge font-mono">PROBLEM STATEMENT</span>
							<span class="problem-tag font-mono">CORE FRICTION</span>
						</div>
						<p class="problem-body font-sans">{data.problemStatement}</p>
					</div>
				)}

				{data.keyDecisions && data.keyDecisions.length > 0 && (
					<div class="architecture-matrix-container card">
						<div class="matrix-table-wrapper">
							<table class="architecture-matrix-table">
								<thead>
									<tr class="font-mono">
										<th class="col-challenge">01 // Architectural Challenge</th>
										<th class="col-solution">02 // Engineering Solution</th>
										<th class="col-impact">03 // Measured Impact</th>
									</tr>
								</thead>
								<tbody>
									{data.keyDecisions.map((item, idx) => (
										<tr class="matrix-row">
											<td class="cell-challenge">
												<div class="challenge-title-wrap">
													<span class="challenge-idx font-mono">0{idx + 1}</span>
													<span class="challenge-name font-sans">{item.challenge}</span>
												</div>
											</td>
											<td class="cell-solution font-sans">
												<div class="solution-text-box">
													<p>{item.decision}</p>
												</div>
											</td>
											<td class="cell-impact font-sans">
												{item.outcome ? (
													<div class="impact-pill-wrap">
														<span class="impact-check">✓</span>
														<p class="impact-text">{item.outcome}</p>
													</div>
												) : (
													<span class="impact-none font-mono">—</span>
												)}
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</div>
				)}
			</section>
		)}

		<!-- 6. Value Proposition Canvas (2-Column Pain vs Gain Industry Standard) -->
		{data.valueProposition && (
			<section class="case-section" id="value-proposition">
				<span class="section-tag font-mono">04 // PRODUCT STRATEGY</span>
				<h2 class="section-heading">Value Proposition Canvas</h2>
				
				<div class="vpc-target-row">
					<span class="vpc-target-label font-mono">TARGET MARKET & USERS:</span>
					<span class="vpc-target-val font-sans">{data.valueProposition.targetCustomer}</span>
				</div>

				<div class="vpc-matrix-container card">
					<div class="vpc-table-wrapper">
						<table class="vpc-table">
							<thead>
								<tr class="font-mono">
									<th class="vpc-th-pains">
										<div class="vpc-th-title-wrap">
											<span class="vpc-th-icon">🛑</span>
											<span>Severe Pains & User Friction (Before)</span>
										</div>
									</th>
									<th class="vpc-th-gains">
										<div class="vpc-th-title-wrap">
											<span class="vpc-th-icon">⚡</span>
											<span>Architectural Gains & Resolution (After)</span>
										</div>
									</th>
								</tr>
							</thead>
							<tbody>
								{data.valueProposition.items.map((item) => (
									<tr class="vpc-row">
										<!-- Left Column: Pain / Friction -->
										<td class="vpc-cell-pain">
											<div class="vpc-pair-box">
												<div class="vpc-pair-header">
													<span class="vpc-pain-cross">✕</span>
													<h4 class="vpc-pair-title vpc-pain-title font-sans">{item.painTitle}</h4>
												</div>
												<p class="vpc-pair-desc font-sans">{item.painDescription}</p>
											</div>
										</td>

										<!-- Right Column: Gain / Solution -->
										<td class="vpc-cell-gain">
											<div class="vpc-pair-box">
												<div class="vpc-pair-header">
													<span class="vpc-gain-check">✓</span>
													<h4 class="vpc-pair-title vpc-gain-title font-sans">{item.gainTitle}</h4>
												</div>
												<p class="vpc-pair-desc font-sans">{item.gainDescription}</p>
											</div>
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</div>
			</section>
		)}

		<!-- 7. Security, Reliability & Future Roadmap -->
		{(data.securityReliability?.length > 0 || data.futureRoadmap?.length > 0) && (
			<section class="case-section" id="security-roadmap">
				<div class="security-roadmap-grid">
					{data.securityReliability?.length > 0 && (
						<div class="card font-mono">
							<span class="section-tag font-mono">SECURITY</span>
							<h3 class="box-heading">Security & Reliability</h3>
							<ul class="check-list">
								{data.securityReliability.map((item) => (
									<li>
										<span class="check-icon">✓</span>
