---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseBreadcrumb from '../../components/work/CaseBreadcrumb.astro';
import CaseHero from '../../components/work/CaseHero.astro';
import CaseStudyLayout from '../../components/work/CaseStudyLayout.astro';
import CaseContributionChapter from '../../components/work/CaseContributionChapter.astro';
import CaseProductChapter from '../../components/work/CaseProductChapter.astro';
import CaseProofChapter from '../../components/work/CaseProofChapter.astro';
import CaseBuildChapter from '../../components/work/CaseBuildChapter.astro';
import CaseTrustChapter from '../../components/work/CaseTrustChapter.astro';
import CaseDeepDive from '../../components/work/CaseDeepDive.astro';
import CaseMarkdown from '../../components/work/CaseMarkdown.astro';
import CaseAdjacentNav from '../../components/work/CaseAdjacentNav.astro';
import CaseImageLightbox from '../../components/ui/CaseImageLightbox.astro';
import { deriveMyImpact, resolveProductForDetail, toCaseStudyView } from '../../lib/projectView';
import { ipLabel, isRealUrl } from '../../lib/work';
import '../../styles/case.css';
import '../../styles/case-study.css';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	const sorted = [...projects].sort((a, b) => a.data.order - b.data.order);

	return projects.flatMap((project) => {
		const currentIndex = sorted.findIndex((p) => p.id === project.id);
		const prevProject = currentIndex > 0 ? sorted[currentIndex - 1] : null;
		const nextProject = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;
		const props = { project, prevProject, nextProject };
		const paths = [{ params: { slug: project.id }, props }];
		if (project.data.id && project.data.id !== project.id) {
			paths.push({ params: { slug: project.data.id }, props });
		}
		return paths;
	});
}

const { project, prevProject, nextProject } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const rawBody = project.body || '';
const contribution = data.contribution;
const product = data.product;
const caseStory = data.caseStory;

const structuredWords = [
	data.title || '',
	data.subtitle || '',
	data.description || '',
	contribution?.headline || '',
	product?.summary || '',
	product?.problem || '',
	...(contribution?.scope || []),
	...(data.myImpact?.map((m) => `${m.label} ${m.value} ${m.detail || ''}`) || []),
	...(data.keyDecisions?.map((k) => `${k.challenge} ${k.decision} ${k.outcome || ''}`) || [])
].join(' ');
const totalWordCount = (rawBody + ' ' + structuredWords).replace(/[#*`_~[\]()]/g, ' ').trim().split(/\s+/).filter(Boolean).length;
const readingTimeText = `~${Math.max(1, Math.ceil(totalWordCount / 200))} min read`;

const classLabel = ipLabel(data.classification);
const live = isRealUrl(data.links?.liveDemo);
const parent = isRealUrl(data.links?.parentPlatform);
const github = isRealUrl(data.links?.github);
const ghFront = isRealUrl(data.links?.githubFrontend);
const ghBack = isRealUrl(data.links?.githubBackend);
const docs = isRealUrl(data.links?.docs);
const hasActions = live || parent || github || ghFront || ghBack || docs;

const sanitize = (src?: string) => {
	if (!src) return null;
	if (src.includes('dummy') || src.includes('thumb-')) return null;
	return src;
};

const allProjectImages = Array.from(
	new Set(
		[
			data.visualAssets?.heroMockup,
			...(data.images || []),
			...(data.visualAssets?.screenshots || [])
		]
			.map(sanitize)
			.filter((img): img is string => Boolean(img))
	)
);

const isPhone = data.platformType === 'mobile';

const stackRows = [
	{ label: 'Frontend', items: data.techStack?.frontend },
	{ label: 'Mobile & Hardware', items: data.techStack?.mobile_hardware },
	{ label: 'Backend', items: data.techStack?.backend },
	{ label: 'Database', items: data.techStack?.database },
	{ label: 'DevOps & Infra', items: data.techStack?.devops }
].filter((row) => row.items && row.items.length > 0);

const hasMarkdownBody = rawBody.trim().length > 0;

const caseView = toCaseStudyView(project, {
	imageCount: allProjectImages.length,
	hasMarkdownBody,
	hasStackRows: stackRows.length > 0,
	hasKeyDecisions: (data.keyDecisions?.length ?? 0) > 0,
	hasStackRationale: (caseStory?.stackRationale?.length ?? 0) > 0,
	hasSecurity: (data.securityReliability?.length ?? 0) > 0,
	hasRoadmap: (data.futureRoadmap?.length ?? 0) > 0,
});

const outcomeLine = contribution.headline?.trim() || undefined;

const productForChapter = resolveProductForDetail(data);
---

<BaseLayout title={`${data.title} | Case Study`} description={data.description} isWide alignStart>
	<div class="case-shell">
		<article class="case">
			<CaseBreadcrumb title={data.title} readingTimeText={readingTimeText} />

			<CaseStudyLayout chapters={caseView.chapters}>
				<section id="case-top" class="case-chapter case-chapter--hero">
					<CaseHero
						title={data.title}
						subtitle={data.subtitle}
						chip={data.chip}
						status={data.status}
						classLabel={classLabel}
						role={data.role}
						timeline={data.timeline}
						links={data.links}
						hasActions={hasActions}
						live={live}
						parent={parent}
						github={github}
						ghFront={ghFront}
						ghBack={ghBack}
						docs={docs}
						stack={data.stack}
						heroImages={allProjectImages}
						isPhone={isPhone}
						outcomeLine={outcomeLine}
						contributionLabel={contribution.label?.trim()}
					/>
				</section>

				{caseView.hasContributionChapter && (
					<CaseContributionChapter contribution={contribution} />
				)}

				{caseView.hasProductChapter && (
					<CaseProductChapter
						product={productForChapter}
						caseStory={caseStory}
						showCaseStory={caseView.showCaseStory}
						showVpc={caseView.showVpc}
						problem={data.problem}
						benefitMatrix={data.benefitMatrix}
						projectId={data.id || project.id}
					/>
				)}

				{caseView.hasProofChapter && (
					<CaseProofChapter
						myImpact={deriveMyImpact(data)}
						images={allProjectImages}
						title={data.title}
						isPhone={isPhone}
					/>
				)}

				{caseView.hasBuildChapter && (
					<CaseBuildChapter
						stackRationale={caseStory?.stackRationale}
						stackRows={stackRows}
						keyDecisions={data.keyDecisions}
						problemStatement={data.problem?.statement || product.problem}
						improvements={data.improvements}
					/>
				)}

				{caseView.hasTrustChapter && (
					<CaseTrustChapter
						securityReliability={data.securityReliability}
						futureRoadmap={data.futureRoadmap}
					/>
				)}

				{caseView.hasAppendixChapter && (
					<CaseDeepDive defaultExpanded={false}>
						<CaseMarkdown>
							<Content />
						</CaseMarkdown>
					</CaseDeepDive>
				)}
			</CaseStudyLayout>

			<CaseAdjacentNav prevProject={prevProject} nextProject={nextProject} />
			<CaseImageLightbox />
		</article>
	</div>

	<script>
		function isCaseBlockInView(el: HTMLElement) {
			const rect = el.getBoundingClientRect();
			const vh = window.innerHeight || document.documentElement.clientHeight;
			return rect.top < vh * 0.92 && rect.bottom > vh * 0.08;
		}

		function setupCaseStudyReveal() {
			const revealElements = document.querySelectorAll<HTMLElement>(
				'.case-chapter--hero, #case-proof, .adjacent'
			);
			if (!revealElements.length) return;

			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			revealElements.forEach((el) => {
				if (!el.classList.contains('case-reveal')) {
					el.classList.add('case-reveal');
				}
				if (reducedMotion || isCaseBlockInView(el)) {
					el.classList.add('is-revealed');
				}
			});

			if (reducedMotion || !('IntersectionObserver' in window)) {
				revealElements.forEach((el) => el.classList.add('is-revealed'));
				return;
			}

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-revealed');
							observer.unobserve(entry.target);
						}
					});
				},
				{
					root: null,
					rootMargin: '0px 0px -8% 0px',
					threshold: 0,
				}
			);

			revealElements.forEach((el) => {
				if (!el.classList.contains('is-revealed')) {
					observer.observe(el);
				}
			});
		}

		setupCaseStudyReveal();
		document.addEventListener('astro:page-load', setupCaseStudyReveal);
		document.addEventListener('astro:after-swap', setupCaseStudyReveal);
	</script>
</BaseLayout>
