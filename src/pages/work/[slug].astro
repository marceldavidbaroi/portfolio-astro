---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project, index) => {
		const sorted = [...projects].sort((a, b) => a.data.order - b.data.order);
		const currentIndex = sorted.findIndex((p) => p.id === project.id);
		const prevProject = currentIndex > 0 ? sorted[currentIndex - 1] : null;
		const nextProject = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;

		return {
			params: { slug: project.id },
			props: { project, prevProject, nextProject }
		};
	});
}

const { project, prevProject, nextProject } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);

// Construct comprehensive table of contents
const tocItems: { id: string; text: string; depth: number }[] = [];

if (data.executiveOverview || (data.impactMetrics && data.impactMetrics.length > 0)) {
	tocItems.push({ id: 'executive-overview', text: 'Executive Overview', depth: 2 });
}
if (data.techStack && Object.keys(data.techStack).length > 0) {
	tocItems.push({ id: 'tech-stack', text: 'Technology Stack', depth: 2 });
}
if (data.problemStatement || (data.keyDecisions && data.keyDecisions.length > 0)) {
	tocItems.push({ id: 'engineering-decisions', text: 'Engineering Decisions', depth: 2 });
}
if (data.securityReliability?.length > 0 || data.futureRoadmap?.length > 0) {
	tocItems.push({ id: 'security-roadmap', text: 'Security & Roadmap', depth: 2 });
}

// Add all markdown headings (depth 2)
headings.forEach((h) => {
	if (h.depth === 2) {
		const isDuplicate = tocItems.some(
			(item) => item.id === h.slug || item.text.toLowerCase() === h.text.toLowerCase()
		);
		if (!isDuplicate) {
			tocItems.push({ id: h.slug, text: h.text, depth: 2 });
		}
	}
});

// Check if the project has genuine production screenshots (not placeholders/dummies)
const realImages = (data.images || []).filter(
	(img: string) => img && !img.includes('dummy') && !img.includes('thumb-')
);
const hasRealHeroMockup = Boolean(data.visualAssets?.heroMockup) && !data.visualAssets?.heroMockup?.includes('dummy');
const hasRealHeroImage = data.platformType === 'mobile' 
	? realImages.length > 0 
	: hasRealHeroMockup;

// Helper to validate whether a link is a real project target (not generic GitHub profile or placeholder)
const isRealUrl = (url?: string) => {
	if (!url) return false;
	const trimmed = url.trim().replace(/\/+$/, '');
	if (!trimmed.startsWith('http://') && !trimmed.startsWith('https://')) return false;
	if (trimmed === 'https://github.com/marceldavidbaroi' || trimmed === 'https://github.com') return false;
	if (trimmed.includes('example.com') || trimmed.includes('localhost')) return false;
	return true;
};

const hasActionButtons = Boolean(
	isRealUrl(data.links?.liveDemo) ||
	isRealUrl(data.links?.parentPlatform) ||
	isRealUrl(data.links?.github) ||
	isRealUrl(data.links?.githubFrontend) ||
	isRealUrl(data.links?.githubBackend) ||
	isRealUrl(data.links?.docs)
);
---

<BaseLayout 
	title={`${data.title} | Case Study`} 
	description={data.subtitle || data.description}
	isWide={true}
>
	<div class="case-layout-grid">
		<!-- Main Article Content Area -->
		<article class="case-study-page case-detail-container font-mono" data-platform={data.platformType || 'desktop'}>
			<!-- Top Breadcrumb & Tag -->
			<div class="breadcrumb-bar">
				<a href="/work" class="back-link">
					<span class="arrow">‹</span> Back to Selected Work
				</a>
				<span class="case-tag font-dot">CASE STUDY // {data.id}</span>
			</div>

		<!-- Main Case Study Header -->
		<header class="case-header">
			<div class="header-badge-row">
				<span class="chip-accent font-dot">{data.chip}</span>
				{data.status && <span class="status-pill">{data.status}</span>}
			</div>

			<h1 class="case-title font-dot">{data.title}</h1>
			
			{data.subtitle && (
				<p class="case-subtitle">{data.subtitle}</p>
			)}

			<!-- Action Buttons / Links (Only rendered if genuine links exist) -->
			{hasActionButtons && (
				<div class="project-actions">
					{isRealUrl(data.links?.liveDemo) && (
						<a href={data.links!.liveDemo} target="_blank" rel="noopener noreferrer" class="btn btn-accent">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle>
								<line x1="2" y1="22" y2="12"></line>
								<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
							</svg>
							Live Demo
						</a>
					)}
					{isRealUrl(data.links?.parentPlatform) && (
						<a href={data.links!.parentPlatform} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
								<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
							</svg>
							Parent Platform
						</a>
					)}
					{isRealUrl(data.links?.github) && (
						<a href={data.links!.github} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
								<path d="M9 18c-4.51 2-5-2-7-2"></path>
							</svg>
							Repository
						</a>
					)}
					{isRealUrl(data.links?.githubFrontend) && (
						<a href={data.links!.githubFrontend} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
							Frontend Repo
						</a>
					)}
					{isRealUrl(data.links?.githubBackend) && (
						<a href={data.links!.githubBackend} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
							Backend Repo
						</a>
					)}
					{isRealUrl(data.links?.docs) && (
						<a href={data.links!.docs} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
							Documentation
						</a>
					)}
				</div>
			)}
		</header>

		<!-- 1. Hero Image / Application Mockup Showcase (Rendered ONLY if genuine screenshots exist) -->
		{hasRealHeroImage && (
			<section class="case-section">
				{data.platformType === 'mobile' ? (
					<div class="hero-mobile-gallery-wrapper">
						<div class="hero-mobile-devices-row">
							{realImages.slice(0, 3).map((screenImg: string, sIdx: number) => (
								<div class={`hero-mobile-phone-device device-pos-${sIdx}`}>
									<div class="mobile-speaker-notch">
										<span class="notch-camera-dot"></span>
										<span class="notch-speaker-bar"></span>
									</div>
									<div class="mobile-mockup-screen">
										<img 
											src={screenImg} 
											alt={`${data.title} Mobile Screen ${sIdx + 1}`} 
											class="mobile-hero-img" 
											loading="eager"
										/>
									</div>
									<div class="mobile-home-indicator"></div>
								</div>
							))}
						</div>
					</div>
				) : (
					<div class="hero-mockup-frame">
						<div class="browser-header">
							<div class="window-dots">
								<span></span><span></span><span></span>
							</div>
							<span class="browser-url">app.{data.id.toLowerCase()}.internal/dashboard</span>
						</div>
						<div class="mockup-display-area">
							<img 
								src={data.visualAssets!.heroMockup} 
								alt={`${data.title} Interface Screenshot`} 
								class="hero-mockup-img" 
								loading="eager"
							/>
						</div>
					</div>
				)}
			</section>
		)}

		<!-- 2. Metadata Quick Overview Table / Grid -->
		<section class="case-section">
			<div class="metadata-grid">
				{data.role && (
					<div class="meta-box card">
						<span class="meta-label">Role & Responsibilities</span>
						<p class="meta-value">{data.role}</p>
					</div>
				)}
				{data.timeline && (
					<div class="meta-box card">
						<span class="meta-label">Timeline & Lifecycle</span>
						<p class="meta-value">{data.timeline}</p>
					</div>
				)}
			</div>
		</section>

		<!-- 3. Executive Overview (Google XYZ Pattern) & KPI Metric Badges -->
		{data.executiveOverview && (
			<section class="case-section" id="executive-overview">
				<div class="xyz-overview-card card">
					<span class="section-tag font-dot">01 // IMPACT FORMULA</span>
					<h2 class="section-heading font-dot">Executive Overview</h2>
					<blockquote class="xyz-quote">
						"{data.executiveOverview}"
					</blockquote>

					{data.impactMetrics && data.impactMetrics.length > 0 && (
						<div class="metrics-row">
							{data.impactMetrics.map((metric) => (
								<div class="metric-card">
									<span class="metric-val font-dot">{metric.value}</span>
									<span class="metric-lbl font-mono">{metric.label}</span>
									{metric.detail && <span class="metric-sub">{metric.detail}</span>}
								</div>
							))}
						</div>
					)}
				</div>
			</section>
		)}

		<!-- 4. Categorized Tech Stack Matrix -->
		{data.techStack && (
			<section class="case-section" id="tech-stack">
				<span class="section-tag font-dot">02 // ARCHITECTURE</span>
				<h2 class="section-heading font-dot">Technology Stack</h2>
				
				<div class="tech-stack-grid">
					{data.techStack.frontend && data.techStack.frontend.length > 0 && (
						<div class="tech-group card">
							<span class="tech-group-title">Frontend Ecosystem</span>
							<div class="tech-tags-wrap">
								{data.techStack.frontend.map((item) => (
									<span class="tech-badge">{item}</span>
								))}
							</div>
						</div>
					)}
					{data.techStack.mobile_hardware && data.techStack.mobile_hardware.length > 0 && (
						<div class="tech-group card">
							<span class="tech-group-title">Mobile Hardware & ML Kit</span>
							<div class="tech-tags-wrap">
								{data.techStack.mobile_hardware.map((item) => (
									<span class="tech-badge">{item}</span>
								))}
							</div>
						</div>
					)}
					{data.techStack.backend && data.techStack.backend.length > 0 && (
						<div class="tech-group card">
							<span class="tech-group-title">Backend & APIs</span>
							<div class="tech-tags-wrap">
								{data.techStack.backend.map((item) => (
									<span class="tech-badge">{item}</span>
								))}
							</div>
						</div>
					)}
					{data.techStack.database && data.techStack.database.length > 0 && (
						<div class="tech-group card">
							<span class="tech-group-title">Database & Storage</span>
							<div class="tech-tags-wrap">
								{data.techStack.database.map((item) => (
									<span class="tech-badge">{item}</span>
								))}
							</div>
						</div>
					)}
					{data.techStack.devops && data.techStack.devops.length > 0 && (
						<div class="tech-group card">
							<span class="tech-group-title">DevOps & Tooling</span>
							<div class="tech-tags-wrap">
								{data.techStack.devops.map((item) => (
									<span class="tech-badge">{item}</span>
								))}
							</div>
						</div>
					)}
				</div>
			</section>
		)}

		<!-- 5. Problem Statement & Key Technical Decisions -->
		{(data.problemStatement || (data.keyDecisions && data.keyDecisions.length > 0)) && (
			<section class="case-section" id="engineering-decisions">
				<span class="section-tag font-dot">03 // ENGINEERING DECISIONS</span>
				<h2 class="section-heading font-dot">Technical Challenges & Solutions</h2>

				{data.problemStatement && (
					<div class="problem-box card">
						<span class="problem-title">Problem Statement & User Friction</span>
						<p class="problem-body">{data.problemStatement}</p>
					</div>
				)}

				{data.keyDecisions && data.keyDecisions.length > 0 && (
					<div class="decisions-list">
						{data.keyDecisions.map((item, idx) => (
							<div class="decision-card card">
								<div class="decision-header">
									<span class="decision-index font-dot">0{idx + 1}</span>
									<h3 class="decision-challenge font-mono">{item.challenge}</h3>
								</div>
								<div class="decision-body">
									<div class="decision-row">
										<span class="decision-lbl">Action / Decision:</span>
										<p class="decision-desc">{item.decision}</p>
									</div>
									{item.outcome && (
										<div class="decision-row outcome-row">
											<span class="decision-lbl">Measured Outcome:</span>
											<p class="decision-desc">{item.outcome}</p>
										</div>
									)}
								</div>
							</div>
						))}
					</div>
				)}
			</section>
		)}

		<!-- 7. Security, Reliability & Future Roadmap -->
		{(data.securityReliability?.length > 0 || data.futureRoadmap?.length > 0) && (
			<section class="case-section" id="security-roadmap">
				<div class="security-roadmap-grid">
					{data.securityReliability?.length > 0 && (
						<div class="card font-mono">
							<span class="section-tag font-dot">SECURITY</span>
							<h3 class="box-heading">Security & Reliability</h3>
							<ul class="check-list">
								{data.securityReliability.map((item) => (
									<li>
										<span class="check-icon">✓</span>
										<span>{item}</span>
									</li>
								))}
							</ul>
						</div>
					)}
					{data.futureRoadmap?.length > 0 && (
						<div class="card font-mono">
							<span class="section-tag font-dot">ROADMAP</span>
							<h3 class="box-heading">Future Iterations</h3>
							<ul class="check-list">
								{data.futureRoadmap.map((item) => (
									<li>
										<span class="bullet-accent font-dot">›</span>
										<span>{item}</span>
									</li>
								))}
							</ul>
						</div>
					)}
				</div>
			</section>
		)}

		<!-- 8. Markdown Deep-Dive Content -->
		<section class="case-section markdown-body-wrapper">
			<div class="markdown-article">
				<Content />
			</div>
		</section>

		<!-- Bottom Pagination / Project Navigation -->
		<footer class="case-footer-nav">
			{prevProject ? (
				<a href={`/work/${prevProject.id}`} class="nav-prev card">
					<span class="nav-dir">‹ PREVIOUS PROJECT</span>
					<span class="nav-name">{prevProject.data.title}</span>
				</a>
			) : <div />}

			{nextProject ? (
				<a href={`/work/${nextProject.id}`} class="nav-next card">
					<span class="nav-dir">NEXT PROJECT ›</span>
					<span class="nav-name">{nextProject.data.title}</span>
				</a>
			) : <div />}
		</footer>
	</article>

	<!-- Right Side Sticky Table of Contents Navigation -->
	{tocItems.length > 0 && (
		<aside class="case-toc-sidebar" aria-label="Table of Contents">
			<div class="toc-sticky-box">
				<div class="toc-header">
					<span class="toc-pulse-dot"></span>
					<span class="toc-title font-dot">ON THIS PAGE</span>
				</div>
				<nav class="toc-nav">
					<ul class="toc-list font-mono">
						{tocItems.map((item) => (
							<li class="toc-item">
								<a href={`#${item.id}`} class="toc-link" data-target={item.id}>
									<span class="toc-indicator">›</span>
									<span class="toc-text">{item.text}</span>
								</a>
							</li>
						))}
					</ul>
				</nav>
				<div class="toc-footer">
					<button type="button" class="toc-top-btn font-mono" id="toc-top-button" aria-label="Back to top">
						<span>Back to top</span>
						<span class="font-dot">↑</span>
					</button>
				</div>
			</div>
		</aside>
	)}
	</div>
</BaseLayout>

<style>
	.case-layout-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 240px;
		gap: 3rem;
		width: 100%;
		align-items: start;
		position: relative;
	}

	@media (max-width: 1120px) {
		.case-layout-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
		}
		.case-toc-sidebar {
			display: none !important;
		}
	}

	/* Sticky Right-Side Table of Contents */
	.case-toc-sidebar {
		position: sticky;
		top: 6rem;
		max-height: calc(100vh - 8rem);
		display: flex;
		flex-direction: column;
		z-index: 20;
		padding-top: 2rem;
	}

	.toc-sticky-box {
		padding: 1.25rem 1rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: 16px;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		box-shadow: 0 4px 20px rgba(95, 80, 56, 0.04);
	}

	.toc-header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid rgba(95, 80, 56, 0.12);
	}

	.toc-pulse-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 6px var(--accent);
		display: inline-block;
	}

	.toc-title {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--text-main);
	}

	.toc-nav {
		overflow-y: auto;
		max-height: calc(100vh - 15rem);
		padding-right: 0.25rem;
	}

	.toc-nav::-webkit-scrollbar {
		width: 3px;
	}

	.toc-nav::-webkit-scrollbar-thumb {
		background: rgba(95, 80, 56, 0.2);
		border-radius: 3px;
	}

	.toc-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.toc-item {
		font-size: 0.8125rem;
	}

	.toc-link {
		display: flex;
		align-items: flex-start;
		gap: 0.35rem;
		color: var(--text-muted);
		text-decoration: none !important;
		padding: 0.35rem 0.5rem;
		border-radius: 6px;
		transition: all 0.15s ease;
		line-height: 1.35;
	}

	.toc-indicator {
		color: transparent;
		transition: color 0.15s ease, transform 0.15s ease;
		font-weight: bold;
		flex-shrink: 0;
	}

	.toc-link:hover {
		color: var(--accent);
		background: rgba(95, 80, 56, 0.06);
	}

	.toc-link:hover .toc-indicator {
		color: var(--accent);
		transform: translateX(2px);
	}

	.toc-link.active {
		color: var(--accent);
		font-weight: 700;
		background: rgba(180, 33, 53, 0.08);
	}

	.toc-link.active .toc-indicator {
		color: var(--accent);
	}

	.toc-footer {
		padding-top: 0.6rem;
		border-top: 1px solid rgba(95, 80, 56, 0.1);
	}

	.toc-top-btn {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		background: transparent;
		border: none;
		cursor: pointer;
		font-family: inherit;
		font-size: 0.75rem;
		color: var(--text-muted);
		text-decoration: none !important;
		padding: 0.35rem 0.5rem;
		border-radius: 6px;
		transition: all 0.2s ease;
	}

	.toc-top-btn:hover {
		color: var(--accent);
		background: rgba(95, 80, 56, 0.06);
	}

	.case-study-page {
		width: 100%;
		max-width: 960px;
		padding: 2rem 0 6rem;
		text-align: left;
	}

	.breadcrumb-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgba(95, 80, 56, 0.12);
		margin-bottom: 2rem;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.back-link {
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.875rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		transition: color 0.2s ease;
	}

	.back-link:hover {
		color: var(--accent);
	}

	.case-tag {
		font-size: 0.8125rem;
		letter-spacing: 0.08em;
		color: var(--accent);
	}

	.case-header {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-bottom: 3rem;
	}

	.header-badge-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.chip-accent {
		background: var(--accent);
		color: #ffffff;
		font-size: 0.8125rem;
		padding: 0.3rem 0.85rem;
		border-radius: 9999px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.status-pill {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		background: rgba(95, 80, 56, 0.08);
