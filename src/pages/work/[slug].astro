</style>

<script>
	async function initMermaid() {
		try {
			// Find all pre elements that contain mermaid syntax or language-mermaid
			const codeBlocks = Array.from(document.querySelectorAll('pre, pre code'));
			const targets: { pre: HTMLElement; code: string }[] = [];

			for (const el of codeBlocks) {
				const text = el.textContent?.trim() || '';
				const isMermaid = 
					el.classList.contains('language-mermaid') || 
					el.parentElement?.classList.contains('language-mermaid') ||
					el.getAttribute('data-language') === 'mermaid' ||
					text.startsWith('flowchart') || 
					text.startsWith('sequenceDiagram') || 
					text.startsWith('mindmap') || 
					text.startsWith('timeline') || 
					text.startsWith('graph');

				if (isMermaid) {
					const pre = (el.tagName.toLowerCase() === 'pre' ? el : el.closest('pre')) as HTMLElement | null;
					if (pre && !pre.dataset.processed) {
						pre.dataset.processed = 'true';
						targets.push({ pre, code: text });
					}
				}
			}

			if (targets.length === 0) return;

			// Dynamically import Mermaid ESM from CDN
			// @ts-ignore
			const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs');

			mermaid.initialize({
				startOnLoad: false,
				theme: 'base',
				themeVariables: {
					primaryColor: '#f4f0e7',
					primaryTextColor: '#2b251e',
					primaryBorderColor: '#5f5038',
					lineColor: '#5f5038',
					secondaryColor: '#ffffff',
					tertiaryColor: '#ede7da',
					noteBkgColor: '#f4f0e7',
					noteTextColor: '#2b251e',
					noteBorderColor: '#5f5038',
					actorBkg: '#f4f0e7',
					actorBorder: '#5f5038',
					actorTextColor: '#2b251e',
					signalColor: '#5f5038',
					signalTextColor: '#2b251e',
					labelBoxBkgColor: '#f4f0e7',
					labelBoxBorderColor: '#5f5038',
					labelTextColor: '#2b251e',
					loopTextColor: '#2b251e',
					activationBorderColor: '#b42135',
					activationBkgColor: '#f4f0e7',
					fontFamily: 'NType 82 Mono, monospace',
					fontSize: '13px'
				},
				securityLevel: 'loose'
			});

			for (let i = 0; i < targets.length; i++) {
				const { pre, code } = targets[i];
				const wrapper = document.createElement('div');
				wrapper.className = 'mermaid-diagram-card';
				
				const diagramDiv = document.createElement('div');
				diagramDiv.className = 'mermaid';
				diagramDiv.textContent = code;
				
				wrapper.appendChild(diagramDiv);
				pre.replaceWith(wrapper);
			}

			await mermaid.run();
		} catch (err) {
			console.error('Mermaid render error:', err);
		}
	}

	// Initialize TOC ScrollSpy
	function initTocScrollSpy() {
			const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
			if (tocLinks.length === 0) return;

			const targetIds = Array.from(tocLinks)
				.map((link) => link.getAttribute('data-target'))
				.filter((id): id is string => Boolean(id));

			const targetElements = targetIds
				.map((id) => document.getElementById(id))
				.filter((el): el is HTMLElement => el !== null);

			if (targetElements.length === 0) return;

			let activeId = targetIds[0] || '';

			const observerOptions = {
				root: null,
				rootMargin: '-80px 0px -70% 0px',
				threshold: 0,
			};

			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						activeId = entry.target.id;
						updateActiveToc();
					}
				});
			}, observerOptions);

			targetElements.forEach((el) => observer.observe(el));

			function updateActiveToc() {
				tocLinks.forEach((link) => {
					if (link.getAttribute('data-target') === activeId) {
						link.classList.add('active');
					} else {
						link.classList.remove('active');
					}
				});
			}

			// Smooth scroll click handler with sticky header offset
			tocLinks.forEach((link) => {
				link.addEventListener('click', (e) => {
					const targetId = link.getAttribute('data-target');
					if (targetId) {
						const targetEl = document.getElementById(targetId);
						if (targetEl) {
							e.preventDefault();
							const headerOffset = 90;
							const elementPosition = targetEl.getBoundingClientRect().top;
							const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

							window.scrollTo({
								top: Math.max(0, offsetPosition),
								behavior: 'smooth'
							});
							history.pushState(null, '', `#${targetId}`);
							activeId = targetId;
							updateActiveToc();
						}
					}
				});
			});

			// Back to Top button click handler
			const topBtn = document.getElementById('toc-top-button');
			if (topBtn) {
				topBtn.addEventListener('click', (e) => {
					e.preventDefault();
					window.scrollTo({ top: 0, behavior: 'smooth' });
					history.pushState(null, '', window.location.pathname);
				});
			}

			updateActiveToc();
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', () => {
				initMermaid();
				initTocScrollSpy();
			});
		} else {
			initMermaid();
			initTocScrollSpy();
		}
	</script>
