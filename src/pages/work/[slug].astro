			padding: 1.5rem 1.25rem;
		}

		.lead-before-after {
			padding: 1rem 1.1rem;
		}
	}

	.hero-mockup-img {
		width: 100%;
		height: auto;
		display: block;
		object-fit: cover;
	}

	.mockup-icon-placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		color: var(--accent);
		text-align: center;
	}

	.main-display-icon {
		opacity: 0.85;
	}

	.display-label {
		font-size: 0.9375rem;
		letter-spacing: 0.08em;
		color: var(--text-main);
	}

	/* Metadata Grid */
	.metadata-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.25rem;
	}

	.meta-box {
		padding: 1.35rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		border-radius: 16px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		box-shadow: 0 2px 8px rgba(95, 80, 56, 0.03);
	}

	.meta-label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent);
		font-weight: 700;
		font-family: var(--font-mono);
	}

	.meta-value {
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--text-main);
		font-weight: 500;
	}

	.readtime-meta-val {
		display: inline-flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.meta-clock-icon {
		color: var(--accent);
		flex-shrink: 0;
	}

	.readtime-sub {
		font-size: 0.75rem;
		color: var(--text-muted);
		font-weight: 400;
	}

	/* XYZ Overview Card */
	.xyz-overview-card {
		padding: 2.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		border-radius: 24px;
		background: linear-gradient(135deg, var(--card-bg) 0%, rgba(180, 33, 53, 0.035) 100%);
		border: 1px solid rgba(180, 33, 53, 0.22);
		box-shadow: 0 8px 30px rgba(95, 80, 56, 0.06);
	}

	.xyz-quote {
		font-size: clamp(1.05rem, 1.8vw, 1.25rem);
		line-height: 1.7;
		color: var(--text-main);
		font-style: normal;
		border-left: 3px solid var(--accent);
		padding-left: 1.35rem;
		font-weight: 400;
	}

	.metrics-row {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		margin-top: 0.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(95, 80, 56, 0.12);
	}

	@media (max-width: 860px) {
		.metrics-row {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 480px) {
		.metrics-row {
			grid-template-columns: 1fr;
		}
	}

	.metric-card {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.75rem 1rem;
		background: #ffffff;
		border: 1px solid rgba(95, 80, 56, 0.12);
		border-radius: 12px;
		box-shadow: 0 2px 8px rgba(95, 80, 56, 0.03);
	}

	.metric-val {
		font-size: 1.75rem;
		font-weight: 700;
		color: var(--accent);
	}

	.metric-lbl {
		font-size: 0.8125rem;
		font-weight: 700;
		color: var(--text-main);
		letter-spacing: 0.02em;
	}

	.metric-sub {
		font-size: 0.75rem;
		color: var(--text-muted);
		line-height: 1.4;
	}

	/* Tech Stack */
	.tech-stack-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 768px) {
		.tech-stack-grid {
			grid-template-columns: 1fr;
		}
	}

	.tech-group {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		border-radius: 16px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.tech-group:hover {
		border-color: rgba(95, 80, 56, 0.25);
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(95, 80, 56, 0.05);
	}

	.tech-group-title {
		font-size: 0.8125rem;
		font-weight: 700;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-family: var(--font-mono);
	}

	.tech-tags-wrap {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.tech-badge {
		font-size: 0.8125rem;
		padding: 0.35rem 0.75rem;
		background: #ffffff;
		border: 1px solid rgba(95, 80, 56, 0.14);
		border-radius: 8px;
		color: var(--text-main);
		font-weight: 500;
	}

	/* Decisions & Problem Statement */
	.problem-box {
		padding: 1.75rem 2rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-bottom: 2rem;
		border-left: 4px solid var(--accent);
		background: linear-gradient(135deg, var(--card-bg) 0%, rgba(180, 33, 53, 0.03) 100%);
		border-radius: 16px;
		border-top: 1px solid var(--card-border);
		border-right: 1px solid var(--card-border);
		border-bottom: 1px solid var(--card-border);
	}

	.problem-badge-row {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.problem-badge {
		font-size: 0.75rem;
		padding: 0.25rem 0.75rem;
		border-radius: 9999px;
		background: rgba(180, 33, 53, 0.1);
		color: var(--accent);
		font-weight: 700;
		letter-spacing: 0.06em;
	}

	.problem-tag {
		font-size: 0.8125rem;
		color: var(--text-muted);
		letter-spacing: 0.05em;
	}

	.problem-body {
		font-size: 1rem;
		line-height: 1.65;
		color: var(--text-main);
	}

	/* Architecture Matrix Table */
	.architecture-matrix-container {
		padding: 0;
		overflow: hidden;
		border-radius: 20px;
		border: 1px solid var(--card-border);
		background: var(--card-bg);
		box-shadow: 0 4px 20px rgba(95, 80, 56, 0.04);
	}

	.matrix-table-wrapper {
		width: 100%;
		overflow-x: auto;
	}

	.architecture-matrix-table {
		width: 100%;
		border-collapse: collapse;
		text-align: left;
		font-size: 0.875rem;
		min-width: 760px;
		font-family: var(--font-sans);
	}

	.architecture-matrix-table thead {
		background: rgba(95, 80, 56, 0.08);
		border-bottom: 2px solid rgba(95, 80, 56, 0.16);
		font-family: var(--font-mono);
	}

	.architecture-matrix-table th {
		padding: 1.15rem 1.35rem;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--text-main);
		text-transform: uppercase;
		white-space: nowrap;
	}

	.col-challenge {
		width: 28%;
	}

	.col-solution {
		width: 44%;
	}

	.col-impact {
		width: 28%;
	}

	.matrix-row {
		background: #ffffff;
		border-bottom: 1px solid rgba(95, 80, 56, 0.1);
		transition: background 0.18s ease, border-left-color 0.18s ease;
	}

	.matrix-row:nth-child(even) {
		background: #fbf9f5;
	}

	.matrix-row:last-child {
		border-bottom: none;
	}

	.matrix-row:hover {
		background: rgba(180, 33, 53, 0.04);
	}

	.architecture-matrix-table td {
		padding: 1.35rem 1.5rem;
		vertical-align: top;
		line-height: 1.6;
		font-family: var(--font-sans);
	}

	.cell-challenge {
		background: transparent;
		border-right: 1px solid rgba(95, 80, 56, 0.1);
	}

	.challenge-title-wrap {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.challenge-idx {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent);
		letter-spacing: 0.08em;
	}

	.challenge-name {
		font-size: 0.9375rem;
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.35;
	}

	.cell-solution {
		color: var(--text-main);
		border-right: 1px solid rgba(95, 80, 56, 0.1);
	}

	.solution-text-box p {
		margin: 0;
		font-size: 0.875rem;
		color: var(--text-main);
		line-height: 1.6;
	}

	.cell-impact {
		background: transparent;
	}

	.impact-pill-wrap {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
	}

	.impact-check {
		color: #16a34a;
		font-weight: bold;
		font-size: 0.9375rem;
		line-height: 1.4;
		flex-shrink: 0;
	}

	.impact-text {
		margin: 0;
		font-size: 0.84375rem;
		color: #15803d;
		line-height: 1.5;
		font-weight: 500;
	}

	.impact-none {
		color: var(--text-muted);
	}

	/* Value Proposition Canvas (VPC) Table Styles */
	.vpc-target-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding: 0.85rem 1.35rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: 12px;
		margin-bottom: 1.5rem;
	}

	.vpc-target-label {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent);
		letter-spacing: 0.08em;
	}

	.vpc-target-val {
		font-size: 0.9375rem;
		color: var(--text-main);
		font-weight: 700;
	}

	.vpc-matrix-container {
		padding: 0;
		overflow: hidden;
		border-radius: 20px;
		border: 1px solid var(--card-border);
		background: var(--card-bg);
		box-shadow: 0 4px 20px rgba(95, 80, 56, 0.04);
	}

	.vpc-table-wrapper {
		width: 100%;
		overflow-x: auto;
	}

	.vpc-table {
		width: 100%;
		border-collapse: collapse;
		text-align: left;
		font-size: 0.875rem;
		min-width: 820px;
		font-family: var(--font-sans);
	}

	.vpc-table thead {
		background: rgba(95, 80, 56, 0.08);
		border-bottom: 2px solid rgba(95, 80, 56, 0.16);
		font-family: var(--font-mono);
	}

	.vpc-table th {
		padding: 1.15rem 1.35rem;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--text-main);
		text-transform: uppercase;
		white-space: nowrap;
	}

	.vpc-th-dimension {
		width: 22%;
	}

	.vpc-th-pains {
		width: 50%;
		border-right: 1px solid rgba(95, 80, 56, 0.14);
		background: rgba(239, 68, 68, 0.05);
	}

	.vpc-th-gains {
		width: 50%;
		background: rgba(34, 197, 94, 0.05);
	}

	.vpc-th-title-wrap {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 700;
	}

	.vpc-th-icon {
		font-size: 0.9375rem;
	}

	.vpc-row {
		background: #ffffff;
		border-bottom: 1px solid rgba(95, 80, 56, 0.1);
		transition: background 0.15s ease;
	}

	.vpc-row:nth-child(even) {
		background: #fbf9f5;
	}

	.vpc-row:last-child {
		border-bottom: none;
	}

	.vpc-row:hover {
		background: rgba(180, 33, 53, 0.04);
	}

	.vpc-table td {
		padding: 1.35rem 1.6rem;
		vertical-align: top;
		line-height: 1.6;
		font-family: var(--font-sans);
	}

	.vpc-cell-pain {
		border-right: 1px solid rgba(95, 80, 56, 0.1);
	}

	.vpc-cell-gain {
		background: transparent;
	}

	.vpc-pair-box {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.vpc-pair-header {
		display: flex;
		align-items: flex-start;
		gap: 0.55rem;
	}

	.vpc-pain-cross {
		color: #dc2626;
		font-size: 0.875rem;
		font-weight: 800;
		flex-shrink: 0;
		line-height: 1.35;
	}

	.vpc-gain-check {
		color: #16a34a;
		font-size: 0.9375rem;
		font-weight: 800;
		flex-shrink: 0;
		line-height: 1.35;
	}

	.vpc-pair-title {
		margin: 0;
		font-size: 0.9375rem;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	.vpc-pain-title {
		color: #b91c1c;
	}

	.vpc-gain-title {
		color: #15803d;
	}

	.vpc-pair-desc {
		margin: 0;
		font-size: 0.875rem;
		color: var(--text-main);
		line-height: 1.6;
		padding-left: 1.35rem;
	}



	/* Security & Roadmap */
	.security-roadmap-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 768px) {
		.security-roadmap-grid {
			grid-template-columns: 1fr;
		}
	}

	.box-heading {
		font-size: 1.2rem;
		color: var(--text-main);
		margin-bottom: 1rem;
	}

	.check-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.check-list li {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--text-muted);
	}

	.check-icon {
		color: #10b981;
		font-weight: 700;
	}

	.bullet-accent {
		color: var(--accent);
		font-weight: 700;
	}

	/* Markdown Article Typography */
	.markdown-body-wrapper {
		padding-top: 2rem;
		border-top: 1px solid rgba(95, 80, 56, 0.12);
	}

	.markdown-article {
		font-size: 1rem;
		line-height: 1.7;
		color: var(--text-main);
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.markdown-article h2 {
		font-family: var(--font-dot);
		font-size: 1.75rem;
		color: var(--text-main);
		margin-top: 1.5rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.markdown-article h3 {
		font-size: 1.25rem;
		color: var(--accent);
		margin-top: 1rem;
	}

	.markdown-article p {
		color: var(--text-muted);
	}

	.markdown-article ul, .markdown-article ol {
		padding-left: 1.5rem;
		color: var(--text-muted);
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.markdown-body-wrapper {
		width: 100%;
		max-width: 100%;
		overflow: hidden;
	}

	.markdown-article {
		width: 100%;
		max-width: 100%;
		overflow-x: hidden;
	}

	.markdown-article img {
		max-width: 100%;
		width: 100%;
		height: auto;
		border-radius: 12px;
		border: 1px solid var(--card-border);
		box-shadow: 0 6px 20px rgba(95, 80, 56, 0.08);
		margin: 1.5rem 0;
		display: block;
		object-fit: contain;
	}

	/* Markdown Mobile Phone Mockup Frame (Compact & Realistic) */
	:global(.md-mockup-mobile-wrapper) {
		display: flex;
		justify-content: center;
		margin: 2.25rem auto;
		width: 100%;
	}

	:global(.md-mobile-phone-device) {
		max-width: 250px;
		width: 100%;
		background: #ffffff;
		border: 6px solid rgba(95, 80, 56, 0.45) !important;
		border-radius: 36px;
		overflow: hidden;
		box-shadow: 0 16px 40px rgba(95, 80, 56, 0.16);
		display: flex;
		flex-direction: column;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	:global(.md-mobile-phone-device:hover) {
		transform: translateY(-4px);
		box-shadow: 0 22px 48px rgba(95, 80, 56, 0.22);
	}

	:global(.md-mobile-phone-device .mobile-speaker-notch) {
		padding: 0.5rem 0.75rem 0.35rem;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		background: #fbf9f5;
		border-bottom: 1px solid rgba(95, 80, 56, 0.12);
	}

	:global(.md-mobile-phone-device .mobile-mockup-screen) {
		background: #ffffff;
		width: 100%;
		overflow: hidden;
	}

	:global(.md-mobile-phone-device .mobile-home-indicator) {
		width: 80px;
		height: 3px;
		background: rgba(95, 80, 56, 0.35);
		border-radius: 9999px;
		margin: 0.45rem auto;
	}

	:global(.md-mobile-phone-device img) {
		width: 100% !important;
		max-width: 100% !important;
		height: auto !important;
		display: block !important;
		border: none !important;
		box-shadow: none !important;
		border-radius: 0 !important;
		margin: 0 !important;
		object-fit: contain !important;
	}

	/* Markdown Tablet Mockup Frame (Compact Realistic Tablet Border) */
	:global(.md-mockup-tablet-wrapper) {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		margin: 2.25rem auto;
		gap: 0.65rem;
	}

	:global(.md-tablet-device) {
		max-width: 620px;
		width: 100%;
		background: #ffffff;
		border: 8px solid rgba(95, 80, 56, 0.45) !important;
		border-radius: 26px;
		overflow: hidden;
		box-shadow: 0 16px 42px rgba(95, 80, 56, 0.16);
		display: flex;
		flex-direction: column;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	:global(.md-tablet-device:hover) {
		transform: translateY(-3px);
		box-shadow: 0 22px 50px rgba(95, 80, 56, 0.22);
	}

	:global(.tablet-top-bezel) {
		height: 14px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #fbf9f5;
		border-bottom: 1px solid rgba(95, 80, 56, 0.12);
	}

	:global(.tablet-camera-dot) {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: rgba(95, 80, 56, 0.45);
	}

	:global(.tablet-screen-area) {
		background: #ffffff;
		width: 100%;
		overflow: hidden;
	}

	:global(.tablet-bottom-bezel) {
		height: 16px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #fbf9f5;
		border-top: 1px solid rgba(95, 80, 56, 0.12);
	}

	:global(.tablet-home-indicator) {
		width: 120px;
		height: 4px;
		background: rgba(95, 80, 56, 0.35);
		border-radius: 9999px;
	}

	:global(.md-tablet-caption) {
		font-size: 0.8125rem;
		font-family: 'NType 82 Mono', monospace;
		color: var(--text-muted);
		text-align: center;
		max-width: 600px;
		line-height: 1.4;
	}

	:global(.md-tablet-device img) {
		width: 100% !important;
		max-width: 100% !important;
		height: auto !important;
		display: block !important;
		border: none !important;
		box-shadow: none !important;
		border-radius: 0 !important;
		margin: 0 !important;
		object-fit: contain !important;
	}

	.markdown-article pre,
	.markdown-article pre.astro-code {
		background: #f4f0e7 !important;
		border: 1px solid rgba(95, 80, 56, 0.16) !important;
		border-radius: 16px !important;
		padding: 1.5rem !important;
		color: #2b251e !important;
		margin: 1.5rem 0 !important;
	}

	.markdown-article table {
		width: 100%;
		border-collapse: collapse;
		margin: 2rem 0;
		border-radius: 14px;
		overflow: hidden;
		border: 1px solid var(--card-border);
		background: #ffffff;
		font-size: 0.875rem;
	}

	.markdown-article tbody tr:nth-child(even) {
		background: #fbf9f5;
	}

	.markdown-article tbody tr:hover {
		background: rgba(180, 33, 53, 0.04);
	}

	.markdown-article th,
	.markdown-article td {
		padding: 0.85rem 1.15rem;
		text-align: left;
		border-bottom: 1px solid rgba(95, 80, 56, 0.1);
	}

	.markdown-article th {
		background: rgba(95, 80, 56, 0.08);
		color: var(--text-main);
		font-weight: 700;
