---
import BaseLayout from '../layouts/BaseLayout.astro';
import { bscCseProgram, hscScienceProgram } from '../data/education';
import { finalYearThesisResearch } from '../data/research';

const thesis = finalYearThesisResearch;

const metrics = [
	{ value: '3.91', label: 'B.Sc. in CSE CGPA', sub: 'Daffodil International University' },
	{ value: '+60%', label: 'Code Reusability', sub: 'Via Private Package Architectures' },
	{ value: '100%', label: 'RLS Data Isolation', sub: 'Multi-Tenant SaaS Security' },
	{ value: '10+', label: 'Platforms Shipped', sub: 'Enterprise, SaaS & Mobile' }
];

const principles = [
	{
		num: '01',
		title: 'Architecture-First Synthesis',
		desc: 'I model relational data, map intricate dependency graphs, and validate specifications before writing code or employing AI boilerplate synthesis (Cursor Agentic, GitHub Copilot).'
	},
	{
		num: '02',
		title: 'Strict Data & Type Safety',
		desc: 'I design PostgreSQL schemas with explicit constraints, TypeORM/Supabase Row-Level Security (RLS), and end-to-end TypeScript interfaces from backend DTOs to frontend state.'
	},
	{
		num: '03',
		title: 'Modular Infrastructure',
		desc: 'I decouple monolithic corporate codebases into isolated, autonomous proprietary npm packages governed by strict Semantic Versioning (SemVer) and private Git registries.'
	},
	{
		num: '04',
		title: 'Measurable Impact (Google XYZ)',
		desc: 'Every technical decision is measured against real metrics: decreasing dashboard load times by 48%, reducing ticket approval latency by 85%, or eliminating runtime bugs.'
	}
];

const skillCategories = [
	{
		category: 'Engineering Workflow',
		items: [
			'Architecture-First AI Synthesis',
			'Relational Data Modeling',
			'Systematic Code Validation',
			'Structural Codebase Refactoring',
			'Automated MVP Scaffolding'
		]
	},
	{
		category: 'Backend & Cloud Services',
		items: [
			'PHP (Core & MVC)',
			'Supabase (Realtime, RLS)',
			'NestJS',
			'Node.js',
			'Express',
			'TypeORM',
			'PostgreSQL',
			'MongoDB',
			'RESTful API Engineering'
		]
	},
	{
		category: 'Frontend Ecosystem',
		items: [
			'Vue.js (v2/v3)',
			'Quasar Framework',
			'TypeScript',
			'JavaScript (ES6+)',
			'React',
			'Next.js (App Router)',
			'React Native',
			'Pinia',
			'Vuex'
		]
	},
	{
		category: 'Styles & Architecture',
		items: [
			'Tailwind CSS',
			'ShadCN UI',
			'Bootstrap',
			'Figma to Code',
			'Semantic Versioning (SemVer)',
			'Private Git Registries',
			'Git Submodules',
			'Multi-Tenant SaaS'
		]
	}
];

const certifications = [
	{ title: 'Responsible AI: Applying AI Principles with Google Cloud', issuer: 'Google Cloud', date: 'Aug 2025', id: '17581956' },
	{ title: 'Prompt Design in Vertex AI', issuer: 'Google Cloud', date: 'Aug 2025', id: '17581523' },
	{ title: 'Introduction to Responsible AI', issuer: 'Google Cloud', date: 'Aug 2025', id: '17472223' },
	{ title: 'Introduction to Large Language Models', issuer: 'Google Cloud', date: 'Aug 2025', id: '17320196' },
	{ title: 'Introduction to Generative AI', issuer: 'Google Cloud', date: 'Jul 2025', id: '17216550' },
	{ title: 'Project Management Foundations Suite', issuer: 'LinkedIn Professional', date: 'May 2025' },
	{ title: 'Python Essentials 1 & 2', issuer: 'Cisco Networking Academy', date: 'May 2025' },
	{ title: 'JavaScript Essentials 1 & 2', issuer: 'Cisco Networking Academy', date: 'Oct 2024' },
	{ title: 'Career Essentials in Generative AI', issuer: 'Microsoft & LinkedIn', date: 'Mar 2024' },
	{ title: 'Responsive Web Design Studio Suite', issuer: 'freeCodeCamp', date: 'Mar 2025', id: 'marceldavid-rwd' },
	{ title: 'Graphic Design Foundations (Typography & Layout)', issuer: 'LinkedIn Academy', date: 'Jul 2022' }
];
---

<BaseLayout 
	title="About Marcel David Baroi | Full-Stack Software Engineer" 
	description="Personal background, engineering philosophy, technical skill matrix, education, and credentials of Marcel David Baroi."
>
	<!-- 1. Header Profile -->
	<section class="about-hero">
		<div class="hero-status">
			<span class="status-dot"></span>
			<span class="status-text font-mono">[001] BASED IN DHAKA, BANGLADESH • HYBRID / REMOTE</span>
		</div>

		<div class="hero-titles">
			<span class="section-tag font-dot">00 // ABOUT ME</span>
			<h1 class="title font-dot">Marcel David Baroi</h1>
			<p class="subtitle font-dot">Full-Stack Software Engineer</p>
		</div>

		<p class="hero-bio font-mono">
			Highly disciplined Full-Stack Software Engineer specializing in planning, architecting, and delivering enterprise web applications, multi-tenant SaaS structures, and cross-platform native software ecosystems.
		</p>

		<!-- Action Links & Contact Pills -->
		<div class="hero-actions">
			<a href="mailto:marceldavidbaroi@gmail.com" class="btn btn-accent font-mono">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect width="20" height="16" x="2" y="4" rx="2"></rect>
					<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
				</svg>
				Get In Touch
			</a>
			<a href="https://linkedin.com/in/marceldavidbaroi" target="_blank" rel="noopener noreferrer" class="btn btn-primary font-mono">
				LinkedIn
			</a>
			<a href="https://github.com/marceldavidbaroi" target="_blank" rel="noopener noreferrer" class="btn btn-secondary font-mono">
				GitHub
			</a>
		</div>
	</section>

	<!-- 2. Metrics Strip -->
	<section class="about-section">
		<div class="metrics-grid">
			{metrics.map((m) => (
				<div class="metric-card card font-mono">
					<span class="metric-num font-dot">{m.value}</span>
					<span class="metric-label">{m.label}</span>
					<span class="metric-sub">{m.sub}</span>
				</div>
			))}
		</div>
	</section>

	<!-- 3. Engineering Philosophy & How I Work -->
	<section class="about-section">
		<div class="section-header">
			<span class="section-tag font-dot">01 // PHILOSOPHY</span>
			<h2 class="section-title font-dot">Architecture-First Paradigm</h2>
			<p class="section-desc font-mono">
				Building production-grade software requires sound structural foundations before code generation.
			</p>
		</div>

		<div class="principles-grid">
			{principles.map((p) => (
				<div class="principle-card card font-mono">
					<div class="principle-header">
						<span class="principle-num font-dot">{p.num}</span>
						<h3 class="principle-title">{p.title}</h3>
					</div>
					<p class="principle-desc">{p.desc}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 4. Core Technical Matrix -->
	<section class="about-section">
		<div class="section-header">
			<span class="section-tag font-dot">02 // CAPABILITIES</span>
			<h2 class="section-title font-dot">Technical Skill Matrix</h2>
			<p class="section-desc font-mono">
				Technologies, frameworks, and architectural tools leveraged across production environments.
			</p>
		</div>

		<div class="skills-grid">
			{skillCategories.map((group) => (
				<div class="skill-card card font-mono">
					<h3 class="skill-category-title">{group.category}</h3>
					<ul class="skill-tags">
						{group.items.map((skill) => (
							<li class="skill-tag">{skill}</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>

	<!-- 5. Formal Education & Research -->
	<section class="about-section" id="academic-curriculum">
		<div class="section-header">
			<span class="section-tag font-dot">03 // PEDIGREE</span>
			<h2 class="section-title font-dot">Academic Education & Research</h2>
			<p class="section-desc font-mono">
				Undergraduate computer science degree, higher secondary science foundation, and final year thesis research.
			</p>
		</div>

		<div class="edu-grid">
			<!-- DIU B.Sc. in CSE -->
			<div class="edu-card card font-mono">
				<div class="edu-top">
					<div class="edu-badge-group">
						<span class="edu-badge">{bscCseProgram.badge}</span>
						<span class="edu-duration-badge font-mono">{bscCseProgram.duration}</span>
					</div>
					<span class="edu-gpa font-dot">CGPA {bscCseProgram.cgpa.toFixed(2)} / {bscCseProgram.maxGpa.toFixed(2)}</span>
				</div>

				<div class="edu-card-main">
					{bscCseProgram.logo && (
						<div class="edu-card-logo-box">
							<img
								src={bscCseProgram.logo}
								alt={`${bscCseProgram.institution} Crest`}
								class="edu-card-logo"
								width="56"
								height="56"
								loading="lazy"
							/>
						</div>
					)}
					<div class="edu-card-text">
						<h3 class="edu-degree">{bscCseProgram.degree}</h3>
						<p class="edu-institution">
							<a
								href={bscCseProgram.institutionUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="inst-web-link"
								title={`Visit ${bscCseProgram.institution} Website`}
							>
								<span>{bscCseProgram.institution}</span>
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
									<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
									<polyline points="15 3 21 3 21 9"></polyline>
									<line x1="10" y1="14" x2="21" y2="3"></line>
								</svg>
							</a>
							<span class="inst-divider">•</span>
							<span>{bscCseProgram.location}</span>
						</p>
					</div>
				</div>

				<p class="edu-summary">
					{bscCseProgram.summary}
				</p>
				<div class="edu-focus-areas">
					<span class="focus-title font-dot">Key Academic Focus:</span>
					<ul class="focus-list">
						{bscCseProgram.keyFocusAreas.map((area) => (
							<li class="focus-item">{area}</li>
						))}
					</ul>
				</div>
				<div class="edu-card-footer">
					<a href="/education/bsc-cse" class="edu-details-link font-dot">
						<span>View B.Sc. in CSE Full Details & Transcript</span>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</a>
				</div>
			</div>

			<!-- NDC HSC -->
			<div class="edu-card card font-mono">
				<div class="edu-top">
					<div class="edu-badge-group">
						<span class="edu-badge">{hscScienceProgram.badge}</span>
						<span class="edu-duration-badge font-mono">{hscScienceProgram.period}</span>
					</div>
					<span class="edu-gpa font-dot">GPA {hscScienceProgram.gpa.toFixed(2)} / {hscScienceProgram.maxGpa.toFixed(2)}</span>
				</div>

				<div class="edu-card-main">
					{hscScienceProgram.logo && (
						<div class="edu-card-logo-box ndc-card-logo-box">
							<img
								src={hscScienceProgram.logo}
								alt={`${hscScienceProgram.institution} Logo`}
								class="edu-card-logo"
								width="90"
								height="40"
								loading="lazy"
							/>
						</div>
					)}
					<div class="edu-card-text">
						<h3 class="edu-degree">{hscScienceProgram.degree}</h3>
						<p class="edu-institution">
							<a
								href={hscScienceProgram.institutionUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="inst-web-link"
								title={`Visit ${hscScienceProgram.institution} Website`}
							>
								<span>{hscScienceProgram.institution}</span>
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
									<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
									<polyline points="15 3 21 3 21 9"></polyline>
									<line x1="10" y1="14" x2="21" y2="3"></line>
								</svg>
							</a>
							<span class="inst-divider">•</span>
							<span>{hscScienceProgram.location}</span>
						</p>
					</div>
				</div>

				<p class="edu-summary">
					{hscScienceProgram.summary}
				</p>
				<div class="edu-focus-areas">
					<span class="focus-title font-dot">Science Curriculum:</span>
					<ul class="focus-list">
						{hscScienceProgram.keyCourses.map((c) => (
							<li class="focus-item">{c}</li>
						))}
					</ul>
				</div>
				{hscScienceProgram.coCurricular && (
					<div class="edu-focus-areas">
						<span class="focus-title font-dot">Co-Curricular Clubs:</span>
						<ul class="focus-list">
							{hscScienceProgram.coCurricular.map((club) => (
								<li class="focus-item club-highlight">{club}</li>
							))}
						</ul>
					</div>
				)}
				<div class="edu-card-footer">
					<a href="/education/hsc-science" class="edu-details-link font-dot">
						<span>View Notre Dame College HSC Details & Curriculum</span>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</a>
				</div>
			</div>

			<!-- Final Year Thesis Research -->
			<div class="edu-card card font-mono thesis-about-card">
				<div class="edu-top">
					<div class="edu-badge-group">
						<span class="edu-badge font-dot">{thesis.badge}</span>
						<span class="edu-duration-badge font-mono">{thesis.institution} • #{thesis.projectNumber}</span>
					</div>
					<span class="edu-gpa font-dot">DenseNet: 97.93% / 95.99%</span>
				</div>

				<div class="edu-card-main">
					<div class="edu-card-text">
						<h3 class="edu-degree">{thesis.title}</h3>
						<p class="edu-institution">
							<span>Author: {thesis.author} ({thesis.authorRole})</span>
							<span class="inst-divider">•</span>
							<span>Ekush Dataset Benchmark (80,000 Images)</span>
						</p>
					</div>
				</div>

				<p class="edu-summary">
					{thesis.abstract}
				</p>

				<div class="thesis-metrics-strip font-mono">
					<div class="t-strip-item">
						<span class="t-strip-val font-dot">97.93%</span>
						<span class="t-strip-lbl">Vowel Acc (F1: 0.98)</span>
					</div>
					<div class="t-strip-item">
						<span class="t-strip-val font-dot">95.99%</span>
						<span class="t-strip-lbl">Consonant Acc (F1: 0.96)</span>
					</div>
					<div class="t-strip-item">
						<span class="t-strip-val font-dot">16 Models</span>
						<span class="t-strip-lbl">Comparative Benchmarks</span>
					</div>
					<div class="t-strip-item">
						<span class="t-strip-val font-dot">Solo Thesis</span>
						<span class="t-strip-lbl">Individual Research</span>
					</div>
				</div>

				<div class="edu-card-footer">
					<a href="/research/01-bangla-hwcr-ekush" class="edu-details-link font-dot">
						<span>Read Full Research Paper & 16-Model Benchmarks</span>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 6. Verified Credentials & Certifications -->
	<section class="about-section">
		<div class="section-header">
			<span class="section-tag font-dot">04 // CREDENTIALS</span>
			<h2 class="section-title font-dot">Verified Certifications</h2>
			<p class="section-desc font-mono">
				Specialized certifications across Google Cloud AI, Generative AI, Cisco Networking, and Software Engineering.
			</p>
		</div>

		<div class="certs-grid font-mono">
			{certifications.map((cert) => (
				<div class="cert-card card">
					<div class="cert-top">
						<span class="cert-issuer">{cert.issuer}</span>
						<span class="cert-date">{cert.date}</span>
					</div>
					<h3 class="cert-name">{cert.title}</h3>
					{cert.id && <span class="cert-id font-mono">Credential ID: {cert.id}</span>}
				</div>
			))}
		</div>
	</section>

	<!-- 7. Contact CTA Box -->
	<section class="about-section">
		<div class="cta-card card font-mono">
			<span class="section-tag font-dot">05 // COLLABORATION</span>
			<h2 class="cta-title font-dot">Let's Build Something Resilient</h2>
			<p class="cta-text">
				Available for full-stack engineering roles, system architecture design, and high-impact SaaS development.
			</p>
			<div class="cta-buttons">
				<a href="mailto:marceldavidbaroi@gmail.com" class="btn btn-accent">
					Email Me
				</a>
				<a href="https://linkedin.com/in/marceldavidbaroi" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
					Connect on LinkedIn
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.about-hero {
		width: 100%;
		padding: 3rem 0 2rem;
		text-align: left;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.hero-status {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		padding: 0.35rem 0.9rem;
		border-radius: 9999px;
		width: fit-content;
	}

	.status-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: #22c55e;
		box-shadow: 0 0 10px rgba(34, 197, 94, 0.6);
		animation: pulse 2s infinite ease-in-out;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.5; transform: scale(0.85); }
	}

	.status-text {
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		color: var(--text-muted);
		font-weight: 500;
	}

	.hero-titles {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.section-tag {
		font-size: 0.9375rem;
		letter-spacing: 0.12em;
		color: var(--accent);
		text-transform: uppercase;
		font-weight: 700;
		-webkit-text-stroke: 0.25px currentColor;
	}

	.title {
		font-size: clamp(3rem, 7vw, 5.5rem);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-main);
		line-height: 1.05;
		-webkit-text-stroke: 0.45px currentColor;
		text-rendering: optimizeLegibility;
	}

	.subtitle {
		font-size: clamp(1.35rem, 3vw, 2.25rem);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
		font-weight: 700;
		-webkit-text-stroke: 0.35px currentColor;
	}

	.hero-bio {
		font-size: clamp(1.05rem, 1.8vw, 1.25rem);
		line-height: 1.65;
		color: var(--text-muted);
		max-width: 820px;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	.btn-secondary {
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		color: var(--text-main);
	}

	.btn-secondary:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.about-section {
		width: 100%;
		margin-top: 5rem;
		text-align: left;
	}

	.section-header {
		margin-bottom: 2rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--text-main);
		-webkit-text-stroke: 0.35px currentColor;
	}

	.section-desc {
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--text-muted);
		max-width: 700px;
	}

	/* Metrics Strip */
	.metrics-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 860px) {
		.metrics-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 480px) {
		.metrics-grid {
			grid-template-columns: 1fr;
		}
	}

	.metric-card {
		padding: 1.75rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		text-align: left;
	}

	.metric-num {
		font-size: 2.25rem;
		color: var(--accent);
	}

	.metric-label {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--text-main);
	}

	.metric-sub {
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	/* Principles Grid */
	.principles-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}

	@media (max-width: 768px) {
		.principles-grid {
			grid-template-columns: 1fr;
		}
	}

	.principle-card {
		padding: 2.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
