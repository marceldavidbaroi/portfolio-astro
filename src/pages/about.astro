---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutMetrics from '../components/about/AboutMetrics.astro';
import AboutCapabilities from '../components/about/AboutCapabilities.astro';
import AboutPhilosophy from '../components/about/AboutPhilosophy.astro';
import AboutEducationResearch from '../components/about/AboutEducationResearch.astro';
import AboutCredentials from '../components/about/AboutCredentials.astro';
import AboutBeyondTerminal from '../components/about/AboutBeyondTerminal.astro';
import AboutContactCTA from '../components/about/AboutContactCTA.astro';

import {
	metrics,
	principles,
	skillCategories,
	compactCerts,
	compactPursuits
} from '../data/aboutData';
---

<BaseLayout 
	title="About Marcel David Baroi | Full-Stack & Enterprise Systems Engineer" 
	description="Personal background, engineering philosophy, technical skill matrix, education, and credentials of Marcel David Baroi."
>
	<!-- 1. Header Profile & Triage Hero -->
	<AboutHero />

	<!-- 2. Metrics Strip (At a Glance) -->
	<AboutMetrics metrics={metrics} />

	<!-- 3. Core Technical Matrix & Capabilities -->
	<AboutCapabilities skillCategories={skillCategories} />

	<!-- 4. Engineering Philosophy & Architecture -->
	<AboutPhilosophy principles={principles} />

	<!-- 5. Academic Pedigree & Research -->
	<AboutEducationResearch />

	<!-- 6. Verified Industry Credentials -->
	<AboutCredentials compactCerts={compactCerts} />

	<!-- 7. Beyond the Terminal (Civic Leadership & Creative Craft) -->
	<AboutBeyondTerminal compactPursuits={compactPursuits} />

	<!-- 8. Closing Collaboration & Contact CTA -->
	<AboutContactCTA />
</BaseLayout>
