---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutJump from '../components/about/AboutJump.astro';
import AboutCapabilities from '../components/about/AboutCapabilities.astro';
import AboutCareer from '../components/about/AboutCareer.astro';
import AboutPhilosophy from '../components/about/AboutPhilosophy.astro';
import AboutEducationResearch from '../components/about/AboutEducationResearch.astro';
import AboutGallery from '../components/about/AboutGallery.astro';
import AboutCredentials from '../components/about/AboutCredentials.astro';
import AboutBeyondTerminal from '../components/about/AboutBeyondTerminal.astro';
import HomeContactClose from '../components/home/HomeContactClose.astro';
import { getCollection } from 'astro:content';

import {
	metrics,
	principles,
	skillCategories,
	compactCerts,
	compactPursuits
} from '../data/aboutData';

import '../styles/about.css';

import { mediaMap, resolveAssets } from '../lib/media';

const media = mediaMap(await getCollection('media'));
const experience = (await getCollection('experience'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({
		slug: entry.id,
		...entry.data,
		cardImages: resolveAssets(entry.data.cardImages || [], media).map((a) => a.src)
	}));
---

<BaseLayout
	title="About Marcel David Baroi | Software Engineer"
	description="Personal background, engineering philosophy, technical skill matrix, education, credentials, and photo albums of Marcel David Baroi."
	isWide
	alignStart
>
	<AboutHero metrics={metrics} />
	<AboutJump />
	<AboutPhilosophy principles={principles} />
	<AboutCapabilities skillCategories={skillCategories} />
	<AboutCareer experience={experience} />
	<AboutEducationResearch />
	<AboutGallery />
	<AboutCredentials compactCerts={compactCerts} />
	<AboutBeyondTerminal compactPursuits={compactPursuits} />
	<HomeContactClose />
</BaseLayout>
