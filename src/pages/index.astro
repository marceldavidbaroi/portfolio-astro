---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeFeaturedWork from '../components/home/HomeFeaturedWork.astro';
import HomeExperienceRail from '../components/home/HomeExperienceRail.astro';
import HomeEducationStrip from '../components/home/HomeEducationStrip.astro';
import HomeSkillsStrip from '../components/home/HomeSkillsStrip.astro';
import HomeContactClose from '../components/home/HomeContactClose.astro';
import { getCollection, getEntry } from 'astro:content';
import { metrics } from '../data/aboutData';
import { mediaMap, resolveAssets } from '../lib/media';

const media = mediaMap(await getCollection('media'));
const bscEntry = await getEntry('education', 'bsc-cse');
const hscEntry = await getEntry('education', 'hsc-science');
if (!bscEntry || !hscEntry) throw new Error('Missing education content');
const bscCseProgram = bscEntry.data;
const hscScienceProgram = hscEntry.data;

const projectEntries = await getCollection('projects');
const byId = Object.fromEntries(projectEntries.map((entry) => [entry.id, { slug: entry.id, ...entry.data }]));

const focused = ['01-tradeflowbd', '02-service-desk']
	.map((id) => byId[id])
	.filter(Boolean);
const featured = focused[0];
const supporting = [
	'07-pennyperfect',
	'03-thrift-inventory',
	'14-microfinance-loan-app',
	'11-quizzes-streaming',
	'08-docstach'
]
	.map((id) => byId[id])
	.filter(Boolean);

const experience = (await getCollection('experience'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({
		slug: entry.id,
		...entry.data,
		cardImages: resolveAssets(entry.data.cardImages || [], media).map((a) => a.src)
	}));

const portraitFile = ['portrait.webp', 'portrait.jpg', 'portrait.jpeg', 'portrait.png']
	.find((name) => fs.existsSync(path.join(process.cwd(), 'public/images', name)));
const portraitSrc = portraitFile ? `/images/${portraitFile}` : null;
const proof = [
	metrics.find((m) => m.value === '10+'),
	metrics.find((m) => m.value === '100%'),
	metrics.find((m) => m.value === '3.91')
].filter(Boolean);

const skills = ['Vue 3', 'Quasar', 'TypeScript', 'PostgreSQL', 'Supabase', 'NestJS', 'Docker', 'Pinia'];
const workCount = projectEntries.length;
---

<BaseLayout isWide alignStart>
	<HomeHero portraitSrc={portraitSrc} proof={proof} />

	{featured && (
		<HomeFeaturedWork focused={focused} supporting={supporting} workCount={workCount} />
	)}

	<HomeExperienceRail experience={experience} />
	<HomeEducationStrip bscCseProgram={bscCseProgram} hscScienceProgram={hscScienceProgram} />
	<HomeSkillsStrip skills={skills} />
	<HomeContactClose />
</BaseLayout>
