---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeModeTabs from "../components/home/HomeModeTabs.astro";
import HomeActionsBar from "../components/home/HomeActionsBar.astro";
import HomeHowIWork from "../components/home/HomeHowIWork.astro";
import HomeFeaturedWork from "../components/home/HomeFeaturedWork.astro";
import HomeExperienceRail from "../components/home/HomeExperienceRail.astro";
import HomeEducationStrip from "../components/home/HomeEducationStrip.astro";
import HomeSkillsStrip from "../components/home/HomeSkillsStrip.astro";
import HomeContactClose from "../components/home/HomeContactClose.astro";
import { getCollection, getEntry } from "astro:content";
import { getAllProjects } from "../lib/getProject";
import { mediaMap, resolveAssets } from "../lib/media";
import { toProjectListItem } from "../lib/projectView";

const media = mediaMap(await getCollection("media"));
const bscEntry = await getEntry("education", "bsc-cse");
const hscEntry = await getEntry("education", "hsc-science");
if (!bscEntry || !hscEntry) throw new Error("Missing education content");
const bscCseProgram = bscEntry.data;
const hscScienceProgram = hscEntry.data;

const projectEntries = await getAllProjects();
const byId = Object.fromEntries(
	projectEntries.map((entry) => [entry.id, entry]),
);

const focused = projectEntries
	.filter((entry) => entry.data.featured)
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3)
	.map((entry) => toProjectListItem(entry));
const featured = focused[0];

const experience = (await getCollection("experience"))
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({
		slug: entry.id,
		...entry.data,
		cardImages: resolveAssets(entry.data.cardImages || [], media).map(
			(a) => a.src,
		),
	}));

const skills = [
	"Next.js",
	"Vue 3",
	"NestJS",
	"Flutter",
	"TypeScript",
	"PostgreSQL",
	"Supabase",
	"Docker",
];
const workCount = projectEntries.length;

import "../styles/about.css";
---

<BaseLayout isWide alignStart>
	<div class="page-mesh-bg" aria-hidden="true">
		<span class="page-orb page-orb-1"></span>
		<span class="page-orb page-orb-2"></span>
		<span class="page-orb page-orb-3"></span>
	</div>
	<HomeHero />
	<HomeModeTabs />
	<HomeActionsBar />

	<div class="home-scroll-flow" id="home-scroll-flow">
		<div class="reveal-section">
			<HomeHowIWork />
		</div>

		{featured && (
			<div class="reveal-section">
				<HomeFeaturedWork focused={focused} workCount={workCount} />
			</div>
		)}

		<div class="reveal-section">
			<HomeExperienceRail experience={experience} />
		</div>

		<div class="reveal-section">
			<HomeEducationStrip
				bscCseProgram={bscCseProgram}
				hscScienceProgram={hscScienceProgram}
			/>
		</div>

		<div class="reveal-section">
			<HomeSkillsStrip />
		</div>

		<div class="reveal-section">
			<HomeContactClose />
		</div>
	</div>
</BaseLayout>

<script>
	function initHomeScrollReveal() {
		const sections = document.querySelectorAll(".reveal-section");
		if (!sections.length) return;

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-revealed");
						observer.unobserve(entry.target);
					}
				});
			},
			{
				threshold: 0.05,
				rootMargin: "0px 0px -40px 0px",
			},
		);

		sections.forEach((section) => {
			observer.observe(section);
		});
	}

	initHomeScrollReveal();
	document.addEventListener("astro:page-load", initHomeScrollReveal);
</script>

<style>
	.home-scroll-flow {
		width: 100%;
		display: flex;
		flex-direction: column;
	}

	.reveal-section {
		opacity: 0;
		transform: translateY(28px);
		transition:
			opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
		will-change: opacity, transform;
	}

	.reveal-section.is-revealed {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal-section {
			opacity: 1 !important;
			transform: none !important;
			transition: none !important;
		}
	}

	.page-mesh-bg {
		position: fixed;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		z-index: -1;
	}

	.page-orb {
		position: absolute;
		border-radius: 999px;
		filter: blur(110px);
		opacity: 0.42;
		will-change: transform;
		transition: background-color 0.55s ease;
	}

	.page-orb-1 {
		width: clamp(320px, 48vw, 680px);
		height: clamp(320px, 48vw, 680px);
		top: -14%;
		left: -10%;
		background: var(--hero-orb-1, #bcc7d4);
		animation: pageOrbDriftA 20s ease-in-out infinite alternate;
	}

	.page-orb-2 {
		width: clamp(300px, 44vw, 640px);
		height: clamp(300px, 44vw, 640px);
		top: 28%;
		right: -12%;
		background: var(--hero-orb-2, #cfd6cc);
		animation: pageOrbDriftB 24s ease-in-out infinite alternate;
	}

	.page-orb-3 {
		width: clamp(280px, 42vw, 600px);
		height: clamp(280px, 42vw, 600px);
		bottom: -16%;
		left: 18%;
		background: var(--hero-orb-1, #bcc7d4);
		opacity: 0.28;
		animation: pageOrbDriftC 26s ease-in-out infinite alternate;
	}

	@keyframes pageOrbDriftA {
		0% { transform: translate3d(0, 0, 0) scale(1); }
		100% { transform: translate3d(6%, 8%, 0) scale(1.1); }
	}

	@keyframes pageOrbDriftB {
		0% { transform: translate3d(0, 0, 0) scale(1); }
		100% { transform: translate3d(-7%, -6%, 0) scale(1.08); }
	}

	@keyframes pageOrbDriftC {
		0% { transform: translate3d(0, 0, 0) scale(1); }
		100% { transform: translate3d(5%, -7%, 0) scale(1.07); }
	}

	@media (prefers-reduced-motion: reduce) {
		.page-orb {
			animation: none;
		}
	}

	:global(html[data-theme="dark"]) .page-orb {
		opacity: 0.3;
	}

	:global(html[data-theme="dark"]) .page-orb-3 {
		opacity: 0.2;
	}

	:global(body) {
		background-color: var(--bg-grad-start);
		background-image: linear-gradient(
			160deg,
			var(--bg-grad-start) 0%,
			var(--bg-grad-end) 100%
		);
		background-attachment: fixed;
		transition:
			background-color 0.4s ease,
			color 0.3s ease;
	}

</style>
