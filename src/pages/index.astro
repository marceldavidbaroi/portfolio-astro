---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { bscCseProgram, hscScienceProgram } from '../data/education';
import { metrics } from '../data/aboutData';

const projectEntries = await getCollection('projects');
const byId = Object.fromEntries(projectEntries.map((entry) => [entry.id, { slug: entry.id, ...entry.data }]));

const focused = ['01-tradeflowbd', '02-service-desk']
	.map((id) => byId[id])
	.filter(Boolean);
const featured = focused[0];
const supporting = [
	'07-pennyperfect',
	'03-thrift-inventory',
	'14-microfinance-loan-app',
	'11-quizzes-streaming',
	'08-docstach'
]
	.map((id) => byId[id])
	.filter(Boolean);

const experience = (await getCollection('experience'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({
		slug: entry.id,
		...entry.data
	}));

const portraitFile = ['portrait.webp', 'portrait.jpg', 'portrait.jpeg', 'portrait.png']
	.find((name) => fs.existsSync(path.join(process.cwd(), 'public/images', name)));
const portraitSrc = portraitFile ? `/images/${portraitFile}` : null;
const proof = [
	metrics.find((m) => m.value === '10+'),
	metrics.find((m) => m.value === '100%'),
	metrics.find((m) => m.value === '3.91')
].filter(Boolean);

const skills = ['Vue 3', 'Quasar', 'TypeScript', 'PostgreSQL', 'Supabase', 'NestJS', 'Docker', 'Pinia'];
const workCount = projectEntries.length;

function shots(project: { images?: string[] }) {
	return (project.images || []).filter((img) => img && !img.includes('thumb-')).slice(0, 3);
}
---

<BaseLayout isWide alignStart>
	<section class="hero" aria-label="Introduction">
		<div class="hero-grid">
			<p class="status font-mono">
				<span class="status-dot" aria-hidden="true"></span>
				Available · Remote / relocation · Dhaka · US/EU overlap
			</p>
			<h1 class="name font-dot">Marcel David Baroi</h1>
			<p class="role">Full-Stack Engineer — multi-tenant SaaS &amp; enterprise systems</p>
			<p class="bio">
				I design and ship Vue / Quasar systems on PostgreSQL — wholesale ERP, support desks, and operations tools used in production.
			</p>
			<ul class="proof">
				{proof.map((m) => (
					<li>
						<strong>{m.value}</strong>
						<span>{m.label}</span>
					</li>
				))}
			</ul>
			<div class="hero-actions">
				<a class="btn-solid font-mono" href="mailto:marceldavidbaroi@gmail.com">Email me</a>
				<a class="btn-ghost font-mono" href="/resume.pdf" target="_blank" rel="noopener noreferrer">Resume</a>
				<a class="text-link font-mono" href="https://linkedin.com/in/marceldavidbaroi" target="_blank" rel="noopener noreferrer">LinkedIn</a>
				<a class="text-link font-mono" href="https://github.com/marceldavidbaroi" target="_blank" rel="noopener noreferrer">GitHub</a>
			</div>

			<figure class="hero-portrait">
				{portraitSrc ? (
					<img
						src={portraitSrc}
						alt="Portrait of Marcel David Baroi"
						width="640"
						height="854"
					/>
				) : (
					<div class="portrait-slot" role="img" aria-label="Portrait placeholder. Add public/images/portrait.webp">
						<span class="portrait-initials font-dot">MDB</span>
						<span class="portrait-hint font-mono">Add public/images/portrait.webp</span>
					</div>
				)}
				<figcaption class="portrait-caption font-mono">Marcel David Baroi</figcaption>
			</figure>
		</div>
	</section>

	{featured && (
		<section class="featured" aria-labelledby="work-heading">
			<div class="section-kicker">
				<p class="label font-mono">Work</p>
				<a class="section-link font-mono" href="/work">All {workCount} →</a>
			</div>
			<h2 id="work-heading" class="sr-only">Featured work</h2>

			<div class="focus-list">
				{focused.map((project) => (
					<a class="feature-band" href={`/work/${project.slug}`}>
						<div class="feature-meta">
							<p class="kicker font-mono">{project.chip}</p>
							<h3 class="feature-title">{project.title}</h3>
							<p class="feature-desc">{project.description}</p>
						</div>
						<ul class="metric-row font-mono">
							{(project.impactMetrics || []).slice(0, 3).map((m) => (
								<li>
									<b>{m.value}</b>
									<span>{m.label}</span>
								</li>
							))}
						</ul>
						<span class="inline-cta font-mono">Read case study →</span>
					</a>
				))}
			</div>

			<div class="work-list">
				{supporting.map((project) => {
					const thumbs = shots(project);
					const isMobile = project.platformType === 'mobile';
					return (
						<a class="work-item" href={`/work/${project.slug}`}>
							<div class="work-copy">
								<p class="kicker font-mono">{project.chip}</p>
								<h3 class="support-title">{project.title}</h3>
							</div>
							<div class:list={['shot-stack', { 'is-phone': isMobile }]} aria-hidden="true">
								{thumbs.length > 0 ? (
									thumbs.map((src, i) => (
										<span class="shot-layer" style={`--i: ${i}`}>
											<img src={src} alt="" loading="lazy" />
										</span>
									))
								) : (
									<span class="shot-layer is-empty" style="--i: 0"></span>
								)}
							</div>
						</a>
					);
				})}
			</div>

			<a class="work-index" href="/work">
				<span class="work-index-copy">
					<span class="work-index-title">See all work</span>
					<span class="work-index-meta font-mono">{workCount} case studies</span>
				</span>
				<span class="section-link font-mono">View archive →</span>
			</a>
		</section>
	)}

	<section class="experience" aria-labelledby="exp-heading">
		<div class="section-kicker">
			<p class="label font-mono">Experience</p>
		</div>
		<h2 id="exp-heading" class="sr-only">Work experience</h2>
		<ol class="rail">
			{experience.map((item) => {
				const line = item.highlights?.[item.order === 1 ? 1 : 0] || item.summary;
				return (
					<li class="rail-row">
						<p class="rail-when font-mono">{item.period}</p>
						<div class="rail-body">
							<div class="rail-head">
								<h3 class="rail-role">{item.role}</h3>
								{item.badge && <span class="rail-badge font-mono">{item.badge}</span>}
							</div>
							<p class="rail-company">{item.company}</p>
							<p class="rail-line">{line}</p>
							{item.relatedProjects && item.relatedProjects.length > 0 && (
								<p class="rail-links font-mono">
									{item.relatedProjects.slice(0, 2).map((rp) => (
										<a href={`/work/${rp.slug}`}>{rp.label}</a>
									))}
								</p>
							)}
						</div>
					</li>
				);
			})}
		</ol>
	</section>

	<section class="education" aria-label="Education">
		<p class="label font-mono">Education</p>
		<div class="edu-list">
			<a class="edu-row" href="/education/bsc-cse">
				{bscCseProgram.logo && (
					<img src={bscCseProgram.logo} alt="" class="edu-logo" width="28" height="28" />
				)}
				<p class="edu-copy">
					<strong>{bscCseProgram.shortDegree}</strong>
					<span class="edu-sep">·</span>
					{bscCseProgram.institutionShort}
					<span class="edu-sep">·</span>
					CGPA {bscCseProgram.cgpa.toFixed(2)} / {bscCseProgram.maxGpa.toFixed(2)}
				</p>
				<span class="section-link font-mono">Transcript →</span>
			</a>
			<a class="edu-row" href="/education/hsc-science">
				{hscScienceProgram.logo && (
					<img src={hscScienceProgram.logo} alt="" class="edu-logo edu-logo-wide" width="40" height="24" />
				)}
				<p class="edu-copy">
					<strong>HSC Science</strong>
					<span class="edu-sep">·</span>
					{hscScienceProgram.institutionShort}
					<span class="edu-sep">·</span>
					GPA {hscScienceProgram.gpa.toFixed(2)} / {hscScienceProgram.maxGpa.toFixed(2)}
				</p>
				<span class="section-link font-mono">Details →</span>
			</a>
		</div>
	</section>

	<section class="skills" aria-label="Skills">
		<div class="skills-row">
			<p class="label font-mono">Stack</p>
			<p class="skills-line">
				{skills.map((name) => (
					<span>{name}</span>
				))}
			</p>
			<a class="section-link font-mono" href="/skills">Full matrix →</a>
		</div>
	</section>

	<section class="close" aria-label="Contact">
		<p class="close-kicker font-mono">Available for full-time · remote or relocation</p>
		<p class="close-title">Let’s talk.</p>
		<div class="hero-actions">
			<a class="btn-solid font-mono" href="mailto:marceldavidbaroi@gmail.com">Email me</a>
			<a class="btn-ghost font-mono" href="https://linkedin.com/in/marceldavidbaroi" target="_blank" rel="noopener noreferrer">LinkedIn</a>
		</div>
	</section>
</BaseLayout>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.label {
		font-size: 0.62rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
		font-weight: 700;
		margin: 0;
	}

	.section-kicker {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.section-link,
	.text-link,
	.inline-cta {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--accent);
		text-decoration: none;
		white-space: nowrap;
	}

	.section-link:hover,
	.text-link:hover,
	.inline-cta:hover {
		text-decoration: underline;
	}

	.kicker {
		font-size: 0.62rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
		margin: 0;
		font-weight: 700;
	}

	/* Hero */
	.hero {
		padding-bottom: 4.5rem;
		border-bottom: 1px solid rgba(95, 80, 56, 0.12);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(220px, 300px);
		grid-template-areas:
			'status portrait'
			'name portrait'
			'role portrait'
			'bio portrait'
			'proof portrait'
			'actions portrait';
		column-gap: 2.75rem;
		row-gap: 0.7rem;
		align-items: start;
	}

	.status { grid-area: status; }
	.name { grid-area: name; }
	.role { grid-area: role; }
	.bio { grid-area: bio; }
	.proof { grid-area: proof; }
	.hero-actions { grid-area: actions; }
	.hero-portrait { grid-area: portrait; }

	.status {
		display: inline-flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.45rem;
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin: 0;
		line-height: 1.45;
	}

	.status-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #3f7d4e;
		flex-shrink: 0;
	}

	.name {
		font-size: clamp(1.85rem, 6vw, 3.35rem);
		font-weight: 700;
		letter-spacing: 0.02em;
		line-height: 1.05;
		color: var(--text-main);
		margin: 0;
		text-transform: none;
		-webkit-text-stroke: 0.3px currentColor;
		overflow-wrap: break-word;
	}

	.role {
		margin: 0;
		font-size: 1.02rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--text-muted);
		line-height: 1.35;
		max-width: 28rem;
	}

	.bio {
		margin: 0.15rem 0 0;
		font-size: 1.05rem;
		line-height: 1.55;
		color: var(--text-main);
		max-width: 34rem;
	}

	.proof {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 1.35rem 1.75rem;
		margin: 0.55rem 0 0.15rem;
		padding: 0.85rem 0 0;
		border-top: 1px solid rgba(95, 80, 56, 0.12);
	}

	.proof li {
		display: flex;
		flex-direction: column;
		gap: 0.12rem;
	}

	.proof strong {
		font-size: 1.35rem;
		letter-spacing: -0.03em;
		line-height: 1;
		color: var(--text-main);
	}

	.proof span {
		font-size: 0.68rem;
		color: var(--text-muted);
		letter-spacing: 0.02em;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
		margin-top: 0.35rem;
	}

	.btn-solid,
	.btn-ghost {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.62rem 1.15rem;
		border-radius: 9999px;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
	}

	.btn-solid {
		background: var(--accent);
		color: #fffdfa;
	}

	.btn-solid:hover {
		background: var(--accent-hover);
	}

	.btn-ghost {
		background: transparent;
		color: var(--text-main);
		border: 1px solid rgba(95, 80, 56, 0.28);
	}

	.btn-ghost:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.hero-portrait {
		justify-self: end;
		width: 100%;
		max-width: 300px;
		margin: 0;
		background: #fffdfa;
		padding: 0.45rem 0.45rem 1.2rem;
		border: 1px solid rgba(95, 80, 56, 0.14);
		box-shadow: 0 18px 40px rgba(95, 80, 56, 0.14);
		transform: rotate(-1.1deg);
	}

	.hero-portrait img,
	.portrait-slot {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		object-position: center top;
		background: var(--card-bg);
	}

	.portrait-slot {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.7rem;
		border: 1px dashed rgba(95, 80, 56, 0.28);
		background: linear-gradient(180deg, #f4f0e7 0%, #ebe6d8 100%);
	}

	.portrait-initials {
		font-size: 2.1rem;
		letter-spacing: 0.08em;
		color: var(--text-main);
		-webkit-text-stroke: 0.3px currentColor;
	}

	.portrait-hint {
		font-size: 0.55rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		text-align: center;
		max-width: 12rem;
		line-height: 1.4;
	}

	.portrait-caption {
		display: block;
		margin-top: 0.65rem;
		padding: 0 0.15rem;
		font-size: 0.58rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-portrait {
			animation: rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
		}
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: rotate(-1.1deg) translateY(18px);
		}
		to {
			opacity: 1;
			transform: rotate(-1.1deg) translateY(0);
		}
	}

	/* Featured + supporting */
	.featured {
		padding: 3.75rem 0 3.5rem;
		border-bottom: 1px solid rgba(95, 80, 56, 0.12);
	}

	.focus-list {
		margin-bottom: 0.35rem;
	}

	.feature-band {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) auto auto;
		gap: 1.5rem 2rem;
		align-items: end;
		text-decoration: none;
		color: inherit;
		padding: 1.5rem 0;
		border-bottom: 1px solid rgba(95, 80, 56, 0.1);
	}

	.focus-list .feature-band:first-child {
		padding-top: 0;
	}

	.feature-band:hover .feature-title {
		color: var(--accent);
	}

	.feature-meta {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		min-width: 0;
	}

	.feature-title {
		margin: 0;
		font-size: clamp(1.15rem, 2.1vw, 1.55rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.2;
		color: var(--text-main);
		overflow-wrap: break-word;
	}

	.feature-desc {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--text-main);
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.metric-row {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem 1.1rem;
		margin: 0.25rem 0 0;
		padding: 0;
	}

	.metric-row li {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.metric-row b {
		font-size: 0.92rem;
		letter-spacing: 0.02em;
		color: var(--text-main);
	}

	.metric-row span {
		font-size: 0.58rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.work-list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 2.25rem;
	}

	.work-item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 7.4rem;
		align-items: center;
		gap: 0.7rem 0.85rem;
		padding: 0.85rem 0;
		border-top: 1px solid rgba(95, 80, 56, 0.1);
		text-decoration: none;
		color: inherit;
		min-width: 0;
	}

	.work-item:hover .support-title {
		color: var(--accent);
	}

	.work-copy {
		display: flex;
		flex-direction: column;
		gap: 0.28rem;
		min-width: 0;
	}

	.shot-stack {
		--w: 86px;
		--h: 56px;
		position: relative;
		width: calc(var(--w) + 20px);
		height: calc(var(--h) + 14px);
		justify-self: end;
		isolation: isolate;
	}

	.shot-stack.is-phone {
		--w: 40px;
		--h: 70px;
		width: calc(var(--w) + 28px);
		height: calc(var(--h) + 10px);
	}

	.shot-layer {
		position: absolute;
		right: calc(var(--i) * 7px);
		bottom: calc(var(--i) * 5px);
		width: var(--w);
		height: var(--h);
		border-radius: 7px;
		border: 1px solid rgba(95, 80, 56, 0.2);
		background: #fffdfa;
		box-shadow: 0 8px 16px rgba(95, 80, 56, 0.12);
		overflow: hidden;
		transform: rotate(calc(-11deg + var(--i) * 5deg));
		z-index: calc(4 - var(--i));
		transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.shot-stack.is-phone .shot-layer {
		border-radius: 9px;
	}

	.shot-layer.is-empty {
		border-style: dashed;
		background: var(--card-bg);
	}

	.shot-layer img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
	}

	.work-item:hover .shot-layer {
		transform: rotate(calc(-7deg + var(--i) * 4deg)) translateY(-3px);
	}

	.support-title {
		margin: 0;
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.3;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 0.15s ease;
	}

	.work-index {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 0.35rem;
		padding: 1.15rem 0 0.15rem;
		border-top: 1px solid rgba(95, 80, 56, 0.1);
		text-decoration: none;
		color: inherit;
		min-height: 3.1rem;
	}

	.work-index-copy {
		display: flex;
		flex-direction: column;
		gap: 0.18rem;
		min-width: 0;
	}

	.work-index-title {
		font-size: 1.02rem;
		font-weight: 800;
		letter-spacing: -0.025em;
		color: var(--text-main);
	}

	.work-index-meta {
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.work-index:hover .work-index-title,
	.work-index:hover .section-link {
		color: var(--accent);
	}

	/* Experience rail */
	.experience {
		padding: 3.25rem 0 2.75rem;
		border-bottom: 1px solid rgba(95, 80, 56, 0.12);
	}

	.rail {
		list-style: none;
