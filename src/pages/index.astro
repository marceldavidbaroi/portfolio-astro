---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projectEntries = await getCollection('projects');
const projects = projectEntries
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 4)
	.map((entry) => ({
		slug: entry.id,
		...entry.data
	}));

const experienceEntries = await getCollection('experience');
const experience = experienceEntries
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({
		slug: entry.id,
		...entry.data
	}));

const education = [
	{
		degree: 'Bachelor of Science in Computer Science & Engineering',
		institution: 'Daffodil International University (DIU)',
		period: '2020 — 2024',
		badge: 'Graduated 2024',
		gpa: 'CGPA 3.91 / 4.00',
		summary: 'Comprehensive curriculum emphasizing Distributed Systems, Relational Database Architecture, Data Structures & Algorithms, Object-Oriented Software Design, and Scalable Web Platforms.',
		courses: ['Distributed Systems', 'Relational Databases', 'Data Structures & Algorithms', 'Web Engineering', 'Software Architecture']
	},
	{
		degree: 'Higher Secondary Certificate (HSC) — Science',
		institution: 'Notre Dame College, Dhaka',
		period: '2017 — 2019',
		badge: 'Graduated 2019',
		gpa: 'GPA 4.67 / 5.00',
		summary: 'Rigorous foundational studies in Higher Mathematics, Physics, Chemistry, and Analytical Problem Solving.',
		courses: ['Higher Mathematics', 'Physics', 'Chemistry', 'Analytical Logic']
	}
];
---

<BaseLayout title="Marcel David Baroi | Full-Stack Software Engineer">
	<!-- Hero Section -->
	<section class="hero">
		<div class="hero-status">
			<span class="status-dot"></span>
			<span class="status-text font-mono">[001] AVAILABLE FOR OPPORTUNITIES</span>
		</div>
		<h1 class="title font-dot">Marcel David</h1>
		<p class="subtitle font-dot">Software engineer</p>
		<p class="hero-bio font-mono">
			Specializing in architecture-first full-stack systems, multi-tenant SaaS platforms, and enterprise web solutions across Vue.js/Quasar, Supabase, PHP, and NestJS.
		</p>
	</section>

	<!-- Projects Section -->
	<section id="projects" class="section">
		<div class="section-header">
			<div class="section-label-group">
				<span class="section-tag font-dot">01 // CREATION</span>
				<h2 class="section-title font-dot">Featured Projects</h2>
			</div>
			<p class="section-desc font-mono">
				Selected architectural builds, production-grade applications, and engineering experiments.
			</p>
		</div>

		<div class="projects-grid">
			{projects.map((project) => (
				<a href={`/work/${project.slug}`} class="project-showcase-card">
					<!-- Top Info Header: Title, Description, Keyword Chip -->
					<div class="card-header-info">
						<h3 class="project-title font-mono">{project.title}</h3>
						<p class="project-description font-mono">{project.description}</p>
						<div class="chip-container">
							<span class="keyword-chip font-mono">{project.chip}</span>
						</div>
					</div>

					<!-- Bottom Image Slot: Desktop (16:10) or Mobile (9:19.5 Phone) Screenshots -->
					<div class={`card-image-slot slot-${project.platformType || 'desktop'}`}>
						<div class={`thumbs-mosaic mosaic-${project.platformType || 'desktop'}`}>
							{[1, 2, 3, 4].map((idx) => {
								const img = project.images && project.images[idx - 1] && !project.images[idx - 1].includes('thumb-') ? project.images[idx - 1] : null;
								const isMobile = project.platformType === 'mobile';
								return (
									<div class={`thumb-card thumb-${idx} ${isMobile ? 'thumb-mobile-device' : 'thumb-desktop-window'}`}>
										{isMobile && (
											<div class="mobile-phone-notch">
												<span class="notch-pill"></span>
											</div>
										)}
										{img ? (
											<img src={img} alt={`${project.title} Preview ${idx}`} class="thumb-img" loading="lazy" />
										) : (
											<div class="thumb-placeholder">
												<svg 
													xmlns="http://www.w3.org/2000/svg" 
													width="32" 
													height="32" 
													viewBox="0 0 24 24" 
													fill="none" 
													stroke="currentColor" 
													stroke-width="1.5" 
													stroke-linecap="round" 
													stroke-linejoin="round"
													class="placeholder-icon"
												>
													{isMobile ? (
														<>
															<rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
															<line x1="12" x2="12.01" y1="18" y2="18"></line>
														</>
													) : (
														<>
															<rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
															<circle cx="8.5" cy="8.5" r="1.5"></circle>
															<polyline points="21 15 16 10 5 21"></polyline>
														</>
													)}
												</svg>
												<span class="placeholder-idx font-mono">{isMobile ? `SCREEN 0${idx}` : `PREVIEW 0${idx}`}</span>
											</div>
										)}
									</div>
								);
							})}
						</div>
					</div>
				</a>
			))}
		</div>

		<!-- View All Projects Button -->
		<div class="projects-action-row">
			<a href="/work" class="btn-explore-all font-mono">
				<span>Explore All Projects</span>
				<span class="action-arrow font-dot">→</span>
			</a>
		</div>
	</section>

	<!-- Experience Section -->
	<section id="experience" class="section">
		<div class="section-header">
			<div class="section-label-group">
				<span class="section-tag font-dot">02 // TRAJECTORY</span>
				<h2 class="section-title font-dot">Work Experience</h2>
			</div>
			<p class="section-desc font-mono">
				A chronological breakdown of professional engineering roles and technical milestones.
			</p>
		</div>

		<div class="experience-grid">
			{experience.map((item) => (
				<article class="experience-showcase-card">
					<!-- Top Info Header -->
					<div class="card-header-info">
						<div class="exp-top-row">
							<h3 class="project-title font-mono">{item.role}</h3>
							<span class="keyword-chip font-mono">{item.period}</span>
						</div>
						<p class="exp-company-sub font-mono">
							<span class="company-name">{item.company}</span>
							<span class="exp-badge font-mono">{item.badge}</span>
						</p>
						<p class="project-description font-mono">{item.summary}</p>
						
						<ul class="exp-bullets font-mono">
							{item.highlights.map((h) => (
								<li>
									<span class="bullet-dot font-dot">›</span>
									<span>{h}</span>
								</li>
							))}
						</ul>
					</div>

					<!-- Visual Code / Architecture Window Area -->
					<div class="card-image-slot">
						<div class="exp-code-window font-mono">
							<div class="window-header">
								<div class="win-dots">
									<span></span><span></span><span></span>
								</div>
								<span class="win-title">{item.company.toLowerCase().replace(/\s+/g, '-')}-core.config</span>
							</div>
							<div class="window-body">
								<div class="code-line"><span class="c-key">status:</span> <span class="c-val">'active'</span>,</div>
								<div class="code-line"><span class="c-key">uptime:</span> <span class="c-num">99.99</span>,</div>
								<div class="code-line"><span class="c-key">stack:</span> [</div>
								{item.stack.map((s) => (
									<div class="code-indent"><span class="c-str">'{s}'</span>,</div>
								))}
								<div class="code-line">]</div>
							</div>
						</div>
					</div>
				</article>
			))}
		</div>
	</section>

	<!-- Education Section -->
	<section id="education" class="section">
		<div class="section-header">
			<div class="section-label-group">
				<span class="section-tag font-dot">03 // PEDIGREE</span>
				<h2 class="section-title font-dot">Academic Education</h2>
			</div>
			<p class="section-desc font-mono">
				Formal computer science curriculum, foundational engineering honors, and academic credentials.
			</p>
		</div>

		<div class="education-grid">
			{education.map((item) => (
				<div class="education-card card font-mono">
					<div class="edu-top-row">
						<span class="edu-badge">{item.badge}</span>
						<span class="edu-gpa font-dot">{item.gpa}</span>
					</div>
					<h3 class="edu-degree">{item.degree}</h3>
					<div class="edu-inst-row">
						<span class="edu-inst">{item.institution}</span>
						<span class="edu-divider">•</span>
						<span class="edu-period">{item.period}</span>
					</div>
					<p class="edu-summary">{item.summary}</p>
					
					<div class="edu-courses">
						<span class="edu-course-label">Focus Areas:</span>
						<div class="edu-course-tags">
							{item.courses.map((course) => (
								<span class="edu-tag">{course}</span>
							))}
						</div>
					</div>
				</div>
			))}
		</div>
	</section>
</BaseLayout>

<style>
	/* Hero Section */
	.hero {
		min-height: calc(85vh - 100px);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		padding: 3rem 0;
		text-align: center;
	}

	.hero-status {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		padding: 0.35rem 0.9rem;
		border-radius: 9999px;
		margin-bottom: 0.5rem;
	}

	.status-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: #22c55e;
		box-shadow: 0 0 10px rgba(34, 197, 94, 0.6);
		animation: pulse 2s infinite ease-in-out;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.5; transform: scale(0.85); }
	}

	.status-text {
		font-size: 0.8125rem;
		letter-spacing: 0.06em;
		color: var(--text-muted);
		font-weight: 500;
	}

	.title {
		font-size: clamp(3.5rem, 10vw, 8.5rem);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-main);
		line-height: 1.02;
		word-break: break-word;
		-webkit-text-stroke: 0.5px currentColor;
		text-rendering: optimizeLegibility;
	}

	.subtitle {
		font-size: clamp(1.5rem, 4vw, 3rem);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
		line-height: 1.15;
		font-weight: 700;
		-webkit-text-stroke: 0.35px currentColor;
	}

	.hero-bio {
		font-size: clamp(1rem, 1.8vw, 1.15rem);
		line-height: 1.6;
		color: var(--text-muted);
		max-width: 620px;
		margin-top: 0.5rem;
	}

	/* Section Common Styles */
	.section {
		width: 100%;
		margin-top: 7rem;
		text-align: left;
	}

	.section-header {
		margin-bottom: 2.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.section-label-group {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.section-tag {
		font-size: 0.9375rem;
		letter-spacing: 0.12em;
		color: var(--accent);
		text-transform: uppercase;
		font-weight: 700;
		-webkit-text-stroke: 0.25px currentColor;
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--text-main);
		line-height: 1.1;
		-webkit-text-stroke: 0.35px currentColor;
	}

	.section-desc {
		font-size: 1rem;
		line-height: 1.5;
		color: var(--text-muted);
		max-width: 640px;
	}

	/* Projects 2-Column Grid */
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}

	@media (max-width: 768px) {
		.projects-grid {
			grid-template-columns: 1fr;
		}
	}

	.projects-action-row {
		display: flex;
		justify-content: center;
		margin-top: 3rem;
		width: 100%;
	}

	.btn-explore-all {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.9rem 2rem;
		border-radius: 9999px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		color: var(--text-main);
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none !important;
		transition: all 0.25s ease;
		box-shadow: 0 4px 15px rgba(95, 80, 56, 0.05);
	}

	.btn-explore-all:hover {
		background: var(--btn-primary);
		color: #fffdfa;
		border-color: var(--btn-primary);
		transform: translateY(-2px);
		box-shadow: 0 10px 25px rgba(95, 80, 56, 0.15);
	}

	.action-arrow {
		font-size: 1.15rem;
		color: var(--accent);
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.btn-explore-all:hover .action-arrow {
		color: #ffffff;
		transform: translateX(4px);
	}

	/* Exact Reference Card Styling */
	.project-showcase-card,
	.project-showcase-card:hover,
	.project-showcase-card:focus,
	.project-showcase-card:active {
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: 32px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 600px;
		position: relative;
		text-decoration: none !important;
		color: inherit;
		cursor: pointer;
		transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
	}

	.project-showcase-card * {
		text-decoration: none !important;
	}

	.project-showcase-card:hover {
		transform: translateY(-4px);
		border-color: rgba(95, 80, 56, 0.28);
		box-shadow: 0 20px 45px rgba(95, 80, 56, 0.1);
	}

	.card-header-info {
		padding: 2.25rem 2.25rem 1rem 2.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		z-index: 2;
	}

	.project-title {
		font-size: 1.85rem;
		font-weight: 800;
		color: var(--text-main);
		letter-spacing: -0.03em;
		line-height: 1.15;
	}

	.project-description {
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--text-muted);
		max-width: 90%;
	}

	.chip-container {
		margin-top: 0.65rem;
	}

	.keyword-chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.4rem 1.15rem;
		border-radius: 9999px;
		border: 1px solid rgba(95, 80, 56, 0.7);
		background: transparent;
		color: var(--text-main);
		font-size: 0.8125rem;
		font-weight: 500;
		transition: all 0.2s ease;
	}

	.project-showcase-card:hover .keyword-chip {
		background: var(--btn-primary);
		color: #fffdfa;
		border-color: var(--btn-primary);
	}

	/* Card Image / Media Slot: Desktop & Mobile Screen Support */
	.card-image-slot {
		position: relative;
		min-height: 380px;
		width: 100%;
		overflow: hidden;
		display: flex;
		align-items: flex-end;
		justify-content: flex-end;
	}

	/* Desktop Screenshot Mosaic: 16:10 Widescreen */
	.mosaic-desktop {
		position: absolute;
		right: -60px;
		bottom: -60px;
		width: 620px;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
		transform: rotate(-20deg) skew(-2deg);
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.project-showcase-card:hover .mosaic-desktop {
		transform: rotate(-16deg) skew(-1deg) translateY(-10px);
	}

	/* Mobile Screenshot Mosaic: 9:19.5 Slim Smartphone Grid */
	.mosaic-mobile {
		position: absolute;
		right: -25px;
		bottom: -50px;
		width: 480px;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 18px;
		transform: rotate(-14deg) skew(-1deg);
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.project-showcase-card:hover .mosaic-mobile {
		transform: rotate(-10deg) skew(0deg) translateY(-12px);
	}

	.thumb-card {
		background: linear-gradient(145deg, #ffffff 0%, #f7f4ee 100%);
		border: 1px solid rgba(95, 80, 56, 0.16);
		overflow: hidden;
		box-shadow: 0 14px 32px rgba(95, 80, 56, 0.12);
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.25s ease;
		position: relative;
	}

	/* Desktop Window Card */
	.thumb-desktop-window {
		border-radius: 12px;
		aspect-ratio: 16 / 10;
	}

	/* Mobile Smartphone Frame Card */
	.thumb-mobile-device {
		border-radius: 24px;
		aspect-ratio: 9 / 19;
		border: 2px solid rgba(95, 80, 56, 0.22);
		box-shadow: 0 16px 36px rgba(95, 80, 56, 0.15);
		background: #ffffff;
	}

	.mobile-phone-notch {
		position: absolute;
		top: 6px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.notch-pill {
		width: 32px;
		height: 4px;
		background: rgba(95, 80, 56, 0.35);
		border-radius: 9999px;
	}

	.thumb-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		display: block;
		transition: transform 0.3s ease;
	}

	.thumb-mobile-device .thumb-img {
		object-position: top left;
	}

	.project-showcase-card:hover .thumb-img {
		transform: scale(1.04);
	}

	.thumb-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		color: rgba(95, 80, 56, 0.45);
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.project-showcase-card:hover .thumb-placeholder {
		color: var(--accent);
	}

	.placeholder-icon {
		opacity: 0.7;
		transition: transform 0.25s ease, opacity 0.25s ease;
	}

	.project-showcase-card:hover .placeholder-icon {
		opacity: 1;
		transform: scale(1.1);
	}

	.placeholder-idx {
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		color: var(--text-muted);
		font-weight: 500;
	}

	/* Experience Showcase: Single Card per Row */
	.experience-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	.experience-showcase-card {
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: 32px;
		overflow: hidden;
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		min-height: 400px;
		position: relative;
		transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
	}

	@media (max-width: 860px) {
		.experience-showcase-card {
			grid-template-columns: 1fr;
			min-height: 520px;
		}
	}

	.experience-showcase-card:hover {
		transform: translateY(-4px);
		border-color: rgba(95, 80, 56, 0.28);
		box-shadow: 0 20px 45px rgba(95, 80, 56, 0.1);
	}

	.experience-showcase-card .card-header-info {
		padding: 2.5rem 2.25rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.65rem;
	}

	.experience-showcase-card .card-image-slot {
		min-height: 320px;
		display: flex;
		align-items: center;
		justify-content: flex-end;
	}

	.exp-top-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.exp-company-sub {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.9375rem;
	}

	.company-name {
		color: var(--accent);
		font-weight: 600;
	}

	.exp-badge {
		font-size: 0.6875rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		background: rgba(95, 80, 56, 0.08);
		border: 1px solid rgba(95, 80, 56, 0.15);
		color: var(--btn-primary);
		padding: 0.15rem 0.5rem;
		border-radius: 9999px;
	}

	.exp-bullets {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		margin-top: 0.4rem;
	}

	.exp-bullets li {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--text-muted);
	}

	/* Angled Code & Config Window Mockup */
	.exp-code-window {
		position: absolute;
		right: -25px;
		bottom: -20px;
		width: 360px;
		background: #ffffff;
		color: var(--text-main);
		border-radius: 18px;
		border: 1px solid rgba(95, 80, 56, 0.18);
		box-shadow: -12px -12px 36px rgba(95, 80, 56, 0.12);
		padding: 1.1rem 1.25rem;
		transform: rotate(-12deg);
		transition: transform 0.3s ease;
