---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projectEntries = await getCollection('projects');
const projects = projectEntries
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 4)
	.map((entry) => ({
		slug: entry.id,
		...entry.data
	}));

const experienceEntries = await getCollection('experience');
const experience = experienceEntries
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({
		slug: entry.id,
		...entry.data
	}));

import { bscCseProgram, hscScienceProgram, getAcademicStatistics } from '../data/education';
import { finalYearThesisResearch } from '../data/research';

const stats = getAcademicStatistics();
const thesis = finalYearThesisResearch;
---

<BaseLayout title="Marcel David Baroi | Full-Stack Software Engineer">
	<!-- Hero Section -->
	<section class="hero">
		<div class="hero-status">
			<span class="status-dot"></span>
			<span class="status-text font-mono">[001] AVAILABLE FOR OPPORTUNITIES</span>
		</div>
		<h1 class="title font-dot">Marcel David</h1>
		<p class="subtitle font-dot">Software engineer</p>
		<p class="hero-bio">
			Specializing in architecture-first full-stack systems, multi-tenant SaaS platforms, and enterprise web solutions across Vue.js/Quasar, Supabase, PHP, and NestJS.
		</p>
	</section>

	<!-- Projects Section -->
	<section id="projects" class="section">
		<div class="section-header">
			<div class="section-label-group">
				<span class="section-tag font-dot">01 // CREATION</span>
				<h2 class="section-title font-dot">Featured Projects</h2>
			</div>
			<p class="section-desc">
				Selected architectural builds, production-grade applications, and engineering experiments.
			</p>
		</div>

		<div class="projects-grid">
			{projects.map((project) => (
				<a href={`/work/${project.slug}`} class="project-showcase-card">
					<!-- Top Info Header: Title, Description, Keyword Chip -->
					<div class="card-header-info">
						<h3 class="project-title">{project.title}</h3>
						<p class="project-description">{project.description}</p>
						<div class="chip-container">
							<span class="keyword-chip font-mono">{project.chip}</span>
						</div>
					</div>

					<!-- Bottom Image Slot: Desktop (16:10) or Mobile (9:19.5 Phone) Screenshots -->
					{(() => {
						const validImages = (project.images || []).filter((img) => img && !img.includes('thumb-'));
						const thumbsToRender = validImages.length > 0 ? validImages.slice(0, 4) : [null, null, null, null];
						const count = thumbsToRender.length;
						const isBlankMode = validImages.length === 0;

						return (
							<div class={`card-image-slot slot-${project.platformType || 'desktop'} count-${count}`}>
								<div class={`thumbs-mosaic mosaic-${project.platformType || 'desktop'} mosaic-count-${count}`}>
									{thumbsToRender.map((img, idx) => {
										const isMobile = img 
											? (!img.includes('web-') && !img.includes('dashboard') && !img.includes('chart-of-accounts') && !img.includes('balance-sheet') && !img.includes('reports') && (img.includes('collections.png') || img.includes('scanner') || img.includes('register.png') || img.includes('inventory.png') || img.includes('mobile') || project.platformType === 'mobile'))
											: project.platformType === 'mobile';
										return (
											<div class={`thumb-card thumb-${idx + 1} ${isMobile ? 'thumb-mobile-device' : 'thumb-desktop-window'}`}>
												{isMobile && (
													<div class="mobile-phone-notch">
														<span class="notch-pill"></span>
													</div>
												)}
												{img ? (
													<img src={img} alt={`${project.title} Preview ${idx + 1}`} class="thumb-img" loading="lazy" />
												) : (
													<div class="thumb-placeholder">
														<svg 
															xmlns="http://www.w3.org/2000/svg" 
															width="32" 
															height="32" 
															viewBox="0 0 24 24" 
															fill="none" 
															stroke="currentColor" 
															stroke-width="1.5" 
															stroke-linecap="round" 
															stroke-linejoin="round"
															class="placeholder-icon"
														>
															{isMobile ? (
																<>
																	<rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
																	<line x1="12" x2="12.01" y1="18" y2="18"></line>
																</>
															) : (
																<>
																	<rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
																	<circle cx="8.5" cy="8.5" r="1.5"></circle>
																	<polyline points="21 15 16 10 5 21"></polyline>
																</>
															)}
														</svg>
														<span class="placeholder-idx font-mono">{isMobile ? `SCREEN 0${idx + 1}` : `PREVIEW 0${idx + 1}`}</span>
													</div>
												)}
											</div>
										);
									})}
								</div>
							</div>
						);
					})()}
				</a>
			))}
		</div>

		<!-- View All Projects Button -->
		<div class="projects-action-row">
			<a href="/work" class="btn-explore-all font-mono">
				<span>Explore All Projects</span>
				<span class="action-arrow font-dot">→</span>
			</a>
		</div>
	</section>

	<!-- Experience Section -->
	<section id="experience" class="section">
		<div class="section-header">
			<div class="section-label-group">
				<span class="section-tag font-dot">02 // TRAJECTORY</span>
				<h2 class="section-title font-dot">Work Experience</h2>
			</div>
			<p class="section-desc">
				A chronological breakdown of professional engineering roles and technical milestones.
			</p>
		</div>

		<div class="experience-grid">
			{experience.map((item) => (
				<article class="experience-showcase-card">
					<!-- Top Info Header -->
					<div class="card-header-info">
						<div class="exp-top-row">
							<h3 class="project-title">{item.role}</h3>
							<span class="keyword-chip font-mono">{item.period}</span>
						</div>
						<p class="exp-company-sub">
							<span class="company-name">{item.company}</span>
							<span class="exp-badge font-mono">{item.badge}</span>
						</p>
						<p class="project-description">{item.summary}</p>
						
						<ul class="exp-bullets">
							{item.highlights.map((h) => (
								<li>
									<span class="bullet-dot font-dot">›</span>
									<span>{h}</span>
								</li>
							))}
						</ul>
					</div>

					<!-- Visual Code / Architecture Window Area -->
					<div class="card-image-slot">
						<div class="exp-code-window font-mono">
							<div class="window-header">
								<div class="win-dots">
									<span></span><span></span><span></span>
								</div>
								<span class="win-title">{item.company.toLowerCase().replace(/\s+/g, '-')}-core.config</span>
							</div>
							<div class="window-body">
								<div class="code-line"><span class="c-key">status:</span> <span class="c-val">'active'</span>,</div>
								<div class="code-line"><span class="c-key">uptime:</span> <span class="c-num">99.99</span>,</div>
								<div class="code-line"><span class="c-key">stack:</span> [</div>
								{item.stack.map((s) => (
									<div class="code-indent"><span class="c-str">'{s}'</span>,</div>
								))}
								<div class="code-line">]</div>
							</div>
						</div>
					</div>
				</article>
			))}
		</div>
	</section>

	<!-- Education Section -->
	<section id="education" class="section">
		<div class="section-header">
			<div class="section-label-group">
				<span class="section-tag font-dot">03 // PEDIGREE</span>
				<h2 class="section-title font-dot">Academic Education</h2>
			</div>
			<p class="section-desc">
				Formal computer science curriculum, foundational engineering honors, and academic credentials.
			</p>
		</div>

		<div class="education-grid">
			<!-- B.Sc. CSE -->
			<div class="education-card card">
				<div class="edu-top-row">
					<div class="edu-badge-wrap">
						<span class="edu-badge font-mono">{bscCseProgram.badge}</span>
						<span class="edu-credits-tag font-mono">{bscCseProgram.totalCredits} Credits • 11 Semesters</span>
					</div>
					<span class="edu-gpa font-dot">CGPA {bscCseProgram.cgpa.toFixed(2)} / {bscCseProgram.maxGpa.toFixed(2)}</span>
				</div>
				<div class="edu-card-main">
					{bscCseProgram.logo && (
						<div class="edu-card-logo-box">
							<img
								src={bscCseProgram.logo}
								alt={`${bscCseProgram.institution} Crest`}
								class="edu-card-logo"
								width="52"
								height="52"
								loading="lazy"
							/>
						</div>
					)}
					<div class="edu-card-text">
						<h3 class="edu-degree">{bscCseProgram.degree}</h3>
						<div class="edu-inst-row">
							<a
								href={bscCseProgram.institutionUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="inst-web-link"
								title={`Visit ${bscCseProgram.institution} Website`}
							>
								<span>{bscCseProgram.institution}</span>
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
									<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
									<polyline points="15 3 21 3 21 9"></polyline>
									<line x1="10" y1="14" x2="21" y2="3"></line>
								</svg>
							</a>
							<span class="edu-divider">•</span>
							<span class="edu-period font-mono">{bscCseProgram.period}</span>
						</div>
					</div>
				</div>
				<p class="edu-summary">{bscCseProgram.summary}</p>
				
				<div class="edu-courses">
					<span class="edu-course-label font-dot">Core Specializations:</span>
					<div class="edu-course-tags">
						{bscCseProgram.keyFocusAreas.slice(0, 4).map((area) => (
							<span class="edu-tag font-mono">{area}</span>
						))}
					</div>
				</div>

				<div class="edu-footer-link">
					<a href="/education/bsc-cse" class="transcript-link font-dot">
						<span>View B.Sc. in CSE Full Details & Transcript</span>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</a>
				</div>
			</div>

			<!-- HSC Science -->
			<div class="education-card card">
				<div class="edu-top-row">
					<div class="edu-badge-wrap">
						<span class="edu-badge font-mono">{hscScienceProgram.badge}</span>
						<span class="edu-credits-tag font-mono">{hscScienceProgram.field}</span>
					</div>
					<span class="edu-gpa font-dot">GPA {hscScienceProgram.gpa.toFixed(2)} / {hscScienceProgram.maxGpa.toFixed(2)}</span>
				</div>

				<div class="edu-card-main">
					{hscScienceProgram.logo && (
						<div class="edu-card-logo-box ndc-card-logo-box">
							<img
								src={hscScienceProgram.logo}
								alt={`${hscScienceProgram.institution} Logo`}
								class="edu-card-logo"
								width="90"
								height="40"
								loading="lazy"
							/>
						</div>
					)}
					<div class="edu-card-text">
						<h3 class="edu-degree">{hscScienceProgram.degree}</h3>
						<div class="edu-inst-row">
							<a
								href={hscScienceProgram.institutionUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="inst-web-link"
								title={`Visit ${hscScienceProgram.institution} Website`}
							>
								<span>{hscScienceProgram.institution}</span>
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
									<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
									<polyline points="15 3 21 3 21 9"></polyline>
									<line x1="10" y1="14" x2="21" y2="3"></line>
								</svg>
							</a>
							<span class="edu-divider">•</span>
							<span class="edu-period font-mono">{hscScienceProgram.period}</span>
						</div>
					</div>
				</div>
				<p class="edu-summary">{hscScienceProgram.summary}</p>
				
				<div class="edu-courses">
					<span class="edu-course-label font-dot">Science Curriculum:</span>
					<div class="edu-course-tags">
						{hscScienceProgram.keyCourses.map((c) => (
							<span class="edu-tag font-mono">{c}</span>
						))}
					</div>
				</div>

				{hscScienceProgram.coCurricular && (
					<div class="edu-courses">
						<span class="edu-course-label font-dot">Co-Curricular Clubs:</span>
						<div class="edu-course-tags">
							{hscScienceProgram.coCurricular.map((club) => (
								<span class="edu-tag club-tag font-mono">{club}</span>
							))}
						</div>
					</div>
				)}

				<div class="edu-footer-link">
					<a href="/education/hsc-science" class="transcript-link font-dot">
						<span>View Notre Dame College HSC Details & Curriculum</span>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Academic Research & Thesis Section -->
	<section id="research" class="section">
		<div class="section-header">
			<div class="section-label-group">
				<span class="section-tag font-dot">04 // RESEARCH & PUBLICATIONS</span>
				<h2 class="section-title font-dot">Final Year Thesis Research</h2>
			</div>
			<p class="section-desc">
				Empirical computer vision and optical character recognition (OCR) research defended at Daffodil International University.
			</p>
		</div>

		<div class="research-spotlight-card card">
			<div class="research-top-row">
				<div class="research-badge-wrap">
					<span class="research-badge font-mono">{thesis.badge}</span>
					<span class="research-inst-tag font-mono">{thesis.institution} • Project #{thesis.projectNumber}</span>
				</div>
				<span class="research-acc font-dot">DenseNet Peak: 97.93% Vowel / 95.99% Consonant</span>
			</div>

			<h3 class="research-title font-dot">
				<a href="/research/01-bangla-hwcr-ekush" class="research-title-link">
					{thesis.title}
				</a>
			</h3>

			<p class="research-abstract">
				{thesis.abstract}
			</p>

			<div class="research-metrics-grid">
				<div class="r-metric-box">
					<span class="r-metric-val font-dot">97.93%</span>
					<span class="r-metric-lbl">Vowel Accuracy (F1: 0.98)</span>
				</div>
				<div class="r-metric-box">
					<span class="r-metric-val font-dot">95.99%</span>
					<span class="r-metric-lbl">Consonant Accuracy (F1: 0.96)</span>
				</div>
				<div class="r-metric-box">
					<span class="r-metric-val font-dot">80,000</span>
					<span class="r-metric-lbl">Ekush Dataset Images</span>
				</div>
				<div class="r-metric-box">
					<span class="r-metric-val font-dot">16 Models</span>
					<span class="r-metric-lbl">Empirical Benchmarks</span>
				</div>
			</div>

			<div class="research-footer-row">
				<a href="/research/01-bangla-hwcr-ekush" class="research-cta-primary font-dot">
					<span>View Full Thesis Research & 16-Model Benchmarks</span>
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</a>

				<a
					href={thesis.officialRepositoryUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="research-cta-secondary font-mono"
				>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
						<polyline points="15 3 21 3 21 9"></polyline>
						<line x1="10" y1="14" x2="21" y2="3"></line>
					</svg>
					<span>DIU Repository Listing</span>
				</a>

				<a
					href={thesis.pdfDownloadUrl}
					target="_blank"
					download="Bangla-HWCR-Ekush-Thesis-MarcelDavidBaroi.pdf"
					class="research-cta-secondary font-mono"
				>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
						<polyline points="7 10 12 15 17 10"></polyline>
						<line x1="12" y1="15" x2="12" y2="3"></line>
					</svg>
					<span>Download PDF (5.4 MB)</span>
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	/* Hero Section */
	.hero {
		min-height: calc(85vh - 100px);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		padding: 3rem 0;
		text-align: center;
	}

	.hero-status {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		padding: 0.35rem 0.9rem;
		border-radius: 9999px;
		margin-bottom: 0.5rem;
	}

	.status-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: #22c55e;
		box-shadow: 0 0 10px rgba(34, 197, 94, 0.6);
		animation: pulse 2s infinite ease-in-out;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.5; transform: scale(0.85); }
	}

	.status-text {
		font-size: 0.8125rem;
		letter-spacing: 0.06em;
		color: var(--text-muted);
		font-weight: 500;
	}

	.title {
		font-size: clamp(3.5rem, 10vw, 8.5rem);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-main);
		line-height: 1.02;
		word-break: break-word;
		-webkit-text-stroke: 0.5px currentColor;
		text-rendering: optimizeLegibility;
	}

	.subtitle {
		font-size: clamp(1.5rem, 4vw, 3rem);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
		line-height: 1.15;
		font-weight: 700;
		-webkit-text-stroke: 0.35px currentColor;
	}

	.hero-bio {
		font-size: clamp(1rem, 1.8vw, 1.15rem);
		line-height: 1.6;
		color: var(--text-muted);
		max-width: 620px;
		margin-top: 0.5rem;
	}

	/* Section Common Styles */
	.section {
		width: 100%;
		margin-top: 7rem;
		text-align: left;
	}

	.section-header {
		margin-bottom: 2.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.section-label-group {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.section-tag {
		font-size: 0.9375rem;
		letter-spacing: 0.12em;
		color: var(--accent);
		text-transform: uppercase;
		font-weight: 700;
		-webkit-text-stroke: 0.25px currentColor;
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--text-main);
		line-height: 1.1;
		-webkit-text-stroke: 0.35px currentColor;
	}

	.section-desc {
		font-size: 1rem;
		line-height: 1.5;
		color: var(--text-muted);
		max-width: 640px;
	}

	/* Projects 2-Column Grid */
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}

	@media (max-width: 768px) {
		.projects-grid {
			grid-template-columns: 1fr;
		}
	}

	.projects-action-row {
		display: flex;
		justify-content: center;
		margin-top: 3rem;
		width: 100%;
	}

	.btn-explore-all {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.9rem 2rem;
		border-radius: 9999px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		color: var(--text-main);
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none !important;
		transition: all 0.25s ease;
		box-shadow: 0 4px 15px rgba(95, 80, 56, 0.05);
	}

	.btn-explore-all:hover {
		background: var(--btn-primary);
		color: #fffdfa;
		border-color: var(--btn-primary);
		transform: translateY(-2px);
		box-shadow: 0 10px 25px rgba(95, 80, 56, 0.15);
	}

	.action-arrow {
		font-size: 1.15rem;
		color: var(--accent);
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.btn-explore-all:hover .action-arrow {
		color: #ffffff;
		transform: translateX(4px);
	}

	/* Exact Reference Card Styling */
	.project-showcase-card,
	.project-showcase-card:hover,
	.project-showcase-card:focus,
	.project-showcase-card:active {
