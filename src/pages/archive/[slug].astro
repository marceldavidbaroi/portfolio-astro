---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { mediaMap, resolveAsset, resolveAssets } from '../../lib/media';
import '../../styles/about.css';

export async function getStaticPaths() {
	const entries = await getCollection('archive');
	return entries
		.filter((e) => e.data.kind === 'memoir' && e.data.slug)
		.map((entry) => ({
			params: { slug: entry.data.slug },
			props: { entry },
		}));
}

const { entry } = Astro.props;
const d = entry.data;
const map = mediaMap(await getCollection('media'));

const eventPhases = (d.phases || []).map((phase) => {
	const image = phase.imageId ? resolveAsset(phase.imageId, map) : null;
	return {
		...phase,
		imageSrc: image?.src,
		imageAlt: image?.alt,
		imageCaption: phase.imageCaption || image?.caption || '',
	};
});

const days = (d.days || []).map((day) => ({
	...day,
	images: resolveAssets(day.imageIds || [], map).map((a) => ({
		src: a.src,
		alt: a.alt || '',
		caption: a.caption || a.alt || '',
	})),
}));

const isPhases = eventPhases.length > 0;
const pageTitle = d.pageTitle || `${d.title} | Marcel David Baroi`;
const pageDescription = d.pageDescription || d.body || d.title;
---

<BaseLayout title={pageTitle} description={pageDescription} isWide alignStart>
	<nav class="attic-crumb font-mono" aria-label="Breadcrumb">
		<a href="/about" class="attic-crumb-link">About</a>
		<span class="attic-crumb-sep" aria-hidden="true">/</span>
		<a href="/archive" class="attic-crumb-link">Archive</a>
		<span class="attic-crumb-sep" aria-hidden="true">/</span>
		<span class="attic-crumb-current">{d.breadcrumbLabel || d.title}</span>
	</nav>

	<header class="about-attic-head">
		<p class="label font-mono about-attic-kicker">{d.heroTag || d.tag}</p>
		<h1 class="about-attic-title">{d.memoirTitle || d.title}</h1>
		{(d.memoirSubtitle || d.subtitle) && <p class="about-attic-lead">{d.memoirSubtitle || d.subtitle}</p>}
		{d.body && <p class="about-principle-body memoir-lead">{d.body}</p>}

		{d.stats && d.stats.length > 0 && (
			<ul class="about-hero-proof memoir-metrics">
				{d.stats.map((stat) => (
					<li>
						<strong>{stat.value}</strong>
						<span>{stat.label}</span>
					</li>
				))}
			</ul>
		)}
	</header>

	{isPhases ? (
		eventPhases.map((phase, idx) => (
			<section class="about-section memoir-band" id={`phase-${idx + 1}`}>
				{phase.phaseTag && <p class="about-rail-tag font-mono">{phase.phaseTag}</p>}
				<h2 class="about-section-title">{phase.headline || phase.phaseTitle}</h2>
				{phase.subtitle && <p class="about-rail-sub">{phase.subtitle}</p>}
				{phase.imageSrc && (
					<figure class="memoir-figure edu-slot">
						<img src={phase.imageSrc} alt={phase.imageAlt || ''} loading="lazy" />
						{phase.imageCaption && <figcaption class="font-mono">{phase.imageCaption}</figcaption>}
					</figure>
				)}
				{(phase.storyParagraphs || []).map((para) => <p class="about-principle-body">{para}</p>)}
				{phase.reflectionQuote && <blockquote class="about-philo-quote">{phase.reflectionQuote}</blockquote>}
			</section>
		))
	) : (
		days.map((day, idx) => (
			<section class="about-section memoir-band" id={`day-${idx + 1}`}>
				{day.dateTag && <p class="about-rail-tag font-mono">{day.dateTag}</p>}
				<h2 class="about-section-title">{day.headline}</h2>
				{day.subtitle && <p class="about-rail-sub">{day.subtitle}</p>}
				{(day.storyParagraphs || []).map((para) => <p class="about-principle-body">{para}</p>)}
				{day.reflectionQuote && <blockquote class="about-philo-quote">{day.reflectionQuote}</blockquote>}
				{day.images && day.images.length > 0 && (
					<div class="memoir-shots">
						{day.images.map((img) => (
							<figure class="memoir-figure edu-slot">
								<img src={img.src} alt={img.alt} loading="lazy" />
								{img.caption && <figcaption class="font-mono">{img.caption}</figcaption>}
							</figure>
						))}
					</div>
				)}
			</section>
		))
	)}

	{(d.pillars || []).length > 0 && (
		<section class="about-section">
			<h2 class="about-section-title">Reflection</h2>
			{(d.pillars || []).map((pillar) => (
				<div class="about-beyond-row">
					<p class="about-beyond-term">{pillar.title || pillar.tag}</p>
					{pillar.desc && <p class="about-beyond-desc">{pillar.desc}</p>}
				</div>
			))}
		</section>
	)}

	<a href="/archive" class="about-return font-mono">← Archive</a>
</BaseLayout>

<style>
	.memoir-lead {
		margin-top: 0.75rem;
	}

	.memoir-metrics {
		border-top: 1px solid rgba(95, 80, 56, 0.12);
		margin-top: 1rem;
	}

	.memoir-band {
		padding-top: 2rem;
	}

	.memoir-figure {
		margin: 1rem 0;
	}

	.memoir-figure img {
		display: block;
		width: 100%;
		max-height: 28rem;
		object-fit: cover;
	}

	.memoir-figure figcaption {
		margin-top: 0.35rem;
		font-size: var(--type-caption);
		color: var(--text-muted);
	}

	.memoir-shots {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 1rem;
		margin-top: 1rem;
	}
</style>
