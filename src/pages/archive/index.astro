---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtticBreadcrumb from '../../components/about/AtticBreadcrumb.astro';
import { getCollection } from 'astro:content';
import { mediaMap, resolveAsset } from '../../lib/media';
import { archiveRailExtras } from '../../data/aboutLayoutDummy';
import '../../styles/about.css';

const map = mediaMap(await getCollection('media'));
const archiveEntries = (await getCollection('archive'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => {
		const d = entry.data;
		const thumbnail = d.thumbnailId ? resolveAsset(d.thumbnailId, map).src : undefined;
		return {
			date: d.tag?.split('//')[1]?.trim() || '[draft] Date',
			tag: d.tag?.split('//')[0]?.trim() || d.tag || '[draft] CIVIC',
			title: d.title,
			subtitle: d.subtitle || '[draft] Archive entry subtitle',
			href: d.dedicatedUrl || '/archive',
			thumbnail,
			body: d.body,
		};
	});

const railEntries = archiveEntries.length >= 3 ? archiveEntries : [...archiveEntries, ...archiveRailExtras];
---

<BaseLayout
	title="Civic Leadership, High-Stakes Operations & Cultural Discipline | Marcel David Baroi"
	description="Civic leadership, high-stakes protocol volunteering, and cultural discipline archives of Marcel David Baroi."
	isWide
	alignStart
>
	<AtticBreadcrumb current="Archive" />

	<header class="about-attic-head">
		<p class="label font-mono about-attic-kicker">Archive</p>
		<h1 class="about-attic-title">Civic years & discipline</h1>
		<p class="about-attic-lead">
			High-stakes civic operations, protocol volunteering, and cultural discipline from collegiate years — not a personal scrapbook.
		</p>
	</header>

	<div class="about-archive-rail">
		{railEntries.map((entry) => (
			<a class="about-rail-row about-archive-row" href={entry.href}>
				<p class="about-rail-when font-mono">{entry.date}</p>
				<div>
					<p class="about-rail-tag font-mono">{entry.tag}</p>
					<h2 class="about-rail-title">{entry.title}</h2>
					<p class="about-rail-sub">{entry.subtitle}</p>
					{entry.thumbnail && (
						<div class="about-shot-fan" aria-hidden="true">
							<img src={entry.thumbnail} alt="" class="about-shot-fan-img" loading="lazy" />
						</div>
					)}
				</div>
			</a>
		))}
	</div>

	<p class="about-archive-beyond font-mono">
		Creative pursuits and hobbies live on <a href="/about#beyond">About → Beyond</a>.
	</p>

	<a href="/about" class="about-return font-mono">← About</a>
</BaseLayout>

<style>
	.about-archive-rail {
		display: flex;
		flex-direction: column;
	}

	.about-archive-row {
		text-decoration: none;
		color: inherit;
	}

	.about-archive-row:hover .about-rail-title {
		color: var(--accent);
	}

	.about-shot-fan {
		margin-top: 0.75rem;
		width: 7.4rem;
	}

	.about-shot-fan-img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border: 1px solid rgba(95, 80, 56, 0.14);
		transform: rotate(-1.5deg);
	}

	.about-archive-beyond {
		margin: 1.5rem 0 0;
		font-size: var(--type-meta);
		color: var(--text-muted);
	}

	.about-archive-beyond a {
		color: var(--accent);
		font-weight: 700;
		text-decoration: none;
	}

	.about-archive-beyond a:hover {
		text-decoration: underline;
	}
</style>
