---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { compactPursuits } from '../../data/aboutData';
import { mediaMap, resolveAsset } from '../../lib/media';

const map = mediaMap(await getCollection('media'));
const archiveEntries = (await getCollection('archive')).sort((a, b) => a.data.order - b.data.order);

const collegeStories = archiveEntries.map((entry) => {
	const d = entry.data;
	const thumbnail = d.thumbnailId ? resolveAsset(d.thumbnailId, map).src : undefined;
	return {
		id: d.id === 'road-safety' ? 'student-movement' : d.id,
		tag: d.tag,
		title: d.title,
		subtitle: d.subtitle,
		icon: d.icon,
		body: d.body,
		dedicatedUrl: d.dedicatedUrl,
		btnText: d.btnText,
		thumbnail
	};
});

const personalPursuits = compactPursuits.map((c) => ({
	title: c.title,
	tag: c.tag,
	desc: c.desc,
	url: c.url,
	icon: c.iconType === 'music' ? '🥁' : c.iconType === 'pen' ? '🎨' : c.iconType === 'theater' ? '🎭' : '🎬'
}));
---

<BaseLayout
	title="Civic Leadership, High-Stakes Operations & Cultural Discipline | Marcel David Baroi"
	description="Civic leadership, high-stakes protocol volunteering, and cultural discipline archives of Marcel David Baroi — Papal Mass security protocol, 2018 road-safety operations, and classical Tabla training."
	isWide={true}
>
	<div class="archive-container">
		<!-- Top Breadcrumb -->
		<nav class="archive-breadcrumb font-mono" aria-label="Breadcrumb">
			<a href="/" class="b-link">Home</a>
			<span class="b-sep">/</span>
			<a href="/about" class="b-link">About</a>
			<span class="b-sep">/</span>
			<span class="b-curr">Civic Leadership & Discipline</span>
		</nav>

		<!-- Hero Banner -->
		<header class="archive-hero card">
			<div class="hero-top-row">
				<span class="archive-tag font-mono">ARCHIVE // LEADERSHIP & DISCIPLINE</span>
				<span class="archive-badge font-mono">EQ · Operations · Craft</span>
			</div>

			<h1 class="archive-title font-dot">Civic Leadership, High-Stakes Operations & Cultural Discipline</h1>
			<p class="archive-tagline">
				<em>Protocol Under Pressure • Civic Accountability • Mathematical Rhythm</em>
			</p>

			<p class="archive-intro">
				Executive framing for culture-fit screeners: core volunteer for Pope Francis 2017 Papal Mass protocol (~100,000 attendees), student-led 2018 road-safety corridor operations, and three years of classical Tabla training in complex mathematical rhythm cycles (Taal). These chapters demonstrate high-stakes teamwork, civic responsibility, and sustained creative discipline — not a personal scrapbook.
			</p>

			<div class="archive-quick-nav font-mono">
				<a href="#college-chapter" class="q-btn">01. High-Stakes Civic Ops</a>
				<a href="#creative-chapter" class="q-btn">02. Cultural Discipline & Craft</a>
				<a href="/education/hsc-science/gallery" class="q-btn">03. Photo Gallery (Archive) ↗</a>
			</div>
		</header>

		<!-- CHAPTER 1: NOTRE DAME COLLEGE -->
		<section id="college-chapter" class="archive-section">
			<div class="section-title-wrap">
				<span class="ch-num font-mono">CHAPTER 01 // 2017 — 2019</span>
				<h2 class="ch-title">High-Stakes Operations & Civic Milestones</h2>
				<p class="ch-desc">
					Transformative collegiate years at Notre Dame College, Dhaka. Rigorous academic discipline, campus camaraderie, and witnessing historic cultural and student-led civic moments.
				</p>
			</div>

			<div class="stories-grid">
				{collegeStories.map((story) => (
					<article class="story-card card" id={story.id}>
						<div class="story-header">
							<span class="story-icon">{story.icon}</span>
							<div class="story-meta">
								<span class="story-tag font-mono">{story.tag}</span>
								<h3 class="story-title">{story.title}</h3>
								<p class="story-sub">{story.subtitle}</p>
							</div>
						</div>
						{story.thumbnail && (
							<div class="story-thumb-wrap">
								<img src={story.thumbnail} alt={story.title} class="story-thumb-img" loading="lazy" />
							</div>
						)}
						<p class="story-body">{story.body}</p>
						{story.dedicatedUrl && (
							<div class="story-action-row">
								<a href={story.dedicatedUrl} class="story-read-btn font-mono">
									<span>{story.btnText || 'Read Full Historical Memoir →'}</span>
								</a>
							</div>
						)}
					</article>
				))}
			</div>
		</section>

		<!-- CHAPTER 2: CREATIVE PURSUITS -->
		<section id="creative-chapter" class="archive-section">
			<div class="section-title-wrap">
				<span class="ch-num font-mono">CHAPTER 02 // BEYOND CODE</span>
				<h2 class="ch-title">Creative Pursuits, Music & Fine Arts</h2>
				<p class="ch-desc">
					Rhythm, illustration, and cinema narrative architecture that bring balance and right-brain creativity to software engineering.
				</p>
			</div>

			<div class="creative-grid">
				{personalPursuits.map((c) => (
					<div class="creative-card card">
						<div class="creative-top">
							<span class="creative-tag font-mono">{c.tag}</span>
							<span class="creative-icon">{c.icon}</span>
						</div>
						<h3 class="creative-title">{c.title}</h3>
						<p class="creative-desc">{c.desc}</p>
						{c.url && (
							<a href={c.url} target="_blank" rel="noopener noreferrer" class="creative-link font-mono">
								<span>View IMDb Profile</span>
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
									<polyline points="15 3 21 3 21 9"></polyline>
									<line x1="10" y1="14" x2="21" y2="3"></line>
								</svg>
							</a>
						)}
					</div>
				))}
			</div>
		</section>

		<!-- Cross Navigation -->
		<div class="archive-cross-nav card">
			<div class="cross-col">
				<span class="cross-lbl font-mono">FORMAL PEDIGREE</span>
				<a href="/education/hsc-science" class="cross-link">← Notre Dame College (HSC Science)</a>
			</div>
			<div class="cross-col">
				<span class="cross-lbl font-mono">EXECUTIVE PROFILE</span>
				<a href="/about" class="cross-link">Return to About Me Profile →</a>
			</div>
			<div class="cross-col">
				<span class="cross-lbl font-mono">SOFTWARE ENGINEERING</span>
				<a href="/work" class="cross-link">Explore Production Work & Case Studies →</a>
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	.archive-container {
		width: 100%;
		max-width: 1080px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 3rem;
		padding: 1rem 1rem 4rem;
		text-align: left;
	}

	/* Breadcrumb */
	.archive-breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.b-link {
		color: var(--text-muted);
		transition: color 0.15s ease;
	}

	.b-link:hover {
		color: var(--accent);
	}

	.b-sep {
		opacity: 0.4;
	}

	.b-curr {
		color: var(--accent);
		font-weight: 600;
	}

	/* Hero Header */
	.archive-hero {
		padding: 2.5rem;
		border-radius: 16px;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		background: linear-gradient(135deg, var(--card-bg) 0%, rgba(180, 33, 53, 0.03) 100%);
		border: 1px solid rgba(180, 33, 53, 0.2);
	}

	.hero-top-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.archive-tag {
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		color: var(--accent);
		font-weight: 700;
	}

	.archive-badge {
		font-size: 0.72rem;
		padding: 0.2rem 0.65rem;
		border-radius: 9999px;
		background: rgba(180, 33, 53, 0.08);
		color: var(--accent);
		border: 1px solid rgba(180, 33, 53, 0.2);
		font-weight: 700;
	}

	.archive-title {
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.15;
		letter-spacing: 0.01em;
	}

	.archive-tagline {
		font-size: 1.05rem;
		color: var(--accent);
		margin-top: -0.5rem;
	}

	.archive-intro {
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--text-muted);
		max-width: 860px;
	}

	.archive-quick-nav {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		padding-top: 0.5rem;
		border-top: 1px dashed rgba(95, 80, 56, 0.15);
	}

	.q-btn {
		font-size: 0.78rem;
		padding: 0.4rem 0.85rem;
		background: rgba(95, 80, 56, 0.06);
		color: var(--text-main);
		border-radius: 6px;
		border: 1px solid rgba(95, 80, 56, 0.12);
		transition: all 0.15s ease;
		font-weight: 600;
	}

	.q-btn:hover {
		background: var(--accent);
		color: #fffdfa;
		border-color: var(--accent);
	}

	.q-btn.highlight-gallery {
		background: rgba(180, 33, 53, 0.1);
		border-color: rgba(180, 33, 53, 0.28);
		color: var(--accent);
		font-weight: 700;
	}

	.q-btn.highlight-gallery:hover {
		background: var(--accent);
		color: #fffdfa;
	}

	/* Sections */
	.archive-section {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.section-title-wrap {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.ch-num {
		font-size: 0.75rem;
		color: var(--accent);
		letter-spacing: 0.08em;
		font-weight: 700;
	}

	.ch-title {
		font-size: clamp(1.35rem, 2.5vw, 1.85rem);
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.3;
	}

	.ch-desc {
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--text-muted);
		max-width: 820px;
	}

	/* Stories Grid */
	.stories-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 850px) {
		.stories-grid {
			grid-template-columns: 1fr;
		}
	}

	.story-card {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		padding: 1.75rem;
		border-radius: 14px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		display: flex;
		flex-direction: column;
		gap: 1rem;
		overflow: hidden;
	}

	.story-header {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
	}

	.story-icon {
		font-size: 1.75rem;
		line-height: 1;
		flex-shrink: 0;
	}

	.story-meta {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.story-tag {
		font-size: 0.68rem;
		color: var(--accent);
		letter-spacing: 0.06em;
		font-weight: 700;
	}

	.story-title {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.35;
	}

	.story-sub {
		font-size: 0.78rem;
		color: var(--text-muted);
		line-height: 1.4;
	}

	.story-thumb-wrap {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid var(--card-border);
		max-height: 220px;
	}

	.story-thumb-img {
		width: 100%;
		max-width: 100%;
		height: auto;
		max-height: 220px;
		object-fit: cover;
		display: block;
	}

	.story-body {
		font-size: 0.86rem;
		line-height: 1.65;
		color: var(--text-muted);
	}

	.story-action-row {
		margin-top: 0.5rem;
		padding-top: 0.85rem;
		border-top: 1px dashed rgba(95, 80, 56, 0.12);
	}

	.story-read-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		padding: 0.35rem 0.75rem;
		border-radius: 6px;
		background: rgba(180, 33, 53, 0.08);
		border: 1px solid rgba(180, 33, 53, 0.2);
		transition: all 0.15s ease;
	}

	.story-read-btn:hover {
		background: var(--accent);
		color: #fffdfa;
		border-color: var(--accent);
		transform: translateX(2px);
	}

	.creative-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 768px) {
		.creative-grid {
			grid-template-columns: 1fr;
		}
	}

	.creative-card {
		padding: 1.5rem;
		border-radius: 12px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.creative-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.creative-tag {
		font-size: 0.68rem;
		color: var(--accent);
		background: rgba(180, 33, 53, 0.08);
		padding: 0.18rem 0.5rem;
		border-radius: 4px;
		font-weight: 700;
	}

	.creative-icon {
		font-size: 1.2rem;
	}

	.creative-title {
		font-size: 1rem;
		font-weight: 700;
		color: var(--text-main);
	}

	.creative-desc {
		font-size: 0.82rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	.creative-link {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: auto;
		padding-top: 0.35rem;
		transition: all 0.15s ease;
	}

	.creative-link:hover {
		color: var(--accent-hover);
		transform: translateX(2px);
	}

	/* Cross Navigation */
	.archive-cross-nav {
		padding: 1.75rem 2rem;
		border-radius: 16px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.cross-col {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.cross-lbl {
		font-size: 0.72rem;
		color: var(--text-muted);
		letter-spacing: 0.05em;
	}

	.cross-link {
		font-size: 0.92rem;
		color: var(--accent);
		font-weight: 700;
		transition: all 0.15s ease;
	}

	.cross-link:hover {
		color: var(--accent-hover);
		transform: translateX(2px);
	}
</style>
