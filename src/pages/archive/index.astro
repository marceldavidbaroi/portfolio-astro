---
import BaseLayout from '../../layouts/BaseLayout.astro';

const collegeStories = [
	{
		id: 'nobin-boron',
		tag: 'ORIENTATION // 2017',
		title: 'Nobin Boron (College Orientation Day)',
		subtitle: 'A Sea of 3,000 Notredamians, Raining Skies, and the Commanding Voice of Tetas Sir',
		icon: '🌱',
		body: `The Nobin Boron (orientation) at Notre Dame College was a mesmerizing, goosebump-inducing introduction to collegiate life. It was pouring rain that morning, and many of us assumed the program would surely start late. But at sharp 9:00 AM on the dot, the commanding, resonant voice of Tetas Sir (Prof. Tetas, Head of the Department of Physics) boomed through the speakers, instantly capturing the absolute silence of over 6,000 attendees.

Standing among 3,000 freshmen, all dressed in the pristine new college uniform with matching transparent college bags and holding flowers, I was left utterly speechless. The choreographic precision, clockwork punctuality, and grand organizational discipline of that morning were unlike anything I had ever witnessed. It was the unforgettable moment I realized what it truly meant to be a Notredamian—a shared memory every alumnus carries with pride.`
	},
	{
		id: 'pope-francis',
		tag: 'HISTORIC EVENT // DEC 2, 2017',
		title: 'Pope Francis Apostolic Visit & International Security Protocol Force',
		subtitle: 'Selected as Core Volunteer for 100,000-Attendee Papal Mass & 10,000-Youth NDC Gathering',
		icon: '🕊️',
		dedicatedUrl: '/archive/pope-francis-visit-2017',
		btnText: 'Read Diplomatic & Protocol Memoir →',
		thumbnail: '/images/archive/pope-francis/pope-francis-notre-dame-college-stage.jpg',
		body: `During Pope Francis's historic apostolic journey to Myanmar and Bangladesh in late 2017 (themed "Harmony and Peace"), I was given the rare honor of being selected as a primary student volunteer. One afternoon, Father Susanto called me and 19 peers using the famed college pink slips to invite us to serve as official volunteers for the 10,000-youth gathering hosted right on the Notre Dame College campus. 

Shortly after, Father Susanto selected 6 of us from that group into the core volunteer force for the main Papal Mass at Ramna Race Course, attended by over 100,000 people. To prepare for this massive global event, we underwent intensive seminars and training sessions over multiple weeks, coordinating with international security details and learning large-scale protocol management. Witnessing global diplomacy, inter-faith harmony, and international event coordination firsthand was one of the most formative milestones of my college life.`
	},
	{
		id: 'student-movement',
		tag: 'CIVIC ENGAGEMENT // JULY 2018',
		title: 'Student-Led Road Safety & Civic Movement',
		subtitle: 'Standing in Solidarity for Transport Reform & Civic Discipline',
		icon: '✊',
		dedicatedUrl: '/archive/road-safety-movement-2018',
		btnText: 'Read Day-by-Day Historical Memoir →',
		thumbnail: '/images/archive/road-safety/03-shapla-chottor-blockade-aerial.jpg',
		body: `On July 29, 2018, following the tragic road incident on Airport Road that took the lives of students Mim and Rajib, students from Notre Dame College, Shaheed Ramiz Uddin, and colleges across Dhaka took to the streets in a peaceful, self-organized movement. Students created dedicated emergency vehicle lanes, verified vehicle licenses, and advocated for strict public transit safety governance. This formative experience ingrained a deep sense of civic duty, ethical accountability, and systemic discipline.`
	},
	{
		id: 'rag-day',
		tag: 'CAMPUS HERITAGE // 2019',
		title: 'Noterdamian Traditions & Bittersweet Farewell',
		subtitle: 'The 8:10 AM Gate Rule, Room 304, and Campus Brotherhood',
		icon: '🏛️',
		body: `Notre Dame College was defined by its legendary discipline—the strict 8:10 AM gate closure, short hair, uniform inspections, and the brotherhood of Batch '19 (Group 13, Room 304) navigating the labyrinth of Harrington Building, Ganguly Building, Father Timm Building, and Fr. Peixotto Building. On the final day, classes concluded not with celebratory chaos, but with heartfelt parting speeches from our mentors and teachers. Leaving Room 304 and stepping through the college gates marked the transition to adulthood and engineering.`
	}
];

const personalPursuits = [
	{
		title: 'Classical Percussion (Tabla)',
		tag: '2015 — 2017 • 3 YEARS FORMAL TRAINING',
		icon: '🥁',
		desc: 'Completed 3 years of classical Tabla training (2015–2017). Mastering classical Indian rhythm cycles (Taal), mathematical subdivisions, tempo accelerations, and polyrhythms instilled structural cadence, timing precision, and deep focus.'
	},
	{
		title: 'Drawing, Fine Arts & Competitions',
		tag: '2014 — 2015 • MULTI-COMPETITION WINNER',
		icon: '🎨',
		desc: 'Formal fine arts and drawing education (2014–2015), winning multiple art and drawing competitions. Mastery of freehand illustration, proportion geometry, and spatial composition directly informs frontend component hierarchy and UI ergonomics.'
	},
	{
		title: 'Role-Play Acting & Community Theatre',
		tag: 'COMMUNITY & CHURCH DRAMA',
		icon: '🎭',
		desc: 'Active participant in numerous role-play acting performances, dramas, and community productions in church programs. Cultivated deep empathetic communication, public vocal presence, and collaborative stage confidence.'
	},
	{
		title: 'Cinema & Screenplay Narrative Structure',
		tag: 'CINEPHILE & NARRATIVE DESIGN',
		icon: '🎬',
		desc: 'Avid cinephile analyzing global cinema, cinematography, and narrative pacing—drawing parallels between screenwriting structural coherence, systemic invariants, and enterprise domain stability.',
		url: 'https://www.imdb.com/user/p.bk6ud655mqlvdqktibh2swwdzm?ref_=ext_shr_lnk'
	}
];
---

<BaseLayout
	title="Personal Archives & Formative Journey | Marcel David Baroi"
	description="Personal archives, college memories from Notre Dame College (2017–2019), and creative pursuits of Marcel David Baroi."
	isWide={true}
>
	<div class="archive-container">
		<!-- Top Breadcrumb -->
		<nav class="archive-breadcrumb font-mono" aria-label="Breadcrumb">
			<a href="/" class="b-link">Home</a>
			<span class="b-sep">/</span>
			<a href="/about" class="b-link">About</a>
			<span class="b-sep">/</span>
			<span class="b-curr">Personal Archives & Journey</span>
		</nav>

		<!-- Hero Banner -->
		<header class="archive-hero card">
			<div class="hero-top-row">
				<span class="archive-tag font-mono">ARCHIVE // 2017 — 2024</span>
				<span class="archive-badge font-mono">Formative Chapters</span>
			</div>

			<h1 class="archive-title font-dot">Personal Archives & Formative Journey</h1>
			<p class="archive-tagline">
				<em>Programmer • Learner • Mentor</em>
			</p>

			<p class="archive-intro">
				A preserved chronicling of defining moments, collegiate heritage at Notre Dame College (2017–2019), and the creative pursuits that shaped my engineering mindset.
			</p>

			<div class="archive-quick-nav font-mono">
				<a href="#college-chapter" class="q-btn">01. College Chapter (NDC)</a>
				<a href="#creative-chapter" class="q-btn">02. Creative Dimensions & Fine Arts</a>
				<a href="/education/hsc-science/gallery" class="q-btn highlight-gallery">03. Full NDC Photo Gallery (75+ Photos) ↗</a>
			</div>
		</header>

		<!-- CHAPTER 1: NOTRE DAME COLLEGE -->
		<section id="college-chapter" class="archive-section">
			<div class="section-title-wrap">
				<span class="ch-num font-mono">CHAPTER 01 // 2017 — 2019</span>
				<h2 class="ch-title">Notre Dame College Memories & Civic Milestones</h2>
				<p class="ch-desc">
					Transformative collegiate years at Notre Dame College, Dhaka. Rigorous academic discipline, campus camaraderie, and witnessing historic cultural and student-led civic moments.
				</p>
			</div>

			<div class="stories-grid">
				{collegeStories.map((story) => (
					<article class="story-card card" id={story.id}>
						<div class="story-header">
							<span class="story-icon">{story.icon}</span>
							<div class="story-meta">
								<span class="story-tag font-mono">{story.tag}</span>
								<h3 class="story-title">{story.title}</h3>
								<p class="story-sub">{story.subtitle}</p>
							</div>
						</div>
						{story.thumbnail && (
							<div class="story-thumb-wrap">
								<img src={story.thumbnail} alt={story.title} class="story-thumb-img" loading="lazy" />
							</div>
						)}
						<p class="story-body">{story.body}</p>
						{story.dedicatedUrl && (
							<div class="story-action-row">
								<a href={story.dedicatedUrl} class="story-read-btn font-mono">
									<span>{story.btnText || 'Read Full Historical Memoir →'}</span>
								</a>
							</div>
						)}
					</article>
				))}
			</div>
		</section>

		<!-- CHAPTER 2: CREATIVE PURSUITS -->
		<section id="creative-chapter" class="archive-section">
			<div class="section-title-wrap">
				<span class="ch-num font-mono">CHAPTER 02 // BEYOND CODE</span>
				<h2 class="ch-title">Creative Pursuits, Music & Fine Arts</h2>
				<p class="ch-desc">
					Rhythm, illustration, and cinema narrative architecture that bring balance and right-brain creativity to software engineering.
				</p>
			</div>

			<div class="creative-grid">
				{personalPursuits.map((c) => (
					<div class="creative-card card">
						<div class="creative-top">
							<span class="creative-tag font-mono">{c.tag}</span>
							<span class="creative-icon">{c.icon}</span>
						</div>
						<h3 class="creative-title">{c.title}</h3>
						<p class="creative-desc">{c.desc}</p>
						{c.url && (
							<a href={c.url} target="_blank" rel="noopener noreferrer" class="creative-link font-mono">
								<span>View IMDb Profile</span>
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
									<polyline points="15 3 21 3 21 9"></polyline>
									<line x1="10" y1="14" x2="21" y2="3"></line>
								</svg>
							</a>
						)}
					</div>
				))}
			</div>
		</section>

		<!-- Cross Navigation -->
		<div class="archive-cross-nav card">
			<div class="cross-col">
				<span class="cross-lbl font-mono">FORMAL PEDIGREE</span>
				<a href="/education/hsc-science" class="cross-link">← Notre Dame College (HSC Science)</a>
			</div>
			<div class="cross-col">
				<span class="cross-lbl font-mono">EXECUTIVE PROFILE</span>
				<a href="/about" class="cross-link">Return to About Me Profile →</a>
			</div>
			<div class="cross-col">
				<span class="cross-lbl font-mono">SOFTWARE ENGINEERING</span>
				<a href="/work" class="cross-link">Explore Production Work & Case Studies →</a>
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	.archive-container {
		width: 100%;
		max-width: 1080px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 3rem;
		padding: 1rem 1rem 4rem;
		text-align: left;
	}

	/* Breadcrumb */
	.archive-breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.b-link {
		color: var(--text-muted);
		transition: color 0.15s ease;
	}

	.b-link:hover {
		color: var(--accent);
	}

	.b-sep {
		opacity: 0.4;
	}

	.b-curr {
		color: var(--accent);
		font-weight: 600;
	}

	/* Hero Header */
	.archive-hero {
		padding: 2.5rem;
		border-radius: 16px;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		background: linear-gradient(135deg, var(--card-bg) 0%, rgba(180, 33, 53, 0.03) 100%);
		border: 1px solid rgba(180, 33, 53, 0.2);
	}

	.hero-top-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.archive-tag {
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		color: var(--accent);
		font-weight: 700;
	}

	.archive-badge {
		font-size: 0.72rem;
		padding: 0.2rem 0.65rem;
		border-radius: 9999px;
		background: rgba(180, 33, 53, 0.08);
		color: var(--accent);
		border: 1px solid rgba(180, 33, 53, 0.2);
		font-weight: 700;
	}

	.archive-title {
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.15;
		letter-spacing: 0.01em;
	}

	.archive-tagline {
		font-size: 1.05rem;
		color: var(--accent);
		margin-top: -0.5rem;
	}

	.archive-intro {
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--text-muted);
		max-width: 860px;
	}

	.archive-quick-nav {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		padding-top: 0.5rem;
		border-top: 1px dashed rgba(95, 80, 56, 0.15);
	}

	.q-btn {
		font-size: 0.78rem;
		padding: 0.4rem 0.85rem;
		background: rgba(95, 80, 56, 0.06);
		color: var(--text-main);
		border-radius: 6px;
		border: 1px solid rgba(95, 80, 56, 0.12);
		transition: all 0.15s ease;
		font-weight: 600;
	}

	.q-btn:hover {
		background: var(--accent);
		color: #fffdfa;
		border-color: var(--accent);
	}

	.q-btn.highlight-gallery {
		background: rgba(180, 33, 53, 0.1);
		border-color: rgba(180, 33, 53, 0.28);
		color: var(--accent);
		font-weight: 700;
	}

	.q-btn.highlight-gallery:hover {
		background: var(--accent);
		color: #fffdfa;
	}

	/* Sections */
	.archive-section {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.section-title-wrap {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.ch-num {
		font-size: 0.75rem;
		color: var(--accent);
		letter-spacing: 0.08em;
		font-weight: 700;
	}

	.ch-title {
		font-size: clamp(1.35rem, 2.5vw, 1.85rem);
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.3;
	}

	.ch-desc {
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--text-muted);
		max-width: 820px;
	}

	/* Stories Grid */
	.stories-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 850px) {
		.stories-grid {
			grid-template-columns: 1fr;
		}
	}

	.story-card {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		padding: 1.75rem;
		border-radius: 14px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		display: flex;
		flex-direction: column;
		gap: 1rem;
		overflow: hidden;
	}

	.story-header {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
	}

	.story-icon {
		font-size: 1.75rem;
		line-height: 1;
		flex-shrink: 0;
	}

	.story-meta {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.story-tag {
		font-size: 0.68rem;
		color: var(--accent);
		letter-spacing: 0.06em;
		font-weight: 700;
	}

	.story-title {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.35;
	}

	.story-sub {
		font-size: 0.78rem;
		color: var(--text-muted);
		line-height: 1.4;
	}

	.story-thumb-wrap {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid var(--card-border);
		max-height: 220px;
	}

	.story-thumb-img {
		width: 100%;
		max-width: 100%;
		height: auto;
		max-height: 220px;
		object-fit: cover;
		display: block;
	}

	.story-body {
		font-size: 0.86rem;
		line-height: 1.65;
		color: var(--text-muted);
	}

	.story-action-row {
		margin-top: 0.5rem;
		padding-top: 0.85rem;
		border-top: 1px dashed rgba(95, 80, 56, 0.12);
	}

	.story-read-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		padding: 0.35rem 0.75rem;
		border-radius: 6px;
		background: rgba(180, 33, 53, 0.08);
		border: 1px solid rgba(180, 33, 53, 0.2);
		transition: all 0.15s ease;
	}

	.story-read-btn:hover {
		background: var(--accent);
		color: #fffdfa;
		border-color: var(--accent);
		transform: translateX(2px);
	}

	.creative-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 768px) {
		.creative-grid {
			grid-template-columns: 1fr;
		}
	}

	.creative-card {
		padding: 1.5rem;
		border-radius: 12px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.creative-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.creative-tag {
		font-size: 0.68rem;
		color: var(--accent);
		background: rgba(180, 33, 53, 0.08);
		padding: 0.18rem 0.5rem;
		border-radius: 4px;
		font-weight: 700;
	}

	.creative-icon {
		font-size: 1.2rem;
	}

	.creative-title {
		font-size: 1rem;
		font-weight: 700;
		color: var(--text-main);
	}

	.creative-desc {
		font-size: 0.82rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	.creative-link {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: auto;
		padding-top: 0.35rem;
		transition: all 0.15s ease;
	}

	.creative-link:hover {
		color: var(--accent-hover);
		transform: translateX(2px);
	}

	/* Cross Navigation */
	.archive-cross-nav {
		padding: 1.75rem 2rem;
		border-radius: 16px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.cross-col {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.cross-lbl {
		font-size: 0.72rem;
		color: var(--text-muted);
		letter-spacing: 0.05em;
	}

	.cross-link {
		font-size: 0.92rem;
		color: var(--accent);
		font-weight: 700;
		transition: all 0.15s ease;
	}

	.cross-link:hover {
		color: var(--accent-hover);
		transform: translateX(2px);
	}
</style>
