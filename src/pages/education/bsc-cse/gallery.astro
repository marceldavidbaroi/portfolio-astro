---
import GalleryPage from '../../../components/GalleryPage.astro';
import { getEntry } from 'astro:content';

const gallery = await getEntry('galleries', 'bsc-cse');
const title = gallery?.data.title || 'Daffodil International University — Gallery';
const photos: { src: string; caption: string }[] = [];
---

<GalleryPage
	title={title}
	backHref="/education/bsc-cse"
	backLabel="B.Sc. CSE"
	tag="Gallery"
	description="Campus and academic photo gallery for DIU CSE Batch 55."
	photos={photos}
	emptyHint='Photos coming soon — drop files in <code>public/images/education/</code>.'
	crumb="school"
/>
