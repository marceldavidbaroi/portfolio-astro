---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { mediaMap, resolveAssets } from '../../../lib/media';
import '../../../styles/about.css';
import '../../../styles/education.css';

const galleryEntry = await getEntry('galleries', 'hsc-science');
if (!galleryEntry) throw new Error('Missing galleries/hsc-science');

const map = mediaMap(await getCollection('media'));
const galleries = galleryEntry.data.albums.map((album) => {
	const assets = resolveAssets(
		album.photos.map((p) => p.id),
		map
	);
	return {
		id: album.id,
		tag: album.tag,
		title: album.title,
		desc: album.description,
		memoirLink: album.memoirHref,
		photos: album.photos.map((p, i) => ({
			src: assets[i].src,
			title: assets[i].title,
			caption: assets[i].caption || '',
			alt: assets[i].alt,
			span: p.span,
			isEmblem: p.isEmblem
		}))
	};
});
---

<BaseLayout
	title="Notre Dame College Photo Gallery & Memoirs | Marcel David Baroi"
	description="Photo gallery, student brotherhood, and chronicled memories from Notre Dame College (HSC Science Batch '19, Group 13) by Marcel David Baroi."
	isWide
	alignStart
>
	<div class="hsc-gallery-page">
		<nav class="attic-crumb font-mono" aria-label="Breadcrumb">
			<a href="/about" class="attic-crumb-link">About</a>
			<span class="attic-crumb-sep" aria-hidden="true">/</span>
			<a href="/about#school" class="attic-crumb-link">School</a>
			<span class="attic-crumb-sep" aria-hidden="true">/</span>
			<span class="attic-crumb-current">Gallery</span>
		</nav>

		<header class="about-attic-head">
			<p class="label font-mono about-attic-kicker">Gallery</p>
			<h1 class="about-attic-title">Notre Dame College photo archive</h1>
			<p class="about-attic-lead">
				Visual chronicles of campus brotherhood, historic papal visits, and the 2018 civic movements. Batch '19 · Group 13.
			</p>
		</header>

		<div class="hsc-gallery-sections">
			{galleries.map((section) => (
				<section class="hsc-gallery-section" id={section.id}>
					<header class="hsc-gallery-section-head">
						<div>
							<p class="label font-mono">{section.tag}</p>
							<h2 class="edu-section-title">{section.title}</h2>
							<p class="edu-body-text">{section.desc}</p>
						</div>
						{section.memoirLink && (
							<a href={section.memoirLink} class="text-link font-mono">Read memoir →</a>
						)}
					</header>

					<div class="hsc-gallery-grid">
						{section.photos.map((photo) => (
							<figure
								class:list={[
									'hsc-gallery-item',
									photo.span === 'full' && 'hsc-gallery-item--full',
									photo.span === 'wide' && 'hsc-gallery-item--wide'
								]}
								data-spotlight-src={photo.src}
								data-spotlight-title={photo.title || section.title}
								data-spotlight-caption={photo.caption}
							>
								<button
									type="button"
									class="hsc-gallery-shot"
									aria-label={`View ${photo.title || section.title}`}
								>
									<img
										src={photo.src}
										alt={photo.alt || photo.title || 'Notre Dame College photo'}
										class:list={['hsc-gallery-img', photo.isEmblem && 'is-emblem']}
										loading="lazy"
									/>
								</button>
								{section.id !== 'ndc-visit-dec-2018' && section.id !== 'ndc-college-memories' && (
									<figcaption class="font-mono">
										{photo.title && <strong>{photo.title}</strong>}
										{photo.caption && <span>{photo.caption}</span>}
									</figcaption>
								)}
							</figure>
						))}
					</div>
				</section>
			))}
		</div>

		<div id="gallery-spotlight-modal" class="hsc-spotlight" aria-hidden="true" role="dialog">
			<div class="hsc-spotlight-backdrop" id="spotlight-backdrop"></div>
			<div class="hsc-spotlight-panel">
				<button class="hsc-spotlight-close font-mono" id="spotlight-close" type="button" aria-label="Close">Close</button>
				<button class="hsc-spotlight-nav prev font-mono" id="spotlight-prev" type="button" aria-label="Previous photo">←</button>
				<div class="hsc-spotlight-stage">
					<img id="spotlight-img" src="" alt="" class="hsc-spotlight-img" />
					<div class="hsc-spotlight-meta">
						<div>
							<h3 id="spotlight-title" class="hsc-spotlight-title"></h3>
							<p id="spotlight-desc" class="hsc-spotlight-caption font-mono"></p>
						</div>
						<span id="spotlight-counter" class="hsc-spotlight-counter font-mono"></span>
					</div>
				</div>
				<button class="hsc-spotlight-nav next font-mono" id="spotlight-next" type="button" aria-label="Next photo">→</button>
			</div>
		</div>

		<nav class="edu-text-nav font-mono" aria-label="Gallery navigation">
			<a href="/education/hsc-science" class="text-link">← HSC Science overview</a>
			<a href="/archive" class="text-link">Personal archives →</a>
			<a href="/education/bsc-cse" class="text-link">B.Sc. CSE →</a>
		</nav>
	</div>

	<script>
		function initSpotlight() {
			const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-spotlight-src]'));
			const modal = document.getElementById('gallery-spotlight-modal');
			const backdrop = document.getElementById('spotlight-backdrop');
			const closeBtn = document.getElementById('spotlight-close');
			const prevBtn = document.getElementById('spotlight-prev');
			const nextBtn = document.getElementById('spotlight-next');
			const spotImg = document.getElementById('spotlight-img') as HTMLImageElement | null;
			const spotTitle = document.getElementById('spotlight-title');
			const spotDesc = document.getElementById('spotlight-desc');
			const spotCounter = document.getElementById('spotlight-counter');

			if (!modal || !spotImg || cards.length === 0) return;

			let currentIndex = 0;

			function openSpotlight(index: number) {
				currentIndex = (index + cards.length) % cards.length;
				const card = cards[currentIndex];
				const src = card.dataset.spotlightSrc || '';
				const title = card.dataset.spotlightTitle || '';
				const caption = card.dataset.spotlightCaption || '';

				spotImg.src = src;
				spotImg.alt = title || caption || 'Gallery photo';
				if (spotTitle) spotTitle.textContent = title;
				if (spotDesc) spotDesc.textContent = caption;
				if (spotCounter) spotCounter.textContent = `${currentIndex + 1} / ${cards.length}`;

				modal.classList.add('is-open');
				modal.setAttribute('aria-hidden', 'false');
				document.body.style.overflow = 'hidden';
			}

			function closeSpotlight() {
				modal.classList.remove('is-open');
				modal.setAttribute('aria-hidden', 'true');
				document.body.style.overflow = '';
				spotImg.src = '';
			}

			cards.forEach((card, idx) => {
				const trigger = card.querySelector('button') || card;
				trigger.addEventListener('click', () => openSpotlight(idx));
				card.addEventListener('keydown', (e) => {
					if ((e as KeyboardEvent).key === 'Enter') openSpotlight(idx);
				});
			});

			closeBtn?.addEventListener('click', closeSpotlight);
			backdrop?.addEventListener('click', closeSpotlight);
			nextBtn?.addEventListener('click', () => openSpotlight(currentIndex + 1));
			prevBtn?.addEventListener('click', () => openSpotlight(currentIndex - 1));

			window.addEventListener('keydown', (e) => {
				if (!modal.classList.contains('is-open')) return;
				if (e.key === 'Escape') closeSpotlight();
				if (e.key === 'ArrowRight') openSpotlight(currentIndex + 1);
				if (e.key === 'ArrowLeft') openSpotlight(currentIndex - 1);
			});
		}

		initSpotlight();
		document.addEventListener('astro:page-load', initSpotlight);
	</script>
</BaseLayout>

<style>
	.hsc-gallery-page {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		padding: 0 0 4rem;
	}

	.hsc-gallery-sections {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.hsc-gallery-section {
		padding: 2rem 0 0;
		border-top: 1px solid rgba(95, 80, 56, 0.12);
	}

	.hsc-gallery-section-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem 1.5rem;
		margin-bottom: 1.25rem;
	}

	.hsc-gallery-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
		background: rgba(95, 80, 56, 0.12);
		border: 1px solid rgba(95, 80, 56, 0.12);
	}

	.hsc-gallery-item--full,
	.hsc-gallery-item--wide {
		grid-column: 1 / -1;
	}

	.hsc-gallery-item {
		background: var(--paper);
	}

	.hsc-gallery-shot {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: var(--paper);
		cursor: pointer;
		border-radius: 0;
		box-shadow: none;
	}

	.hsc-gallery-img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.hsc-gallery-img.is-emblem {
		object-fit: contain;
		background: var(--paper);
		padding: 1rem;
	}

	.hsc-gallery-item figcaption {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		margin-top: 0.35rem;
		font-size: var(--type-caption);
		color: var(--text-muted);
	}

	.hsc-gallery-item figcaption strong {
		color: var(--text-main);
		font-weight: 600;
	}

	.hsc-spotlight {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}

	.hsc-spotlight.is-open {
		opacity: 1;
		pointer-events: auto;
	}

	.hsc-spotlight-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(43, 37, 30, 0.9);
	}

	.hsc-spotlight-panel {
		position: relative;
		z-index: 1;
		width: min(100%, 1100px);
		padding: 1rem;
		box-sizing: border-box;
	}

	.hsc-spotlight-close {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		border: 0;
		background: transparent;
		color: var(--paper);
		cursor: pointer;
		font-size: var(--type-caption);
	}

	.hsc-spotlight-nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		border: 0;
		background: transparent;
		color: var(--paper);
		font-size: 1.25rem;
		cursor: pointer;
		padding: 0.5rem;
	}

	.hsc-spotlight-nav.prev {
		left: 0;
	}

	.hsc-spotlight-nav.next {
		right: 0;
	}

	.hsc-spotlight-stage {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		padding: 0 2.5rem;
	}

	.hsc-spotlight-img {
		max-width: 100%;
		max-height: 72vh;
		object-fit: contain;
	}

	.hsc-spotlight-meta {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		color: var(--paper);
	}

	.hsc-spotlight-title {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 700;
	}

	.hsc-spotlight-caption {
		margin: 0.2rem 0 0;
		font-size: var(--type-caption);
		color: rgba(255, 252, 248, 0.75);
	}

	.hsc-spotlight-counter {
		flex-shrink: 0;
		font-size: var(--type-caption);
		color: rgba(255, 252, 248, 0.85);
	}

	@media (max-width: 900px) {
		.hsc-gallery-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
