---
import '../../styles/education.css';
import '../../styles/about.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EduBreadcrumb from '../../components/education/EduBreadcrumb.astro';
import EduHero from '../../components/education/EduHero.astro';
import EduBody from '../../components/education/EduBody.astro';
import EduCrossNav from '../../components/education/EduCrossNav.astro';
import { getCollection, getEntry } from 'astro:content';
import { getAcademicStatistics, type Semester } from '../../lib/education';

export async function getStaticPaths() {
	const entries = await getCollection('education');
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry }
	}));
}

const { entry } = Astro.props;
const program = entry.data;
const isBsc = program.id === 'bsc-cse';
const bscCseProgram = isBsc ? program : (await getEntry('education', 'bsc-cse'))?.data;
const hscScienceProgram = !isBsc ? program : (await getEntry('education', 'hsc-science'))?.data;
if (!bscCseProgram || !hscScienceProgram) throw new Error('Missing education entries');

const stats = getAcademicStatistics((bscCseProgram.semesters || []) as Semester[]);

const pageTitle = isBsc
	? `${bscCseProgram.degree} | Academic Transcript`
	: `${hscScienceProgram.degree} | Academic Background`;

const pageDesc = isBsc
	? `Official curriculum, 11-semester transcript, course breakdowns, and academic honors for ${bscCseProgram.degree} at ${bscCseProgram.institution}.`
	: `Foundational science curriculum, Higher Mathematics, Physics, Chemistry, and academic credentials at ${hscScienceProgram.institution}.`;
---

<BaseLayout title={pageTitle} description={pageDesc} isWide alignStart>
	<div class="edu-detail-container">
		<EduBreadcrumb isBsc={isBsc} />
		<EduHero isBsc={isBsc} bscCseProgram={bscCseProgram} hscScienceProgram={hscScienceProgram} />
		<EduBody isBsc={isBsc} bscCseProgram={bscCseProgram} hscScienceProgram={hscScienceProgram} />
		<EduCrossNav isBsc={isBsc} />
	</div>
</BaseLayout>
