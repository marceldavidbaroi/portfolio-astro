---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtticBreadcrumb from '../../components/about/AtticBreadcrumb.astro';
import { getCollection } from 'astro:content';
import '../../styles/about.css';

const principles = (await getCollection('philosophy'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((e) => e.data);
---

<BaseLayout
	title="Engineering Philosophy & System Architecture | Marcel David Baroi"
	description="Core architectural principles, AI synthesis workflows, data safety standards, and engineering methodology of Marcel David Baroi."
	isWide
	alignStart
>
	<AtticBreadcrumb current="Philosophy" />

	<header class="about-attic-head">
		<p class="label font-mono about-attic-kicker">Philosophy</p>
		<h1 class="about-attic-title">Engineering principles</h1>
		<p class="about-attic-lead">
			Four foundational paradigms governing architecture-first synthesis, zero-trust data layers, modular reusability, and measurable velocity.
		</p>
	</header>

	{principles.map((p) => (
			<section class="about-section about-philo-band philo-reveal" id={`principle-${p.num}`}>
				<article class="about-principle-row about-philo-band-head">
					<p class="about-principle-num font-mono">{p.num}</p>
					<div>
						<h2 class="about-principle-title">{p.title}</h2>
						{p.subtitle && <p class="about-philo-subtitle">{p.subtitle}</p>}
					</div>
				</article>
				{p.pullQuote && <blockquote class="about-philo-quote">"{p.pullQuote}"</blockquote>}
				<p class="about-principle-body">{p.desc}</p>
				{p.mermaid && (
					<div class="about-philo-slot">
						<pre class="language-mermaid"><code class="language-mermaid">{p.mermaid}</code></pre>
					</div>
				)}
				{p.proofLinks && p.proofLinks.length > 0 && (
					<p class="about-philo-proofs font-mono">
						{p.proofLinks.map((link) => (
							<a href={link.href} class="about-principle-proof">{link.label}</a>
						))}
					</p>
				)}
			</section>
		))}

	<nav class="about-philo-exits font-mono philo-reveal" aria-label="Related pages">
		<a href="/about" class="text-link">← About</a>
		<a href="/skills" class="text-link">Skills →</a>
		<a href="/work" class="text-link">Work →</a>
	</nav>
</BaseLayout>

<script>
	async function initMermaid() {
		const codeBlocks = Array.from(document.querySelectorAll('pre.language-mermaid, code.language-mermaid'));
		const uniquePres = new Set<HTMLElement>();
		codeBlocks.forEach((el) => {
			const pre = el.tagName === 'PRE' ? el : el.closest('pre');
			if (pre instanceof HTMLElement) uniquePres.add(pre);
		});

		if (uniquePres.size === 0) return;

		const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs');
		mermaid.initialize({
			startOnLoad: false,
			theme: 'base',
			securityLevel: 'loose',
			themeVariables: {
				primaryColor: '#f4f0e7',
				primaryTextColor: '#2b251e',
				primaryBorderColor: '#84353f',
				lineColor: '#5f5038',
				secondaryColor: '#fffcf8',
				tertiaryColor: '#ede7da',
				fontFamily: "'Plus Jakarta Sans', sans-serif",
			},
		});

		for (const pre of uniquePres) {
			const code = pre.querySelector('code')?.textContent || pre.textContent || '';
			const diagramDiv = document.createElement('div');
			diagramDiv.className = 'mermaid';
			diagramDiv.textContent = code.trim();
			pre.replaceWith(diagramDiv);
		}

		await mermaid.run();
	}

	function initPhiloReveal() {
		const revealElements = document.querySelectorAll<HTMLElement>('.philo-reveal');
		if (!revealElements.length) return;

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
			revealElements.forEach((el) => el.classList.add('is-revealed'));
			return;
		}

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-revealed');
						observer.unobserve(entry.target);
					}
				});
			},
			{
				root: null,
				rootMargin: '0px 0px -40px 0px',
				threshold: 0.08,
			}
		);

		revealElements.forEach((el) => {
			if (!el.classList.contains('is-revealed')) {
				observer.observe(el);
			}
		});
	}

	function setupPage() {
		initMermaid();
		initPhiloReveal();
	}

	setupPage();
	document.addEventListener('astro:page-load', setupPage);
</script>

<style>
	/* 1. Editorial Principle Block Reveal */
	.philo-reveal {
		opacity: 0;
		transform: translateY(18px);
		transition:
			opacity var(--dur-enter, 600ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
			transform var(--dur-enter, 600ms) var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
		will-change: opacity, transform;
	}

	.philo-reveal.is-revealed {
		opacity: 1;
		transform: translateY(0);
	}

	.about-philo-band-head {
		border-top: 0;
		padding-top: 0;
	}

	.about-philo-subtitle {
		margin: 0.25rem 0 0;
		font-size: var(--type-meta);
		color: var(--text-muted);
	}

	/* 2. Pull-Quote Hairline Expansion */
	.about-philo-quote {
		position: relative;
		margin: 0 0 0.85rem;
		padding-left: 1rem;
		font-size: var(--type-xyz);
		line-height: 1.55;
		color: var(--text-main);
		font-style: italic;
	}

	.about-philo-quote::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		width: 2px;
		height: 0;
		background: rgba(var(--accent-rgb), 0.55);
		transition: height 650ms var(--ease-out);
		will-change: height;
	}

	.is-revealed .about-philo-quote::before {
		height: 100%;
	}

	/* 3. Mermaid Diagram Gentle Illumination */
	.about-philo-slot {
		margin: 1rem 0;
		padding: 1.25rem;
		background: var(--card-bg);
		border: 1px solid rgba(95, 80, 56, 0.12);
		overflow-x: auto;
		transition:
			border-color 450ms var(--ease-out),
			box-shadow 450ms var(--ease-out);
	}

	.is-revealed .about-philo-slot {
		animation: philoSlotGlow 1.6s var(--ease-out) 200ms 1 normal forwards;
	}

	@keyframes philoSlotGlow {
		0% {
			border-color: rgba(95, 80, 56, 0.12);
			box-shadow: 0 0 0 transparent;
		}
		40% {
			border-color: rgba(var(--accent-rgb), 0.45);
			box-shadow: 0 0 16px rgba(var(--accent-rgb), 0.12);
		}
		100% {
			border-color: rgba(95, 80, 56, 0.16);
			box-shadow: 0 0 0 transparent;
		}
	}

	.about-philo-slot pre {
		margin: 0;
		background: transparent !important;
		border-radius: 0 !important;
		box-shadow: none !important;
		border: 0 !important;
		padding: 0 !important;
	}

	.about-philo-proofs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		margin: 0.5rem 0 0;
	}

	.about-philo-exits {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		margin: 2.5rem 0 1rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.philo-reveal {
			opacity: 1 !important;
			transform: none !important;
			transition: none !important;
		}

		.about-philo-quote::before {
			height: 100% !important;
			transition: none !important;
		}

		.is-revealed .about-philo-slot {
			animation: none !important;
		}
	}
</style>
