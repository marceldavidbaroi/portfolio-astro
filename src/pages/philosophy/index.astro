---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtticBreadcrumb from '../../components/about/AtticBreadcrumb.astro';
import { getCollection } from 'astro:content';
import { philosophyBandExtras } from '../../data/aboutLayoutDummy';
import '../../styles/about.css';

const principles = (await getCollection('philosophy'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((e) => e.data);

function bandExtra(num: string) {
	return philosophyBandExtras.find((b) => b.principleNum === num);
}
---

<BaseLayout
	title="Engineering Philosophy & System Architecture | Marcel David Baroi"
	description="Core architectural principles, AI synthesis workflows, data safety standards, and engineering methodology of Marcel David Baroi."
	isWide
	alignStart
>
	<AtticBreadcrumb current="Philosophy" />

	<header class="about-attic-head">
		<p class="label font-mono about-attic-kicker">Philosophy</p>
		<h1 class="about-attic-title">Engineering principles</h1>
		<p class="about-attic-lead">
			Four foundational paradigms governing architecture-first synthesis, zero-trust data layers, modular reusability, and measurable velocity.
		</p>
	</header>

	{principles.map((p) => {
		const extra = bandExtra(p.num);
		const mermaid = p.mermaid || extra?.mermaid || 'flowchart LR\n  A["[draft]"] --> B["[draft]"]';
		const proofLinks = p.proofLinks?.length
			? p.proofLinks
			: extra
				? [{ href: extra.proofHref, label: extra.proofLabel }]
				: [];
		return (
			<section class="about-section about-philo-band" id={`principle-${p.num}`}>
				<article class="about-principle-row about-philo-band-head">
					<p class="about-principle-num font-mono">{p.num}</p>
					<div>
						<h2 class="about-principle-title">{p.title}</h2>
						{(p.subtitle || extra?.subtitle) && (
							<p class="about-philo-subtitle">{p.subtitle || extra?.subtitle}</p>
						)}
					</div>
				</article>
				{p.pullQuote && <blockquote class="about-philo-quote">"{p.pullQuote}"</blockquote>}
				<p class="about-principle-body">{p.desc}</p>
				<div class="about-philo-slot">
					<pre class="language-mermaid"><code class="language-mermaid">{mermaid}</code></pre>
				</div>
				{proofLinks.length > 0 && (
					<p class="about-philo-proofs font-mono">
						{proofLinks.map((link) => (
							<a href={link.href} class="about-principle-proof">{link.label}</a>
						))}
					</p>
				)}
			</section>
		);
	})}

	<nav class="about-philo-exits font-mono" aria-label="Related pages">
		<a href="/about" class="text-link">← About</a>
		<a href="/skills" class="text-link">Skills →</a>
		<a href="/work" class="text-link">Work →</a>
	</nav>
</BaseLayout>

<script>
	async function initMermaid() {
		const codeBlocks = Array.from(document.querySelectorAll('pre.language-mermaid, code.language-mermaid'));
		const uniquePres = new Set<HTMLElement>();
		codeBlocks.forEach((el) => {
			const pre = el.tagName === 'PRE' ? el : el.closest('pre');
			if (pre instanceof HTMLElement) uniquePres.add(pre);
		});

		if (uniquePres.size === 0) return;

		const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs');
		mermaid.initialize({
			startOnLoad: false,
			theme: 'base',
			securityLevel: 'loose',
			themeVariables: {
				primaryColor: '#f4f0e7',
				primaryTextColor: '#2b251e',
				primaryBorderColor: '#b42135',
				lineColor: '#5f5038',
				secondaryColor: '#fffdfa',
				tertiaryColor: '#ede7da',
				fontFamily: 'Geist, sans-serif',
			},
		});

		for (const pre of uniquePres) {
			const code = pre.querySelector('code')?.textContent || pre.textContent || '';
			const diagramDiv = document.createElement('div');
			diagramDiv.className = 'mermaid';
			diagramDiv.textContent = code.trim();
			pre.replaceWith(diagramDiv);
		}

		await mermaid.run();
	}

	initMermaid();
	document.addEventListener('astro:page-load', initMermaid);
</script>

<style>
	.about-philo-band-head {
		border-top: 0;
		padding-top: 0;
	}

	.about-philo-subtitle {
		margin: 0.25rem 0 0;
		font-size: var(--type-meta);
		color: var(--text-muted);
	}

	.about-philo-quote {
		margin: 0 0 0.85rem;
		padding-left: 1rem;
		border-left: 2px solid rgba(180, 33, 53, 0.35);
		font-size: var(--type-xyz);
		line-height: 1.55;
		color: var(--text-main);
		font-style: italic;
	}

	.about-philo-slot {
		margin: 1rem 0;
		padding: 1.25rem;
		background: var(--card-bg);
		border: 1px solid rgba(95, 80, 56, 0.12);
		overflow-x: auto;
	}

	.about-philo-slot pre {
		margin: 0;
		background: transparent;
	}

	.about-philo-proofs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		margin: 0.5rem 0 0;
	}

	.about-philo-exits {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		margin: 2.5rem 0 1rem;
	}
</style>
