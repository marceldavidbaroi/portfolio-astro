---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { researchMetaExtras } from '../../data/aboutLayoutDummy';
import '../../styles/about.css';

export async function getStaticPaths() {
	const entries = await getCollection('research');
	return entries.map((entry) => ({
		params: { slug: entry.data.slug || entry.id },
		props: { publication: entry.data },
	}));
}

const { publication } = Astro.props;
const actionHref = publication.officialRepositoryUrl || researchMetaExtras.actionHref;
const actionLabel = publication.officialRepositoryUrl ? 'View repository ↗' : researchMetaExtras.actionLabel;
---

<BaseLayout
	title={`${publication.shortTitle} — Academic Research | Marcel David Baroi`}
	description={publication.abstract}
	isWide
	alignStart
>
	<nav class="attic-crumb font-mono" aria-label="Breadcrumb">
		<a href="/about" class="attic-crumb-link">About</a>
		<span class="attic-crumb-sep" aria-hidden="true">/</span>
		<a href="/education/bsc-cse" class="attic-crumb-link">B.Sc. CSE</a>
		<span class="attic-crumb-sep" aria-hidden="true">/</span>
		<span class="attic-crumb-current">Thesis</span>
	</nav>

	<header class="about-attic-head research-head">
		<p class="label font-mono about-attic-kicker">{publication.badge || publication.type}</p>
		<h1 class="about-attic-title">{publication.title}</h1>
		{publication.subtitle && <p class="about-attic-lead">{publication.subtitle}</p>}

		<dl class="edu-facts-rail font-mono research-meta-rail">
			<div class="edu-fact">
				<dt>Author</dt>
				<dd>{publication.author}</dd>
			</div>
			<div class="edu-fact">
				<dt>Institution</dt>
				<dd>{publication.institution}</dd>
			</div>
			<div class="edu-fact">
				<dt>Project</dt>
				<dd>#{publication.projectNumber}</dd>
			</div>
			<div class="edu-fact">
				<dt>Period</dt>
				<dd>{publication.period || researchMetaExtras.submissionDate}</dd>
			</div>
		</dl>

		<div class="hero-actions">
			<a class="btn-solid font-mono" href={actionHref} target="_blank" rel="noopener noreferrer">{actionLabel}</a>
			{publication.pdfDownloadUrl && (
				<a class="btn-ghost font-mono" href={publication.pdfDownloadUrl} target="_blank" rel="noopener noreferrer">Download PDF</a>
			)}
		</div>
	</header>

	<section class="about-section">
		<h2 class="about-section-title">Abstract</h2>
		<p class="about-principle-body">{publication.abstract}</p>
	</section>

	{publication.problemStatement && (
		<section class="about-section">
			<h2 class="about-section-title">Problem</h2>
			<p class="about-principle-body">{publication.problemStatement}</p>
		</section>
	)}

	{publication.keyMetrics?.length > 0 && (
		<section class="about-section">
			<h2 class="about-section-title">Key metrics</h2>
			<ul class="about-hero-proof research-metrics">
				{publication.keyMetrics.map((m) => (
					<li>
						<strong>{m.value}</strong>
						<span>{m.label}</span>
					</li>
				))}
			</ul>
		</section>
	)}

	{publication.methodologySummary && (
		<section class="about-section">
			<h2 class="about-section-title">Methodology</h2>
			<p class="about-principle-body">{publication.methodologySummary}</p>
		</section>
	)}

	{publication.dataProcessing?.length > 0 && (
		<section class="about-section edu-slot">
			<h2 class="about-section-title">Data pipeline</h2>
			<ul class="research-list">
				{publication.dataProcessing.map((step) => <li>{step}</li>)}
			</ul>
		</section>
	)}

	{publication.benchmarks?.length > 0 && (
		<section class="about-section edu-slot">
			<h2 class="about-section-title">Benchmarks</h2>
			<div class="research-table-wrap">
				<table class="research-table">
					<thead>
						<tr>
							<th>Model</th>
							<th>Vowel</th>
							<th>Consonant</th>
						</tr>
					</thead>
					<tbody>
						{publication.benchmarks.map((row) => (
							<tr>
								<td>{row.modelName}</td>
								<td>{row.vowelAccuracy}%</td>
								<td>{row.consonantAccuracy}%</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>
	)}

	{publication.keyTakeaways?.length > 0 && (
		<section class="about-section">
			<h2 class="about-section-title">Takeaways</h2>
			<ul class="research-list">
				{publication.keyTakeaways.map((item) => <li>{item}</li>)}
			</ul>
		</section>
	)}

	<a href="/about#school" class="about-return font-mono">← School</a>
</BaseLayout>

<style>
	.research-head {
		margin-bottom: 1rem;
	}

	.research-meta-rail {
		margin-top: 1.25rem;
	}

	.research-metrics {
		border-top: 0;
		padding-top: 0;
	}

	.research-list {
		margin: 0;
		padding-left: 1.1rem;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		font-size: var(--type-body);
		line-height: 1.55;
		color: var(--text-main);
	}

	.research-table-wrap {
		overflow-x: auto;
	}

	.research-table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--type-xyz);
	}

	.research-table th,
	.research-table td {
		padding: 0.55rem 0.65rem;
		border-top: 1px solid rgba(95, 80, 56, 0.12);
		text-align: left;
	}

	.research-table th {
		font-size: var(--type-caption);
		color: var(--text-muted);
		text-transform: uppercase;
	}
</style>
