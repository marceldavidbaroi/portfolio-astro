---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtticBreadcrumb from '../../components/about/AtticBreadcrumb.astro';
import { certifications } from '../../data/certifications';
import { credsDummyGroups } from '../../data/aboutLayoutDummy';
import '../../styles/about.css';

const totalCount = certifications.length;
const featured = certifications.filter((c) => c.isFeaturedOnAbout);
const authorities = [...new Set(certifications.map((c) => c.authority))];

const authorityLogos: Record<string, string> = {
	Google: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/googlecloud/googlecloud-original.svg',
	Cisco: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/cisco/cisco-original.svg',
	Microsoft: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/azure/azure-original.svg',
	LinkedIn: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linkedin/linkedin-original.svg',
	HackerRank: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg',
	freeCodeCamp: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg',
	Canva: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/canva/canva-original.svg',
};

const issuerGroups = Object.values(
	certifications.reduce<Record<string, { issuer: string; authority: string; rows: typeof certifications }>>(
		(acc, cert) => {
			const key = cert.issuerDisplay;
			if (!acc[key]) acc[key] = { issuer: cert.issuerDisplay, authority: cert.authority, rows: [] };
			acc[key].rows.push(cert);
			return acc;
		},
		{}
	)
).sort((a, b) => a.issuer.localeCompare(b.issuer));

const tabs = [
	{ id: 'featured', label: 'Featured', count: featured.length },
	{ id: 'all', label: 'All', count: totalCount },
	...authorities.map((auth) => ({
		id: auth,
		label: auth,
		count: certifications.filter((c) => c.authority === auth).length,
	})),
];
---

<BaseLayout
	title="Verified Credentials & Certifications | Marcel David Baroi"
	description="Official verified certifications across Google Cloud AI, Generative AI, Cisco Networking Academy, Microsoft, HackerRank, and freeCodeCamp."
	isWide
	alignStart
>
	<AtticBreadcrumb current="Credentials" />

	<header class="about-attic-head">
		<p class="label font-mono about-attic-kicker">Credentials</p>
		<h1 class="about-attic-title">Verified certifications</h1>
		<p class="about-attic-lead">
			{totalCount} industry credentials with direct verification links. Featured credentials surface first for recruiter triage.
		</p>
	</header>

	<div class="about-creds-toolbar">
		<div class="about-tabs" role="tablist" aria-label="Filter credentials" id="creds-tabs">
			{tabs.map((tab, i) => (
				<button
					class:list={['about-tab font-mono', { 'is-active': i === 0 }]}
					type="button"
					data-filter={tab.id}
					role="tab"
					aria-selected={i === 0 ? 'true' : 'false'}
				>
					{tab.label} <span class="about-tab-count">{tab.count}</span>
				</button>
			))}
			<span class="creds-tab-indicator" id="creds-tab-indicator" aria-hidden="true"></span>
		</div>
		<label class="about-creds-search-wrap">
			<span class="sr-only">Search credentials</span>
			<input type="search" id="creds-search" class="about-creds-search font-sans" placeholder="Title, issuer, category…" autocomplete="off" />
		</label>
	</div>

	<section class="about-section about-creds-featured" id="creds-featured" aria-label="Featured credentials">
		<div class="creds-group-header">
			<span class="creds-group-icon-wrap creds-badge-sheen" aria-hidden="true">★</span>
			<h2 class="about-stack-category font-mono">Featured</h2>
		</div>
		{featured.map((cert) => (
			<a
				href={cert.url}
				target="_blank"
				rel="noopener noreferrer"
				class="about-list-row cert-row cred-row"
				data-authority={cert.authority}
				data-featured="true"
				data-search={`${cert.title} ${cert.issuerDisplay} ${cert.category} ${cert.authority}`.toLowerCase()}
			>
				<p class="about-list-issuer font-mono">{cert.issuerDisplay}</p>
				<p class="about-list-title">{cert.title}</p>
				<p class="about-list-meta font-mono">{cert.date} <span class="cred-arrow">↗</span></p>
			</a>
		))}
	</section>

	{issuerGroups.map((group) => {
		const logoUrl = authorityLogos[group.authority];
		return (
			<section
				class="about-section about-creds-issuer"
				data-issuer-group={group.authority}
				aria-label={group.issuer}
			>
				<div class="creds-group-header">
					{logoUrl && (
						<span class="creds-group-logo-wrap">
							<img
								src={logoUrl}
								alt={`${group.issuer} logo`}
								class="creds-group-logo"
								loading="lazy"
								decoding="async"
							/>
						</span>
					)}
					<h2 class="about-stack-category font-mono">{group.issuer}</h2>
				</div>
				{group.rows.map((cert) => (
					<a
						href={cert.url}
						target="_blank"
						rel="noopener noreferrer"
						class="about-list-row cert-row"
						data-authority={cert.authority}
						data-featured={cert.isFeaturedOnAbout ? 'true' : 'false'}
						data-search={`${cert.title} ${cert.issuerDisplay} ${cert.category} ${cert.authority}`.toLowerCase()}
					>
						<p class="about-list-issuer font-mono">{cert.issuerDisplay}</p>
						<p class="about-list-title">{cert.title}</p>
						<p class="about-list-meta font-mono">{cert.date} <span class="cred-arrow">↗</span></p>
					</a>
				))}
			</section>
		);
	})}

	{credsDummyGroups.map((group) => (
		<section class="about-section about-creds-issuer about-creds-dummy" data-issuer-group={group.tabId} hidden>
			<div class="creds-group-header">
				<h2 class="about-stack-category font-mono">{group.issuer}</h2>
			</div>
			{group.rows.map((row) => (
				<a href={row.href} class="about-list-row cert-row" data-authority={group.tabId} data-featured="false" data-search={row.title.toLowerCase()}>
					<p class="about-list-issuer font-mono">{group.issuer}</p>
					<p class="about-list-title">{row.title}</p>
					<p class="about-list-meta font-mono">{row.date} <span class="cred-arrow">↗</span></p>
				</a>
			))}
		</section>
	))}

	<a href="/about" class="about-return font-mono">← About</a>
</BaseLayout>

<script>
	function initCredsFilter() {
		const tabsWrap = document.getElementById('creds-tabs');
		const indicator = document.getElementById('creds-tab-indicator');
		const tabs = document.querySelectorAll<HTMLButtonElement>('.about-tab[data-filter]');
		const rows = document.querySelectorAll<HTMLElement>('.cert-row');
		const sections = document.querySelectorAll<HTMLElement>('.about-creds-issuer, .about-creds-featured');
		const searchInput = document.getElementById('creds-search') as HTMLInputElement | null;
		const dummySections = document.querySelectorAll<HTMLElement>('.about-creds-dummy');

		if (!tabsWrap || !tabs.length) return;

		const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let filter = 'featured';

		function updateIndicator(activeTab: HTMLElement) {
			if (!indicator || prefersReduced) return;
			const wrapRect = tabsWrap!.getBoundingClientRect();
			const tabRect = activeTab.getBoundingClientRect();
			const left = tabRect.left - wrapRect.left;
			const width = tabRect.width;

			indicator.style.transform = `translateX(${left}px)`;
			indicator.style.width = `${width}px`;
			indicator.style.opacity = '1';
		}

		const initialActive = document.querySelector<HTMLButtonElement>('#creds-tabs .about-tab.is-active') || tabs[0];
		if (initialActive) {
			updateIndicator(initialActive);
		}

		function applyFilter(isTabSwitch = false) {
			const q = (searchInput?.value || '').trim().toLowerCase();

			if (prefersReduced || !isTabSwitch) {
				rows.forEach((row) => {
					const authority = row.dataset.authority || '';
					const isFeatured = row.dataset.featured === 'true';
					const hay = row.dataset.search || '';
					const matchFilter =
						filter === 'all' ||
						(filter === 'featured' && isFeatured) ||
						authority === filter;
					const matchSearch = !q || hay.includes(q);
					row.hidden = !(matchFilter && matchSearch);
					row.classList.remove('is-fading-out', 'is-settling-in');
				});

				sections.forEach((section) => {
					const visible = section.querySelectorAll('.cert-row:not([hidden])').length > 0;
					section.hidden = !visible;
				});

				if (filter !== 'all' && filter !== 'featured') {
					const hasVisible = [...rows].some((r) => !r.hidden && r.dataset.authority === filter);
					dummySections.forEach((s) => {
						if (s.dataset.issuerGroup === filter) s.hidden = hasVisible;
					});
				} else {
					dummySections.forEach((s) => { s.hidden = true; });
				}
				return;
			}

			// Smooth cross-dissolve when switching authority tabs
			const departing: HTMLElement[] = [];
			const arriving: HTMLElement[] = [];

			rows.forEach((row) => {
				const authority = row.dataset.authority || '';
				const isFeatured = row.dataset.featured === 'true';
				const hay = row.dataset.search || '';
				const matchFilter =
					filter === 'all' ||
					(filter === 'featured' && isFeatured) ||
					authority === filter;
				const matchSearch = !q || hay.includes(q);
				const willBeVisible = matchFilter && matchSearch;
				const isCurrentlyVisible = !row.hidden;

				if (isCurrentlyVisible && !willBeVisible) {
					departing.push(row);
				} else if (!isCurrentlyVisible && willBeVisible) {
					arriving.push(row);
				}
			});

			if (departing.length > 0) {
				departing.forEach((row) => row.classList.add('is-fading-out'));

				setTimeout(() => {
					departing.forEach((row) => {
						row.hidden = true;
						row.classList.remove('is-fading-out');
					});

					arriving.forEach((row) => {
						row.hidden = false;
						row.classList.add('is-settling-in');
						requestAnimationFrame(() => {
							row.classList.remove('is-settling-in');
						});
					});

					sections.forEach((section) => {
						const visible = section.querySelectorAll('.cert-row:not([hidden])').length > 0;
						section.hidden = !visible;
					});

					if (filter !== 'all' && filter !== 'featured') {
						const hasVisible = [...rows].some((r) => !r.hidden && r.dataset.authority === filter);
						dummySections.forEach((s) => {
							if (s.dataset.issuerGroup === filter) s.hidden = hasVisible;
						});
					} else {
						dummySections.forEach((s) => { s.hidden = true; });
					}
				}, 150);
			} else {
				arriving.forEach((row) => {
					row.hidden = false;
					row.classList.add('is-settling-in');
					requestAnimationFrame(() => {
						row.classList.remove('is-settling-in');
					});
				});

				sections.forEach((section) => {
					const visible = section.querySelectorAll('.cert-row:not([hidden])').length > 0;
					section.hidden = !visible;
				});

				if (filter !== 'all' && filter !== 'featured') {
					const hasVisible = [...rows].some((r) => !r.hidden && r.dataset.authority === filter);
					dummySections.forEach((s) => {
						if (s.dataset.issuerGroup === filter) s.hidden = hasVisible;
					});
				} else {
					dummySections.forEach((s) => { s.hidden = true; });
				}
			}
		}

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				filter = tab.dataset.filter || 'all';
				tabs.forEach((t) => {
					const active = t === tab;
					t.classList.toggle('is-active', active);
					t.setAttribute('aria-selected', active ? 'true' : 'false');
				});
				updateIndicator(tab);
				applyFilter(true);
			});
		});

		searchInput?.addEventListener('input', () => applyFilter(false));

		window.addEventListener('resize', () => {
			const activeTab = document.querySelector<HTMLButtonElement>('#creds-tabs .about-tab.is-active');
			if (activeTab) updateIndicator(activeTab);
		}, { passive: true });

		applyFilter(false);
	}

	initCredsFilter();
	document.addEventListener('astro:page-load', initCredsFilter);
</script>

<style>
	.about-creds-toolbar {
		margin-bottom: 1.5rem;
	}

	.about-tabs {
		position: relative;
	}

	.about-tabs .about-tab {
		border-bottom: 2px solid transparent !important;
	}

	.creds-tab-indicator {
		position: absolute;
		bottom: -1px;
		left: 0;
		height: 2px;
		background: var(--accent);
		opacity: 0;
		transition:
			transform var(--dur-ui, 220ms) var(--ease-ui, cubic-bezier(0.22, 1, 0.36, 1)),
			width var(--dur-ui, 220ms) var(--ease-ui, cubic-bezier(0.22, 1, 0.36, 1)),
			opacity var(--dur-fast, 150ms) ease;
		pointer-events: none;
		will-change: transform, width;
	}

	.about-creds-search-wrap {
		display: block;
		margin-top: 0.75rem;
		max-width: 22rem;
	}

	.about-creds-search {
		width: 100%;
		border: 0;
		border-bottom: 1px solid rgba(95, 80, 56, 0.22);
		background: transparent;
		padding: 0.35rem 0;
		font-size: var(--type-body);
		color: var(--text-main);
	}

	.about-creds-search:focus {
		outline: none;
		border-bottom-color: var(--accent);
	}

	.about-creds-featured {
		padding-top: 0;
	}

	.creds-group-header {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-bottom: 0.85rem;
	}

	.creds-group-header .about-stack-category {
		margin: 0;
	}

	.creds-group-logo-wrap {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: var(--radius-sm, 6px);
		background: var(--card-bg-elevated, #ffffff);
		border: 1px solid var(--card-border, rgba(95, 80, 56, 0.12));
		padding: 0.2rem;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
		flex-shrink: 0;
	}

	.creds-group-logo {
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}

	.creds-group-icon-wrap {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: var(--radius-sm, 6px);
		background: var(--card-bg-elevated, #ffffff);
		border: 1px solid var(--card-border, rgba(95, 80, 56, 0.12));
		color: var(--accent);
		font-size: 0.85rem;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
		flex-shrink: 0;
		overflow: hidden;
	}

	/* Featured Seal Badge Sheen Glint */
	.creds-badge-sheen::after {
		content: '';
		position: absolute;
		top: -50%;
		left: -60%;
		width: 40%;
		height: 200%;
		background: linear-gradient(
			90deg,
			transparent 0%,
			rgba(255, 255, 255, 0.55) 50%,
			transparent 100%
		);
		transform: rotate(25deg);
		opacity: 0;
		animation: badgeGlint 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.35s 1 forwards;
		pointer-events: none;
	}

	@keyframes badgeGlint {
		0% {
			left: -60%;
			opacity: 0;
		}
		30% {
			opacity: 1;
		}
		100% {
			left: 140%;
			opacity: 0;
		}
	}

	/* Row verification arrow glide & smooth cross-dissolve */
	.cert-row {
		transition: opacity 180ms var(--ease-out), transform 180ms var(--ease-out);
		will-change: opacity, transform;
	}

	.cert-row.is-fading-out {
		opacity: 0;
		transform: translateY(3px);
	}

	.cert-row.is-settling-in {
		opacity: 0;
		transform: translateY(3px);
	}

	.cred-arrow {
		display: inline-block;
		transition: transform var(--dur-ui, 220ms) var(--ease-ui, cubic-bezier(0.22, 1, 0.36, 1));
		will-change: transform;
	}

	.cert-row:hover .cred-arrow {
		transform: translate(2px, -2px);
	}

	:root[data-theme="dark"] .creds-group-logo-wrap,
	[data-theme="dark"] .creds-group-logo-wrap,
	:root[data-theme="dark"] .creds-group-icon-wrap,
	[data-theme="dark"] .creds-group-icon-wrap {
		background: var(--card-bg-elevated, #282623);
		border-color: var(--card-border, rgba(227, 222, 214, 0.12));
	}

	:root[data-theme="dark"] .creds-badge-sheen::after,
	[data-theme="dark"] .creds-badge-sheen::after {
		background: linear-gradient(
			90deg,
			transparent 0%,
			rgba(255, 255, 255, 0.22) 50%,
			transparent 100%
		);
	}

	@media (prefers-reduced-motion: reduce) {
		.creds-tab-indicator {
			display: none;
		}

		.about-tabs .about-tab.is-active {
			border-bottom-color: var(--accent) !important;
		}

		.creds-badge-sheen::after {
			display: none !important;
			animation: none !important;
		}

		.cert-row {
			opacity: 1 !important;
			transform: none !important;
			transition: none !important;
		}

		.cred-arrow {
			transform: none !important;
			transition: none !important;
		}
	}
</style>
