---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtticBreadcrumb from '../../components/about/AtticBreadcrumb.astro';
import { certifications } from '../../data/certifications';
import { credsDummyGroups } from '../../data/aboutLayoutDummy';
import '../../styles/about.css';

const totalCount = certifications.length;
const featured = certifications.filter((c) => c.isFeaturedOnAbout);
const authorities = [...new Set(certifications.map((c) => c.authority))];

const issuerGroups = Object.values(
	certifications.reduce<Record<string, { issuer: string; authority: string; rows: typeof certifications }>>(
		(acc, cert) => {
			const key = cert.issuerDisplay;
			if (!acc[key]) acc[key] = { issuer: cert.issuerDisplay, authority: cert.authority, rows: [] };
			acc[key].rows.push(cert);
			return acc;
		},
		{}
	)
).sort((a, b) => a.issuer.localeCompare(b.issuer));

const tabs = [
	{ id: 'featured', label: 'Featured', count: featured.length },
	{ id: 'all', label: 'All', count: totalCount },
	...authorities.map((auth) => ({
		id: auth,
		label: auth,
		count: certifications.filter((c) => c.authority === auth).length,
	})),
];
---

<BaseLayout
	title="Verified Credentials & Certifications | Marcel David Baroi"
	description="Official verified certifications across Google Cloud AI, Generative AI, Cisco Networking Academy, Microsoft, HackerRank, and freeCodeCamp."
	isWide
	alignStart
>
	<AtticBreadcrumb current="Credentials" />

	<header class="about-attic-head">
		<p class="label font-mono about-attic-kicker">Credentials</p>
		<h1 class="about-attic-title">Verified certifications</h1>
		<p class="about-attic-lead">
			{totalCount} industry credentials with direct verification links. Featured credentials surface first for recruiter triage.
		</p>
	</header>

	<div class="about-creds-toolbar">
		<div class="about-tabs" role="tablist" aria-label="Filter credentials" id="creds-tabs">
			{tabs.map((tab, i) => (
				<button
					class:list={['about-tab font-mono', { 'is-active': i === 0 }]}
					type="button"
					data-filter={tab.id}
					role="tab"
					aria-selected={i === 0 ? 'true' : 'false'}
				>
					{tab.label} <span class="about-tab-count">{tab.count}</span>
				</button>
			))}
		</div>
		<label class="about-creds-search-wrap">
			<span class="sr-only">Search credentials</span>
			<input type="search" id="creds-search" class="about-creds-search font-sans" placeholder="Title, issuer, category…" autocomplete="off" />
		</label>
	</div>

	<section class="about-section about-creds-featured" id="creds-featured" aria-label="Featured credentials">
		<h2 class="about-stack-category font-mono">Featured</h2>
		{featured.map((cert) => (
			<a
				href={cert.url}
				target="_blank"
				rel="noopener noreferrer"
				class="about-list-row cred-row"
				data-authority={cert.authority}
				data-featured="true"
				data-search={`${cert.title} ${cert.issuerDisplay} ${cert.category} ${cert.authority}`.toLowerCase()}
			>
				<p class="about-list-issuer font-mono">{cert.issuerDisplay}</p>
				<p class="about-list-title">{cert.title}</p>
				<p class="about-list-meta font-mono">{cert.date} ↗</p>
			</a>
		))}
	</section>

	{issuerGroups.map((group) => (
		<section
			class="about-section about-creds-issuer"
			data-issuer-group={group.authority}
			aria-label={group.issuer}
		>
			<h2 class="about-stack-category font-mono">{group.issuer}</h2>
			{group.rows.map((cert) => (
				<a
					href={cert.url}
					target="_blank"
					rel="noopener noreferrer"
					class="about-list-row cert-row"
					data-authority={cert.authority}
					data-featured={cert.isFeaturedOnAbout ? 'true' : 'false'}
					data-search={`${cert.title} ${cert.issuerDisplay} ${cert.category} ${cert.authority}`.toLowerCase()}
				>
					<p class="about-list-issuer font-mono">{cert.issuerDisplay}</p>
					<p class="about-list-title">{cert.title}</p>
					<p class="about-list-meta font-mono">{cert.date} ↗</p>
				</a>
			))}
		</section>
	))}

	{credsDummyGroups.map((group) => (
		<section class="about-section about-creds-issuer about-creds-dummy" data-issuer-group={group.tabId} hidden>
			<h2 class="about-stack-category font-mono">{group.issuer}</h2>
			{group.rows.map((row) => (
				<a href={row.href} class="about-list-row cert-row" data-authority={group.tabId} data-featured="false" data-search={row.title.toLowerCase()}>
					<p class="about-list-issuer font-mono">{group.issuer}</p>
					<p class="about-list-title">{row.title}</p>
					<p class="about-list-meta font-mono">{row.date} ↗</p>
				</a>
			))}
		</section>
	))}

	<a href="/about" class="about-return font-mono">← About</a>
</BaseLayout>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>('.about-tab[data-filter]');
	const rows = document.querySelectorAll<HTMLElement>('.cert-row');
	const sections = document.querySelectorAll<HTMLElement>('.about-creds-issuer, .about-creds-featured');
	const searchInput = document.getElementById('creds-search') as HTMLInputElement | null;
	const dummySections = document.querySelectorAll<HTMLElement>('.about-creds-dummy');

	let filter = 'featured';

	function applyFilter() {
		const q = (searchInput?.value || '').trim().toLowerCase();

		rows.forEach((row) => {
			const authority = row.dataset.authority || '';
			const isFeatured = row.dataset.featured === 'true';
			const hay = row.dataset.search || '';
			const matchFilter =
				filter === 'all' ||
				(filter === 'featured' && isFeatured) ||
				authority === filter;
			const matchSearch = !q || hay.includes(q);
			row.hidden = !(matchFilter && matchSearch);
		});

		sections.forEach((section) => {
			const visible = section.querySelectorAll('.cert-row:not([hidden])').length > 0;
			section.hidden = !visible;
		});

		if (filter !== 'all' && filter !== 'featured') {
			const hasVisible = [...rows].some((r) => !r.hidden && r.dataset.authority === filter);
			dummySections.forEach((s) => {
				if (s.dataset.issuerGroup === filter) s.hidden = hasVisible;
			});
		} else {
			dummySections.forEach((s) => { s.hidden = true; });
		}
	}

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			filter = tab.dataset.filter || 'all';
			tabs.forEach((t) => {
				const active = t === tab;
				t.classList.toggle('is-active', active);
				t.setAttribute('aria-selected', active ? 'true' : 'false');
			});
			applyFilter();
		});
	});

	searchInput?.addEventListener('input', applyFilter);
	applyFilter();
</script>

<style>
	.about-creds-toolbar {
		margin-bottom: 1.5rem;
	}

	.about-creds-search-wrap {
		display: block;
		margin-top: 0.75rem;
		max-width: 22rem;
	}

	.about-creds-search {
		width: 100%;
		border: 0;
		border-bottom: 1px solid rgba(95, 80, 56, 0.22);
		background: transparent;
		padding: 0.35rem 0;
		font-size: var(--type-body);
		color: var(--text-main);
	}

	.about-creds-search:focus {
		outline: none;
		border-bottom-color: var(--accent);
	}

	.about-creds-featured {
		padding-top: 0;
	}
</style>
