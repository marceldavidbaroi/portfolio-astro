---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { certifications, issuersSummary } from '../../data/certifications';

const totalCount = certifications.length;
const featuredCount = certifications.filter((c) => c.isFeaturedOnAbout).length;
const sortedCertifications = [
	...certifications.filter((c) => c.isFeaturedOnAbout),
	...certifications.filter((c) => !c.isFeaturedOnAbout),
];
---

<BaseLayout
	title="Verified Credentials & Certifications | Marcel David Baroi"
	description="Official verified certifications across Google Cloud AI, Generative AI, Cisco Networking Academy, Microsoft, HackerRank, and freeCodeCamp."
	isWide={true}
>
	<div class="credentials-page-container">
		<!-- Breadcrumbs -->
		<nav class="page-breadcrumb font-mono" aria-label="Breadcrumb">
			<a href="/" class="b-link">Home</a>
			<span class="b-sep">/</span>
			<a href="/about" class="b-link">About</a>
			<span class="b-sep">/</span>
			<span class="b-curr">Verified Credentials</span>
		</nav>

		<!-- Hero Header -->
		<header class="creds-hero card">
			<div class="hero-top-meta">
				<span class="section-tag font-dot">01 // VERIFIED CREDENTIALS</span>
				<span class="badge-status success font-mono">{totalCount} Industry Credentials</span>
			</div>

			<h1 class="creds-title font-dot">Professional Certifications & Accreditations</h1>
			<p class="creds-subtitle font-dot">Google Cloud • Cisco • Microsoft • LinkedIn • HackerRank • freeCodeCamp • Canva</p>

			<p class="creds-desc">
				A comprehensive directory of {totalCount} verified professional accreditations, industry certifications, and evaluated competencies spanning Enterprise AI, System Architecture, Modern Programming, and Project Leadership. Every entry links directly to its official issuing authority or Credly ledger. Start with the {featuredCount} high-rigor Featured credentials for fastest recruiter triage.
			</p>

			<!-- Issuer Summary Strip -->
			<div class="issuers-summary-grid font-mono">
				{issuersSummary.map((iss) => (
					<div class="issuer-pill card">
						<span class="i-count font-dot">{iss.count}</span>
						<div class="i-info">
							<span class="i-name">{iss.name}</span>
							<span class="i-badge font-mono">{iss.badge}</span>
						</div>
					</div>
				))}
			</div>
		</header>

		<!-- Interactive Filter & Search Controls -->
		<div class="creds-toolbar card">
			<div class="filter-tabs" role="tablist">
				<button class="filter-tab active font-mono" data-filter="featured">Featured / High-Rigor ({featuredCount})</button>
				<button class="filter-tab font-mono" data-filter="all">All ({totalCount})</button>
				<button class="filter-tab font-mono" data-filter="Google">Google Cloud (5)</button>
				<button class="filter-tab font-mono" data-filter="Cisco">Cisco (5)</button>
				<button class="filter-tab font-mono" data-filter="AI">GenAI & Copilot (7)</button>
				<button class="filter-tab font-mono" data-filter="Project Management">Management (6)</button>
				<button class="filter-tab font-mono" data-filter="Design">Design & UX (6)</button>
				<button class="filter-tab font-mono" data-filter="Coding">Languages & Web (5)</button>
			</div>

			<div class="search-box-wrap">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<input
					type="text"
					id="cert-search-input"
					class="cert-search-input font-mono"
					placeholder="Search credentials by title, authority, or category..."
					autocomplete="off"
				/>
				<span id="results-counter" class="results-counter font-mono">{featuredCount} showing</span>
			</div>
		</div>

		<!-- Certifications Grid -->
		<div class="certs-list-grid" id="certs-grid">
			{sortedCertifications.map((cert) => (
				<article
					class="cert-detail-card card"
					id={cert.id}
					data-authority={cert.authority}
					data-category={cert.category}
					data-featured={cert.isFeaturedOnAbout ? 'true' : 'false'}
					data-title={cert.title.toLowerCase()}
					data-keywords={`${cert.title} ${cert.authority} ${cert.issuerDisplay} ${cert.category} ${cert.licenseNumber || ''}`.toLowerCase()}
					style={cert.isFeaturedOnAbout ? undefined : 'display: none;'}
				>
					<div class="c-top-row">
						<span class="c-category font-mono">{cert.category}</span>
						<span class="c-date font-mono">{cert.date}</span>
					</div>

					<div class="c-main-row">
						<div class="c-svg-box">
							{cert.iconType === 'bot' && (
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="3" y="11" width="18" height="10" rx="2"></rect>
									<circle cx="12" cy="5" r="2"></circle>
									<path d="M12 7v4"></path>
									<line x1="8" y1="16" x2="8" y2="16"></line>
									<line x1="16" y1="16" x2="16" y2="16"></line>
								</svg>
							)}
							{cert.iconType === 'sparkles' && (
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
								</svg>
							)}
							{cert.iconType === 'terminal' && (
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<polyline points="4 17 10 11 4 5"></polyline>
									<line x1="12" y1="19" x2="20" y2="19"></line>
								</svg>
							)}
							{cert.iconType === 'code' && (
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<polyline points="16 18 22 12 16 6"></polyline>
									<polyline points="8 6 2 12 8 18"></polyline>
								</svg>
							)}
							{cert.iconType === 'globe' && (
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="10"></circle>
									<line x1="2" y1="12" x2="22" y2="12"></line>
									<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1 4-10z"></path>
								</svg>
							)}
							{cert.iconType === 'award' && (
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="8" r="7"></circle>
									<polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
								</svg>
							)}
							{cert.iconType === 'layers' && (
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
									<polyline points="2 17 12 22 22 17"></polyline>
									<polyline points="2 12 12 17 22 12"></polyline>
								</svg>
							)}
							{cert.iconType === 'palette' && (
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
									<circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
									<circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
									<circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
									<path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C22 6.5 17.5 2 12 2Z"></path>
								</svg>
							)}
						</div>
						<div class="c-title-box">
							<span class="c-issuer font-mono">{cert.issuerDisplay}</span>
							<h2 class="c-title">{cert.title}</h2>
						</div>
					</div>

					<p class="c-summary">{cert.summary}</p>

					<div class="c-footer">
						<div class="c-meta-left font-mono">
							{cert.licenseNumber && (
								<span class="c-id-badge" title="Credential License ID">
									<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
									</svg>
									ID: {cert.licenseNumber}
								</span>
							)}
							{cert.startedOn && (
								<span class="c-started-badge">
									Started: {cert.startedOn}
								</span>
							)}
						</div>

						<a
							href={cert.url}
							target="_blank"
							rel="noopener noreferrer"
							class="verify-btn font-mono"
							title={`Verify ${cert.title} on ${cert.authority}`}
						>
							<span>Verify Credential</span>
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
								<polyline points="15 3 21 3 21 9"></polyline>
								<line x1="10" y1="14" x2="21" y2="3"></line>
							</svg>
						</a>
					</div>
				</article>
			))}
		</div>

		<!-- No Results State -->
		<div id="no-results-box" class="no-results card hidden font-mono">
			<p>No credentials match your filter or search query. <button id="btn-reset-filters" class="reset-link">Reset filters</button></p>
		</div>

		<!-- Cross Navigation -->
		<div class="creds-cross-nav card">
			<div class="nav-col">
				<span class="nav-lbl font-mono">EXECUTIVE PROFILE</span>
				<a href="/about" class="nav-link">← Return to About Profile</a>
			</div>
			<div class="nav-col">
				<span class="nav-lbl font-mono">CAPABILITIES</span>
				<a href="/skills" class="nav-link">Technical Skill Matrix →</a>
			</div>
			<div class="nav-col">
				<span class="nav-lbl font-mono">ACADEMIC FOUNDATION</span>
				<a href="/education/bsc-cse" class="nav-link">B.Sc. in CSE Transcript →</a>
			</div>
		</div>
	</div>
</BaseLayout>

<script>
	function initCredentialsFilter() {
		const filterTabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
		const searchInput = document.getElementById('cert-search-input') as HTMLInputElement | null;
		const cards = document.querySelectorAll<HTMLElement>('.cert-detail-card');
		const counter = document.getElementById('results-counter');
		const noResults = document.getElementById('no-results-box');
		const resetBtn = document.getElementById('btn-reset-filters');

		let currentFilter = 'featured';
		let searchQuery = '';

		function applyFilters() {
			let visibleCount = 0;

			cards.forEach((card) => {
				const authority = card.getAttribute('data-authority') || '';
				const category = card.getAttribute('data-category') || '';
				const featured = card.getAttribute('data-featured') === 'true';
				const keywords = card.getAttribute('data-keywords') || '';

				// Category/Authority match
				let matchesFilter = true;
				if (currentFilter === 'featured') {
					matchesFilter = featured;
				} else if (currentFilter === 'all') {
					matchesFilter = true;
				} else if (currentFilter === 'Google') {
					matchesFilter = authority === 'Google';
				} else if (currentFilter === 'Cisco') {
					matchesFilter = authority === 'Cisco';
				} else if (currentFilter === 'AI') {
					matchesFilter = category === 'Cloud & Generative AI';
				} else if (currentFilter === 'Project Management') {
					matchesFilter = category === 'Project Management';
				} else if (currentFilter === 'Design') {
					matchesFilter = category === 'Design & UX Foundations';
				} else if (currentFilter === 'Coding') {
					matchesFilter = category === 'Core Engineering & Languages' || category === 'Frontend & Web Development';
				}

				// Search query match
				const matchesSearch = !searchQuery || keywords.includes(searchQuery);

				if (matchesFilter && matchesSearch) {
					card.style.display = 'flex';
					visibleCount++;
				} else {
					card.style.display = 'none';
				}
			});

			if (counter) {
				counter.textContent = `${visibleCount} showing`;
			}

			if (noResults) {
				if (visibleCount === 0) {
					noResults.classList.remove('hidden');
				} else {
					noResults.classList.add('hidden');
				}
			}
		}

		filterTabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				filterTabs.forEach((t) => t.classList.remove('active'));
				tab.classList.add('active');
				currentFilter = tab.getAttribute('data-filter') || 'featured';
				applyFilters();
			});
		});

		if (searchInput) {
			searchInput.addEventListener('input', (e) => {
				searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
				applyFilters();
			});
		}

		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				if (searchInput) searchInput.value = '';
				searchQuery = '';
				currentFilter = 'featured';
				filterTabs.forEach((t) => t.classList.remove('active'));
				const firstTab = document.querySelector<HTMLButtonElement>('.filter-tab[data-filter="featured"]');
				if (firstTab) firstTab.classList.add('active');
				applyFilters();
			});
		}

		applyFilters();
	}

	initCredentialsFilter();
	document.addEventListener('astro:after-swap', initCredentialsFilter);
</script>

<style>
	.credentials-page-container {
		width: 100%;
		max-width: 1080px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2.25rem;
		padding: 1rem 1rem 4rem;
		text-align: left;
	}

	/* Breadcrumb */
	.page-breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.b-link {
		color: var(--text-muted);
		transition: color 0.15s ease;
	}

	.b-link:hover {
		color: var(--accent);
	}

	.b-sep {
		opacity: 0.4;
	}

	.b-curr {
		color: var(--accent);
		font-weight: 600;
	}

	/* Hero */
	.creds-hero {
		padding: 2.25rem;
		border-radius: 16px;
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
		background: linear-gradient(135deg, var(--card-bg) 0%, rgba(180, 33, 53, 0.03) 100%);
		border: 1px solid rgba(180, 33, 53, 0.2);
	}

	.hero-top-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.badge-status.success {
		font-size: 0.72rem;
		padding: 0.2rem 0.65rem;
		border-radius: 9999px;
		background: rgba(46, 125, 50, 0.12);
		color: #2e7d32;
		border: 1px solid rgba(46, 125, 50, 0.25);
		font-weight: 700;
	}

	.creds-title {
		font-size: clamp(1.85rem, 3.5vw, 2.5rem);
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.2;
	}

	.creds-subtitle {
		font-size: 0.95rem;
		color: var(--accent);
		line-height: 1.4;
	}

	.creds-desc {
		font-size: 0.92rem;
		line-height: 1.65;
		color: var(--text-muted);
		max-width: 880px;
	}

	/* Issuer Summary Pills */
	.issuers-summary-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.75rem;
		padding-top: 0.85rem;
		border-top: 1px dashed rgba(95, 80, 56, 0.15);
	}

	@media (max-width: 900px) {
		.issuers-summary-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 480px) {
		.issuers-summary-grid {
			grid-template-columns: 1fr;
		}
	}

	.issuer-pill {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.65rem 0.85rem;
		border-radius: 10px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
	}

	.i-count {
		font-size: 1.2rem;
		font-weight: 800;
		color: var(--accent);
		min-width: 24px;
	}

	.i-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	.i-name {
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.2;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.i-badge {
		font-size: 0.68rem;
		color: var(--text-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* Toolbar & Controls */
	.creds-toolbar {
		padding: 1.25rem 1.5rem;
		border-radius: 14px;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
	}

	.filter-tabs {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.filter-tab {
		background: rgba(95, 80, 56, 0.05);
		border: 1px solid rgba(95, 80, 56, 0.12);
		padding: 0.35rem 0.75rem;
		border-radius: 6px;
		font-size: 0.75rem;
		color: var(--text-muted);
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.filter-tab:hover {
		color: var(--text-main);
		border-color: var(--accent);
		background: rgba(180, 33, 53, 0.05);
	}

	.filter-tab.active {
		background: var(--accent);
		color: #fffdfa;
		border-color: var(--accent);
		font-weight: 700;
	}

	.search-box-wrap {
		position: relative;
		display: flex;
		align-items: center;
		width: 100%;
	}

	.search-icon {
		position: absolute;
		left: 0.85rem;
		color: var(--text-muted);
		pointer-events: none;
	}

	.cert-search-input {
		width: 100%;
		padding: 0.6rem 6.5rem 0.6rem 2.4rem;
		border-radius: 8px;
		background: rgba(95, 80, 56, 0.03);
		border: 1px solid rgba(95, 80, 56, 0.15);
		color: var(--text-main);
		font-size: 0.82rem;
		outline: none;
		transition: border-color 0.15s ease;
	}

	.cert-search-input:focus {
		border-color: var(--accent);
		background: rgba(95, 80, 56, 0.06);
	}

	.results-counter {
		position: absolute;
		right: 0.85rem;
		font-size: 0.72rem;
		color: var(--text-muted);
	}

	@media (max-width: 768px) {
		.creds-hero,
		.creds-toolbar {
			padding: 1.25rem;
		}
	}

	@media (max-width: 480px) {
		.search-box-wrap {
			flex-direction: column;
			align-items: stretch;
			gap: 0.45rem;
		}

		.cert-search-input {
			padding-right: 0.85rem;
		}

		.results-counter {
			position: static;
			align-self: flex-end;
		}
	}

	/* Certs Grid */
	.certs-list-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 768px) {
		.certs-list-grid {
			grid-template-columns: 1fr;
		}
	}

	.cert-detail-card {
		padding: 1.6rem;
		border-radius: 14px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		transition: all 0.15s ease;
	}

	.cert-detail-card:hover {
		border-color: rgba(180, 33, 53, 0.35);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(180, 33, 53, 0.06);
	}

	.c-top-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.c-category {
		font-size: 0.68rem;
		color: var(--accent);
		background: rgba(180, 33, 53, 0.08);
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
		font-weight: 700;
	}

	.c-date {
		font-size: 0.72rem;
		color: var(--text-muted);
	}

	.c-main-row {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
	}

	.c-svg-box {
		width: 40px;
		height: 40px;
		border-radius: 10px;
		background: rgba(180, 33, 53, 0.08);
		color: var(--accent);
		border: 1px solid rgba(180, 33, 53, 0.2);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.c-title-box {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.c-issuer {
		font-size: 0.7rem;
		color: var(--accent);
		letter-spacing: 0.05em;
		font-weight: 700;
	}

	.c-title {
		font-size: 1.02rem;
